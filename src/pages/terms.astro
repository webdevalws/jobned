---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "September 18, 2026";
---

<Layout
  title="Terms and Conditions - JobNed"
  description="Read the official Terms and Conditions governing your use of JobNed recruitment platform, AI screening services, employer subscriptions, and payment transactions."
  keywords="terms and conditions, user agreement, JobNed terms of service, employer subscription terms, candidate portal rules"
  schemaType="Organization"
>
  <!-- Landing Navigation -->
  <header class="landing-nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="logo-icon">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span class="logo-text">Job<span class="highlight">Ned</span></span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/jobs">Find Jobs</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="nav-actions">
        <button type="button" class="theme-toggle-btn" aria-label="Toggle Light/Dark Theme" title="Toggle Light/Dark Theme">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href="/login" class="btn btn-outline">Sign In</a>
      </div>
    </div>
  </header>

  <main class="terms-page-wrapper">
    <div class="terms-container">
      
      <!-- Hero Banner -->
      <section class="terms-hero">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
          Legal Terms &amp; Conditions
        </div>
        <h1 class="terms-title">Terms and Conditions</h1>
        <p class="terms-subtitle">
          Please read these Terms and Conditions ("Terms", "Agreement") carefully before using the <strong>JobNed</strong> platform operated by <strong>RecruitNest Technologies Private Limited</strong>.
        </p>
        <div class="last-updated">
          <span>Last Updated: <strong>{lastUpdated}</strong></span>
        </div>
      </section>

      <!-- Content Layout -->
      <div class="terms-grid">
        
        <!-- Table of Contents Sticky Sidebar -->
        <aside class="terms-toc">
          <h3>Table of Contents</h3>
          <ul>
            <li><a href="#acceptance">1. Acceptance of Terms</a></li>
            <li><a href="#services">2. Platform &amp; SaaS Services</a></li>
            <li><a href="#account">3. User Accounts &amp; Security</a></li>
            <li><a href="#billing">4. Subscriptions, Fees &amp; Payments</a></li>
            <li><a href="#refund-cancellation">5. Cancellation &amp; No-Refund Policy</a></li>
            <li><a href="#employer-rules">6. Employer Conduct &amp; Postings</a></li>
            <li><a href="#candidate-rules">7. Candidate Conduct &amp; Resumes</a></li>
            <li><a href="#ai-disclaimer">8. AI Screening &amp; Match Scores</a></li>
            <li><a href="#intellectual-property">9. Intellectual Property</a></li>
            <li><a href="#liability">10. Limitation of Liability</a></li>
            <li><a href="#governing-law">11. Governing Law &amp; Jurisdiction</a></li>
            <li><a href="#contact-info">12. Contact &amp; Grievance Officer</a></li>
          </ul>
        </aside>

        <!-- Main Document Content -->
        <article class="terms-content">
          
          <section id="acceptance" class="policy-section">
            <h2>1. Acceptance of Terms</h2>
            <p>
              By accessing, browsing, registering an account, subscribing to any paid plan, or using the <strong>JobNed</strong> website (the "Platform" or "Service"), you agree to be bound by these Terms and Conditions, our <a href="/privacy">Privacy Policy</a>, and our <a href="/refund-policy">Cancellation &amp; Refund Policy</a>.
            </p>
            <p>
              If you do not agree with any part of these Terms, you must not access or use our services. These Terms apply to all visitors, job seekers ("Candidates"), hiring managers, recruiters, and companies ("Employers").
            </p>
          </section>

          <section id="services" class="policy-section">
            <h2>2. Platform &amp; SaaS Services</h2>
            <p>
              JobNed provides an online recruitment marketplace and candidate management software enabling:
            </p>
            <ul>
              <li><strong>Job Postings:</strong> Employers to create, manage, publish, and promote employment opportunities.</li>
              <li><strong>Candidate Discovery &amp; Applications:</strong> Candidates to discover job listings, submit resumes, take pre-screening questionnaires, and track application statuses.</li>
              <li><strong>AI Screening &amp; Match Analysis:</strong> Algorithmic parsing and semantic vector evaluation to match candidate skills with job requisitions.</li>
              <li><strong>Employer Subscriptions &amp; Credits:</strong> Premium software features, candidate resume access, interview scheduling, and team collaboration workflows.</li>
            </ul>
          </section>

          <section id="account" class="policy-section">
            <h2>3. User Accounts &amp; Security</h2>
            <p>
              When you create an account with JobNed, you must provide accurate, complete, and updated information. You are solely responsible for:
            </p>
            <ul>
              <li>Maintaining the confidentiality of your account credentials, passwords, and API keys.</li>
              <li>All activities and transactions conducted under your account.</li>
              <li>Promptly notifying us at <a href="mailto:support@jobned.com">support@jobned.com</a> of any unauthorized access or security breach.</li>
            </ul>
          </section>

          <section id="billing" class="policy-section">
            <h2>4. Subscriptions, Fees &amp; Payments (Razorpay Integration)</h2>
            <p>
              JobNed offers free tier features as well as premium paid subscription plans for employers and recruiting teams.
            </p>
            <ul>
              <li><strong>Payment Processing:</strong> All online payments, credit card, debit card, UPI, and net banking transactions are processed securely through our authorized payment gateway partner, <strong>Razorpay Software Private Limited</strong>.</li>
              <li><strong>Billing Cycle:</strong> Subscriptions are billed on a recurring monthly or annual basis as chosen during checkout.</li>
              <li><strong>Taxes:</strong> All applicable taxes (including GST where applicable in India) are calculated and displayed at checkout.</li>
              <li><strong>Automatic Renewals:</strong> To ensure uninterrupted access to hiring tools and job listings, paid subscriptions renew automatically unless cancelled prior to the renewal date.</li>
            </ul>
          </section>

          <section id="refund-cancellation" class="policy-section">
            <h2>5. Cancellation &amp; Strict No-Refund Policy</h2>
            <div class="alert-box">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
              <div>
                <strong>Important Notice on Refunds:</strong>
                <p>
                  JobNed maintains a <strong>Strict No-Refund Policy</strong>. Due to the digital SaaS nature of our platform—where employer credits, resume databases, and AI evaluations are instantly unlocked and consumed upon payment—all subscription payments and credit package purchases are non-refundable.
                </p>
              </div>
            </div>
            <p>
              You may cancel your auto-renewing subscription at any time via your Employer Account Settings. Upon cancellation, your access remains active until the end of the paid billing cycle, after which no further recurring charges will be made. For complete details, refer to our <a href="/refund-policy">Cancellation and Refund Policy</a>.
            </p>
          </section>

          <section id="employer-rules" class="policy-section">
            <h2>6. Employer Conduct &amp; Postings</h2>
            <p>
              Employers posting job vacancies agree that:
            </p>
            <ul>
              <li>All posted jobs represent genuine, lawful employment or contractual opportunities.</li>
              <li>Job listings do not demand unlawful fees or deposits from candidates to apply or interview.</li>
              <li>Job postings comply with applicable equal opportunity and anti-discrimination employment laws.</li>
              <li>Candidate personal resumes accessed via the platform are used solely for direct hiring evaluation and are not redistributed or resold to third-party data brokers.</li>
            </ul>
          </section>

          <section id="candidate-rules" class="policy-section">
            <h2>7. Candidate Conduct &amp; Resumes</h2>
            <p>
              Job seekers using JobNed agree that:
            </p>
            <ul>
              <li>All resume information, work history, skill declarations, and screening answers submitted are truthful and accurate.</li>
              <li>You will not upload malicious files, corrupted PDFs, or copyrighted materials that you do not have permission to distribute.</li>
              <li>You will not impersonate any person or entity in job applications.</li>
            </ul>
          </section>

          <section id="ai-disclaimer" class="policy-section">
            <h2>8. AI Screening &amp; Match Scores Disclaimer</h2>
            <p>
              JobNed's AI resume screening, skill matching, and candidate ranking algorithms are provided as assistive decision-support tools. Final hiring decisions, interviews, and job offers are made exclusively at the discretion of employers. JobNed does not guarantee candidate selection or employment.
            </p>
          </section>

          <section id="intellectual-property" class="policy-section">
            <h2>9. Intellectual Property</h2>
            <p>
              The Platform and its original content, features, logos, vector icons, design system, and proprietary algorithms are the exclusive property of <strong>RecruitNest Technologies Private Limited</strong> and are protected by applicable copyright, trademark, and trade secret laws.
            </p>
          </section>

          <section id="liability" class="policy-section">
            <h2>10. Limitation of Liability</h2>
            <p>
              To the maximum extent permitted by applicable law, in no event shall JobNed, its directors, employees, or partners be liable for any indirect, incidental, special, consequential, or punitive damages, including loss of profits, data, or business opportunities arising from the use or inability to use the platform.
            </p>
          </section>

          <section id="governing-law" class="policy-section">
            <h2>11. Governing Law &amp; Dispute Jurisdiction</h2>
            <p>
              These Terms shall be governed by and construed in accordance with the laws of <strong>India</strong>. Any disputes, claims, or legal actions arising under these Terms shall be subject to the exclusive jurisdiction of the competent courts in <strong>Bengaluru, Karnataka, India</strong>.
            </p>
          </section>

          <section id="contact-info" class="policy-section">
            <h2>12. Contact &amp; Grievance Redressal</h2>
            <p>
              For questions regarding these Terms or to reach our Grievance Officer in compliance with the Information Technology Act:
            </p>
            <div class="contact-card">
              <div class="contact-header">
                <h4>RecruitNest Technologies Pvt. Ltd. (JobNed)</h4>
              </div>
              <div class="contact-links">
                <div class="contact-item">
                  <span>General Support:</span>
                  <a href="mailto:support@jobned.com">support@jobned.com</a>
                </div>
                <div class="contact-item">
                  <span>Billing &amp; Payments:</span>
                  <a href="mailto:billing@jobned.com">billing@jobned.com</a>
                </div>
                <div class="contact-item">
                  <span>Grievance Officer:</span>
                  <a href="mailto:grievance@jobned.com">grievance@jobned.com</a>
                </div>
                <div class="contact-item">
                  <span>Address:</span>
                  <span>#402, Tech Hub Tower, Outer Ring Road, Bengaluru, KA 560103, India</span>
                </div>
              </div>
            </div>
          </section>

        </article>
      </div>
    </div>
  </main>
</Layout>

<style>
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }
  :global([data-theme="light"]) .landing-nav {
    background: rgba(255, 255, 255, 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
  }
  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--color-primary);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .terms-page-wrapper {
    min-height: 80vh;
    padding: 3.5rem 1.5rem 5rem 1.5rem;
  }
  .terms-container {
    max-width: 1160px;
    margin: 0 auto;
  }

  .terms-hero {
    text-align: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(167, 139, 250, 0.12);
    color: var(--color-primary);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .terms-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .terms-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.65;
  }
  .last-updated {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .terms-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
  }

  .terms-toc {
    position: sticky;
    top: 5rem;
    height: fit-content;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .terms-toc h3 {
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .terms-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .terms-toc a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .terms-toc a:hover {
    color: var(--color-primary);
  }

  .terms-content {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }
  .policy-section h2 {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(167, 139, 250, 0.25);
  }
  .policy-section p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
    font-size: 0.96rem;
  }
  .policy-section ul {
    color: var(--color-text-muted);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .policy-section li strong {
    color: var(--color-text-main);
  }
  .policy-section a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .alert-box {
    display: flex;
    gap: 1rem;
    background: rgba(245, 158, 11, 0.1);
    border: 1px solid rgba(245, 158, 11, 0.3);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    color: var(--color-text-main);
    margin: 1.25rem 0;
  }
  .alert-box svg {
    color: #F59E0B;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .alert-box strong {
    display: block;
    margin-bottom: 0.35rem;
    color: #F59E0B;
  }
  .alert-box p {
    margin: 0;
    font-size: 0.92rem;
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }
  .contact-header h4 {
    margin: 0 0 1rem 0;
    color: var(--color-text-main);
    font-size: 1.1rem;
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.92rem;
  }
  .contact-item span:first-child {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .terms-grid {
      grid-template-columns: 1fr;
    }
    .terms-toc {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .terms-title {
      font-size: 2.15rem;
    }
  }
</style>

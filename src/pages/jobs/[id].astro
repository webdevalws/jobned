                    </span>
                  </div>

                  <div class="candidate-card-footer">
                    <span class="applied-date-label">
                      Applied {new Date(app.appliedAt).toLocaleDateString(undefined, { month: 'short', day: 'numeric', year: 'numeric' })}
                    </span>
                    <div class="candidate-action-links">
                      {app.resumeUrl && (
                        <a href={getResumeViewerUrl(app.resumeUrl, Astro.url.origin)} target="_blank" rel="noopener noreferrer" class="btn-applicant-action" title="View PDF Resume">
                          📄 Resume
                        </a>
                      )}
                      <a href={`/employer/applications/${app.id}`} class="btn-applicant-action btn-review" title="Review & Shortlist">
                        Review Candidate →
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      )}
    </div>
  </div>

  <!-- Toast Notification element -->
  <div id="toast" class="toast" style="display: none;"></div>
</DashboardLayout>

<script>
  // Add Toast helper
  function showToast(message: string, type: 'success' | 'error' = 'success') {
    if (typeof (window as any).showToast === 'function') {
      (window as any).showToast(message, type);
      return;
    }
    const toast = document.getElementById('toast');
    if (!toast) return;
    toast.textContent = message;
    toast.className = `toast ${type === 'error' ? 'toast-error' : 'toast-success'}`;
    toast.style.display = 'block';
    setTimeout(() => {
      toast.style.display = 'none';
    }, 4000);
  }

  // Handle Resume Mode Toggle (Default vs Custom)
  const modeDefaultEl = document.getElementById('modeDefaultResume') as HTMLInputElement | null;
  const modeCustomEl = document.getElementById('modeCustomResume') as HTMLInputElement | null;
  const customUploadBox = document.getElementById('customResumeUploadBox');
  const labelDefault = document.getElementById('choiceDefaultResumeLabel');
  const labelCustom = document.getElementById('choiceCustomResumeLabel');
  const resumeFileInput = document.getElementById("resumeFile") as HTMLInputElement | null;

  function updateResumeModeUI() {
    if (modeCustomEl && modeCustomEl.checked) {
      if (customUploadBox) customUploadBox.style.display = 'block';
      if (labelCustom) labelCustom.classList.add('active');
      if (labelDefault) labelDefault.classList.remove('active');
      if (resumeFileInput) resumeFileInput.required = true;
    } else if (modeDefaultEl && modeDefaultEl.checked) {
      if (customUploadBox) customUploadBox.style.display = 'none';
      if (labelDefault) labelDefault.classList.add('active');
      if (labelCustom) labelCustom.classList.remove('active');
      if (resumeFileInput) {
        resumeFileInput.required = false;
        resumeFileInput.value = '';
      }
    }
  }

  modeDefaultEl?.addEventListener('change', updateResumeModeUI);
  modeCustomEl?.addEventListener('change', updateResumeModeUI);

  const form = document.getElementById("applyForm");
  if (form) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const jobId = (document.getElementById("applyJobId") as HTMLInputElement).value;
      const hasDefaultResume = (document.getElementById("hasDefaultResume") as HTMLInputElement)?.value === 'true';
      const isCustomMode = modeCustomEl ? modeCustomEl.checked : !hasDefaultResume;
      const useDefault = hasDefaultResume && !isCustomMode;

      const photoFileInput = document.getElementById("photoFile") as HTMLInputElement | null;
      const linkedinUrlInput = document.getElementById("linkedinUrl") as HTMLInputElement;
      const portfolioUrlInput = document.getElementById("portfolioUrl") as HTMLInputElement;
      const coverLetter = (document.getElementById("coverLetter") as HTMLTextAreaElement).value.trim();

      const file = resumeFileInput?.files?.[0];
      const photoFile = photoFileInput?.files?.[0];

      if (!useDefault && !file) {
        showToast("Please upload your resume", "error");
        resumeFileInput?.focus();
        return;
      }

      if (!photoFile && photoFileInput?.required) {
        showToast("Please upload a profile photo", "error");
        photoFileInput?.focus();
        return;
      }

      const linkedinUrl = linkedinUrlInput.value.trim();
      const linkedinRegex = /^https?:\/\/(www\.)?linkedin\.com\/(in|pub|profile)\/[a-zA-Z0-9%\-_]+(\/.*)?$/i;
      if (!linkedinUrl || !linkedinRegex.test(linkedinUrl)) {
        showToast("Please enter a valid LinkedIn profile URL (e.g., https://linkedin.com/in/yourname)", "error");
        linkedinUrlInput.focus();
        return;
      }

      let portfolioUrl = portfolioUrlInput.value.trim();
      if (portfolioUrl && !/^https?:\/\//i.test(portfolioUrl)) {
        portfolioUrl = "https://" + portfolioUrl;
      }

      // Collect screening questions answers
      const screeningCards = document.querySelectorAll('.screening-question-card');
      const screeningAnswers: any[] = [];
      let hasValidationError = false;

      screeningCards.forEach(card => {
        if (hasValidationError) return;
        const qId = card.getAttribute('data-q-id') || '';
        const qType = card.getAttribute('data-q-type') || '';
        const qText = card.getAttribute('data-q-text') || '';
        const isRequired = card.getAttribute('data-q-required') === 'true';

        let answer = '';
        if (qType === 'yes_no') {
          const checkedRadio = card.querySelector(`input[name="sq_${qId}"]:checked`) as HTMLInputElement | null;
          answer = checkedRadio ? checkedRadio.value : '';
        } else if (qType === 'select') {
          const selectEl = card.querySelector(`select[name="sq_${qId}"]`) as HTMLSelectElement | null;
          answer = selectEl ? selectEl.value.trim() : '';
        } else if (qType === 'paragraph') {
          const textareaEl = card.querySelector(`textarea[name="sq_${qId}"]`) as HTMLTextAreaElement | null;
          answer = textareaEl ? textareaEl.value.trim() : '';
        } else {
          const inputEl = card.querySelector(`input[name="sq_${qId}"]`) as HTMLInputElement | null;
          answer = inputEl ? inputEl.value.trim() : '';
        }

        if (isRequired && !answer) {
          showToast(`Please answer required question: "${qText}"`, "error");
          hasValidationError = true;
          return;
        }

        if (answer) {
          screeningAnswers.push({
            id: qId,
            question: qText,
            type: qType,
            answer: answer
          });
        }
      });

      if (hasValidationError) {
        return;
      }

      const submitBtn = document.getElementById("submitApplyBtn") as HTMLButtonElement;
      const submitText = document.getElementById("submitApplyText") as HTMLElement;
      const submitSpinner = document.getElementById("submitApplySpinner") as HTMLElement;

      submitBtn.disabled = true;
      submitText.style.display = "none";
      submitSpinner.style.display = "inline";

      try {
        const formData = new FormData();
        formData.append("jobPostingId", jobId);

        if (useDefault) {
          formData.append("useDefaultResume", "true");
        } else if (file) {
          formData.append("resume", file);
          const saveAsDefaultCheckbox = document.getElementById("saveAsDefault") as HTMLInputElement | null;
          if (saveAsDefaultCheckbox && saveAsDefaultCheckbox.checked) {
            formData.append("saveAsDefault", "true");
          }
        }

        if (photoFile) {
          formData.append("photo", photoFile);
        }

        formData.append("linkedinUrl", linkedinUrl);
        if (portfolioUrl) {
          formData.append("portfolioUrl", portfolioUrl);
        }
        if (coverLetter) {
          formData.append("coverLetter", coverLetter);
        }
        if (screeningAnswers.length > 0) {
          formData.append("screeningAnswers", JSON.stringify(screeningAnswers));
        }

        const res = await fetch("/api/employee/apply", {
          method: "POST",
          body: formData,
        });

        const data = await res.json();

        if (res.ok) {
          showToast("Application submitted successfully! 🎉");
          setTimeout(() => {
            window.location.reload();
          }, 1500);
        } else {
          showToast(data.error || "Failed to submit application", "error");
        }
      } catch (err) {
        showToast("Network error. Please try again.", "error");
      } finally {
        submitBtn.disabled = false;
        submitText.style.display = "inline";
        submitSpinner.style.display = "none";
      }
    });
  }
</script>


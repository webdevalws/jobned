---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "August 26, 2026";
---

<Layout
  title="Privacy Policy - JobNed"
  description="Learn how JobNed collects, protects, processes, and respects user data, applicant resumes, AI candidate screening models, and hiring organization security."
  keywords="privacy policy, candidate data security, AI resume screening privacy, JobNed legal, GDPR compliance"
>
  <!-- Header / Hero Section -->
  <header class="landing-nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="logo-icon">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span class="logo-text">Job<span class="highlight">Ned</span></span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/jobs">Find Jobs</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
      </nav>
      <div class="nav-actions">
        <button type="button" class="theme-toggle-btn" aria-label="Toggle Light/Dark Theme" title="Toggle Light/Dark Theme">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href="/login" class="btn btn-outline">Sign In</a>
      </div>
    </div>
  </header>

  <main class="privacy-page-wrapper">
    <div class="privacy-container">
      
      <!-- Hero Banner -->
      <section class="privacy-hero">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
          Legal & Privacy
        </div>
        <h1 class="privacy-title">Privacy Policy</h1>
        <p class="privacy-subtitle">
          At <strong>JobNed</strong>, we take your trust, data security, and candidate privacy seriously. This policy outlines how we collect, handle, process, and protect your information across our platform.
        </p>
        <div class="last-updated">
          <span>Effective Date: <strong>{lastUpdated}</strong></span>
        </div>
      </section>

      <!-- Content Grid -->
      <div class="privacy-grid">
        
        <!-- Sidebar Navigation -->
        <aside class="privacy-toc">
          <h3>Table of Contents</h3>
          <ul>
            <li><a href="#overview">1. Overview & Information We Collect</a></li>
            <li><a href="#how-we-use-data">2. How We Use Your Data</a></li>
            <li><a href="#ai-screening">3. AI Screening & Automated Match Score</a></li>
            <li><a href="#data-sharing">4. Data Sharing & Third Parties</a></li>
            <li><a href="#security">5. Data Retention & Security</a></li>
            <li><a href="#user-rights">6. Your Rights & Account Control</a></li>
            <li><a href="#cookies">7. Cookie Policy & Sessions</a></li>
            <li><a href="#contact">8. Contact Our Team</a></li>
          </ul>
        </aside>

        <!-- Main Document Body -->
        <article class="privacy-content">
          
          <section id="overview" class="policy-section">
            <h2>1. Overview & Information We Collect</h2>
            <p>
              JobNed ("we", "us", or "our") operates the job board and applicant tracking platform available at <code>recruitnest.prashantsinghstd.workers.dev</code>. We collect information necessary to deliver job applications, candidate evaluation, and employer job posting workflows.
            </p>
            <h3>A. Information You Provide Directly:</h3>
            <ul>
              <li><strong>Candidate Profile Data:</strong> Full name, email address, headline, work history, skill tags, and headshot photo.</li>
              <li><strong>Resume Documents:</strong> Resumes and CVs uploaded in PDF, DOCX, or image formats stored securely in cloud storage.</li>
              <li><strong>Screening Answers:</strong> Candidate responses to job-specific pre-screening questionnaires.</li>
              <li><strong>Employer Company Data:</strong> Company name, industry, corporate website URL, and job posting specifications.</li>
            </ul>
            <h3>B. Automatically Collected Data:</h3>
            <ul>
              <li>Session tokens, authentication cookies, and request IP addresses required to maintain user sign-in security.</li>
            </ul>
          </section>

          <section id="how-we-use-data" class="policy-section">
            <h2>2. How We Use Your Data</h2>
            <p>We process personal and hiring data strictly for the following real platform operations:</p>
            
            <div class="use-case-cards">
              
              <!-- Card 1 -->
              <div class="use-card">
                <div class="card-header">
                  <div class="card-icon-box">🎯</div>
                  <span class="card-pill">Platform Matching</span>
                </div>
                <h4>AI Job & Resume Skill Matching</h4>
                <p>
                  Our platform generates objective candidate match scores by calculating vector embeddings from job requirements and candidate resumes.
                </p>
                <div class="card-details-list">
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>AI Vector Embeddings:</strong> Analyzes skill relevance, experience level, and role alignment.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Match Score Calculation:</strong> Displays match percentage scores on employer candidate dashboards.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Job Recommendations:</strong> Highlights relevant vacancies matching candidate profiles.</div>
                  </div>
                </div>
              </div>

              <!-- Card 2 -->
              <div class="use-card">
                <div class="card-header">
                  <div class="card-icon-box">⚡</div>
                  <span class="card-pill">Application Pipeline</span>
                </div>
                <h4>Application Delivery & Pipeline Tracking</h4>
                <p>
                  When a candidate submits a job application, their uploaded resume, screening questionnaire answers, and photo are processed and delivered directly to the hiring employer.
                </p>
                <div class="card-details-list">
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Employer Applicant Review:</strong> Enables employers to view resumes, screening answers, and AI scores.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Status Updates:</strong> Updates application status (Received, Under Review, Shortlisted, Rejected).</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Candidate Dashboard:</strong> Allows job seekers to monitor their application progress in real time.</div>
                  </div>
                </div>
              </div>

              <!-- Card 3 -->
              <div class="use-card">
                <div class="card-header">
                  <div class="card-icon-box">✏️</div>
                  <span class="card-pill">Job Creation</span>
                </div>
                <h4>Employer Job Posting & Screening Workflows</h4>
                <p>
                  Employers use JobNed to publish job listings with rich text formatted descriptions and custom screening questions.
                </p>
                <div class="card-details-list">
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>CKEditor Description Formatting:</strong> Supports rich HTML formatted job requirements & duties.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Pre-Screening Questionnaires:</strong> Configures custom questions for candidates to answer during application.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Job Post Management:</strong> Edit, update, publish, or archive active job postings at any time.</div>
                  </div>
                </div>
              </div>

              <!-- Card 4 -->
              <div class="use-card">
                <div class="card-header">
                  <div class="card-icon-box">🔒</div>
                  <span class="card-pill">Account Security</span>
                </div>
                <h4>Account Security & Data Protection</h4>
                <p>
                  We implement robust cryptographic and authentication controls to safeguard candidate and employer user accounts.
                </p>
                <div class="card-details-list">
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Argon2id Password Hashing:</strong> Protects account passwords using modern password hashing standards.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Session Authentication:</strong> Secure HTTP-only session cookies prevent unauthorized access.</div>
                  </div>
                  <div class="detail-item">
                    <span class="check-icon">✓</span>
                    <div><strong>Role-Based Access Control:</strong> Enforces separate permissions for Candidates, Employers, and Admins.</div>
                  </div>
                </div>
              </div>

            </div>
          </section>

          <section id="ai-screening" class="policy-section">
            <h2>3. AI Screening & Automated Match Score</h2>
            <p>
              JobNed calculates candidate match scores using Cloudflare AI Vectorize embeddings. Match scores are based strictly on job qualifications, skills, and experience metrics.
            </p>
          </section>

          <section id="data-sharing" class="policy-section">
            <h2>4. Data Sharing & Third Parties</h2>
            <p>
              We do <strong>NOT</strong> sell user data. Candidate profiles and resumes are shared only with the specific employer to whom the candidate submits an application.
            </p>
          </section>

          <section id="security" class="policy-section">
            <h2>5. Data Retention & Security</h2>
            <p>
              Uploaded resume files and user profile records are stored securely in Cloudflare R2 and D1 database storage with encrypted transmission protocols.
            </p>
          </section>

          <section id="user-rights" class="policy-section">
            <h2>6. Your Rights & Account Control</h2>
            <p>Users have full control over their account data and submitted applications:</p>
            
            <div class="rights-grid">
              
              <div class="right-card">
                <div class="right-icon">📂</div>
                <div class="right-body">
                  <h4>Access & Review Data</h4>
                  <p>View all your submitted job applications, uploaded resumes, profile headshots, and saved jobs directly in your candidate dashboard.</p>
                </div>
              </div>

              <div class="right-card">
                <div class="right-icon">✏️</div>
                <div class="right-body">
                  <h4>Update Profile & Resume</h4>
                  <p>Instantly update your contact details, headline, skills, or uploaded resume document in your account settings.</p>
                </div>
              </div>

              <div class="right-card">
                <div class="right-icon">🔖</div>
                <div class="right-body">
                  <h4>Saved Jobs Management</h4>
                  <p>Save job listings to review later and remove saved bookmarks from your account whenever you choose.</p>
                </div>
              </div>

            </div>
          </section>

          <section id="cookies" class="policy-section">
            <h2>7. Cookie Policy & Sessions</h2>
            <p>
              JobNed uses essential session cookies to keep you signed in securely and remember your active theme preferences (Dark/Light mode).
            </p>
          </section>

          <section id="contact" class="policy-section">
            <h2>8. Contact Our Support Team</h2>
            <p>
              If you have any questions regarding this Privacy Policy or your account data, please contact our support team:
            </p>
            <div class="contact-card">
              <div class="contact-header">
                <h4>JobNed Support Team</h4>
              </div>
              <div class="contact-links">
                <div class="contact-item">
                  <span>Support Email:</span>
                  <a href="mailto:support@jobned.com">support@jobned.com</a>
                </div>
                <div class="contact-item">
                  <span>Privacy Email:</span>
                  <a href="mailto:privacy@jobned.com">privacy@jobned.com</a>
                </div>
              </div>
            </div>
          </section>

        </article>
      </div>
    </div>
  </main>
</Layout>

<style>
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }
  :global([data-theme="light"]) .landing-nav {
    background: rgba(255, 255, 255, 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
  }
  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--color-primary);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .privacy-page-wrapper {
    min-height: 80vh;
    padding: 3.5rem 1.5rem 5rem 1.5rem;
  }
  .privacy-container {
    max-width: 1160px;
    margin: 0 auto;
  }

  .privacy-hero {
    text-align: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(16, 185, 129, 0.12);
    color: var(--color-primary);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .privacy-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .privacy-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.65;
  }
  .last-updated {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  .privacy-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
  }

  .privacy-toc {
    position: sticky;
    top: 5rem;
    height: fit-content;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .privacy-toc h3 {
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .privacy-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .privacy-toc a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .privacy-toc a:hover {
    color: var(--color-primary);
  }

  .privacy-content {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }
  .policy-section h2 {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(16, 185, 129, 0.25);
  }
  .policy-section h3 {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 1.25rem 0 0.5rem 0;
  }
  .policy-section p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }
  .policy-section ul {
    color: var(--color-text-muted);
    line-height: 1.7;
    padding-left: 1.25rem;
    margin-bottom: 1rem;
  }
  .policy-section li {
    margin-bottom: 0.5rem;
  }

  .use-case-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .use-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.25s ease;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.03);
  }
  .use-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.85rem;
  }
  .card-icon-box {
    width: 44px;
    height: 44px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
  }
  .card-pill {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--color-primary);
    background: rgba(16, 185, 129, 0.12);
    padding: 0.25rem 0.65rem;
    border-radius: 50px;
  }

  .use-card h4 {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 0.5rem;
  }
  .use-card p {
    font-size: 0.92rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .card-details-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem;
  }
  .detail-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  .check-icon {
    color: var(--color-primary);
    font-weight: 800;
    margin-top: 1px;
  }
  .detail-item strong {
    color: var(--color-text-main);
  }

  /* User Rights Cards */
  .rights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
    margin-top: 1.25rem;
  }
  .right-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.25rem;
    display: flex;
    gap: 0.85rem;
  }
  .right-icon {
    font-size: 1.5rem;
    line-height: 1;
  }
  .right-body h4 {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 0.35rem;
  }
  .right-body p {
    font-size: 0.85rem;
    line-height: 1.5;
    margin-bottom: 0;
  }

  /* Contact Card */
  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 1.5rem;
    margin-top: 1rem;
  }
  .contact-header h4 {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 1rem;
  }
  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 1rem 1.25rem;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.88rem;
  }
  .contact-item span {
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }
  .contact-item a {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 700;
  }

  @media (max-width: 868px) {
    .nav-links {
      display: none;
    }
    .privacy-grid {
      grid-template-columns: 1fr;
    }
    .privacy-toc {
      position: static;
    }
    .privacy-title {
      font-size: 2rem;
    }
  }
</style>

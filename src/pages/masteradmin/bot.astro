---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { botConversations, botMessages } from '../../db/schema';
import { desc, eq } from 'drizzle-orm';

Astro.response.headers.set(
  "Cache-Control",
  "no-store, no-cache, must-revalidate, max-age=0",
);

const payload = Astro.locals.user;
if (!payload || (payload.userType !== 'masteradmin' && payload.userType !== 'superadmin')) {
  return Astro.redirect('/login');
}

const db = getDb();

let conversations: any[] = [];
let totalConversationsCount = 0;
let namedCount = 0;
let anonymousCount = 0;
let totalMessagesLogged = 0;

try {
  conversations = await db
    .select()
    .from(botConversations)
    .where(eq(botConversations.isDeleted, false))
    .orderBy(desc(botConversations.updatedAt))
    .all();

  totalConversationsCount = conversations.length;
  namedCount = conversations.filter(c => c.visitorName && c.visitorName !== 'Anonymous').length;
  anonymousCount = conversations.filter(c => !c.visitorName || c.visitorName === 'Anonymous').length;
  totalMessagesLogged = conversations.reduce((acc, c) => acc + (Number(c.messageCount) || 0), 0);
} catch (e) {
  console.error('Error fetching bot conversations:', e);
}
---

<DashboardLayout title="Bot Conversations - MasterAdmin" userType="masteradmin" activePath="/masteradmin/bot">
  <div class="bot-admin-container">
    <!-- Header Section -->
    <div class="dashboard-header mb-4">
      <div class="header-titles">
        <span class="badge-tag">AI Chat Logs & User Intelligence</span>
        <h1>JobNed AI Bot Conversations</h1>
        <p class="subtitle">Monitor live visitor interactions, captured names, user questions, and automated platform guidance.</p>
      </div>
      <div class="stats-counter-pill">
        <strong>{totalConversationsCount}</strong> Total Conversations
      </div>
    </div>

    <!-- Metric Overview Cards (2x2 on mobile, 4x1 on desktop) -->
    <div class="bot-metrics-grid mb-4">
      <div class="metric-card">
        <div class="metric-icon metric-purple">🤖</div>
        <div class="metric-info">
          <span class="metric-label">Total Chats</span>
          <span class="metric-value">{totalConversationsCount}</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon metric-green">👤</div>
        <div class="metric-info">
          <span class="metric-label">Named Users</span>
          <span class="metric-value">{namedCount}</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon metric-gray">🕵️</div>
        <div class="metric-info">
          <span class="metric-label">Anonymous</span>
          <span class="metric-value">{anonymousCount}</span>
        </div>
      </div>

      <div class="metric-card">
        <div class="metric-icon metric-blue">💬</div>
        <div class="metric-info">
          <span class="metric-label">Messages</span>
          <span class="metric-value">{totalMessagesLogged}</span>
        </div>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="controls-bar-container mb-4">
      <div class="search-input-wrapper">
        <span class="search-icon">🔍</span>
        <input
          type="text"
          id="botSearchInput"
          class="search-input"
          placeholder="Search by visitor name, message snippet, or ID..."
        />
      </div>
      <div class="filter-group">
        <select id="botFilterSelect" class="filter-select">
          <option value="all">All Visitors ({totalConversationsCount})</option>
          <option value="named">Named Users ({namedCount})</option>
          <option value="anonymous">Anonymous ({anonymousCount})</option>
        </select>
      </div>
    </div>

    {conversations.length === 0 ? (
      <div class="empty-state-card">
        <div class="empty-icon">🤖</div>
        <h3>No Chat Conversations Yet</h3>
        <p>When visitors chat with JobNed AI, conversations and captured names will appear here.</p>
      </div>
    ) : (
      <>
        <!-- 1. DESKTOP & TABLET TABLE VIEW (Hidden on screens < 768px) -->
        <div class="bot-table-view">
          <div class="table-card">
            <div class="table-responsive">
              <table class="data-table" id="botConversationsTable">
                <thead>
                  <tr>
                    <th>Visitor / Name</th>
                    <th>Type</th>
                    <th>Last Message Snippet</th>
                    <th>Page Source</th>
                    <th>Messages</th>
                    <th>Last Active</th>
                    <th style="text-align: right;">Actions</th>
                  </tr>
                </thead>
                <tbody id="botTableBody">
                  {conversations.map((conv) => {
                    const isNamed = conv.visitorName && conv.visitorName !== 'Anonymous';
                    const nameDisplay = isNamed ? conv.visitorName : 'Anonymous';
                    const dateVal = conv.updatedAt || conv.createdAt;
                    let formattedDate = 'Just now';
                    if (dateVal) {
                      try {
                        const d = typeof dateVal === 'number' ? (dateVal < 10000000000 ? new Date(dateVal * 1000) : new Date(dateVal)) : new Date(dateVal);
                        if (!isNaN(d.getTime())) {
                          formattedDate = d.toLocaleString([], {
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit'
                          });
                        }
                      } catch (e) {}
                    }

                    const searchBlob = `${conv.id} ${nameDisplay} ${conv.lastMessage || ''} ${conv.currentPath || ''}`.toLowerCase();

                    return (
                      <tr
                        class="bot-row"
                        data-search={searchBlob}
                        data-type={isNamed ? 'named' : 'anonymous'}
                        data-id={conv.id}
                        data-name={nameDisplay}
                      >
                        <td>
                          <div class="visitor-cell">
                            <div class={`visitor-avatar ${isNamed ? 'avatar-named' : 'avatar-anon'}`}>
                              {isNamed ? nameDisplay.charAt(0).toUpperCase() : '👤'}
                            </div>
                            <div class="visitor-details">
                              <span class="visitor-name-title">{nameDisplay}</span>
                              <span class="visitor-id-sub">{conv.id.slice(0, 14)}...</span>
                            </div>
                          </div>
                        </td>

                        <td>
                          {isNamed ? (
                            <span class="status-badge badge-named">✓ Named</span>
                          ) : (
                            <span class="status-badge badge-anon">Anonymous</span>
                          )}
                        </td>

                        <td>
                          <div class="msg-snippet-cell" title={conv.lastMessage || 'No messages'}>
                            {conv.lastMessage ? conv.lastMessage : <em style="color: var(--color-text-muted);">Started chat</em>}
                          </div>
                        </td>

                        <td>
                          <span class="page-source-tag">
                            {conv.currentPath || '/'}
                          </span>
                        </td>

                        <td>
                          <span class="msg-count-badge">
                            {conv.messageCount || 0} msgs
                          </span>
                        </td>

                        <td>
                          <span class="date-cell">{formattedDate}</span>
                        </td>

                        <td style="text-align: right;">
                          <div class="action-buttons-group">
                            <button
                              type="button"
                              class="btn-view-chat"
                              data-conv-id={conv.id}
                              data-conv-name={nameDisplay}
                              title="View Full Chat Transcript"
                            >
                              💬 View Chat
                            </button>
                            <button
                              type="button"
                              class="btn-delete-conv"
                              data-conv-id={conv.id}
                              title="Delete Conversation"
                            >
                              🗑️
                            </button>
                          </div>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          </div>
        </div>

        <!-- 2. MOBILE CARDS VIEW (Visible only on screens < 768px for perfect touch responsiveness) -->
        <div class="bot-mobile-cards-view">
          {conversations.map((conv) => {
            const isNamed = conv.visitorName && conv.visitorName !== 'Anonymous';
            const nameDisplay = isNamed ? conv.visitorName : 'Anonymous';
            const dateVal = conv.updatedAt || conv.createdAt;
            let formattedDate = 'Just now';
            if (dateVal) {
              try {
                const d = typeof dateVal === 'number' ? (dateVal < 10000000000 ? new Date(dateVal * 1000) : new Date(dateVal)) : new Date(dateVal);
                if (!isNaN(d.getTime())) {
                  formattedDate = d.toLocaleString([], {
                    month: 'short',
                    day: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                  });
                }
              } catch (e) {}
            }

            const searchBlob = `${conv.id} ${nameDisplay} ${conv.lastMessage || ''} ${conv.currentPath || ''}`.toLowerCase();

            return (
              <div
                class="bot-mobile-card"
                data-search={searchBlob}
                data-type={isNamed ? 'named' : 'anonymous'}
                data-id={conv.id}
                data-name={nameDisplay}
              >
                <!-- Card Header -->
                <div class="mobile-card-header">
                  <div class="mobile-card-user">
                    <div class={`visitor-avatar ${isNamed ? 'avatar-named' : 'avatar-anon'}`}>
                      {isNamed ? nameDisplay.charAt(0).toUpperCase() : '👤'}
                    </div>
                    <div class="mobile-user-details">
                      <div class="mobile-name-row">
                        <span class="visitor-name-title">{nameDisplay}</span>
                        {isNamed ? (
                          <span class="status-badge badge-named">✓ Named</span>
                        ) : (
                          <span class="status-badge badge-anon">Anonymous</span>
                        )}
                      </div>
                      <span class="visitor-id-sub">ID: {conv.id.slice(0, 16)}...</span>
                    </div>
                  </div>
                  <span class="date-cell mobile-date">{formattedDate}</span>
                </div>

                <!-- Card Message Snippet -->
                <div class="mobile-card-snippet">
                  <span class="snippet-bubble">
                    {conv.lastMessage || 'Started conversation'}
                  </span>
                </div>

                <!-- Card Footer & Actions -->
                <div class="mobile-card-footer">
                  <div class="mobile-card-tags">
                    <span class="page-source-tag">{conv.currentPath || '/'}</span>
                    <span class="msg-count-badge">{conv.messageCount || 0} msgs</span>
                  </div>
                  <div class="action-buttons-group">
                    <button
                      type="button"
                      class="btn-view-chat"
                      data-conv-id={conv.id}
                      data-conv-name={nameDisplay}
                      title="View Full Chat Transcript"
                    >
                      💬 View Chat
                    </button>
                    <button
                      type="button"
                      class="btn-delete-conv"
                      data-conv-id={conv.id}
                      title="Delete Conversation"
                    >
                      🗑️
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      </>
    )}
  </div>

  <!-- Transcript Modal Drawer -->
  <div id="transcriptModal" class="transcript-modal" style="display: none;">
    <div class="modal-backdrop" id="modalBackdrop"></div>
    <div class="modal-drawer">
      <!-- Drawer Header -->
      <div class="drawer-header">
        <div class="drawer-header-left">
          <div class="drawer-avatar" id="drawerAvatar">👤</div>
          <div class="drawer-header-titles">
            <h3 id="drawerVisitorName">Visitor Chat</h3>
            <span class="drawer-conv-id" id="drawerConvId">ID: ...</span>
          </div>
        </div>
        <div class="drawer-header-actions">
          <button type="button" id="drawerCloseBtn" class="drawer-close-btn" aria-label="Close">✕</button>
        </div>
      </div>

      <!-- Drawer Body: Messages -->
      <div class="drawer-body" id="drawerMessagesContainer">
        <div class="loading-state" id="drawerLoading">
          <div class="spinner"></div>
          <span>Loading chat transcript...</span>
        </div>
        <div id="drawerMessagesList" class="drawer-messages-list"></div>
      </div>

      <!-- Drawer Footer -->
      <div class="drawer-footer">
        <span class="drawer-footer-text">JobNed AI Live Interaction Record</span>
        <button type="button" id="drawerCloseBtnBottom" class="btn-secondary">Close</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .bot-admin-container {
    width: 100%;
    max-width: 100%;
    box-sizing: border-box;
  }

  /* Header & Badges */
  .badge-tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    background: rgba(124, 58, 237, 0.12);
    color: var(--color-primary, #A78BFA);
    border-radius: 9999px;
    margin-bottom: 0.5rem;
    border: 1px solid rgba(124, 58, 237, 0.25);
  }

  .stats-counter-pill {
    padding: 0.5rem 1rem;
    background: var(--color-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 9999px;
    font-size: 0.875rem;
    color: var(--color-text-muted, #94A3B8);
    white-space: nowrap;
    align-self: flex-start;
  }
  .stats-counter-pill strong {
    color: var(--color-primary, #A78BFA);
  }

  /* Metrics Grid */
  .bot-metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    width: 100%;
  }

  .metric-card {
    background: var(--color-surface, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    padding: 1.15rem 1rem;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    transition: transform 0.2s ease, border-color 0.2s ease;
    min-width: 0;
  }
  .metric-card:hover {
    transform: translateY(-2px);
    border-color: rgba(124, 58, 237, 0.35);
  }

  .metric-icon {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
  }
  .metric-purple { background: rgba(124, 58, 237, 0.15); border: 1px solid rgba(124, 58, 237, 0.3); }
  .metric-green { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); }
  .metric-gray { background: rgba(148, 163, 184, 0.15); border: 1px solid rgba(148, 163, 184, 0.3); }
  .metric-blue { background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); }

  .metric-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .metric-label {
    font-size: 0.78rem;
    color: var(--color-text-muted, #94A3B8);
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .metric-value {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--color-text-main, #F8FAFC);
    line-height: 1.2;
  }

  /* Controls Bar */
  .controls-bar-container {
    display: flex;
    gap: 1rem;
    align-items: center;
    width: 100%;
  }
  .search-input-wrapper {
    position: relative;
    flex: 1;
    min-width: 200px;
  }
  .search-icon {
    position: absolute;
    left: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.95rem;
    opacity: 0.6;
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.75rem 1rem 0.75rem 2.75rem;
    border-radius: 8px;
    background: var(--color-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    color: var(--color-text-main, #F8FAFC);
    font-size: 0.9rem;
    box-sizing: border-box;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--color-primary, #7C3AED);
    box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.2);
  }

  .filter-group {
    flex-shrink: 0;
  }
  .filter-select {
    padding: 0.75rem 1rem;
    border-radius: 8px;
    background: var(--color-surface, rgba(255, 255, 255, 0.04));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.1));
    color: var(--color-text-main, #F8FAFC);
    font-size: 0.875rem;
    cursor: pointer;
  }

  /* ==========================================================================
     1. DESKTOP/TABLET TABLE VIEW (≥ 768px)
     ========================================================================== */
  .bot-table-view {
    display: block;
    width: 100%;
  }

  .table-card {
    background: var(--color-surface, rgba(255, 255, 255, 0.02));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    overflow: hidden;
    width: 100%;
  }

  .table-responsive {
    width: 100% !important;
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch;
  }

  .data-table {
    width: 100%;
    min-width: 820px;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.9rem;
  }
  .data-table th {
    padding: 0.875rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted, #94A3B8);
    background: rgba(255, 255, 255, 0.02);
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    white-space: nowrap;
  }
  .data-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border, rgba(255, 255, 255, 0.05));
    vertical-align: middle;
  }
  .data-table tr:last-child td {
    border-bottom: none;
  }
  .data-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.03);
  }

  /* Visitor Cell */
  .visitor-cell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 170px;
    white-space: nowrap;
  }
  .visitor-avatar {
    width: 36px;
    height: 36px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.9rem;
    flex-shrink: 0;
  }
  .avatar-named {
    background: linear-gradient(135deg, #8B5CF6, #6D28D9);
    color: #FFF;
  }
  .avatar-anon {
    background: rgba(148, 163, 184, 0.18);
    color: #94A3B8;
  }

  .visitor-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .visitor-name-title {
    font-weight: 600;
    color: var(--color-text-main, #F8FAFC);
    white-space: nowrap;
  }
  .visitor-id-sub {
    font-size: 0.73rem;
    color: var(--color-text-muted, #94A3B8);
    font-family: monospace;
    white-space: nowrap;
  }

  /* Status Badges */
  .status-badge {
    display: inline-block;
    padding: 0.25rem 0.55rem;
    border-radius: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge-named {
    background: rgba(16, 185, 129, 0.15);
    color: #10B981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }
  .badge-anon {
    background: rgba(148, 163, 184, 0.12);
    color: #94A3B8;
    border: 1px solid rgba(148, 163, 184, 0.25);
  }

  /* Message Snippet */
  .msg-snippet-cell {
    max-width: 280px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: var(--color-text-muted, #94A3B8);
    font-size: 0.85rem;
  }

  /* Page Source Tag */
  .page-source-tag {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 4px;
    font-family: monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted, #94A3B8);
    white-space: nowrap;
  }

  /* Message Count Badge */
  .msg-count-badge {
    display: inline-block;
    padding: 0.25rem 0.6rem;
    background: rgba(124, 58, 237, 0.12);
    color: var(--color-primary, #A78BFA);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .date-cell {
    font-size: 0.82rem;
    color: var(--color-text-muted, #94A3B8);
    white-space: nowrap;
  }

  /* Action Buttons */
  .action-buttons-group {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    white-space: nowrap;
  }

  .btn-view-chat {
    padding: 0.4rem 0.75rem;
    background: rgba(124, 58, 237, 0.15);
    border: 1px solid rgba(124, 58, 237, 0.35);
    color: var(--color-primary, #A78BFA);
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .btn-view-chat:hover {
    background: var(--color-primary, #7C3AED);
    color: #FFF;
  }

  .btn-delete-conv {
    background: transparent;
    border: 1px solid transparent;
    padding: 0.4rem;
    border-radius: 6px;
    cursor: pointer;
    opacity: 0.6;
    transition: opacity 0.2s, background-color 0.2s;
  }
  .btn-delete-conv:hover {
    opacity: 1;
    background: rgba(244, 63, 94, 0.15);
    border-color: rgba(244, 63, 94, 0.3);
  }

  /* ==========================================================================
     2. MOBILE CARDS VIEW (< 768px)
     ========================================================================== */
  .bot-mobile-cards-view {
    display: none; /* hidden by default on desktop */
  }

  .bot-mobile-card {
    background: var(--color-surface, rgba(255, 255, 255, 0.03));
    border: 1px solid var(--color-border, rgba(255, 255, 255, 0.08));
    border-radius: 12px;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: border-color 0.2s ease;
  }
  .bot-mobile-card:hover {
    border-color: rgba(124, 58, 237, 0.3);
  }

  .mobile-card-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .mobile-card-user {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    flex: 1;
  }
  .mobile-user-details {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .mobile-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .mobile-date {
    font-size: 0.72rem;
    color: var(--color-text-muted, #94A3B8);
    flex-shrink: 0;
  }

  .mobile-card-snippet {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    padding: 0.65rem 0.85rem;
  }

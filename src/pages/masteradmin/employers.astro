---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { users, jobPostings, plans } from '../../db/schema';
import { eq, desc, count } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || (payload.userType !== 'masteradmin' && payload.userType !== 'superadmin')) {
  return Astro.redirect('/login');
}

const db = getDb();

// Fetch ONLY employers
const employers = await db.select().from(users).where(
  eq(users.userType, 'employer')
).orderBy(desc(users.createdAt)).all();

// Map plans for names
const allPlans = await db.select().from(plans).all();
const planMap = new Map(allPlans.map(p => [p.planId, p.planName]));

// Fetch job counts per employer
const jobCounts = await db.select({
  employerId: jobPostings.employerId,
  jobCount: count()
}).from(jobPostings).groupBy(jobPostings.employerId).all();

const jobCountMap = new Map(jobCounts.map(j => [j.employerId, j.jobCount]));
---

<DashboardLayout title="Employer Directory - MasterAdmin" userType="masteradmin" activePath="/masteradmin/employers">
  <div class="dashboard-header mb-4">
    <div class="header-titles">
      <span class="badge-tag">MasterAdmin Management</span>
      <h1>Employer Directory & Accounts</h1>
      <p class="subtitle">Review company profiles, manage verification status, edit details, or suspend recruiter accounts.</p>
    </div>
    <div class="stats-counter-pill">
      <strong>{employers.length}</strong> Registered Employers
    </div>
  </div>

  <!-- Search Section -->
  <div class="search-bar-container mb-4">
    <div class="search-input-wrapper">
      <span class="search-icon">🔍</span>
      <input type="text" id="employerSearchInput" class="search-input" placeholder="Search employers by company, name, or email..." />
    </div>
  </div>

  <!-- Bulk Actions Toolbar (Hidden until items selected) -->
  <div id="bulkActionsToolbar" class="bulk-actions-toolbar mb-4" style="display: none;">
    <div class="bulk-actions-info">
      <span class="bulk-count-badge"><span id="selectedEmployersCount">0</span> Selected</span>
      <span class="bulk-info-text">Choose an action to apply to selected employer accounts</span>
    </div>
    <div class="bulk-actions-buttons">
      <button type="button" class="btn-bulk-deselect" id="btnDeselectAllEmployers">
        ✕ Clear Selection
      </button>
      <button type="button" id="btnDeleteSelectedEmployers" class="btn-bulk-delete">
        🗑️ Delete Selected (<span id="deleteSelectedBtnCount">0</span>)
      </button>
    </div>
  </div>

  <div class="table-card">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 44px; text-align: center;">
              <input type="checkbox" id="selectAllCheckbox" class="row-checkbox-input" title="Select All Employers" />
            </th>
            <th>Company & Recruiter</th>
            <th>Contact Email</th>
            <th>Tier / Plan</th>
            <th>Jobs Posted</th>
            <th>Verification</th>
            <th>Account Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {employers.length === 0 ? (
            <tr>
              <td colspan="8" class="empty-cell">
                <div class="empty-state">
                  <div class="empty-icon">🏢</div>
                  <h3>No Employers Found</h3>
                  <p>No registered employer accounts exist in the database.</p>
                </div>
              </td>
            </tr>
          ) : (
            employers.map((emp) => {
              const planName = planMap.get(emp.planId || 'P001') || emp.planId || 'Starter Free';
              const jobsCount = jobCountMap.get(emp.id) || 0;
              const isBlocked = emp.isActive === false;
              const searchText = `${emp.companyName || ''} ${emp.firstName || ''} ${emp.lastName || ''} ${emp.email || ''}`.toLowerCase();

              return (
                <tr class={`employer-row ${isBlocked ? 'blocked-row' : ''}`} data-emp-id={emp.id} data-search-text={searchText}>
                  <td style="text-align: center;">
                    <input type="checkbox" class="employer-row-checkbox row-checkbox-input" value={emp.id} title={`Select ${emp.companyName || emp.firstName}`} />
                  </td>
                  <td>
                    <div class="company-meta-cell">
                      <div class="company-logo-avatar">
                        {emp.companyName ? emp.companyName.charAt(0).toUpperCase() : emp.firstName.charAt(0).toUpperCase()}
                      </div>
                      <div>
                        <strong class="company-name-txt">{emp.companyName || `${emp.firstName} ${emp.lastName}`}</strong>
                        <div class="recruiter-sub">👤 {emp.firstName} {emp.lastName}</div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="email-txt">{emp.email}</span>
                  </td>
                  <td>
                    <span class="plan-pill">{planName}</span>
                  </td>
                  <td>
                    <span class="jobs-badge">
                      <strong>{jobsCount}</strong> Jobs
                    </span>
                  </td>
                  <td>
                    <span class={`status-pill status-${emp.verifiedStatus}`}>
                      {emp.verifiedStatus === 'verified' ? '✓ Verified' : emp.verifiedStatus === 'rejected' ? '✕ Rejected' : '⏳ Pending'}
                    </span>
                  </td>
                  <td>
                    <span class={`account-pill ${isBlocked ? 'pill-blocked' : 'pill-active'}`}>
                      {isBlocked ? '🔴 Suspended' : '🟢 Active'}
                    </span>
                  </td>
                  <td>
                    <div class="actions-group">
                      <!-- View Employer Dashboard (Impersonate) -->
                      <button 
                        type="button" 
                        class="btn-action-icon impersonate-action" 
                        title="View Employer Dashboard (Impersonate)"
                        onclick={`impersonateUser('${emp.id}')`}
                      >
                        🚀
                      </button>

                      <!-- Quick View Modal Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon view-emp-btn" 
                        title="View Employer Details"
                        data-id={emp.id}
                        data-company={emp.companyName || `${emp.firstName} ${emp.lastName}`}
                        data-recruiter={`${emp.firstName} ${emp.lastName}`}
                        data-email={emp.email}
                        data-phone={emp.phone || 'N/A'}
                        data-website={emp.companyWebsite || 'N/A'}
                        data-industry={emp.companyIndustry || 'N/A'}
                        data-size={emp.companySize || 'N/A'}
                        data-bio={emp.companyBio || 'No biography available.'}
                        data-plan={planName}
                        data-verified={emp.verifiedStatus}
                        data-active={emp.isActive !== false ? 'Active' : 'Suspended'}
                      >
                        👁️
                      </button>

                      <!-- Edit Button -->
                      <a href={`/masteradmin/employers/${emp.id}/edit`} class="btn-action-icon edit-action" title="Edit Employer Profile & Plan">
                        ✏️
                      </a>

                      <!-- Change Password Quick Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon change-pwd-btn" 
                        title="Change Employer Password"
                        data-id={emp.id}
                        data-name={emp.companyName || `${emp.firstName} ${emp.lastName}`}
                      >
                        🔑
                      </button>

                      <!-- Block / Unblock Button -->
                      <button 
                        type="button" 
                        class={`btn-action-icon block-btn ${isBlocked ? 'unblock-action' : 'block-action'}`} 
                        title={isBlocked ? 'Reactivate Employer Account' : 'Block / Suspend Employer'}
                        data-id={emp.id}
                        data-action={isBlocked ? 'unblock' : 'block'}
                      >
                        {isBlocked ? '🟢' : '🚫'}
                      </button>

                      <!-- Delete Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon delete-action delete-emp-btn" 
                        title="Delete Employer Account"
                        data-id={emp.id}
                        data-name={emp.companyName || `${emp.firstName} ${emp.lastName}`}
                      >
                        🗑️
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Employer View Modal -->
  <div id="empModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-logo" id="mLogo">🏢</div>
          <div>
            <h2 id="mCompany">Company Name</h2>
            <p id="mRecruiter">Recruiter Name</p>
          </div>
        </div>
        <button type="button" class="modal-close" id="closeModal">✕</button>
      </div>

      <div class="modal-body">
        <div class="modal-info-grid">
          <div class="info-item">
            <span class="lbl">Email</span>
            <span class="val" id="mEmail">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Phone</span>
            <span class="val" id="mPhone">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Website</span>
            <span class="val" id="mWebsite">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Industry</span>
            <span class="val" id="mIndustry">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Company Size</span>
            <span class="val" id="mSize">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Subscription Plan</span>
            <span class="val highlight" id="mPlan">—</span>
          </div>
        </div>

        <div class="modal-section-title">Company Biography</div>
        <p class="bio-text" id="mBio">Biography details...</p>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="closeModalBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- Change Password Modal -->
  <div id="pwdModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card modal-card-sm">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-logo">🔑</div>
          <div>
            <h2>Change Employer Password</h2>
            <p id="pwdTargetUser">Target Account</p>
          </div>
        </div>
        <button type="button" class="modal-close" id="closePwdModal">✕</button>
      </div>

      <form id="quick-pwd-form">
        <input type="hidden" id="pwdUserId" value="" />
        <div class="modal-body">
          <div class="form-group">
            <label for="quickNewPassword">New Password <span class="req">*</span></label>
            <input type="password" id="quickNewPassword" required minlength="6" placeholder="Enter at least 6 characters..." />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" id="closePwdModalBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="savePwdBtn">Save New Password</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  // --- MULTI-SELECT & BULK ACTIONS LOGIC ---
  const searchInput = document.getElementById('employerSearchInput') as HTMLInputElement | null;
  const selectAllCheckbox = document.getElementById('selectAllCheckbox') as HTMLInputElement | null;
  const bulkToolbar = document.getElementById('bulkActionsToolbar');
  const selectedCountEl = document.getElementById('selectedEmployersCount');
  const deleteBtnCountEl = document.getElementById('deleteSelectedBtnCount');
  const btnDeselectAll = document.getElementById('btnDeselectAllEmployers');
  const btnDeleteSelected = document.getElementById('btnDeleteSelectedEmployers') as HTMLButtonElement | null;

  function getVisibleCheckboxes() {
    const visibleRows = Array.from(document.querySelectorAll('.employer-row')).filter(r => (r as HTMLElement).style.display !== 'none');
    return visibleRows.map(r => r.querySelector('.employer-row-checkbox') as HTMLInputElement).filter(Boolean);
  }

  function updateSelectionUI() {
    const visibleCheckboxes = getVisibleCheckboxes();
    const checkedBoxes = Array.from(document.querySelectorAll('.employer-row-checkbox:checked')) as HTMLInputElement[];
    const count = checkedBoxes.length;

    if (selectedCountEl) selectedCountEl.textContent = String(count);
    if (deleteBtnCountEl) deleteBtnCountEl.textContent = String(count);

    if (bulkToolbar) {
      bulkToolbar.style.display = count > 0 ? 'flex' : 'none';
    }

    if (selectAllCheckbox) {
      if (visibleCheckboxes.length > 0 && visibleCheckboxes.every(cb => cb.checked)) {
        selectAllCheckbox.checked = true;
        selectAllCheckbox.indeterminate = false;
      } else if (count > 0) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = true;
      } else {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      }
    }

    document.querySelectorAll('.employer-row').forEach(row => {
      const cb = row.querySelector('.employer-row-checkbox') as HTMLInputElement | null;
      if (cb && cb.checked) {
        row.classList.add('selected-row');
      } else {
        row.classList.remove('selected-row');
      }
    });
  }

  selectAllCheckbox?.addEventListener('change', (e) => {
    const isChecked = (e.target as HTMLInputElement).checked;
    getVisibleCheckboxes().forEach(cb => {
      cb.checked = isChecked;
    });
    updateSelectionUI();
  });

  document.querySelector('.data-table')?.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.classList.contains('employer-row-checkbox')) {
      updateSelectionUI();
    }
  });

  btnDeselectAll?.addEventListener('click', () => {
    document.querySelectorAll('.employer-row-checkbox').forEach(cb => (cb as HTMLInputElement).checked = false);
    if (selectAllCheckbox) {
      selectAllCheckbox.checked = false;
      selectAllCheckbox.indeterminate = false;
    }
    updateSelectionUI();
  });

  // Search Filter Update
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase().trim();
      const rows = document.querySelectorAll('.employer-row');
      rows.forEach(row => {
        const textContent = (row as HTMLElement).getAttribute('data-search-text') || row.textContent?.toLowerCase() || '';
        if (!term || textContent.includes(term)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
      updateSelectionUI();
    });
  }

  // Bulk Delete Action
  btnDeleteSelected?.addEventListener('click', async () => {
    const checkedBoxes = Array.from(document.querySelectorAll('.employer-row-checkbox:checked')) as HTMLInputElement[];
    if (checkedBoxes.length === 0) return;

    const selectedIds = checkedBoxes.map(cb => cb.value);
    const count = selectedIds.length;

    const confirmMsg = count === 1
      ? `Are you sure you want to PERMANENTLY DELETE 1 selected employer account?\n\nAll associated job postings and applications will be deleted.`
      : `Are you sure you want to PERMANENTLY DELETE all ${count} selected employer accounts?\n\nAll associated job postings and applications for these companies will be permanently deleted.`;

    if (!confirm(confirmMsg)) return;

    const btn = document.getElementById('btnDeleteSelectedEmployers') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = `Deleting ${count} employers...`;
    }

    try {
      const res = await fetch('/api/admin/employers/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ userIds: selectedIds })
      });

      const data = await res.json();

      if (res.ok && data.success) {
        selectedIds.forEach(id => {
          const row = document.querySelector(`.employer-row[data-emp-id="${id}"]`);
          if (row) {
            (row as HTMLElement).style.transition = 'all 0.3s ease';
            (row as HTMLElement).style.opacity = '0';
            (row as HTMLElement).style.transform = 'translateX(20px)';
            setTimeout(() => row.remove(), 300);
          }
        });

        setTimeout(() => {
          updateSelectionUI();
          const remaining = document.querySelectorAll('.employer-row:not([style*="display: none"])').length;
          const countPill = document.querySelector('.stats-counter-pill strong');
          if (countPill) countPill.textContent = String(remaining);

          if (remaining === 0) {
            const tbody = document.querySelector('.data-table tbody');
            if (tbody) {
              tbody.innerHTML = `
                <tr>
                  <td colspan="8" class="empty-cell">
                    <div class="empty-state">
                      <div class="empty-icon">🏢</div>
                      <h3>No Employers Found</h3>
                      <p>No registered employer accounts exist in the database.</p>
                    </div>
                  </td>
                </tr>
              `;
            }
          }
        }, 350);

        // @ts-ignore
        if (window.showToast) window.showToast(`${count} employer account(s) deleted successfully!`);
      } else {
        // @ts-ignore
        if (window.showToast) window.showToast(data.error || 'Failed to delete employers', 'error');
      }
    } catch (err) {
      // @ts-ignore
      if (window.showToast) window.showToast('An error occurred during bulk deletion.', 'error');
    } finally {
      if (btnDeleteSelected) {
        btnDeleteSelected.disabled = false;
        btnDeleteSelected.innerHTML = `🗑️ Delete Selected (<span id="deleteSelectedBtnCount">0</span>)`;
      }
    }
  });

  // Single Delete Employer Logic
  document.querySelectorAll('.delete-emp-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const userId = b.dataset.id;
      const name = b.dataset.name;
      if (!userId) return;

      if (!confirm(`Are you sure you want to PERMANENTLY DELETE employer "${name}"? All associated job postings and applications will be deleted.`)) {
        return;
      }

      try {
        const res = await fetch('/api/admin/employers/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Employer deleted successfully.');
          const row = document.querySelector(`.employer-row[data-emp-id="${userId}"]`);
          if (row) {
            (row as HTMLElement).style.transition = 'all 0.3s ease';
            (row as HTMLElement).style.opacity = '0';
            (row as HTMLElement).style.transform = 'translateX(20px)';
            setTimeout(() => {
              row.remove();
              updateSelectionUI();
              const remaining = document.querySelectorAll('.employer-row:not([style*="display: none"])').length;
              const countPill = document.querySelector('.stats-counter-pill strong');
              if (countPill) countPill.textContent = String(remaining);
            }, 300);
          } else {
            window.location.reload();
          }
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to delete employer', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred during deletion.', 'error');
      }
    });
  });
</script>

<style>
  .mb-4 { margin-bottom: 1.75rem; }

  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .badge-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(168, 85, 247, 0.15);
    color: #a855f7;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .header-titles h1 {
    margin: 0 0 0.3rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .stats-counter-pill {
    padding: 0.5rem 1rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
  .stats-counter-pill strong {
    color: #a855f7;
    font-size: 1.1rem;
  }

  .search-bar-container {
    width: 100%;
  }

  /* Bulk Actions Toolbar */
  .bulk-actions-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    background: linear-gradient(135deg, rgba(168, 85, 247, 0.12), rgba(147, 51, 234, 0.06));
    border: 1px solid rgba(168, 85, 247, 0.3);
    border-radius: 14px;
    padding: 0.85rem 1.25rem;
    box-shadow: 0 4px 15px rgba(168, 85, 247, 0.1);
    animation: fadeInSlide 0.2s ease-out;
  }
  @keyframes fadeInSlide {
    from { opacity: 0; transform: translateY(-6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .bulk-actions-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    flex: 1 1 auto;
    min-width: 0;
  }

  .bulk-count-badge {
    background: #a855f7;
    color: #ffffff;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 9999px;
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-block;
  }

  .bulk-info-text {
    font-size: 0.88rem;
    color: var(--color-text-main, #1E293B);
    font-weight: 600;
  }

  .bulk-actions-buttons {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .btn-bulk-deselect {
    background: transparent;
    border: 1px solid var(--color-border, #CBD5E1);
    color: var(--color-text-muted, #64748B);
    padding: 0.45rem 0.85rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .btn-bulk-deselect:hover {
    background: var(--color-bg, #F1F5F9);
    color: var(--color-text-main, #0F172A);
  }

  .btn-bulk-delete {
    background: #EF4444;
    color: #ffffff;
    border: none;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(239, 68, 68, 0.3);
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .btn-bulk-delete:hover {
    background: #DC2626;
    box-shadow: 0 6px 16px rgba(239, 68, 68, 0.4);
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .bulk-actions-toolbar {
      flex-direction: column;
      align-items: stretch;
      padding: 0.75rem 1rem;
      gap: 0.65rem;
    }
    .bulk-actions-info {
      width: 100%;
      justify-content: flex-start;
      gap: 0.5rem;
    }
    .bulk-info-text {
      font-size: 0.8rem;
      flex: 1 1 auto;
    }
    .bulk-actions-buttons {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .btn-bulk-deselect, .btn-bulk-delete {
      width: 100%;
      text-align: center;
      justify-content: center;
      padding: 0.5rem 0.4rem;
      font-size: 0.78rem;
    }
  }

  /* Custom Checkbox Styling */
  .row-checkbox-input {
    width: 18px;
    height: 18px;
    accent-color: #a855f7;
    cursor: pointer;
    vertical-align: middle;
    border-radius: 4px;
  }

  .selected-row {
    background-color: rgba(168, 85, 247, 0.08) !important;
  }
  
  .search-input-wrapper {
    display: flex;
    align-items: center;

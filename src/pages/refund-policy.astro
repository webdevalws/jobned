---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "September 18, 2026";
---

<Layout
  title="Cancellation and Refund Policy - JobNed"
  description="Read the official Cancellation and Refund Policy for JobNed SaaS subscriptions, employer credits, and Razorpay transactions. Strict No Refund Policy."
  keywords="cancellation policy, refund policy, no refund policy, JobNed payments, razorpay refund policy, employer subscription billing"
  schemaType="Organization"
>
  <!-- Landing Navigation -->
  <header class="landing-nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="logo-icon">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span class="logo-text">Job<span class="highlight">Ned</span></span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/jobs">Find Jobs</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/contact">Contact</a>
      </nav>
      <div class="nav-actions">
        <button type="button" class="theme-toggle-btn" aria-label="Toggle Light/Dark Theme" title="Toggle Light/Dark Theme">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href="/login" class="btn btn-outline">Sign In</a>
      </div>
    </div>
  </header>

  <main class="refund-page-wrapper">
    <div class="refund-container">
      
      <!-- Hero Banner -->
      <section class="refund-hero">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"></path>
            <path d="M12 18V6"></path>
          </svg>
          Billing &amp; Merchant Compliance
        </div>
        <h1 class="refund-title">Cancellation &amp; Refund Policy</h1>
        <p class="refund-subtitle">
          Official cancellation terms and refund policy for <strong>JobNed</strong> subscriptions, employer credit packs, and digital recruitment software services processed via <strong>Razorpay</strong>.
        </p>
        <div class="last-updated">
          <span>Effective Date: <strong>{lastUpdated}</strong></span>
        </div>
      </section>

      <!-- Prominent Strict No Refund Notice -->
      <div class="strict-no-refund-banner">
        <div class="banner-icon">🚫</div>
        <div class="banner-text">
          <h3>Strict No-Refund Policy on All Digital Subscriptions</h3>
          <p>
            Please note that <strong>all purchases, subscription plan activations, employer credit packs, and job posting fees on JobNed are strictly non-refundable</strong> once processed. Because our digital recruitment tools, AI resume evaluations, and candidate access are delivered immediately upon payment, no partial or full refunds can be issued under standard circumstances.
          </p>
        </div>
      </div>

      <!-- Content Grid -->
      <div class="refund-grid">
        
        <!-- Table of Contents Sidebar -->
        <aside class="refund-toc">
          <h3>Table of Contents</h3>
          <ul>
            <li><a href="#digital-nature">1. Nature of Digital SaaS Services</a></li>
            <li><a href="#no-refunds">2. Strict Non-Refundable Terms</a></li>
            <li><a href="#cancellation">3. Subscription Cancellation Procedure</a></li>
            <li><a href="#free-tiers">4. Free Tiers &amp; Plan Previews</a></li>
            <li><a href="#duplicate-payments">5. Duplicate &amp; Failed Transactions</a></li>
            <li><a href="#chargebacks">6. Chargebacks &amp; Dispute Policy</a></li>
            <li><a href="#contact-billing">7. Merchant Support &amp; Billing Inquiries</a></li>
          </ul>
        </aside>

        <!-- Main Document Body -->
        <article class="refund-content">
          
          <section id="digital-nature" class="policy-section">
            <h2>1. Nature of Digital SaaS Services</h2>
            <p>
              JobNed (operated by <strong>RecruitNest Technologies Private Limited</strong>) delivers cloud-based recruitment and candidate matching software. Our services include:
            </p>
            <ul>
              <li>Instant activation of employer dashboard privileges and job posting slots.</li>
              <li>Immediate real-time execution of AI vector embeddings and candidate matching algorithms.</li>
              <li>Consumable candidate resume unlocks and direct applicant contact details.</li>
              <li>Automated interview scheduling and video screening infrastructure.</li>
            </ul>
            <p>
              Due to the instantaneous fulfillment and consumable nature of these digital assets, value is transferred immediately upon payment confirmation.
            </p>
          </section>

          <section id="no-refunds" class="policy-section">
            <h2>2. Strict Non-Refundable Terms</h2>
            <p>
              In accordance with international digital goods standards and Indian Consumer Protection (E-Commerce) Rules for SaaS products:
            </p>
            <div class="policy-highlight-card">
              <ul>
                <li><strong>No Pro-Rata Refunds:</strong> No pro-rated or partial refunds are provided for unused portions of an active monthly or annual billing cycle.</li>
                <li><strong>No Credit Restitutions:</strong> Unused employer posting credits or candidate resume views cannot be converted back to cash or refunded upon plan expiration.</li>
                <li><strong>Hiring Outcomes:</strong> While JobNed provides powerful AI matching and distribution technology, we do not guarantee specific candidate response rates or finalized hiring placements. Payments are made for software access and tools, not guaranteed candidate employment.</li>
                <li><strong>All Sales Are Final:</strong> Once a payment transaction is successfully authorized through our Razorpay checkout gateway, the transaction is definitive and non-refundable.</li>
              </ul>
            </div>
          </section>

          <section id="cancellation" class="policy-section">
            <h2>3. Subscription Cancellation Procedure</h2>
            <p>
              You maintain full control over your recurring subscription at all times. You can cancel your subscription renewal without penalties by following these steps:
            </p>
            <ol class="step-list">
              <li>Log in to your <strong>JobNed Employer Account</strong>.</li>
              <li>Navigate to <strong>Settings</strong> &gt; <strong>Billing &amp; Subscription</strong>.</li>
              <li>Click on <strong>Cancel Renewal</strong> or manage subscription settings.</li>
              <li>Confirm cancellation before the next scheduled billing date.</li>
            </ol>
            <p>
              <strong>Effect of Cancellation:</strong> When you cancel your subscription, auto-debit will be immediately discontinued. You will retain full access to all paid features and credits until the end of your current paid billing period. No further charges will occur thereafter.
            </p>
          </section>

          <section id="free-tiers" class="policy-section">
            <h2>4. Free Tiers &amp; Plan Previews</h2>
            <p>
              To ensure full transparency before making any purchase, JobNed provides:
            </p>
            <ul>
              <li>Free candidate accounts to browse and apply for jobs at zero cost.</li>
              <li>Free employer onboarding and job creation previews so organizations can evaluate our interface prior to subscribing to paid plans.</li>
              <li>Comprehensive feature tables on our <a href="/pricing">Pricing Page</a> detailing exact plan limits, candidate views, and AI screening capabilities.</li>
            </ul>
          </section>

          <section id="duplicate-payments" class="policy-section">
            <h2>5. Duplicate &amp; Failed Technical Transactions</h2>
            <p>
              In rare events involving payment gateway timeouts, network interruptions, or bank technical errors:
            </p>
            <div class="info-card">
              <h4>A. Charged but Order Failed / Gateway Error:</h4>
              <p>
                If your card or bank account was debited but your JobNed account was not upgraded due to a network interruption, Razorpay's automated reconciliation systems will automatically initiate a refund back to your original payment source within <strong>5 to 7 business days</strong>.
              </p>
              <h4 style="margin-top: 1rem;">B. Accidental Duplicate Debits:</h4>
              <p>
                If you were inadvertently charged twice for the same billing invoice due to a multiple-click glitch or banking error, please email our billing team at <a href="mailto:billing@jobned.com">billing@jobned.com</a> within <strong>7 days</strong> with:
              </p>
              <ul>
                <li>Your registered account email address.</li>
                <li>Both Razorpay Payment IDs (e.g., <code>pay_xxxxxx</code>).</li>
                <li>Screenshot or proof of duplicate debit from your bank statement.</li>
              </ul>
              <p>
                Upon verification of genuine duplicate capture for a single order, the duplicate amount will be reversed to the original payment source within 5–7 banking days.
              </p>
            </div>
          </section>

          <section id="chargebacks" class="policy-section">
            <h2>6. Chargebacks &amp; Dispute Policy</h2>
            <p>
              We encourage users to reach out directly to our billing support desk (<a href="mailto:billing@jobned.com">billing@jobned.com</a>) before initiating a chargeback or payment dispute with your credit card provider or bank. Unwarranted chargebacks filed for validly delivered digital services will result in immediate suspension of the associated employer account and cancellation of published job postings.
            </p>
          </section>

          <section id="contact-billing" class="policy-section">
            <h2>7. Merchant Support &amp; Billing Inquiries</h2>
            <p>
              If you have any questions or require clarification regarding our Cancellation and Refund Policy, please contact our merchant billing team:
            </p>
            <div class="contact-card">
              <div class="contact-header">
                <h4>JobNed Merchant Support Desk</h4>
                <p class="entity-sub">RecruitNest Technologies Private Limited</p>
              </div>
              <div class="contact-links">
                <div class="contact-item">
                  <span>Billing &amp; Payment Support:</span>
                  <a href="mailto:billing@jobned.com">billing@jobned.com</a>
                </div>
                <div class="contact-item">
                  <span>General Inquiries:</span>
                  <a href="mailto:support@jobned.com">support@jobned.com</a>
                </div>
                <div class="contact-item">
                  <span>Support Helpline:</span>
                  <span>+91 80 4965 2300 (Mon–Fri, 9:00 AM – 6:00 PM IST)</span>
                </div>
                <div class="contact-item">
                  <span>Office Address:</span>
                  <span>#402, 4th Floor, Tech Hub Tower, Outer Ring Road, Bengaluru, Karnataka 560103, India</span>
                </div>
              </div>
            </div>
          </section>

        </article>
      </div>
    </div>
  </main>
</Layout>

<style>
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }
  :global([data-theme="light"]) .landing-nav {
    background: rgba(255, 255, 255, 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
  }
  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: var(--color-primary);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .refund-page-wrapper {
    min-height: 80vh;
    padding: 3.5rem 1.5rem 5rem 1.5rem;
  }
  .refund-container {
    max-width: 1160px;
    margin: 0 auto;
  }

  .refund-hero {
    text-align: center;
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(239, 68, 68, 0.12);
    color: var(--color-danger);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .refund-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .refund-subtitle {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 720px;
    margin: 0 auto 1.5rem auto;
    line-height: 1.65;
  }
  .last-updated {
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }

  /* Strict No-Refund Notice Banner */
  .strict-no-refund-banner {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    background: rgba(239, 68, 68, 0.08);
    border: 1.5px solid rgba(239, 68, 68, 0.35);
    border-radius: var(--border-radius-lg);
    padding: 1.75rem 2rem;
    margin-bottom: 3.5rem;
  }
  .banner-icon {
    font-size: 2.5rem;
    line-height: 1;
  }
  .banner-text h3 {
    color: var(--color-danger);
    font-size: 1.35rem;
    font-weight: 800;
    margin: 0 0 0.5rem 0;
  }
  .banner-text p {
    color: var(--color-text-main);
    font-size: 0.98rem;
    line-height: 1.65;
    margin: 0;
  }

  .refund-grid {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 3.5rem;
  }

  .refund-toc {
    position: sticky;
    top: 5rem;
    height: fit-content;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.5rem;
  }
  .refund-toc h3 {
    font-size: 0.95rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .refund-toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .refund-toc a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    line-height: 1.4;
    transition: color 0.2s;
  }
  .refund-toc a:hover {
    color: var(--color-primary);
  }

  .refund-content {
    display: flex;
    flex-direction: column;
    gap: 2.75rem;
  }
  .policy-section h2 {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 2px solid rgba(239, 68, 68, 0.25);
  }
  .policy-section p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
    font-size: 0.96rem;
  }
  .policy-section ul {
    color: var(--color-text-muted);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .policy-section li strong {
    color: var(--color-text-main);
  }
  .policy-section a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .step-list {
    color: var(--color-text-muted);
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  .step-list li strong {
    color: var(--color-text-main);
  }

  .policy-highlight-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    margin: 1.25rem 0;
  }
  .policy-highlight-card ul {
    margin-bottom: 0;
  }

  .info-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.5rem;
    margin: 1rem 0;
  }
  .info-card h4 {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0 0 0.4rem 0;
  }
  .info-card p {
    margin-bottom: 0.75rem;
  }

  .contact-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    padding: 1.5rem;
    margin-top: 1rem;
  }
  .contact-header h4 {
    margin: 0 0 0.2rem 0;
    color: var(--color-text-main);
    font-size: 1.1rem;
  }
  .entity-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 1rem 0;
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.92rem;
  }
  .contact-item span:first-child {
    font-weight: 600;
    color: var(--color-text-muted);
    font-size: 0.82rem;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .refund-grid {
      grid-template-columns: 1fr;
    }
    .refund-toc {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .strict-no-refund-banner {
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem;
    }
    .refund-title {
      font-size: 2.15rem;
    }
  }
</style>

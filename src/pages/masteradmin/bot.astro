<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('botSearchInput');
    const filterSelect = document.getElementById('botFilterSelect');
    const tableRows = document.querySelectorAll('.bot-row');
    const mobileCards = document.querySelectorAll('.bot-mobile-card');

    function applyFilters() {
      const q = (searchInput ? searchInput.value : '').toLowerCase().trim();
      const filter = filterSelect ? filterSelect.value : 'all';

      // Filter table rows (desktop view)
      tableRows.forEach(row => {
        const searchBlob = row.getAttribute('data-search') || '';
        const type = row.getAttribute('data-type') || '';
        const matchesQuery = !q || searchBlob.includes(q);
        const matchesFilter = filter === 'all' || type === filter;
        row.style.display = (matchesQuery && matchesFilter) ? '' : 'none';
      });

      // Filter mobile cards (mobile view)
      mobileCards.forEach(card => {
        const searchBlob = card.getAttribute('data-search') || '';
        const type = card.getAttribute('data-type') || '';
        const matchesQuery = !q || searchBlob.includes(q);
        const matchesFilter = filter === 'all' || type === filter;
        card.style.display = (matchesQuery && matchesFilter) ? 'flex' : 'none';
      });
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (filterSelect) filterSelect.addEventListener('change', applyFilters);

    // Transcript Drawer Modal Handling
    const modal = document.getElementById('transcriptModal');
    const backdrop = document.getElementById('modalBackdrop');
    const closeBtn = document.getElementById('drawerCloseBtn');
    const closeBtnBottom = document.getElementById('drawerCloseBtnBottom');
    const visitorNameEl = document.getElementById('drawerVisitorName');
    const convIdEl = document.getElementById('drawerConvId');
    const avatarEl = document.getElementById('drawerAvatar');
    const loadingEl = document.getElementById('drawerLoading');
    const messagesListEl = document.getElementById('drawerMessagesList');
    const drawerContainer = document.getElementById('drawerMessagesContainer');

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function renderBubbleContent(content, isUser) {
      if (!content) return '';
      let safe = escapeHtml(content);

      // Markdown links: [Title](url)
      safe = safe.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(_, label, url) {
        const cleanUrl = url.trim();
        const isExternal = cleanUrl.startsWith('http://') || cleanUrl.startsWith('https://');
        return `<a href="${cleanUrl}" target="${isExternal ? '_blank' : '_self'}" rel="noopener noreferrer">${label}</a>`;
      });

      // Bold: **text** or __text__
      safe = safe.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      safe = safe.replace(/__([^_]+)__/g, '<strong>$1</strong>');

      // Italic: *text* or _text_
      safe = safe.replace(/(^|[^\w*])\*([^\s*][^*]*[^\s*]|[^\s*])\*(?=[^\w*]|$)/g, '$1<em>$2</em>');

      // Inline code: `code`
      safe = safe.replace(/`([^`]+)`/g, '<code>$1</code>');

      // Process lines for bullet lists & paragraphs
      const lines = safe.split(/\r?\n/);
      let inUl = false;
      let html = '';

      for (let i = 0; i < lines.length; i++) {
        const line = lines[i].trim();
        if (!line) {
          if (inUl) { html += '</ul>'; inUl = false; }
          continue;
        }

        const bulletMatch = line.match(/^([•\-\*])\s+(.+)$/);
        if (bulletMatch) {
          if (!inUl) { html += '<ul>'; inUl = true; }
          html += `<li>${bulletMatch[2]}</li>`;
        } else {
          if (inUl) { html += '</ul>'; inUl = false; }
          html += `<p>${line}</p>`;
        }
      }
      if (inUl) html += '</ul>';

      return html || `<p>${safe}</p>`;
    }

    function openModal(convId, convName) {
      if (!modal) return;
      modal.classList.add('active');
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';

      const displayName = convName && convName !== 'Anonymous' ? convName : 'Visitor';
      if (visitorNameEl) visitorNameEl.textContent = displayName;
      if (convIdEl) convIdEl.textContent = `Session: ${convId}`;
      if (avatarEl) avatarEl.textContent = convName && convName !== 'Anonymous' ? convName.charAt(0).toUpperCase() : '👤';

      if (loadingEl) loadingEl.style.display = 'flex';
      if (messagesListEl) messagesListEl.innerHTML = '';

      fetch(`/api/masteradmin/bot/conversations?id=${encodeURIComponent(convId)}`)
        .then(res => res.json())
        .then(data => {
          if (loadingEl) loadingEl.style.display = 'none';
          if (!data.success || !Array.isArray(data.messages) || data.messages.length === 0) {
            messagesListEl.innerHTML = `
              <div class="empty-state-card">
                <div class="empty-icon">💬</div>
                <h3>No Messages Logged</h3>
                <p>This conversation has no message records.</p>
              </div>
            `;
            return;
          }

          data.messages.forEach(msg => {
            const isUser = msg.sender === 'user';
            const item = document.createElement('div');
            item.className = `chat-msg-row ${isUser ? 'user-msg-row' : 'bot-msg-row'}`;

            let timeStr = '';
            if (msg.createdAt) {
              try {
                const d = typeof msg.createdAt === 'number' ? (msg.createdAt < 10000000000 ? new Date(msg.createdAt * 1000) : new Date(msg.createdAt)) : new Date(msg.createdAt);
                if (!isNaN(d.getTime())) {
                  timeStr = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                }
              } catch (e) {}
            }

            const senderLabel = isUser ? `👤 ${displayName}` : `🤖 JobNed AI Guide`;
            const bubbleHtml = renderBubbleContent(msg.content, isUser);

            item.innerHTML = `
              <div class="chat-msg-sender">${escapeHtml(senderLabel)}</div>
              <div class="chat-msg-bubble">${bubbleHtml}</div>
              ${timeStr ? `<div class="chat-msg-time">${escapeHtml(timeStr)}</div>` : ''}
            `;
            messagesListEl.appendChild(item);
          });

          // Smooth scroll to latest messages
          if (drawerContainer) {
            setTimeout(() => {
              drawerContainer.scrollTop = drawerContainer.scrollHeight;
            }, 60);
          }
        })
        .catch(err => {
          if (loadingEl) loadingEl.style.display = 'none';
          messagesListEl.innerHTML = `<div style="color: #F43F5E; text-align: center; padding: 2.5rem; font-weight: 500;">Failed to load transcript. Please try again.</div>`;
        });
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      modal.style.display = 'none';
      document.body.style.overflow = '';
    }

    if (backdrop) backdrop.addEventListener('click', closeModal);
    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (closeBtnBottom) closeBtnBottom.addEventListener('click', closeModal);

    // Escape key closes modal
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Bind all view chat buttons (both table and mobile cards)
    document.querySelectorAll('.btn-view-chat').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-conv-id');
        const name = btn.getAttribute('data-conv-name');
        if (id) openModal(id, name);
      });
    });

    // Bind all delete conversation buttons (both table and mobile cards)
    document.querySelectorAll('.btn-delete-conv').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-conv-id');
        if (!id) return;
        if (!confirm('Are you sure you want to delete this chat conversation log?')) return;

        try {
          const res = await fetch('/api/masteradmin/bot/conversations', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ id })
          });
          const data = await res.json();
          if (data.success) {
            document.querySelectorAll(`[data-id="${id}"]`).forEach(el => el.remove());
            if (window.showToast) window.showToast('Conversation deleted', 'success');
          } else {
            alert(data.error || 'Failed to delete');
          }
        } catch (e) {
          alert('Network error deleting conversation');
        }
      });
    });
  });
</script>

---
import { getResumeViewerUrl } from '../../lib/resume-helper';
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getDb } from "../../lib/db";
import { applications, users, jobPostings } from "../../db/schema";
import { eq, desc, asc, and, or, like, ne, notLike, count, sql } from "drizzle-orm";

Astro.response.headers.set(
  "Cache-Control",
  "no-store, no-cache, must-revalidate, max-age=0",
);

const user = Astro.locals.user;
if (!user || (user.userType !== "masteradmin" && user.userType !== "superadmin")) {
  return Astro.redirect("/login");
}

const db = getDb();

const sourceParam = Astro.url.searchParams.get("source") || "alightway";
const sortParam = Astro.url.searchParams.get("sort") || "date_desc";
const positionParam = Astro.url.searchParams.get("position") || "all";
const searchParam = (Astro.url.searchParams.get("search") || Astro.url.searchParams.get("q") || "").trim();

let orderByClause = desc(applications.appliedAt);
if (sortParam === "date_asc") {
  orderByClause = asc(applications.appliedAt);
} else if (sortParam === "status_asc") {
  orderByClause = asc(applications.status);
} else if (sortParam === "status_desc") {
  orderByClause = desc(applications.status);
} else if (sortParam === "name_asc") {
  orderByClause = asc(users.firstName);
} else if (sortParam === "name_desc") {
  orderByClause = desc(users.firstName);
} else if (sortParam === "job_asc") {
  orderByClause = asc(jobPostings.jobTitle);
} else if (sortParam === "job_desc") {
  orderByClause = desc(jobPostings.jobTitle);
}

// Build base conditions based on source selection
const sourceConditions = [];

if (sourceParam === "sanskar") {
  sourceConditions.push(or(
    like(applications.notes, "%Sanskar%"),
    like(applications.notes, "%sanskar%")
  ));
} else if (sourceParam === "alightway") {
  sourceConditions.push(and(
    or(
      eq(users.userType, "external_applicant"), 
      like(jobPostings.id, "external_%"),
      like(applications.jobPostingId, "external_%"),
      like(applications.notes, "%Alightway%"),
      like(applications.notes, "%alightway%"),
      like(applications.notes, "%External%"),
      like(applications.notes, "%external%")
    ),
    notLike(applications.notes, "%Sanskar%"),
    notLike(applications.notes, "%sanskar%")
  ));
} else if (sourceParam === "platform") {
  sourceConditions.push(and(
    or(ne(users.userType, "external_applicant"), sql`${users.userType} IS NULL`), 
    notLike(applications.jobPostingId, "external_%"),
    or(
      sql`${applications.notes} IS NULL`,
      and(
        notLike(applications.notes, "%Alightway%"),
        notLike(applications.notes, "%alightway%"),
        notLike(applications.notes, "%Sanskar%"),
        notLike(applications.notes, "%sanskar%")
      )
    )
  ));
}

const baseSourceWhere = sourceConditions.length > 0 ? and(...sourceConditions) : undefined;

// Fetch distinct positions with counts for current source scope
const availablePositions = await db
  .select({
    jobTitle: sql<string>`COALESCE(${jobPostings.jobTitle}, ${applications.jobPostingId})`,
    count: count(applications.id)
  })
  .from(applications)
  .leftJoin(users, eq(applications.applicantId, users.id))
  .leftJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
  .where(baseSourceWhere)
  .groupBy(sql`COALESCE(${jobPostings.jobTitle}, ${applications.jobPostingId})`)
  .orderBy(desc(count(applications.id)));

// Apply Position and Candidate Search Filter conditions
const finalConditions = [...sourceConditions];
if (positionParam && positionParam !== "all") {
  finalConditions.push(sql`COALESCE(${jobPostings.jobTitle}, ${applications.jobPostingId}) = ${positionParam}`);
}

if (searchParam) {
  finalConditions.push(
    or(
      like(users.firstName, `%${searchParam}%`),
      like(users.lastName, `%${searchParam}%`),
      sql`(${users.firstName} || ' ' || ${users.lastName}) LIKE ${`%${searchParam}%`}`,
      like(users.email, `%${searchParam}%`),
      like(users.phone, `%${searchParam}%`),
      like(applications.notes, `%${searchParam}%`),
      like(applications.coverLetter, `%${searchParam}%`),
      sql`COALESCE(${jobPostings.jobTitle}, ${applications.jobPostingId}) LIKE ${`%${searchParam}%`}`
    )
  );
}

const whereClause = finalConditions.length > 0 ? and(...finalConditions) : undefined;

// Fetch filtered applications
const allApplications = await db
  .select({
    id: applications.id,
    status: applications.status,
    appliedAt: applications.appliedAt,
    applicantFirstName: users.firstName,
    applicantLastName: users.lastName,
    applicantEmail: users.email,
    applicantPhone: users.phone,
    userType: users.userType,
    jobTitle: sql<string>`COALESCE(${jobPostings.jobTitle}, ${applications.jobPostingId})`,
    jobId: applications.jobPostingId,
    jobIsDeleted: jobPostings.isDeleted,
    appIsDeleted: applications.isDeleted,
    resumeUrl: applications.resumeUrl,
    coverLetter: applications.coverLetter,
    notes: applications.notes,
    customAnswers: applications.customAnswers,
  })
  .from(applications)
  .leftJoin(users, eq(applications.applicantId, users.id))
  .leftJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
  .where(whereClause)
  .orderBy(orderByClause);

// Calculate overall counts for stats pills
const alightwayCountRes = await db
  .select({ count: count() })
  .from(applications)
  .leftJoin(users, eq(applications.applicantId, users.id))
  .leftJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
  .where(and(
    or(
      eq(users.userType, "external_applicant"), 
      like(jobPostings.id, "external_%"),
      like(applications.jobPostingId, "external_%"),
      like(applications.notes, "%Alightway%"),
      like(applications.notes, "%alightway%"),
      like(applications.notes, "%External%"),
      like(applications.notes, "%external%")
    ),
    notLike(applications.notes, "%Sanskar%"),
    notLike(applications.notes, "%sanskar%")
  ));

const sanskarCountRes = await db
  .select({ count: count() })
  .from(applications)
  .leftJoin(users, eq(applications.applicantId, users.id))
  .leftJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
  .where(or(
    like(applications.notes, "%Sanskar%"),
    like(applications.notes, "%sanskar%")
  ));

const platformCountRes = await db
  .select({ count: count() })
  .from(applications)
  .leftJoin(users, eq(applications.applicantId, users.id))
  .leftJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
  .where(and(
    or(ne(users.userType, "external_applicant"), sql`${users.userType} IS NULL`), 
    notLike(applications.jobPostingId, "external_%"),
    or(
      sql`${applications.notes} IS NULL`,
      and(
        notLike(applications.notes, "%Alightway%"),
        notLike(applications.notes, "%alightway%"),
        notLike(applications.notes, "%Sanskar%"),
        notLike(applications.notes, "%sanskar%")
      )
    )
  ));

const totalAlightwayApps = alightwayCountRes[0]?.count || 0;
const totalSanskarApps = sanskarCountRes[0]?.count || 0;
const totalPlatformApps = platformCountRes[0]?.count || 0;
const totalAppsAll = totalAlightwayApps + totalSanskarApps + totalPlatformApps;
const totalScopePositionsCount = availablePositions.reduce((acc, p) => acc + p.count, 0);
---

<DashboardLayout
  title="Applications | MasterAdmin"
  userType="masteradmin"
  activePath="/masteradmin/applications"
>
  <div class="dashboard-page-container">
    <div class="dashboard-header mb-4">
      <div class="header-content">
        <div class="title-with-icon">
          <div class="icon-box bg-primary">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 8 9"></polyline>
            </svg>
          </div>
          <div>
            <h1>External & Platform Applications</h1>
            <p class="text-muted" style="margin: 0; font-size: 0.875rem;">
              Manage incoming applications from your live websites (Alightway & Sanskar Construction) and JobNed platform.
            </p>
          </div>
        </div>
        
        <div class="header-actions">
          <a href={`/api/superadmin/export-applications?source=${sourceParam}&position=${encodeURIComponent(positionParam)}&sort=${sortParam}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}`} class="btn btn-outline export-btn">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 0.4rem;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Export CSV ({allApplications.length})
          </a>
        </div>
      </div>
    </div>

    <!-- API Webhook Status Notice -->
    <div class="api-notice-card mb-4">
      <div class="api-notice-icon">🌐</div>
      <div class="api-notice-content">
        <strong>External Website Sync Active (Alightway & Sanskar Construction)</strong>
        <p>Applications submitted on <em>Alightway</em> and <em>Sanskar Construction</em> sync automatically via this API endpoint.</p>
      </div>
      <div class="api-code-pill">
        <code>POST /api/external/submit-application</code>
        <span class="key-badge">Bearer Key: rn_live_8392jf9823f</span>
      </div>
    </div>

    <!-- Source Tabs Row (Segmented Navigation) -->
    <div class="source-tabs-row mb-3">
      <a href={`/masteradmin/applications?source=alightway&position=${encodeURIComponent(positionParam)}&sort=${sortParam}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}`} class={`tab-pill ${sourceParam === 'alightway' ? 'active-tab' : ''}`}>
        <span class="tab-icon">🌐</span>
        <span>Alightway Website</span>
        <span class="tab-count-badge">{totalAlightwayApps}</span>
      </a>

      <a href={`/masteradmin/applications?source=sanskar&position=${encodeURIComponent(positionParam)}&sort=${sortParam}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}`} class={`tab-pill ${sourceParam === 'sanskar' ? 'active-tab' : ''}`}>
        <span class="tab-icon">🏗️</span>
        <span>Sanskar Construction</span>
        <span class="tab-count-badge">{totalSanskarApps}</span>
      </a>

      <a href={`/masteradmin/applications?source=platform&position=${encodeURIComponent(positionParam)}&sort=${sortParam}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}`} class={`tab-pill ${sourceParam === 'platform' ? 'active-tab' : ''}`}>
        <span class="tab-icon">🏢</span>
        <span>JobNed Platform</span>
        <span class="tab-count-badge">{totalPlatformApps}</span>
      </a>

      <a href={`/masteradmin/applications?source=all&position=${encodeURIComponent(positionParam)}&sort=${sortParam}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}`} class={`tab-pill ${sourceParam === 'all' ? 'active-tab' : ''}`}>
        <span class="tab-icon">📊</span>
        <span>All Applications</span>
        <span class="tab-count-badge">{totalAppsAll}</span>
      </a>
    </div>

    <!-- Dedicated Filter & Controls Toolbar Card -->
    <div class="filter-controls-card mb-4">
      <form action="/masteradmin/applications" method="GET" class="filter-controls-form" id="filterControlsForm">
        <input type="hidden" name="source" value={sourceParam} />

        <div class="form-inputs-left">
          <!-- Candidate Search Input with Live Realtime Filter -->
          <div class="search-input-group">
            <span class="search-icon">🔍</span>
            <input 
              type="text" 
              name="search" 
              id="candidateSearchInput" 
              class="candidate-search-input" 
              placeholder="Search candidate by name, email, phone..." 
              value={searchParam}
              autocomplete="off"
            />
            {searchParam && (
              <a 
                href={`/masteradmin/applications?source=${sourceParam}&position=${encodeURIComponent(positionParam)}&sort=${sortParam}`} 
                class="btn-clear-search" 
                title="Clear Search"
              >✕</a>
            )}
          </div>

          <!-- Position Filter Dropdown -->
          <div class="select-group">
            <label for="position-select" class="select-label">💼 Filter Position:</label>
            <select id="position-select" name="position" class="filter-select" onchange="this.form.submit()">
              <option value="all" selected={positionParam === "all"}>
                All Positions
              </option>
              {availablePositions.map((pos) => (
                <option value={pos.jobTitle} selected={positionParam === pos.jobTitle}>
                  {pos.jobTitle} ({pos.count})
                </option>
              ))}
            </select>
          </div>

          <!-- Sort By Dropdown -->
          <div class="select-group">
            <label for="sort-select" class="select-label">⇅ Sort By:</label>
            <select id="sort-select" name="sort" class="sort-select" onchange="this.form.submit()">
              <option value="date_desc" selected={sortParam === "date_desc"}>Newest First</option>
              <option value="date_asc" selected={sortParam === "date_asc"}>Oldest First</option>
              <option value="status_asc" selected={sortParam === "status_asc"}>Status (A-Z)</option>
              <option value="status_desc" selected={sortParam === "status_desc"}>Status (Z-A)</option>
              <option value="name_asc" selected={sortParam === "name_asc"}>Applicant (A-Z)</option>
              <option value="name_desc" selected={sortParam === "name_desc"}>Applicant (Z-A)</option>
            </select>
          </div>
        </div>

        <div class="form-actions-right">
          {searchParam && (
            <div class="active-filter-badge me-2">
              <span>Candidate: <strong>"{searchParam}"</strong></span>
              <a href={`/masteradmin/applications?source=${sourceParam}&position=${encodeURIComponent(positionParam)}&sort=${sortParam}`} class="btn-clear-filter" title="Clear Candidate Search">
                ✕ Reset
              </a>
            </div>
          )}
          {positionParam !== "all" && (
            <div class="active-filter-badge">
              <span>Position: <strong>{positionParam}</strong></span>
              <a href={`/masteradmin/applications?source=${sourceParam}&position=all&sort=${sortParam}${searchParam ? `&search=${encodeURIComponent(searchParam)}` : ''}`} class="btn-clear-filter" title="Clear Position Filter">
                ✕ Reset
              </a>
            </div>
          )}
          <span class="results-count-lbl" id="resultsCountDisplay">
            {searchParam ? `Found ${allApplications.length} matching candidate${allApplications.length === 1 ? '' : 's'}` : `Showing ${allApplications.length} applications`}
          </span>
        </div>
      </form>
    </div>

    <!-- Data Table Card -->
    <div class="table-card">
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Application Source</th>
              <th>Applicant</th>
              <th>Applied Position</th>
              <th>Status</th>
              <th>Applied At</th>
              <th>Resume</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <!-- Live filter 0 matches row -->
            <tr id="noLiveMatchRow" style="display: none;">
              <td colspan="7" class="empty-cell">
                <div class="empty-state">
                  <div class="empty-icon">🔍</div>
                  <h3>No Matching Candidates Found</h3>
                  <p>
                    No candidate found matching "<span id="liveSearchQueryDisplay" style="font-weight: 700; color: var(--color-primary);"></span>".
                    Try searching by name, email address, or phone number.
                  </p>
                </div>
              </td>
            </tr>

            {allApplications.length === 0 ? (
              <tr>
                <td colspan="7" class="empty-cell">
                  <div class="empty-state">
                    <div class="empty-icon">{searchParam ? '🔍' : sourceParam === 'alightway' ? '🌐' : '📁'}</div>
                    <h3>{searchParam ? 'No Candidates Found' : 'No Applications Found'}</h3>
                    <p>
                      {searchParam 
                        ? `No candidates found matching "${searchParam}". Try clearing your search query.`
                        : positionParam !== "all" 
                          ? `No applications found for position "${positionParam}".` 
                          : 'No applications found matching the selected filters.'}
                    </p>
                  </div>
                </td>
              </tr>
            ) : (
              allApplications.map((app) => {
                const notesStr = (app.notes || "").toLowerCase();
                const isSanskar = notesStr.includes("sanskar");
                const isAlightway = !isSanskar && (app.userType === "external_applicant" || (app.jobId && app.jobId.startsWith("external_")) || notesStr.includes("alightway") || notesStr.includes("external"));
                const rowSearchText = `${app.applicantFirstName || ''} ${app.applicantLastName || ''} ${app.applicantEmail || ''} ${app.applicantPhone || ''} ${app.jobTitle || ''} ${app.notes || ''}`.toLowerCase();

                return (
                  <tr class="app-row" data-search-text={rowSearchText}>
                    <td>
                      <span class={`source-tag ${isSanskar ? 'tag-sanskar' : isAlightway ? 'tag-alightway' : 'tag-platform'}`}>
                        {isSanskar ? '🏗️ Sanskar Website' : isAlightway ? '🌐 Alightway Website' : '🏢 JobNed Platform'}
                      </span>
                    </td>
                    <td>
                      <div class="user-meta-cell">
                        <div class="user-avatar-circle">
                          {app.applicantFirstName?.charAt(0).toUpperCase() || "U"}
                        </div>
                        <div>
                          <strong class="user-name-txt">{app.applicantFirstName} {app.applicantLastName}</strong>
                          <div class="email-sub">{app.applicantEmail}</div>
                          {app.applicantPhone && <div class="phone-sub">📞 {app.applicantPhone}</div>}
                        </div>
                      </div>
                    </td>
                    <td>
                      <span class="job-title-txt">{app.jobTitle}</span>
                    </td>
                    <td>
                      <span class={`status-badge status-${app.status}`}>
                        {app.status}
                      </span>
                    </td>
                    <td>
                      <span class="date-txt">
                        {app.appliedAt
                          ? new Date(app.appliedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
                          : "-"}
                      </span>
                    </td>
                    <td>
                      {app.resumeUrl ? (
                        <a href={getResumeViewerUrl(app.resumeUrl, Astro.url.origin)} target="_blank" class="btn-resume">
                          📄 View Resume
                        </a>
                      ) : (
                        <span class="no-resume">No resume</span>
                      )}
                    </td>
                    <td>
                      <div class="actions-cell">
                        <button
                          type="button"
                          class="btn-action-icon view-action"
                          title="View Full Application Details"
                          onclick={`document.getElementById('dialog-${app.id}').showModal()`}
                        >
                          👁️
                        </button>
                        <button
                          type="button"
                          class="btn-action-icon delete-action"
                          title="Delete Application"
                          onclick={`deleteApplication('${app.id}')`}
                        >
                          🗑️
                        </button>
                      </div>

                      <!-- Details Dialog -->
                      <dialog id={`dialog-${app.id}`} class="app-dialog">
                        <div class="dialog-content">
                          <div class="dialog-header">
                            <h3>Application Details</h3>
                            <button type="button" class="dialog-close" onclick={`document.getElementById('dialog-${app.id}').close()`}>✕</button>
                          </div>

                          <div class="dialog-body">
                             <div class="dialog-source-bar mb-3">
                              <span class={`source-tag ${isSanskar ? 'tag-sanskar' : isAlightway ? 'tag-alightway' : 'tag-platform'}`}>
                                {isSanskar ? '🏗️ Submitted via Sanskar Construction' : isAlightway ? '🌐 Submitted via Alightway Live Website' : '🏢 Submitted via JobNed Platform'}
                              </span>
                            </div>

                            <div class="dialog-grid">
                              <div class="dialog-item">
                                <span class="lbl">Applicant Name</span>
                                <span class="val">{app.applicantFirstName} {app.applicantLastName}</span>
                              </div>
                              <div class="dialog-item">
                                <span class="lbl">Email Address</span>
                                <span class="val">{app.applicantEmail}</span>
                              </div>
                              {app.applicantPhone && (
                                <div class="dialog-item">
                                  <span class="lbl">Phone Number</span>
                                  <span class="val">{app.applicantPhone}</span>
                                </div>
                              )}
                              <div class="dialog-item">
                                <span class="lbl">Applied Position</span>
                                <span class="val highlight">{app.jobTitle}</span>
                              </div>
                            </div>

                            {app.coverLetter && (
                              <div class="dialog-section mt-3">
                                <span class="lbl">Cover Letter / Skills Notes</span>
                                <div class="cover-letter-box">
                                  {app.coverLetter}
                                </div>
                              </div>
                            )}

                            {(() => {
                              let customData: any = {};
                              if (app.customAnswers) {
                                try {
                                  customData = typeof app.customAnswers === 'string' ? JSON.parse(app.customAnswers) : app.customAnswers;
                                } catch(e) {}
                              }
                              const screeningAnswers = Array.isArray(customData?.screeningAnswers) ? customData.screeningAnswers : [];
                              if (screeningAnswers.length === 0) return null;
                              return (
                                <div class="dialog-section mt-3">
                                  <span class="lbl">Candidate Screening Responses ({screeningAnswers.length})</span>
                                  <div class="screening-dialog-list">
                                    {screeningAnswers.map((sa: any, sIdx: number) => (
                                      <div class="screening-dialog-item">
                                        <div class="sq-prompt"><strong>Q{sIdx + 1}: {sa.question}</strong></div>
                                        <div class="sq-ans">Answer: <span class="ans-highlight">{sa.answer || '—'}</span></div>
                                      </div>
                                    ))}
                                  </div>
                                </div>
                              );
                            })()}
                          </div>

                          <div class="dialog-footer">
                            <button
                              type="button"
                              class="btn btn-outline"
                              onclick={`document.getElementById('dialog-${app.id}').close()`}
                            >
                              Close
                            </button>
                          </div>
                        </div>
                      </dialog>
                    </td>
                  </tr>
                );
              })
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  async function deleteApplication(id: string) {
    if (confirm("Are you sure you want to delete this application?")) {
      try {
        const res = await fetch(`/api/superadmin/delete-application`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast("Application deleted successfully.");
          window.location.reload();
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast("Failed to delete application.", "error");
        }
      } catch (e) {
        // @ts-ignore
        if (window.showToast) window.showToast("An error occurred while deleting.", "error");
      }
    }
  }
  // @ts-ignore
  window.deleteApplication = deleteApplication;

  // Live Instant Search Filter for Candidates
  const searchInput = document.getElementById("candidateSearchInput") as HTMLInputElement | null;
  const countDisplay = document.getElementById("resultsCountDisplay");
  const noMatchRow = document.getElementById("noLiveMatchRow");
  const liveQuerySpan = document.getElementById("liveSearchQueryDisplay");

  if (searchInput) {
    const applyLiveSearch = () => {
      const q = searchInput.value.toLowerCase().trim();
      const rows = document.querySelectorAll(".app-row");
      let visibleCount = 0;

      rows.forEach((row) => {
        const text = (row.getAttribute("data-search-text") || "").toLowerCase();
        if (!q || text.includes(q)) {
          (row as HTMLElement).style.display = "";
          visibleCount++;
        } else {
          (row as HTMLElement).style.display = "none";
        }
      });

      if (noMatchRow) {
        if (visibleCount === 0 && rows.length > 0 && q) {
          noMatchRow.style.display = "";
          if (liveQuerySpan) liveQuerySpan.textContent = searchInput.value.trim();
        } else {
          noMatchRow.style.display = "none";
        }
      }

      if (countDisplay) {
        if (q) {
          countDisplay.textContent = `Found ${visibleCount} matching candidate${visibleCount === 1 ? '' : 's'}`;
        } else {
          countDisplay.textContent = `Showing ${rows.length} applications`;
        }
      }
    };

    searchInput.addEventListener("input", applyLiveSearch);

    // Pressing Enter submits form so URL & export CSV reflect candidate search
    searchInput.addEventListener("keydown", (e) => {
      if (e.key === "Enter") {
        const form = document.getElementById("filterControlsForm") as HTMLFormElement | null;
        if (form) form.submit();
      }
    });
  }
</script>


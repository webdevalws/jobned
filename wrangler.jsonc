{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "recruitnest",
  "account_id": "a3facadfed4b16b29b95e200f259e7ff",
  "compatibility_date": "2026-08-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "jobned.com", "custom_domain": true },
    { "pattern": "www.jobned.com", "custom_domain": true }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://jobned.com",
    "PUBLIC_STORAGE_URL": "https://jobned.com/uploads",
    "PUBLIC_RAZORPAY_KEY_ID": "rzp_live_TbnQ3kUA2u3BbQ",
    "RAZORPAY_KEY_ID": "rzp_live_TbnQ3kUA2u3BbQ"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "recruitnest",
      "database_id": "22e125f2-3ed6-43d0-91a1-a38d6a43ae58",
      "migrations_dir": "drizzle"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "recruitnest-storage"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b238e5692b334ffda8615424b2ac3875"
    }
  ],
  "vectorize": [
    {
      "binding": "VECTORIZE_INDEX",
      "index_name": "job-embeddings"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "triggers": {
    "crons": ["0 * * * *"]
  }
}

<script>
  (window as any).setQuickStage = function(targetStage: string) {
    const select = document.getElementById('status') as HTMLSelectElement | null;
    if (select) {
      select.value = targetStage;
      document.querySelectorAll('.stage-quick-btn').forEach(btn => btn.classList.remove('active'));
      const activeBtn = document.querySelector(`.stage-quick-btn[onclick*="${targetStage}"]`);
      if (activeBtn) activeBtn.classList.add('active');
    }
  };
  const form = document.getElementById(
    "app-status-form",
  ) as HTMLFormElement | null;
  const saveBtn = document.getElementById(
    "save-app-btn",
  ) as HTMLButtonElement | null;

  if (form && saveBtn) {
    // Handle star selection visual update
    const stars = form.querySelectorAll(".star-label");
    stars.forEach((star, idx) => {
      star.addEventListener("click", () => {
        // Highlight all stars up to selected
        stars.forEach((s, i) => {
          const icon = s.querySelector(".star-icon");
          if (icon) {
            if (i <= idx) {
              icon.setAttribute("style", "color: #F59E0B;");
            } else {
              icon.setAttribute("style", "color: #E2E8F0;");
            }
          }
        });
      });
    });

    // Handle form submit
    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const formData = new FormData(e.target as HTMLFormElement);
      const data = Object.fromEntries(formData.entries());

      const originalText = saveBtn.innerText;
      saveBtn.innerText = "Saving Updates...";
      saveBtn.disabled = true;

      try {
        const res = await fetch("/api/employer/applications/update", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          credentials: "same-origin",
          body: JSON.stringify(data),
        });

        if (res.ok) {
          showToast("Application updated successfully!");
          window.location.reload();
        } else {
          const result = await res.json();
          showToast(result.error || "Failed to update application");
        }
      } catch (err) {
        showToast("A network error occurred. Please try again.");
      } finally {
        saveBtn.innerText = originalText;
        saveBtn.disabled = false;
      }
    });
  }
</script>

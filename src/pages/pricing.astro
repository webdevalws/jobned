    </div>

    <div class="login-prompt">
      <p>Already have an account? <a href="/login" class="text-primary fw-600">Log in to dashboard</a></p>
    </div>
  </main>

  <!-- Razorpay Payment Gateway Modal (Supports live checkout & test simulation) -->
  <div id="rzpSimModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card rzp-modal-card">
      <div class="rzp-brand-header">
        <div class="rzp-brand-left">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" class="rzp-logo-svg">
            <path d="M12 2L2 7L12 12L22 7L12 2Z" stroke="#3b82f6" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 17L12 22L22 17" stroke="#3b82f6" stroke-width="2" stroke-linejoin="round"/>
            <path d="M2 12L12 17L22 12" stroke="#3b82f6" stroke-width="2" stroke-linejoin="round"/>
          </svg>
          <span class="rzp-brand-title">Razorpay <span class="badge-trusted">SECURE</span></span>
        </div>
        <button type="button" class="rzp-close" id="closeRzpSimModal" aria-label="Close payment modal">&times;</button>
      </div>

      <div class="rzp-order-bar">
        <div>
          <span class="rzp-order-label">RecruitNest Subscription</span>
          <h3 class="rzp-plan-name" id="simPlanTitle">Basic Plan</h3>
        </div>
        <div class="rzp-price-tag" id="simPriceTag">$1.00</div>
      </div>

      <div class="rzp-test-notice">
        <span class="pulse-dot"></span>
        <span>Payment Gateway Ready &bull; Sandbox Test Mode</span>
      </div>

      <div class="rzp-methods">
        <label class="rzp-method active">
          <input type="radio" name="rzp_method" value="card" checked />
          <div class="method-info">
            <span class="method-name">💳 Cards (Credit/Debit)</span>
            <span class="method-desc">Visa, Mastercard, RuPay &amp; Amex</span>
          </div>
        </label>
        <label class="rzp-method">
          <input type="radio" name="rzp_method" value="upi" />
          <div class="method-info">
            <span class="method-name">📱 UPI / QR</span>
            <span class="method-desc">Google Pay, PhonePe, Paytm, BHIM</span>
          </div>
        </label>
        <label class="rzp-method">
          <input type="radio" name="rzp_method" value="netbanking" />
          <div class="method-info">
            <span class="method-name">🏦 Netbanking</span>
            <span class="method-desc">All major domestic &amp; global banks</span>
          </div>
        </label>
      </div>

      <div class="rzp-sim-actions">
        <button type="button" class="btn btn-primary w-full rzp-pay-btn" id="simConfirmPayBtn">
          Pay <span id="simPayAmount">$1.00</span> &amp; Activate Plan
        </button>
        <button type="button" class="btn btn-outline w-full" id="simCancelPayBtn">Cancel</button>
      </div>

      <div class="rzp-footer-note">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
          <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
        </svg>
        <span>256-Bit Encrypted &bull; Razorpay Payment Infrastructure</span>
      </div>
    </div>
  </div>

  <script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>

  <script define:vars={{ initialIsLoggedIn: !!user, userType: user?.userType || 'employer' }}>
    let isLoggedIn = initialIsLoggedIn;
    let currentOrderData = null;

    const rzpModal = document.getElementById('rzpSimModal');

    // Ensure Razorpay SDK script is ready
    async function ensureRazorpayScript() {
      if (typeof window.Razorpay !== 'undefined') return true;
      return new Promise((resolve) => {
        const s = document.createElement('script');
        s.src = 'https://checkout.razorpay.com/v1/checkout.js';
        s.onload = () => resolve(true);
        s.onerror = () => resolve(false);
        document.body.appendChild(s);
      });
    }

    // Initiate checkout for any plan
    async function startCheckout(planId, price, currency, planName, clickedBtn) {
      const parsedPrice = parseFloat(price) || 0;

      // If user is not logged in, redirect directly to registration page
      if (!isLoggedIn) {
        window.location.href = `/register?plan=${encodeURIComponent(planId)}&type=employer`;
        return;
      }

      // 1. Free plan flow for logged-in user
      if (parsedPrice <= 0) {
        const originalText = clickedBtn ? clickedBtn.innerText : '';
        if (clickedBtn) {
          clickedBtn.innerText = 'Activating...';
          clickedBtn.disabled = true;
        }

        try {
          const res = await fetch('/api/payments/verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ planId, billingCycle: 'monthly' })
          });
          const data = await res.json();
          if (res.ok) {
            alert(`🎉 ${planName || 'Plan'} activated successfully!`);
            window.location.href = userType === 'employer' ? '/employer' : '/dashboard';
          } else {
            alert(data.error || 'Failed to activate plan.');
            if (clickedBtn) {
              clickedBtn.innerText = originalText;
              clickedBtn.disabled = false;
            }
          }
        } catch (err) {
          alert('Network error while activating free plan.');
          if (clickedBtn) {
            clickedBtn.innerText = originalText;
            clickedBtn.disabled = false;
          }
        }
        return;
      }

      // 2. Paid plan flow for logged-in user -> redirect to dedicated checkout page
      if (parsedPrice > 0) {
        window.location.href = `/checkout?plan=${encodeURIComponent(planId)}`;
        return;
      }
    }

    // Triggers either live Razorpay or seamless high-fidelity simulation
    async function triggerGateway(orderData, clickedBtn, originalText) {
      await ensureRazorpayScript();

      const isPlaceholderKey = !orderData.keyId ||
        orderData.keyId.includes('placeholder') ||
        orderData.keyId.includes('dummy') ||
        orderData.orderId.startsWith('order_mock_');

      if (!isPlaceholderKey && typeof window.Razorpay !== 'undefined') {
        // Live Razorpay credentials
        try {
          const options = {
            key: orderData.keyId,
            amount: orderData.amount,
            currency: orderData.currency,
            name: "RecruitNest",
            description: `${orderData.planName} Subscription`,
            order_id: orderData.orderId,
            prefill: {
              name: orderData.userName || "",
              email: orderData.userEmail || ""
            },
            theme: { color: "#4f46e5" },
            handler: async function (response) {
              await verifyAndComplete(orderData.planId, response.razorpay_order_id, response.razorpay_payment_id, response.razorpay_signature);
            },
            modal: {
              ondismiss: function () {
                if (clickedBtn) {
                  clickedBtn.innerText = originalText;
                  clickedBtn.disabled = false;
                }
              }
            }
          };

          const rzp = new window.Razorpay(options);
          rzp.open();
          return;
        } catch (liveErr) {
          console.warn('Live Razorpay invocation fallback to test gateway:', liveErr);
        }
      }

      // Display the Razorpay-themed test modal
      openRzpSimModal(orderData);
      if (clickedBtn) {
        clickedBtn.innerText = originalText;
        clickedBtn.disabled = false;
      }
    }

    // Verify payment with server and activate
    async function verifyAndComplete(planId, orderId, paymentId, signature) {
      const confirmBtn = document.getElementById('simConfirmPayBtn');
      if (confirmBtn) {
        confirmBtn.innerText = 'Verifying with Server...';
        confirmBtn.disabled = true;
      }

      try {
        const verifyRes = await fetch('/api/payments/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            planId,
            billingCycle: 'monthly',
            razorpay_order_id: orderId,
            razorpay_payment_id: paymentId,
            razorpay_signature: signature
          })
        });

        const verifyData = await verifyRes.json();

        if (verifyRes.ok) {
          alert('🎉 Payment verified successfully! Your subscription is now active.');
          window.location.href = userType === 'employer' ? '/employer' : '/dashboard';
        } else {
          alert(verifyData.error || 'Payment verification failed.');
          if (confirmBtn) {
            confirmBtn.innerText = 'Pay & Activate Plan';
            confirmBtn.disabled = false;
          }
        }
      } catch (err) {
        console.error('Verify error:', err);
        alert('Network error while verifying payment.');
        if (confirmBtn) {
          confirmBtn.innerText = 'Pay & Activate Plan';
          confirmBtn.disabled = false;
        }
      }
    }

    function openRzpSimModal(orderData) {
      const symbol = orderData.currency === 'INR' ? '₹' : '$';
      const formatted = `${symbol}${(orderData.amount / 100).toFixed(2)}`;
      document.getElementById('simPlanTitle').innerText = `${orderData.planName} (Monthly)`;
      document.getElementById('simPriceTag').innerText = formatted;
      document.getElementById('simPayAmount').innerText = formatted;
      rzpModal.style.display = 'flex';
    }

    // Setup button listeners
    document.querySelectorAll('.checkout-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const t = e.currentTarget;
        const planId = t.getAttribute('data-plan') || 'P001';
        const price = t.getAttribute('data-price') || '0';
        const currency = t.getAttribute('data-currency') || 'USD';
        const planName = t.getAttribute('data-planname') || 'Plan';
        startCheckout(planId, price, currency, planName, t);
      });
    });

    // Close Modal
    document.getElementById('closeRzpSimModal')?.addEventListener('click', () => {
      rzpModal.style.display = 'none';
    });
    document.getElementById('simCancelPayBtn')?.addEventListener('click', () => {
      rzpModal.style.display = 'none';
    });

    // Simulated Gateway Confirmation Click
    document.getElementById('simConfirmPayBtn')?.addEventListener('click', async () => {
      if (!currentOrderData) return;
      const mockPaymentId = `pay_sim_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`;
      const mockSignature = `sig_sim_${Date.now()}`;
      await verifyAndComplete(currentOrderData.planId, currentOrderData.orderId, mockPaymentId, mockSignature);
    });

    // Auto-checkout if user arrived via /pricing?plan=P001
    const urlParams = new URLSearchParams(window.location.search);
    const autoPlan = urlParams.get('plan');
    if (autoPlan && isLoggedIn) {
      const matchBtn = document.querySelector(`.checkout-btn[data-plan="${autoPlan}"]`);
      if (matchBtn) {
        matchBtn.click();
      }
    }
  </script>
</Layout>

<style>
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }
  :global([data-theme="light"]) .landing-nav {
    background: rgba(255, 255, 255, 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;

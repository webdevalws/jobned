    flex-direction: column;
    gap: 1.25rem;
    margin-top: 0.75rem;
  }
  .card-sub {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.25rem;
    position: relative;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.02);
  }
  .exp-row-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .exp-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary);
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
  }
  .btn-remove-exp {
    background: none;
    border: none;
    color: #ef4444;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .btn-remove-exp:hover {
    background: rgba(239, 68, 68, 0.1);
  }
  .exp-empty {
    text-align: center;
    padding: 2.5rem 1.5rem;
    border: 2px dashed var(--color-border);
    border-radius: var(--border-radius-md);
    color: var(--color-text-muted);
  }
  .exp-empty .empty-icon {
    font-size: 2rem;
    margin-bottom: 0.5rem;
  }
  .date-present-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .checkbox-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
  }
</style>

<script
  define:vars={{
    skillsInitial: skills,
    educationInitial: education,
    workExperienceInitial: workExperience,
  }}
>
  function escHtml(str) {
    if (!str) return "";
    return String(str)
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#039;");
  }

  function escAttr(str) {
    if (!str) return "";
    return String(str).replace(/'/g, "\\'").replace(/"/g, "&quot;");
  }

  // ===== TAB SWITCHING =====
  function switchTab(tab, btn) {
    document
      .querySelectorAll(".tab-panel")
      .forEach((p) => p.classList.remove("active"));
    document
      .querySelectorAll(".settings-nav-item")
      .forEach((b) => b.classList.remove("active"));
    const targetPanel = document.getElementById(`tab-${tab}`);
    if (targetPanel) targetPanel.classList.add("active");
    const targetBtn = btn || document.getElementById(`nav-${tab}`);
    if (targetBtn) {
      targetBtn.classList.add("active");
      targetBtn.scrollIntoView({
        behavior: "smooth",
        inline: "center",
        block: "nearest",
      });
    }
  }
  window.switchTab = switchTab;

  document
    .querySelectorAll(".settings-nav .settings-nav-item")
    .forEach((button) => {
      button.addEventListener("click", function (e) {
        e.preventDefault();
        const tabName =
          this.getAttribute("data-tab") || this.id.replace("nav-", "");
        switchTab(tabName, this);
      });
    });

  // Check URL hash on load
  const hash = window.location.hash.replace("#", "");
  if (["profile", "skills", "links", "security"].includes(hash)) {
    const btn = document.getElementById(`nav-${hash}`);
    if (btn) switchTab(hash, btn);
  }

  // ===== PHOTO UPLOAD =====
  const photoInput = document.getElementById("photo-input");
  const photoPreview = document.getElementById("photo-preview");
  const sidebarAvatar = document.getElementById("sidebarAvatar");
  const photoSelectedInfo = document.getElementById("photo-selected-info");

  photoInput?.addEventListener("change", () => {
    const file = photoInput.files?.[0];
    if (!file) return;

    if (file.size > 5 * 1024 * 1024) {
      showToast("File must be under 5MB", "error");
      photoInput.value = "";
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const src = e.target?.result;
      if (src) {
        photoPreview.src = src;
        sidebarAvatar.src = src;
        photoSelectedInfo.textContent = `📎 ${file.name} (${(file.size / 1024).toFixed(0)} KB) — will be uploaded on save`;
        photoSelectedInfo.style.display = "block";
      }
    };
    reader.readAsDataURL(file);
  });

  // ===== SKILLS MANAGEMENT =====
  let currentSkills = [...skillsInitial];

  function renderSkillChips() {
    const area = document.getElementById("skills-chips");
    const hidden = document.getElementById("skills-hidden");
    area.innerHTML = currentSkills
      .map(
        (skill) => `
      <span class="skill-chip" data-skill="${escHtml(skill)}">
        ${escHtml(skill)}
        <button type="button" class="chip-remove" onclick="removeSkill('${escAttr(skill)}')">×</button>
      </span>
    `,
      )
      .join("");
    hidden.value = JSON.stringify(currentSkills);
  }

  window.addSkill = function (skill) {
    skill = skill.trim();
    if (!skill || currentSkills.includes(skill)) return;
    currentSkills.push(skill);
    renderSkillChips();
  };

  window.removeSkill = function (skill) {
    currentSkills = currentSkills.filter((s) => s !== skill);
    renderSkillChips();
  };

  // Skill text input: Enter or comma to add
  const skillInput = document.getElementById("skill-input");
  skillInput?.addEventListener("keydown", (e) => {
    if (e.key === "Enter" || e.key === ",") {
      e.preventDefault();
      const val = skillInput.value.replace(/,/g, "").trim();
      if (val) {
        addSkill(val);
        skillInput.value = "";
      }
    }
    if (
      e.key === "Backspace" &&
      !skillInput.value &&
      currentSkills.length > 0
    ) {
      currentSkills.pop();
      renderSkillChips();
    }
  });
  // Click on the area to focus the input
  document
    .getElementById("skills-input-area")
    ?.addEventListener("click", () => skillInput?.focus());

  // ===== EDUCATION MANAGEMENT =====
  let currentEducation = [...educationInitial];

  function saveEducationHidden() {
    const rows = document.querySelectorAll(".edu-row");
    currentEducation = Array.from(rows)
      .map((row) => ({
        course: row.querySelector(".edu-course")?.value?.trim() || "",
        college: row.querySelector(".edu-college")?.value?.trim() || "",
        startYear: row.querySelector(".edu-start-year")?.value?.trim() || "",
        endYear: row.querySelector(".edu-end-year")?.value?.trim() || "",
      }))
      .filter((e) => e.course || e.college);
    document.getElementById("education-hidden").value =
      JSON.stringify(currentEducation);
  }

  window.addEducation = function () {
    const list = document.getElementById("education-list");
    const empty = document.getElementById("edu-empty");
    if (empty) empty.remove();

    const div = document.createElement("div");
    div.className = "edu-row";
    div.innerHTML = `
      <div class="form-grid-2">
        <div class="form-group">
          <label>Course (Degree / Certification)</label>
          <input type="text" class="edu-course" placeholder="B.Tech Computer Science" oninput="saveEducationHidden()" />
        </div>
        <div class="form-group">
          <label>College / Institution</label>
          <input type="text" class="edu-college" placeholder="IIT Bombay" oninput="saveEducationHidden()" />
        </div>
      </div>
      <div class="form-grid-2 mt-4">
        <div class="form-group">
          <label>From Year</label>
          <input type="number" class="edu-start-year" placeholder="2020" min="1950" max="2030" oninput="saveEducationHidden()" />
        </div>
        <div class="form-group">
          <label>To Year (or Expected)</label>
          <input type="number" class="edu-end-year" placeholder="2024" min="1950" max="2030" oninput="saveEducationHidden()" />
        </div>
      </div>
      <button type="button" class="remove-edu-btn" onclick="removeEducation(this)">Remove</button>
    `;
    list.appendChild(div);
  };

  window.removeEducation = function (btn) {
    btn.closest(".edu-row").remove();
    saveEducationHidden();
    if (!document.querySelector(".edu-row")) {
      const list = document.getElementById("education-list");
      list.innerHTML = `<div class="edu-empty" id="edu-empty"><p>No education added yet. Click "+ Add" to get started.</p></div>`;
    }
  };

  // Bind change events to existing edu rows
  document
    .querySelectorAll(
      ".edu-course, .edu-college, .edu-start-year, .edu-end-year",
    )
    .forEach((el) => {
      el.addEventListener("input", saveEducationHidden);
    });

  window.saveEducationHidden = saveEducationHidden;

  // ===== WORK EXPERIENCE MANAGEMENT =====
  let currentWorkExperience = [...(workExperienceInitial || [])];

  function saveWorkExperienceHidden() {
    const rows = document.querySelectorAll(".exp-row");
    currentWorkExperience = Array.from(rows)
      .map((row) => {
        const cb = row.querySelector(".exp-current-cb");
        const endDateInput = row.querySelector(".exp-end-date");
        return {
          jobTitle: row.querySelector(".exp-title")?.value?.trim() || "",
          company: row.querySelector(".exp-company")?.value?.trim() || "",
          skillsUsed: row.querySelector(".exp-skills")?.value?.trim() || "",
          startDate: row.querySelector(".exp-start-date")?.value?.trim() || "",
          endDate: cb?.checked ? "Present" : endDateInput?.value?.trim() || "",
          currentlyWorking: cb ? cb.checked : false,
          description: row.querySelector(".exp-desc")?.value?.trim() || "",
        };
      })
      .filter((e) => e.jobTitle || e.company);

    const hidden = document.getElementById("work-experience-hidden");
    if (hidden) hidden.value = JSON.stringify(currentWorkExperience);
  }

  window.addWorkExperience = function () {
    const list = document.getElementById("work-experience-list");
    const empty = document.getElementById("exp-empty");
    if (empty) empty.remove();

    const count = (list?.querySelectorAll(".exp-row").length || 0) + 1;
    const div = document.createElement("div");
    div.className = "exp-row card-sub";
    div.innerHTML = `
      <div class="exp-row-header">
        <span class="exp-badge">Position #${count}</span>
        <button type="button" class="btn-remove-exp" onclick="removeWorkExperience(this)">✕ Remove</button>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label>Job Title / Role Field <span class="req">*</span></label>
          <input type="text" class="exp-title" placeholder="e.g. Senior Full Stack Developer" oninput="saveWorkExperienceHidden()" required />
        </div>
        
        <div class="form-group">
          <label>Company / Organization <span class="req">*</span></label>
          <input type="text" class="exp-company" placeholder="e.g. Alightway Solutions" oninput="saveWorkExperienceHidden()" required />
        </div>
      </div>

      <div class="form-group mt-3">
        <label>Skills & Technologies Used in this Role</label>
        <input type="text" class="exp-skills" placeholder="e.g. React, Node.js, TypeScript, PostgreSQL" oninput="saveWorkExperienceHidden()" />
      </div>

      <div class="form-grid-2 mt-3">
        <div class="form-group">
          <label>Start Date (Month / Year)</label>
          <input type="text" class="exp-start-date" placeholder="e.g. Jan 2022" oninput="saveWorkExperienceHidden()" />
        </div>
        <div class="form-group">
          <label>End Date</label>
          <div class="date-present-wrap">
            <input type="text" class="exp-end-date" placeholder="e.g. Dec 2024 or Present" oninput="saveWorkExperienceHidden()" />
            <label class="checkbox-label mt-1">
              <input type="checkbox" class="exp-current-cb" onchange="toggleCurrentJob(this)" />
              Currently working in this role
            </label>
          </div>
        </div>
      </div>

      <div class="form-group mt-3">
        <label>Description & Key Responsibilities</label>
        <textarea class="exp-desc" rows="3" placeholder="Describe your key responsibilities, projects completed, and achievements at this company..." oninput="saveWorkExperienceHidden()"></textarea>
      </div>
    `;
    list?.appendChild(div);
    saveWorkExperienceHidden();
  };

  window.removeWorkExperience = function (btn) {
    btn.closest(".exp-row")?.remove();
    saveWorkExperienceHidden();
    if (!document.querySelectorAll(".exp-row").length) {
      const list = document.getElementById("work-experience-list");
      if (list) {
        list.innerHTML = `
          <div class="exp-empty" id="exp-empty">
            <div class="empty-icon">💼</div>
            <p>No specific work experience entries added yet. Click <strong>"+ Add Experience"</strong> above to add your employment history.</p>
          </div>
        `;
      }
    }
  };

  window.toggleCurrentJob = function (cb) {
    const row = cb.closest(".exp-row");
    const endDateInput = row?.querySelector(".exp-end-date");
    if (endDateInput) {
      if (cb.checked) {
        endDateInput.value = "Present";
        endDateInput.disabled = true;
      } else {
        if (endDateInput.value === "Present") endDateInput.value = "";
        endDateInput.disabled = false;
      }
    }
    saveWorkExperienceHidden();
  };

  document
    .querySelectorAll(
      ".exp-title, .exp-company, .exp-skills, .exp-start-date, .exp-end-date, .exp-desc",
    )
    .forEach((el) => {
      el.addEventListener("input", saveWorkExperienceHidden);
    });

  window.saveWorkExperienceHidden = saveWorkExperienceHidden;

  // ===== FORM SUBMISSIONS =====
  async function submitForm(
    formId,
    url,
    saveBtnId,
    saveTextId,
    saveSpinnerId,
    extraData,
  ) {
    const form = document.getElementById(formId);
    const btn = document.getElementById(saveBtnId);
    const txt = document.getElementById(saveTextId);
    const spin = document.getElementById(saveSpinnerId);

    btn.disabled = true;
    txt.style.display = "none";
    spin.style.display = "inline";

    try {
      const fd =
        form instanceof HTMLFormElement ? new FormData(form) : new FormData();
      if (extraData) {
        Object.entries(extraData).forEach(([k, v]) => fd.set(k, v));
      }

      const res = await fetch(url, {
        method: "PUT",
        credentials: "same-origin",
        body: fd,
      });
      const data = await res.json();

      if (res.ok) {
        showToast(data.message || "Saved successfully!");
        if (data.avatarUrl) {
          const avatarSrc = data.avatarUrl.startsWith("data:")
            ? data.avatarUrl
            : data.avatarUrl +
              (data.avatarUrl.includes("?") ? "&" : "?") +
              "t=" +
              Date.now();
          if (photoPreview) photoPreview.src = avatarSrc;
          if (sidebarAvatar) sidebarAvatar.src = avatarSrc;
          // Update topbar avatar
          const topbarAvatar = document.querySelector(".avatar");
          if (topbarAvatar) topbarAvatar.src = avatarSrc;
        }
        if (photoSelectedInfo) {
          photoSelectedInfo.style.display = "none";
        }
        if (photoInput) {
          photoInput.value = "";
        }
      } else {
        showToast(data.error || "Failed to save", "error");
      }
    } catch (err) {
      showToast("Network error. Please try again.", "error");
    } finally {
      btn.disabled = false;
      txt.style.display = "inline";
      spin.style.display = "none";
    }
  }

  // Profile form
  document.getElementById("profile-form")?.addEventListener("submit", (e) => {
    e.preventDefault();
    submitForm(
      "profile-form",
      "/api/employee/profile",
      "profile-save-btn",
      "profile-save-text",
      "profile-save-spinner",
      null,
    );
  });

  // Skills form — inject hidden fields from state before submit
  document
    .getElementById("skills-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      saveEducationHidden();
      saveWorkExperienceHidden();
      const btn = document.getElementById("skills-save-btn");
      const txt = document.getElementById("skills-save-text");
      const spin = document.getElementById("skills-save-spinner");

      if (btn) btn.disabled = true;
      if (txt) txt.style.display = "none";
      if (spin) spin.style.display = "inline";

      const fd = new FormData();
      const firstNameEl = document.getElementById("firstName");
      const lastNameEl = document.getElementById("lastName");
      if (firstNameEl) fd.append("firstName", firstNameEl.value);
      if (lastNameEl) fd.append("lastName", lastNameEl.value);
      fd.append(
        "skills",
        document.getElementById("skills-hidden")?.value || "[]",
      );
      fd.append(
        "education",
        document.getElementById("education-hidden")?.value || "[]",
      );
      fd.append(
        "workExperience",
        document.getElementById("work-experience-hidden")?.value || "[]",
      );
      const expEl = document.getElementById("experienceYears");
      if (expEl) fd.append("experienceYears", expEl.value);

      try {
        const res = await fetch("/api/employee/profile", {
          method: "PUT",
          credentials: "same-origin",
          body: fd,
        });
        const data = await res.json();
        if (res.ok) showToast("Skills & experience saved!");
        else showToast(data.error || "Failed to save", "error");
      } catch {
        showToast("Network error", "error");
      } finally {
        if (btn) btn.disabled = false;
        if (txt) txt.style.display = "inline";
        if (spin) spin.style.display = "none";
      }
    });

  // Links form
  document
    .getElementById("links-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("links-save-btn");
      const txt = document.getElementById("links-save-text");
      const spin = document.getElementById("links-save-spinner");
      btn.disabled = true;
      txt.style.display = "none";
      spin.style.display = "inline";

      const fd = new FormData();
      const firstNameEl = document.getElementById("firstName");
      const lastNameEl = document.getElementById("lastName");
      if (firstNameEl) fd.append("firstName", firstNameEl.value);
      if (lastNameEl) fd.append("lastName", lastNameEl.value);
      fd.append(
        "linkedinUrl",
        document.getElementById("linkedinUrl")?.value || "",
      );
      fd.append(
        "portfolioUrl",
        document.getElementById("portfolioUrl")?.value || "",
      );
      fd.append(
        "defaultResumeUrl",
        document.getElementById("defaultResumeUrl")?.value || "",
      );

      const resumeFileInput = document.getElementById("defaultResumeFile");
      if (
        resumeFileInput &&
        resumeFileInput.files &&
        resumeFileInput.files[0]
      ) {
        fd.append("defaultResumeFile", resumeFileInput.files[0]);
      }

      try {
        const res = await fetch("/api/employee/profile", {
          method: "PUT",
          credentials: "same-origin",
          body: fd,
        });
        const data = await res.json();
        if (res.ok) {
          showToast("Profile links and default resume saved! 🎉");
          setTimeout(() => window.location.reload(), 1200);
        } else {
          showToast(data.error || "Failed to save", "error");
        }
      } catch {
        showToast("Network error", "error");
      } finally {
        btn.disabled = false;
        txt.style.display = "inline";
        spin.style.display = "none";
      }
    });

  // Remove default resume button handler
  document
    .getElementById("remove-resume-btn")
    ?.addEventListener("click", async () => {
      if (
        !confirm("Are you sure you want to remove your saved default resume?")
      )
        return;

      const fd = new FormData();
      const firstNameEl = document.getElementById("firstName");
      const lastNameEl = document.getElementById("lastName");
      if (firstNameEl) fd.append("firstName", firstNameEl.value);
      if (lastNameEl) fd.append("lastName", lastNameEl.value);
      fd.append("clearDefaultResume", "true");

      try {
        const res = await fetch("/api/employee/profile", {
          method: "PUT",
          credentials: "same-origin",
          body: fd,
        });
        const data = await res.json();
        if (res.ok) {
          showToast("Default resume removed");
          setTimeout(() => window.location.reload(), 1000);
        } else {
          showToast(data.error || "Failed to remove resume", "error");
        }
      } catch {
        showToast("Network error", "error");
      }
    });

  // ===== PASSWORD CHANGE =====
  const newPwInput = document.getElementById("newPassword");
  const confirmPwInput = document.getElementById("confirmPassword");

  newPwInput?.addEventListener("input", () => {
    const val = newPwInput.value;
    const strength = document.getElementById("pw-strength");
    const label = document.getElementById("pw-label");
    strength.style.display = val ? "flex" : "none";

    const score = [/.{8,}/, /[A-Z]/, /[0-9]/, /[^A-Za-z0-9]/].filter((r) =>
      r.test(val),
    ).length;
    const colors = ["", "#EF4444", "#F59E0B", "#10B981", "#059669"];
    const labels = ["", "Weak", "Fair", "Good", "Strong"];
    for (let i = 1; i <= 4; i++) {
      document.getElementById(`pw-bar-${i}`).style.background =
        i <= score ? colors[score] : "var(--color-border)";
    }
    label.textContent = labels[score] || "Weak";
    label.style.color = colors[score] || "#EF4444";
    checkMatch();
  });

  confirmPwInput?.addEventListener("input", checkMatch);

  function checkMatch() {
    const msg = document.getElementById("pw-match-msg");
    const nv = newPwInput?.value;
    const cv = confirmPwInput?.value;
    if (!cv) {
      msg.style.display = "none";
      return;
    }
    msg.style.display = "block";
    if (nv === cv) {
      msg.textContent = "✓ Passwords match";
      msg.className = "pw-match ok";
    } else {
      msg.textContent = "✗ Passwords do not match";
      msg.className = "pw-match no";
    }
  }

  document
    .getElementById("password-form")
    ?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = document.getElementById("pw-save-btn");
      const txt = document.getElementById("pw-save-text");
      const spin = document.getElementById("pw-save-spinner");

      const currentPassword = document.getElementById("currentPassword").value;
      const newPassword = document.getElementById("newPassword").value;
      const confirmPassword = document.getElementById("confirmPassword").value;

      if (newPassword !== confirmPassword) {
        showToast("Passwords do not match", "error");
        return;
      }
      if (newPassword.length < 8) {
        showToast("Password must be at least 8 characters", "error");
        return;
      }

      btn.disabled = true;
      txt.style.display = "none";
      spin.style.display = "inline";

      try {
        const res = await fetch("/api/auth/change-password", {
          method: "POST",
          credentials: "same-origin",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ currentPassword, newPassword }),
        });
        const data = await res.json();
        if (res.ok) {
          showToast("Password changed successfully! 🔒");
          e.target.reset();
          document.getElementById("pw-strength").style.display = "none";
          document.getElementById("pw-match-msg").style.display = "none";
        } else {
          showToast(data.error || "Failed to change password", "error");
        }
      } catch {
        showToast("Network error", "error");
      } finally {
        btn.disabled = false;
        txt.style.display = "inline";
        spin.style.display = "none";
      }
    });

  // ===== PASSWORD VISIBILITY TOGGLE =====
  window.togglePw = function (id) {
    const el = document.getElementById(id);
    if (el) el.type = el.type === "password" ? "text" : "password";
  };

  // ===== HELPERS (defined at top of script) =====
</script>

<style>
  .default-resume-active-box {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: var(--color-surface-hover);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1rem 1.25rem;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .resume-meta-info {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .resume-badge-icon {
    width: 42px;
    height: 42px;
    border-radius: var(--border-radius-sm);
    background: rgba(16, 185, 129, 0.12);
    color: #10b981;

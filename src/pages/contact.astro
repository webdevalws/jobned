---
import Layout from '../layouts/Layout.astro';

const lastUpdated = "September 18, 2026";
---

<Layout
  title="Contact Us - JobNed Support & Merchant Inquiries"
  description="Get in touch with the JobNed team for support, employer enterprise hiring, billing queries, and platform assistance."
  keywords="contact JobNed, JobNed customer support, employer recruitment help, billing support, JobNed office"
  schemaType="Organization"
>
  <!-- Landing Navigation -->
  <header class="landing-nav">
    <div class="nav-container">
      <div class="logo">
        <a href="/" style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="logo-icon">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline>
            <line x1="12" y1="22.08" x2="12" y2="12"></line>
          </svg>
          <span class="logo-text">Job<span class="highlight">Ned</span></span>
        </a>
      </div>
      <nav class="nav-links">
        <a href="/">Home</a>
        <a href="/jobs">Find Jobs</a>
        <a href="/pricing">Pricing</a>
        <a href="/about">About</a>
        <a href="/contact" class="active">Contact</a>
      </nav>
      <div class="nav-actions">
        <button type="button" class="theme-toggle-btn" aria-label="Toggle Light/Dark Theme" title="Toggle Light/Dark Theme">
          <svg class="sun-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
          <svg class="moon-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
        </button>
        <a href="/login" class="btn btn-outline">Sign In</a>
      </div>
    </div>
  </header>

  <main class="contact-page-wrapper">
    <div class="contact-container">
      
      <!-- Hero Header -->
      <section class="contact-hero">
        <div class="hero-badge">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
          </svg>
          Direct Support &amp; Customer Care
        </div>
        <h1 class="contact-title">Contact Our Team</h1>
        <p class="contact-subtitle">
          Have questions about your account, payment transactions, AI candidate screening, or employer subscriptions? We are here to help.
        </p>
      </section>

      <!-- Main Grid: Info + Contact Form -->
      <div class="contact-grid">
        
        <!-- Left Side: Official Contact Cards & Operating Details -->
        <div class="contact-info-column">
          
          <div class="info-card highlight-card">
            <div class="card-icon-header">
              <div class="icon-circle">🏢</div>
              <div>
                <h3>Company &amp; Registered Office</h3>
                <p class="entity-sub">Official Merchant &amp; Platform Entity</p>
              </div>
            </div>
            <div class="card-body-text">
              <p><strong>JobNed</strong></p>
              <p class="addr-line">Operated by RecruitNest Technologies Private Limited</p>
              <p class="addr-line">#402, 4th Floor, Tech Hub Tower, Outer Ring Road</p>
              <p class="addr-line">Marathahalli - Bellandur Corridor, Bengaluru, Karnataka 560103, India</p>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon-header">
              <div class="icon-circle">✉️</div>
              <div>
                <h3>Email Support Directory</h3>
                <p class="entity-sub">24–48 Business Hours Turnaround</p>
              </div>
            </div>
            <div class="contact-channels">
              <div class="channel-row">
                <span class="channel-label">General &amp; User Support:</span>
                <a href="mailto:support@jobned.com" class="channel-link">support@jobned.com</a>
              </div>
              <div class="channel-row">
                <span class="channel-label">Billing &amp; Payment Inquiries:</span>
                <a href="mailto:billing@jobned.com" class="channel-link">billing@jobned.com</a>
              </div>
              <div class="channel-row">
                <span class="channel-label">Legal &amp; Grievance Officer:</span>
                <a href="mailto:grievance@jobned.com" class="channel-link">grievance@jobned.com</a>
              </div>
            </div>
          </div>

          <div class="info-card">
            <div class="card-icon-header">
              <div class="icon-circle">⏱️</div>
              <div>
                <h3>Operating Hours &amp; Phone</h3>
                <p class="entity-sub">Dedicated Customer Desk</p>
              </div>
            </div>
            <div class="schedule-details">
              <div class="schedule-item">
                <span class="day">Support Desk Helpline:</span>
                <span class="time font-bold">+91 80 4965 2300 / +91 98765 43210</span>
              </div>
              <div class="schedule-item">
                <span class="day">Monday &ndash; Friday:</span>
                <span class="time">9:00 AM &ndash; 6:00 PM IST</span>
              </div>
              <div class="schedule-item">
                <span class="day">Saturday:</span>
                <span class="time">10:00 AM &ndash; 2:00 PM IST</span>
              </div>
              <div class="schedule-item">
                <span class="day">Sunday &amp; Public Holidays:</span>
                <span class="time text-muted">Closed (Email monitored for critical issues)</span>
              </div>
            </div>
          </div>

          <!-- Razorpay Compliance Quick Links -->
          <div class="info-card policy-quick-card">
            <h4>Quick Compliance Links</h4>
            <div class="compliance-links">
              <a href="/terms" class="comp-badge">Terms &amp; Conditions &rarr;</a>
              <a href="/refund-policy" class="comp-badge">Cancellation &amp; Refund Policy &rarr;</a>
              <a href="/privacy" class="comp-badge">Privacy Policy &rarr;</a>
              <a href="/pricing" class="comp-badge">Subscription Pricing &rarr;</a>
            </div>
          </div>

        </div>

        <!-- Right Side: Interactive Inquiry Form -->
        <div class="contact-form-column">
          <div class="form-container-card">
            <div class="form-header">
              <h2>Send Us a Message</h2>
              <p>Fill out the form below and our customer support team will reply within 24 hours.</p>
            </div>

            <form id="contactUsForm" class="contact-form" onsubmit="return false;">
              <div class="form-row">
                <div class="form-group">
                  <label for="fullName">Full Name <span class="req">*</span></label>
                  <input type="text" id="fullName" name="fullName" placeholder="e.g. John Doe" required class="form-input" />
                </div>
                <div class="form-group">
                  <label for="emailAddress">Email Address <span class="req">*</span></label>
                  <input type="email" id="emailAddress" name="emailAddress" placeholder="you@example.com" required class="form-input" />
                </div>
              </div>

              <div class="form-row">
                <div class="form-group">
                  <label for="phone">Phone Number (Optional)</label>
                  <input type="tel" id="phone" name="phone" placeholder="+91 98765 43210" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="category">Inquiry Subject / Topic <span class="req">*</span></label>
                  <select id="category" name="category" required class="form-input form-select">
                    <option value="" disabled selected>Select an inquiry category</option>
                    <option value="billing">Billing, Invoices &amp; Razorpay Payment</option>
                    <option value="employer">Employer Account &amp; Job Posting</option>
                    <option value="candidate">Candidate Profile &amp; Applications</option>
                    <option value="ai-screening">AI Screening &amp; Technical Tools</option>
                    <option value="partnership">Partnership &amp; Enterprise Hiring</option>
                    <option value="general">Other / General Feedback</option>
                  </select>
                </div>
              </div>

              <div class="form-group">
                <label for="orderId">Order / Transaction ID (If related to payment)</label>
                <input type="text" id="orderId" name="orderId" placeholder="e.g. rzp_pay_..., order_..." class="form-input" />
              </div>

              <div class="form-group">
                <label for="message">Detailed Message <span class="req">*</span></label>
                <textarea id="message" name="message" rows="5" placeholder="Please provide details regarding your inquiry..." required class="form-input form-textarea"></textarea>
              </div>

              <div class="form-disclaimer">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                <span>By submitting, you agree to our <a href="/terms">Terms</a> and <a href="/privacy">Privacy Policy</a>. Your details are securely transmitted.</span>
              </div>

              <button type="submit" id="submitContactBtn" class="btn btn-primary submit-btn">
                <span class="btn-text">Submit Message</span>
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="arrow-icon"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              </button>

              <div id="formSuccessAlert" class="success-alert" style="display: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <div>
                  <strong>Message Sent Successfully!</strong>
                  <p>Thank you for reaching out. Ticket reference ID: <span id="ticketIdDisplay" class="font-mono">#JN-8492</span>. Our team will contact you within 24 business hours.</p>
                </div>
              </div>
            </form>
          </div>
        </div>

      </div>

      <!-- FAQ Section -->
      <section class="contact-faq-section">
        <h2 class="faq-title">Frequently Asked Questions</h2>
        <div class="faq-grid">
          <div class="faq-card">
            <h4>How quickly are employer subscriptions activated?</h4>
            <p>Subscriptions and credits purchased via Razorpay are activated instantly upon successful payment confirmation.</p>
          </div>
          <div class="faq-card">
            <h4>What is the refund policy for paid subscriptions?</h4>
            <p>JobNed follows a strict non-refundable policy for digital SaaS plans once activated. Read our full <a href="/refund-policy">Cancellation &amp; Refund Policy</a>.</p>
          </div>
          <div class="faq-card">
            <h4>Where can I download GST/Tax invoices?</h4>
            <p>Invoices are automatically emailed to your registered billing email and can be retrieved from your Employer Dashboard under Settings &gt; Billing.</p>
          </div>
          <div class="faq-card">
            <h4>How do I report technical difficulties?</h4>
            <p>Select "Technical Support" in the form above or email us directly at <a href="mailto:support@jobned.com">support@jobned.com</a> with error screenshots.</p>
          </div>
        </div>
      </section>

    </div>
  </main>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactUsForm');
    const submitBtn = document.getElementById('submitContactBtn');
    const successAlert = document.getElementById('formSuccessAlert');
    const ticketIdDisplay = document.getElementById('ticketIdDisplay');

    if (form && submitBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        
        const fullName = document.getElementById('fullName').value.trim();
        const email = document.getElementById('emailAddress').value.trim();
        const category = document.getElementById('category').value;
        const message = document.getElementById('message').value.trim();

        if (!fullName || !email || !category || !message) {
          if (window.showToast) {
            window.showToast('Please fill in all required fields.', 'warning');
          }
          return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = `<span>Sending Message...</span>`;

        setTimeout(() => {
          const randomTicket = 'JN-' + Math.floor(100000 + Math.random() * 900000);
          if (ticketIdDisplay) ticketIdDisplay.textContent = '#' + randomTicket;
          
          if (successAlert) {
            successAlert.style.display = 'flex';
          }
          form.reset();
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span class="btn-text">Send Another Message</span>`;

          if (window.showToast) {
            window.showToast('Message sent! Support ticket created: ' + randomTicket, 'success');
          }
        }, 800);
      });
    }
  });
</script>

<style>
  .landing-nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
  }
  :global([data-theme="light"]) .landing-nav {
    background: rgba(255, 255, 255, 0.85);
  }
  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-links {
    display: flex;
    gap: 1.75rem;
  }
  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.2s;
  }
  .nav-links a:hover, .nav-links a.active {
    color: var(--color-primary);
  }
  .nav-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .contact-page-wrapper {
    min-height: 80vh;
    padding: 3.5rem 1.5rem 5rem 1.5rem;
  }
  .contact-container {
    max-width: 1180px;
    margin: 0 auto;
  }

  .contact-hero {
    text-align: center;
    margin-bottom: 3.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px dashed var(--color-border);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(167, 139, 250, 0.12);
    color: var(--color-primary);
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
  }
  .contact-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .contact-subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.35fr;
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .contact-info-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    padding: 1.5rem;
    transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
  }
  .info-card:hover {
    border-color: rgba(167, 139, 250, 0.3);
    box-shadow: var(--shadow-md);
  }
  .highlight-card {
    border-left: 4px solid var(--color-primary);
  }

  .card-icon-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }
  .icon-circle {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: rgba(167, 139, 250, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.3rem;
  }
  .card-icon-header h3 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text-main);
    margin: 0;
  }
  .entity-sub {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0 0;
  }

  .card-body-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .addr-line {
    margin: 0.2rem 0;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .channel-row {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .channel-label {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }
  .channel-link {
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .channel-link:hover {
    text-decoration: underline;
  }

  .schedule-details {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    font-size: 0.92rem;
  }
  .schedule-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.04);
  }
  :global([data-theme="light"]) .schedule-item {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  .schedule-item .day {
    color: var(--color-text-muted);
  }
  .schedule-item .time {
    color: var(--color-text-main);
    font-weight: 500;
  }
  .font-bold {
    font-weight: 700 !important;
    color: var(--color-primary) !important;
  }

  .policy-quick-card h4 {
    font-size: 0.95rem;
    margin: 0 0 0.85rem 0;
    color: var(--color-text-main);
  }
  .compliance-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.6rem;
  }
  .comp-badge {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    padding: 0.6rem 0.75rem;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--color-text-main);
    text-decoration: none;
    transition: all 0.2s;
  }
  .comp-badge:hover {
    background: rgba(167, 139, 250, 0.12);
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  /* Right Form Card */
  .form-container-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-xl);
    padding: 2.25rem;
    box-shadow: var(--shadow-md);
  }
  .form-header {
    margin-bottom: 1.75rem;
  }
  .form-header h2 {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0 0 0.4rem 0;
  }
  .form-header p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .form-group label {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-main);
  }
  .req {
    color: var(--color-danger);
  }
  .form-input {
    width: 100%;
    padding: 0.8rem 1rem;
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    color: var(--color-text-main);
    font-size: 0.95rem;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  :global([data-theme="light"]) .form-input {
    background: #FFFFFF;
  }
  .form-input:focus {
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(167, 139, 250, 0.2);
  }
  .form-select {
    cursor: pointer;
  }
  .form-textarea {
    resize: vertical;
    min-height: 110px;
  }

  .form-disclaimer {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }
  .form-disclaimer svg {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-primary);
  }
  .form-disclaimer a {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .submit-btn {
    padding: 0.9rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    cursor: pointer;
    border: none;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .submit-btn:hover {
    transform: translateY(-1px);
    box-shadow: var(--shadow-glow);
  }

  .success-alert {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.3);
    border-radius: var(--border-radius-md);
    padding: 1rem 1.25rem;
    color: var(--color-text-main);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .font-mono {
    font-family: monospace;
    background: rgba(255, 255, 255, 0.1);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: #10B981;
    font-weight: bold;
  }

  /* FAQ */
  .contact-faq-section {
    border-top: 1px dashed var(--color-border);
    padding-top: 3.5rem;
  }
  .faq-title {
    text-align: center;
    font-size: 1.85rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin-bottom: 2rem;
  }
  .faq-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;

          <form action="/jobs" method="GET" class="search-box">
            <div class="search-input-group">
              <svg
                class="search-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><circle cx="11" cy="11" r="8"></circle><line
                  x1="21"
                  y1="21"
                  x2="16.65"
                  y2="16.65"></line></svg
              >
              <input
                type="text"
                name="q"
                placeholder="Job title, keywords, or company"
              />
            </div>
            <div class="search-divider"></div>
            <div class="search-input-group">
              <svg
                class="search-icon"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
                ></path><circle cx="12" cy="10" r="3"></circle></svg
              >
              <input type="text" name="location" placeholder="Location" />
            </div>
            <button type="submit" class="btn btn-primary btn-search btn-glow"
              >Search Jobs &rarr;</button
            >
          </form>

          <div class="popular-searches">
            <span class="popular-label">Popular Searches:</span>
            <a href="/jobs?q=UI%2FUX+Designer" class="search-tag">UI/UX Designer</a>
            <a href="/jobs?q=React+Developer" class="search-tag">React Developer</a>
            <a href="/jobs?q=Product+Manager" class="search-tag">Product Manager</a>
            <a href="/jobs?q=Data+Scientist" class="search-tag">Data Scientist</a>
          </div>
        </div>

        <div class="hero-image">
          <div class="animated-hero-graphic">
            <div class="glow-orb orb-1"></div>
            <div class="glow-orb orb-2"></div>

            <div class="glass-dashboard animate-float">
              <div class="dashboard-header reveal-on-scroll">
                <div class="window-controls">
                  <span class="control-dot close"></span>
                  <span class="control-dot minimize"></span>
                  <span class="control-dot maximize"></span>
                </div>
                <div class="dashboard-title text-gradient">AI Match Engine</div>
              </div>

              <div class="dashboard-body">
                <div class="match-ring-container">
                  <svg class="match-ring" viewBox="0 0 100 100">
                    <circle
                      cx="50"
                      cy="50"
                      r="42"
                      fill="none"
                      stroke="rgba(255,255,255,0.05)"
                      stroke-width="8"></circle>
                    <circle
                      cx="50"
                      cy="50"
                      r="42"
                      fill="none"
                      stroke="url(#ringGradient)"
                      stroke-width="8"
                      stroke-dasharray="264"
                      stroke-dashoffset="20"
                      stroke-linecap="round"
                      class="ring-progress"></circle>
                    <defs>
                      <linearGradient
                        id="ringGradient"
                        x1="0%"
                        y1="0%"
                        x2="100%"
                        y2="100%"

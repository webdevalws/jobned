  .trusted-by {
    padding: 3rem 2rem 5rem;
    text-align: center;
    background: var(--color-bg);
  }
  .trusted-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #9ca3af;
    margin: 0 0 2rem 0;
  }
  .marquee-wrapper {
    overflow: hidden;
    position: relative;
    width: 100%;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 15%,
      black 85%,
      transparent
    );
  }
  .trusted-logos.marquee {
    display: flex;
    align-items: center;
    gap: 3.5rem;
    color: #9ca3af;
    font-size: 1.5rem;
    font-weight: 700;
    opacity: 0.5;
    width: max-content;
    white-space: nowrap;
    flex-wrap: nowrap;
    animation: scroll-left 25s linear infinite;
  }
  .trusted-logos.marquee span {
    white-space: nowrap;
    word-break: normal;
    overflow-wrap: normal;
    flex-shrink: 0;
  }
  @keyframes scroll-left {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }
  .dot-separator {
    font-size: 0.5rem;
  }

  /* How It Works */
  .how-it-works {
    padding: 6rem 2rem;
    background: var(--color-surface);
  }
  .steps-grid {
    max-width: 1000px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }
  .step-card {
    text-align: center;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .step-card:hover {
    transform: translateY(-10px);
  }
  .step-number {
    width: 60px;
    height: 60px;
    background: rgba(167, 139, 250, 0.1);
    color: var(--color-primary);
    font-size: 1.5rem;
    font-weight: 700;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
    transition: all 0.3s ease;
  }
  .step-card:hover .step-number {
    background: var(--color-primary);
    color: white;
    transform: scale(1.1);
    box-shadow: 0 10px 25px rgba(167, 139, 250, 0.4);
  }
  .step-card h3 {
    font-size: 1.25rem;
    margin: 0 0 0.75rem 0;
  }
  .step-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Bento Features */
  .bento-features {
    padding: 8rem 2rem;
    background: var(--color-bg);
    overflow: hidden;
  }
  .bento-badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    background: rgba(167, 139, 250, 0.1);
    color: var(--color-primary);
    border: 1px solid rgba(167, 139, 250, 0.3);
    border-radius: 2rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1rem;
  }
  .bento-grid {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }
  .bento-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.5rem;
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition:
      transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275),
      box-shadow 0.4s ease,
      border-color 0.4s ease;
  }
  .bento-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px -12px rgba(167, 139, 250, 0.15);
    border-color: rgba(167, 139, 250, 0.4);
  }

  /* Gradient Hover Effect overlay */
  .bento-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(167, 139, 250, 0.15),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    z-index: 1;
  }
  .bento-card:hover::before {
    opacity: 1;
  }

  .bento-large {
    grid-column: span 2;
    grid-row: span 2;
    flex-direction: row;
    gap: 2rem;
    align-items: center;
  }
  .bento-wide {
    grid-column: span 2;
    flex-direction: row;
    align-items: center;
    gap: 2rem;
  }
  .bento-small {
    grid-column: span 1;
  }

  .bento-content {
    flex: 1;
    z-index: 2;
  }

  .bento-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: rgba(167, 139, 250, 0.1);
    color: var(--color-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    border: 1px solid rgba(167, 139, 250, 0.2);
  }
  .bento-icon-wrapper.blue {
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border-color: rgba(59, 130, 246, 0.2);
  }
  .bento-icon-wrapper.green {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.2);
  }
  .bento-icon-wrapper.orange {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border-color: rgba(245, 158, 11, 0.2);
  }

  .bento-card h3 {
    font-size: 1.5rem;
    margin: 0 0 1rem 0;
    color: var(--color-text-main);
  }
  .bento-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0;
    font-size: 0.95rem;
  }

  .bento-visual {
    flex: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    z-index: 2;
  }

  .mock-ui {
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 1rem;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    width: 100%;
    max-width: 250px;
    box-shadow: 0 10px 30px -10px rgba(0, 0, 0, 0.5);
  }
  .mock-ring {
    width: 100px;
    height: 100px;
  }
  .circular-chart {
    display: block;
    margin: 0 auto;
    max-width: 80%;
    max-height: 250px;
  }
  .circle-bg {
    fill: none;
    stroke: rgba(255, 255, 255, 0.05);
    stroke-width: 2.5;
  }
  .circle {
    fill: none;
    stroke-width: 2.5;
    stroke-linecap: round;
    animation: progress 2s ease-out forwards;
    stroke: var(--color-primary);
  }
  @keyframes progress {
    0% {
      stroke-dasharray: 0 100;
    }
  }
  .percentage {
    fill: white;
    font-family: sans-serif;
    font-size: 0.5em;
    text-anchor: middle;
    font-weight: bold;
  }

  .mock-lines {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .ml-line {
    height: 6px;
    border-radius: 3px;
  }

  .mock-btn {
    background: var(--color-primary);
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 2rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
    box-shadow: 0 0 20px rgba(167, 139, 250, 0.4);
    animation: pulse-dot-anim 2s infinite;
  }

  @media (max-width: 900px) {
    .bento-large,
    .bento-wide {
      grid-column: span 3;
      flex-direction: column;
      text-align: center;
    }
    .bento-small {
      grid-column: span 3;
      text-align: center;
    }
    .bento-visual {
      justify-content: center;
      width: 100%;
      margin-top: 2rem;
    }
    .bento-icon-wrapper {
      margin: 0 auto 1.25rem;
    }
  }

  /* Testimonials */
  .testimonials {
    padding: 6rem 2rem;
    background: var(--color-surface);
  }
  .testimonials-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .testimonial-card {
    background: var(--color-surface);
    backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    padding: 2rem;
    border-radius: 1rem;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }
  .testimonial-card:hover {
    transform: translateY(-8px);
    border-color: var(--color-primary);
    box-shadow: 0 12px 30px rgba(167, 139, 250, 0.15);
  }
  .stars {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    letter-spacing: 2px;
  }
  .quote {
    color: var(--color-text-main);
    font-size: 1.05rem;
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
    flex: 1;
    font-style: italic;
  }
  .author {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .author-avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
  }
  .author-info {
    display: flex;
    flex-direction: column;
  }
  .author-info strong {
    font-size: 0.95rem;
  }
  .author-info span {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  /* CTA Section */
  .bottom-cta {
    padding: 6rem 2rem;
    text-align: center;
    border-top: 1px solid var(--color-border);
    position: relative;
    overflow: hidden;
    background: linear-gradient(45deg, #7c3aed, #2563eb, #ec4899);
    background-size: 200% 200%;
    animation: gradient-shift 10s ease infinite;
  }
  @keyframes gradient-shift {
    0% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
    100% {
      background-position: 0% 50%;
    }
  }
  .cta-content {
    max-width: 600px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }
  .cta-content h2 {
    font-size: 2.5rem;
    color: #ffffff;
    margin: 0 0 1rem 0;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
  }
  .cta-content p {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 2rem 0;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }
  .bottom-cta .btn-primary {
    background: #ffffff;
    color: #7c3aed;
  }
  .bottom-cta .btn-primary:hover {
    box-shadow: 0 10px 25px rgba(255, 255, 255, 0.4);
  }
  .bottom-cta .btn-outline {
    border-color: rgba(255, 255, 255, 0.5);
    color: #ffffff !important;
    background: transparent !important;
  }
  .bottom-cta .btn-outline:hover {
    background: rgba(255, 255, 255, 0.1) !important;
    border-color: #ffffff;
  }

  /* LIGHT MODE ENHANCEMENTS */
  html[data-theme="light"] body {
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 100%);
  }
  html[data-theme="light"] .hero {
    background:
      radial-gradient(
        circle at top right,
        rgba(167, 139, 250, 0.1),
        transparent 50%
      ),
      radial-gradient(
        circle at bottom left,
        rgba(96, 165, 250, 0.1),
        transparent 50%
      ),
      #ffffff;
  }
  html[data-theme="light"] .glass-dashboard {
    background: rgba(255, 255, 255, 0.7);
    box-shadow:
      0 25px 50px -12px rgba(124, 58, 237, 0.15),
      0 0 0 1px rgba(0, 0, 0, 0.05);
  }
  html[data-theme="light"] .dashboard-header {
    background: rgba(255, 255, 255, 0.5);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  html[data-theme="light"] .match-ring circle[stroke="rgba(255,255,255,0.05)"] {
    stroke: rgba(0, 0, 0, 0.05) !important;
  }
  html[data-theme="light"] .dashboard-footer {
    background: rgba(0, 0, 0, 0.02);
    border-top: 1px solid rgba(0, 0, 0, 0.05);
  }
  html[data-theme="light"] .stat-bar {
    background: rgba(0, 0, 0, 0.05);
  }
  html[data-theme="light"] .mock-ui {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
  }
  html[data-theme="light"] .circle-bg {
    stroke: #e2e8f0;
  }
  html[data-theme="light"] .circle {
    stroke: #7c3aed;
  }
  html[data-theme="light"] .percentage {
    fill: #0f172a;
    font-weight: 800;
  }
  html[data-theme="light"] .mock-btn {
    background: #7c3aed;
    color: #ffffff;
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
  }
  html[data-theme="light"] .interactive-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    box-shadow: 0 25px 50px -12px rgba(124, 58, 237, 0.15);
  }
  html[data-theme="light"] .how-it-works {
    background: #f1f5f9;
  }
  html[data-theme="light"] .step-card {
    background: #ffffff;
    padding: 2.25rem 1.75rem;
    border-radius: 1.5rem;
    border: 1px solid #cbd5e1;
    box-shadow:
      0 10px 25px -5px rgba(15, 23, 42, 0.07),
      0 4px 6px -2px rgba(15, 23, 42, 0.03);
  }
  html[data-theme="light"] .step-number {
    background: linear-gradient(135deg, #ede9fe 0%, #ddd6fe 100%);
    color: #6d28d9;
    border: 1px solid #c4b5fd;
    box-shadow: 0 4px 12px rgba(109, 40, 217, 0.15);
    font-weight: 800;
  }
  html[data-theme="light"] .bento-features {
    background: #f8fafc;
  }
  html[data-theme="light"] .bento-badge {
    background: #ede9fe;
    color: #6d28d9;
    border: 1px solid #c4b5fd;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(109, 40, 217, 0.08);
  }
  html[data-theme="light"] .bento-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    box-shadow:
      0 10px 25px -5px rgba(15, 23, 42, 0.07),
      0 4px 6px -2px rgba(15, 23, 42, 0.03);
  }
  html[data-theme="light"] .bento-icon-wrapper {
    background: #ede9fe !important;
    color: #6d28d9 !important;
    border: 1px solid #c4b5fd !important;
    box-shadow: 0 2px 8px rgba(109, 40, 217, 0.12);
  }
  html[data-theme="light"] .bento-icon-wrapper.blue {
    background: #dbeafe !important;
    color: #1d4ed8 !important;
    border: 1px solid #93c5fd !important;
    box-shadow: 0 2px 8px rgba(29, 78, 216, 0.12);
  }
  html[data-theme="light"] .bento-icon-wrapper.green {
    background: #d1fae5 !important;
    color: #047857 !important;
    border: 1px solid #6ee7b7 !important;
    box-shadow: 0 2px 8px rgba(4, 120, 87, 0.12);
  }
  html[data-theme="light"] .bento-icon-wrapper.orange {
    background: #fef3c7 !important;
    color: #b45309 !important;
    border: 1px solid #fcd34d !important;
    box-shadow: 0 2px 8px rgba(180, 83, 9, 0.12);
  }
  html[data-theme="light"] .bento-card h3,
  html[data-theme="light"] .step-card h3,
  html[data-theme="light"] .section-header h2 {
    color: #0f172a !important;
    font-weight: 700;
  }
  html[data-theme="light"] .bento-card p,
  html[data-theme="light"] .step-card p {
    color: #334155 !important;
    font-weight: 450;
    line-height: 1.6;
  }
  html[data-theme="light"] .section-header p {
    color: #475569 !important;
    font-weight: 500;
  }
  html[data-theme="light"] .stat-card,
  html[data-theme="light"] .testimonial-card {
    background: #ffffff;
    box-shadow:
      0 10px 25px -5px rgba(15, 23, 42, 0.07),
      0 4px 6px -2px rgba(15, 23, 42, 0.03);
    border: 1px solid #cbd5e1;
  }
  html[data-theme="light"] .bento-card:hover,
  html[data-theme="light"] .stat-card:hover,
  html[data-theme="light"] .step-card:hover,
  html[data-theme="light"] .testimonial-card:hover {
    box-shadow:
      0 20px 35px -10px rgba(124, 58, 237, 0.18),
      0 8px 16px -4px rgba(124, 58, 237, 0.06);
    border-color: #8b5cf6;
  }
  html[data-theme="light"] .search-box {
    background: #ffffff;
    border-color: #cbd5e1;
    box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08);
  }
  html[data-theme="light"] .search-box:hover {
    box-shadow: 0 15px 35px -5px rgba(124, 58, 237, 0.15);
    border-color: rgba(124, 58, 237, 0.4);
  }
  html[data-theme="light"] .stats,
  html[data-theme="light"] .trusted-by {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
  }
  html[data-theme="light"] .interactive-showcase,
  html[data-theme="light"] .testimonials {
    background: #f8fafc;
  }
  html[data-theme="light"] .hero-title {
    color: #0f172a;
  }
  html[data-theme="light"] .ring-bg-circle {
    stroke: rgba(0, 0, 0, 0.05) !important;
  }
  html[data-theme="light"] .score-center-text span {
    color: #0f172a;
  }
  html[data-theme="light"] .ai-insight-box {
    background: rgba(124, 58, 237, 0.03);
    border: 1px solid rgba(124, 58, 237, 0.1);
  }

  @media (max-width: 992px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
      text-align: center;
    }
    .hero-subtitle {
      margin-left: auto;
      margin-right: auto;
    }
    .search-box {
      margin-left: auto;
      margin-right: auto;
    }
    .popular-searches {
      justify-content: center;
      margin-bottom: 2.25rem !important;
    }
    .hero-image {
      justify-content: center;
      margin-top: 1.5rem !important;
      width: 100% !important;
    }
    .animated-hero-graphic {
      height: auto !important;
      min-height: 380px !important;
    }
    .stats-container {
      grid-template-columns: repeat(2, 1fr);
    }
    .steps-grid,
    .testimonials-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }

  .btn-text-mobile { display: none; }
  @media (max-width: 520px) {
    .btn-text-desktop { display: none !important; }
    .btn-text-mobile { display: inline !important; }
  }

  @media (max-width: 640px) {
    .hero {
      padding: 3rem 0.85rem 2rem !important;
    }
    .hero-title {
      font-size: clamp(1.75rem, 6.5vw, 2.5rem) !important;
      line-height: 1.25 !important;
      word-break: break-word !important;
      overflow-wrap: break-word !important;
    }
    .search-box {
      flex-direction: column !important;
      border-radius: 1.25rem !important;
      padding: 0.65rem !important;
      gap: 0.5rem !important;
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .popular-searches {
      margin-bottom: 2rem !important;
      gap: 0.45rem !important;
    }
    .hero-image {
      margin-top: 1.75rem !important;
      clear: both !important;
    }
    .animated-hero-graphic {
      height: auto !important;
      min-height: 350px !important;
    }
    .search-divider {
      display: none !important;
    }
    .search-input-group {
      width: 100% !important;
      min-width: 0 !important;
      padding: 0.4rem 0.5rem !important;
      box-sizing: border-box !important;
    }
    .search-input-group input {
      width: 100% !important;
      min-width: 0 !important;
    }
    .btn-search {
      width: 100% !important;
      justify-content: center !important;
      border-radius: 0.85rem !important;
    }
    .stats-container {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 0.85rem !important;
    }
    .stat-card {
      flex-direction: column !important;
      align-items: flex-start !important;
      text-align: left !important;
      padding: 1.15rem 1rem !important;
      gap: 0.65rem !important;
      box-sizing: border-box !important;
    }
    .stat-icon-wrapper {
      width: 44px !important;
      height: 44px !important;
      border-radius: 0.65rem !important;
    }
    .stat-icon-wrapper svg {
      width: 20px !important;
      height: 20px !important;
    }
    .stat-info h3 {
      font-size: 1.35rem !important;
      line-height: 1.2 !important;
      margin: 0 0 0.2rem 0 !important;
    }
    .stat-info p {
      font-size: 0.78rem !important;
      line-height: 1.35 !important;
      word-break: normal !important;
      overflow-wrap: normal !important;
      hyphens: none !important;
      color: var(--color-text-muted) !important;
    }
    .marquee-wrapper {
      overflow: hidden !important;
      max-width: 100% !important;
      width: 100% !important;
    }
    .trusted-logos.marquee {
      display: flex !important;
      align-items: center !important;
      gap: 1.5rem !important;
      font-size: 1.1rem !important;
      white-space: nowrap !important;

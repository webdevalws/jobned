---
import { getResumeViewerUrl } from '../../lib/resume-helper';
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { applications, jobPostings, users } from '../../db/schema';
import { eq, desc, and } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || payload.userType !== 'employer') {
  return Astro.redirect('/login');
}

const statusFilter = Astro.url.searchParams.get('status') || '';
const jobFilter = Astro.url.searchParams.get('jobId') || '';

const db = getDb();

// Fetch employer's job postings to populate the job filter dropdown
const employerJobs = await db.select({
  id: jobPostings.id,
  jobTitle: jobPostings.jobTitle,
}).from(jobPostings)
  .where(eq(jobPostings.employerId, payload.userId))
  .orderBy(desc(jobPostings.createdAt))
  .all();

let query = db.select({
  id: applications.id,
  status: applications.status,
  appliedAt: applications.appliedAt,
  jobTitle: jobPostings.jobTitle,
  jobId: jobPostings.id,
  applicantFirstName: users.firstName,
  applicantLastName: users.lastName,
  applicantEmail: users.email,
  resumeUrl: applications.resumeUrl,
  aiScore: applications.aiScore
})
.from(applications)
.innerJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
.innerJoin(users, eq(applications.applicantId, users.id))
.where(eq(applications.employerId, payload.userId));

const allEmployerApps = await query.orderBy(desc(applications.appliedAt)).all();

const jobSpecificApps = jobFilter ? allEmployerApps.filter(a => a.jobId === jobFilter) : allEmployerApps;
const currentJobTitle = jobSpecificApps[0]?.jobTitle || (jobFilter ? 'Selected Job' : '');

// Filter in-memory if query params provided
let filteredApps = jobSpecificApps;
if (statusFilter) {
  filteredApps = filteredApps.filter(a => a.status === statusFilter);
}

const counts = {
  all: jobSpecificApps.length,
  received: jobSpecificApps.filter(a => a.status === 'received').length,
  under_review: jobSpecificApps.filter(a => a.status === 'under_review').length,
  shortlisted: jobSpecificApps.filter(a => a.status === 'shortlisted').length,
  accepted: jobSpecificApps.filter(a => a.status === 'accepted').length,
  rejected: jobSpecificApps.filter(a => a.status === 'rejected').length,
};

const getTabUrl = (status?: string) => {
  const params = new URLSearchParams();
  if (jobFilter) params.set('jobId', jobFilter);
  if (status) params.set('status', status);
  const qs = params.toString();
  return `/employer/applications${qs ? `?${qs}` : ''}`;
};
---

<DashboardLayout title="Applications Management" userType="employer" activePath="/employer/applications">
  <div class="header-content mb-4">
    <div>
      <span class="badge-tag">Recruiter Workspace</span>
      <h1>Received Applications</h1>
      <p class="subtitle">
        {jobFilter ? `Viewing candidates who applied for "${currentJobTitle}"` : 'Review applicant submissions and update candidate hiring stages.'}
      </p>
    </div>
  </div>

  {jobFilter && (
    <div class="active-filter-banner mb-4">
      <div class="active-filter-info">
        <span class="filter-icon">💼</span>
        <span>Filtered by Job: <strong>{currentJobTitle}</strong> ({jobSpecificApps.length} applicants)</span>
      </div>
      <a href="/employer/applications" class="clear-filter-btn" title="View all applications across all jobs">
        ✕ Show All Jobs ({allEmployerApps.length})
      </a>
    </div>
  )}

  <!-- Status Filter Pills Tabs -->
  <div class="filter-tabs mb-4">
    <a href={getTabUrl()} class={`tab-pill ${!statusFilter ? 'active' : ''}`}>
      All Applications <span class="tab-count">{counts.all}</span>
    </a>
    <a href={getTabUrl('received')} class={`tab-pill ${statusFilter === 'received' ? 'active' : ''}`}>
      Received <span class="tab-count">{counts.received}</span>
    </a>
    <a href={getTabUrl('under_review')} class={`tab-pill ${statusFilter === 'under_review' ? 'active' : ''}`}>
      Under Review <span class="tab-count">{counts.under_review}</span>
    </a>
    <a href={getTabUrl('shortlisted')} class={`tab-pill ${statusFilter === 'shortlisted' ? 'active' : ''}`}>
      Shortlisted <span class="tab-count">{counts.shortlisted}</span>
    </a>
    <a href={getTabUrl('accepted')} class={`tab-pill ${statusFilter === 'accepted' ? 'active' : ''}`}>
      Hired / Accepted <span class="tab-count">{counts.accepted}</span>
    </a>
    <a href={getTabUrl('rejected')} class={`tab-pill ${statusFilter === 'rejected' ? 'active' : ''}`}>
      Rejected <span class="tab-count">{counts.rejected}</span>
    </a>
  </div>

  <!-- Search, Filter & Sorting Bar -->
  <div class="controls-toolbar-card mb-4">
    <div class="controls-row">
      <!-- Search Input -->
      <div class="control-group">
        <label for="applicantSearchInput" class="control-label">Search Candidates:</label>
        <div class="search-input-box">
          <span class="control-icon">🔍</span>
          <input 
            type="text" 
            id="applicantSearchInput" 
            class="control-input" 
            placeholder="Search by name, email, or role..." 
          />
        </div>
      </div>

      <!-- Filter by Role -->
      <div class="control-group">
        <label for="filterRoleSelect" class="control-label">Filter Role:</label>
        <select id="filterRoleSelect" class="control-select">
          <option value="all">All Jobs ({employerJobs.length})</option>
          {employerJobs.map(j => (
            <option value={j.id} selected={jobFilter === j.id}>{j.jobTitle}</option>
          ))}
        </select>
      </div>

      <!-- Sort Options -->
      <div class="control-group">
        <label for="sortSelect" class="control-label">Sort By:</label>
        <select id="sortSelect" class="control-select sort-select">
          <option value="date-desc">📅 Date: Newest First</option>
          <option value="date-asc">⏳ Date: Oldest First</option>
          <option value="name-asc">👤 Name: A to Z</option>
          <option value="name-desc">👤 Name: Z to A</option>
        </select>
      </div>
    </div>

    <!-- Active Summary & Reset Toolbar -->
    <div class="toolbar-footer">
      <span class="results-count-txt">
        Showing <strong id="visibleAppsCount">{filteredApps.length}</strong> of {allEmployerApps.length} applicants
      </span>
      <div class="toolbar-right-btns">
        <button type="button" id="bulkSelectVisibleBtn" class="btn-select-all-toolbar" title="Select / Deselect all visible applicants">
          ☑️ Select Filtered (<span id="selectFilteredCount">{filteredApps.length}</span>)
        </button>
        <button type="button" id="resetFiltersBtn" class="btn-reset-toolbar">
          🔄 Reset Filters
        </button>
      </div>
    </div>
  </div>

  <div class="applications-container">
    {allEmployerApps.length === 0 ? (
      <div class="empty-state">
        <div class="empty-icon">📂</div>
        <h3>No applications received yet</h3>
        <p>No candidates have applied to your active job postings yet.</p>
      </div>
    ) : (
      <div class="table-responsive">
        <table class="data-table" id="applications-table">
          <thead>
            <tr>
              <th class="col-checkbox" style="width: 46px; text-align: center;">
                <input type="checkbox" id="selectAllCheckbox" title="Select/Deselect All Visible Candidates" class="app-custom-checkbox" />
              </th>
              <th data-sort-col="name" style="cursor: pointer;" title="Click to Sort by Applicant Name">Applicant Name ↕️</th>
              <th>Applied Role</th>
              <th>Status</th>
              <th data-sort-col="date" style="cursor: pointer;" title="Click to Sort by Submitted Date">Submitted Date ↕️</th>
              <th class="col-actions">Actions</th>
            </tr>
          </thead>
          <tbody id="applicationsTbody">
            {allEmployerApps.map((app) => {
              const appName = `${app.applicantFirstName || ''} ${app.applicantLastName || ''}`.trim();
              const dateTs = app.appliedAt ? new Date(app.appliedAt).getTime() : 0;
              const formattedDate = app.appliedAt ? new Date(app.appliedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';

              return (
                <tr 
                  class="app-row"
                  data-id={app.id}
                  data-name={appName.toLowerCase()}
                  data-email={(app.applicantEmail || '').toLowerCase()}
                  data-job-id={app.jobId}
                  data-job-title={(app.jobTitle || '').toLowerCase()}
                  data-status={app.status}
                  data-date-ts={dateTs}
                >
                  <td class="col-checkbox" style="width: 46px; text-align: center;">
                    <input 
                      type="checkbox" 
                      class="app-row-checkbox app-custom-checkbox" 
                      data-id={app.id} 
                      data-name={appName} 
                      data-email={app.applicantEmail || ''} 
                      data-job={app.jobTitle || ''} 
                      title={`Select ${appName}`}
                    />
                  </td>
                  <td class="col-applicant">
                    <div class="applicant-cell">
                      <div class="applicant-avatar">
                        {(app.applicantFirstName?.[0] || 'C').toUpperCase()}
                      </div>
                      <div>
                        <strong class="applicant-name">{appName}</strong>
                        <span class="applicant-email">{app.applicantEmail}</span>
                      </div>
                    </div>
                  </td>
                  <td class="col-role">
                    <span class="job-role-text">💼 {app.jobTitle}</span>
                  </td>
                  <td class="col-status">
                    <span class={`status-pill status-${app.status}`}>
                      {app.status.replace('_', ' ').toUpperCase()}
                    </span>
                  </td>
                  <td class="col-date">
                    <span class="date-text">
                      📅 {formattedDate}
                    </span>
                  </td>
                  <td class="col-actions">
                    <div class="mobile-footer-line">
                      <span class="mobile-date-val">
                        📅 {formattedDate}
                      </span>
                    </div>
                    <div class="actions">
                      {app.resumeUrl && (
                        <a href={getResumeViewerUrl(app.resumeUrl, Astro.url.origin)} target="_blank" class="btn-action-icon" title="View Resume PDF">
                          <svg class="icon-sm" width="18" height="18" style="width: 18px; height: 18px; display: block; flex-shrink: 0;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                        </a>
                      )}
                      <a
                        href={`/employer/interviews?appId=${app.id}&action=schedule`}
                        class="btn btn-outline btn-sm btn-schedule"
                        title="Schedule Interview Round"
                      >
                        <span>📅</span> Schedule
                      </a>
                      <a href={`/employer/applications/${app.id}`} class="btn btn-primary btn-sm btn-review" title="View & Review Application">
                        Review &rarr;
                      </a>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
        <div id="noMatchesMsg" class="empty-state" style="display: none; padding: 3rem 1.5rem;">
          <div class="empty-icon">🔍</div>
          <h3>No matching applicants found</h3>
          <p>Try adjusting your search query or role filter.</p>
        </div>
      </div>
    )}
  </div>

  <!-- Floating Bulk Action Toolbar (shows when >= 1 candidate selected) -->
  <div id="bulkActionBar" class="bulk-action-floating-bar" style="display: none;">
    <div class="bulk-floating-content">
      <div class="bulk-count-pill">
        <span class="bulk-badge-dot"></span>
        <span class="bulk-counter-txt"><strong id="selectedAppsCount">0</strong> <span class="txt-long-selected">Candidates </span>Selected</span>
      </div>
      <div class="bulk-actions-group">
        <button type="button" id="clearSelectionBtn" class="btn btn-sm btn-ghost-light" title="Clear selection">
          ✕ Clear
        </button>
        <button type="button" id="openBulkScheduleModalBtn" class="btn btn-sm btn-primary btn-glow">
          <span class="btn-text-full">⚡ Schedule Bulk Interviews &rarr;</span>
          <span class="btn-text-short">⚡ Schedule &rarr;</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Bulk Interview Scheduling Modal -->
  <div id="bulkScheduleModal" class="modal-backdrop" style="display: none;">
    <div class="modal card modern-bulk-modal">
      <div class="modal-header">
        <div>
          <div class="modal-badge">
            <span class="dot-pulse"></span>
            <span>Bulk Interview Setup</span>
          </div>
          <h2 class="modal-title">Schedule Interviews for Selected Candidates</h2>
          <p class="modal-subtitle">Automatically generate staggered individual slots or a group session and send notifications directly to candidate portals.</p>
        </div>
        <button type="button" class="modal-close" id="closeBulkModalBtn" aria-label="Close modal">✕</button>
      </div>

      <form id="bulkScheduleForm" class="modal-body">
        <!-- Selected Candidates Strip -->
        <div class="form-group mb-3">
          <div class="selected-candidates-header">
            <label class="form-label mb-0">
              <span class="label-text">Selected Students (<span id="modalSelectedCount">0</span>)</span>
            </label>
            <span class="label-hint">All selected students will be scheduled &amp; notified</span>
          </div>
          <div id="selectedCandidatesChips" class="selected-candidates-chips-wrap">
            <!-- Populated via JS -->
          </div>
        </div>

        <!-- Interview Title & Format -->
        <div class="form-grid-2 mb-3">
          <div class="form-group">
            <label for="bulkFormTitle" class="form-label">
              <span class="label-text">Interview Title / Round <span class="required">*</span></span>
            </label>
            <input
              type="text"
              id="bulkFormTitle"
              class="form-input"
              placeholder="e.g. Round 1 Technical Screening"
              value="Round 1 Technical Screening"
              required
            />
          </div>

          <div class="form-group">
            <label for="bulkFormType" class="form-label">
              <span class="label-text">Interview Format <span class="required">*</span></span>
            </label>
            <select id="bulkFormType" class="form-select" required>
              <option value="video" selected>Video Call (Google Meet / Zoom)</option>
              <option value="phone">Phone Screening</option>
              <option value="in_person">In-Person Onsite Round</option>
            </select>
          </div>
        </div>

        <!-- Meeting Link / Location -->
        <div class="form-group mb-3">
          <label for="bulkFormMeetingLink" class="form-label">
            <span class="label-text">Meeting Link or Location Address</span>
            <span class="label-hint">Google Meet URL, Zoom link, or Office Room #</span>
          </label>
          <input
            type="text"
            id="bulkFormMeetingLink"
            class="form-input"
            placeholder="https://meet.google.com/xyz-abcd-efg or Corporate HQ Room 302"
          />
        </div>

        <!-- Date & Slot Timing Options -->
        <div class="form-grid-2 mb-3">
          <div class="form-group">
            <label for="bulkFormStartAt" class="form-label">
              <span class="label-text">Start Date &amp; Time <span class="required">*</span></span>
            </label>
            <input
              type="datetime-local"
              id="bulkFormStartAt"
              class="form-input"
              required
            />
          </div>

          <div class="form-group">
            <label for="bulkFormDuration" class="form-label">
              <span class="label-text">Duration per Candidate <span class="required">*</span></span>
            </label>
            <select id="bulkFormDuration" class="form-select" required>
              <option value="15">15 Minutes</option>
              <option value="30" selected>30 Minutes</option>
              <option value="45">45 Minutes</option>
              <option value="60">60 Minutes (1 Hour)</option>
              <option value="90">90 Minutes</option>
            </select>
          </div>
        </div>

        <!-- Scheduling Strategy: Staggered vs Group -->
        <div class="scheduling-strategy-box mb-3">
          <label class="form-label mb-2">
            <span class="label-text">Scheduling Strategy</span>
          </label>
          <div class="strategy-radios-grid">
            <label class="strategy-option-card active" id="strategyCardStaggered">
              <input type="radio" name="bulkSlotMode" value="staggered" checked />
              <div class="strategy-card-inner">
                <span class="strategy-icon">⏱️</span>
                <div>
                  <strong>Staggered Individual Slots</strong>
                  <p>Each student gets their own consecutive time slot automatically (e.g. 10:00, 10:35, 11:10).</p>
                </div>
              </div>
            </label>
            <label class="strategy-option-card" id="strategyCardGroup">
              <input type="radio" name="bulkSlotMode" value="group" />
              <div class="strategy-card-inner">
                <span class="strategy-icon">👥</span>
                <div>
                  <strong>Group / Batch Session</strong>
                  <p>All students attend together at the same start time (e.g. Group Discussion or Orientation).</p>
                </div>
              </div>
            </label>
          </div>
        </div>

        <!-- Buffer between consecutive slots & Interviewer Name -->
        <div class="form-grid-2 mb-3" id="bufferConfigRow">
          <div class="form-group" id="bufferSelectGroup">
            <label for="bulkFormBuffer" class="form-label">
              <span class="label-text">Break Between Candidates</span>
            </label>
            <select id="bulkFormBuffer" class="form-select">
              <option value="0">No Break (0 mins)</option>
              <option value="5" selected>5 Minutes Break</option>
              <option value="10">10 Minutes Break</option>
              <option value="15">15 Minutes Break</option>
            </select>
          </div>

          <div class="form-group">
            <label for="bulkFormInterviewer" class="form-label">
              <span class="label-text">Interviewer Name(s) <span class="label-optional">(Optional)</span></span>
            </label>
            <input
              type="text"
              id="bulkFormInterviewer"
              class="form-input"
              placeholder="e.g. Sarah &amp; David (Hiring Team)"
            />
          </div>
        </div>

        <!-- Notes / Preparation Instructions -->
        <div class="form-group mb-3">
          <label for="bulkFormNotes" class="form-label">
            <span class="label-text">Interview Notes &amp; Instructions <span class="label-optional">(Optional)</span></span>
          </label>
          <textarea
            id="bulkFormNotes"
            class="form-textarea"
            rows="2"
            placeholder="e.g. Please ensure you have a working camera and microphone. Keep your portfolio and resume ready."
          ></textarea>
        </div>

        <!-- Live Generated Schedule Preview Box -->
        <div class="schedule-preview-card mb-3">
          <div class="schedule-preview-header">
            <div>
              <strong>🗓️ Live Schedule Timeline Preview</strong>
              <span class="preview-sub" id="previewTimeSpan">0 slots generated</span>
            </div>
            <span class="preview-badge-pill" id="previewModeBadge">⏱️ Staggered Consecutive</span>
          </div>
          <div id="schedulePreviewList" class="schedule-preview-items">
            <!-- Dynamically calculated time slots -->
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" id="cancelBulkModalBtn">Cancel</button>
          <button type="submit" class="btn btn-primary btn-glow" id="submitBulkScheduleBtn">
            <span>Confirm & Schedule (<span id="submitCountTxt">0</span>) Interviews 🚀</span>
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<!-- Client-side Interactive Filter & Sorting Logic -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('applicantSearchInput');
    const roleSelect = document.getElementById('filterRoleSelect');
    const sortSelect = document.getElementById('sortSelect');
    const resetBtn = document.getElementById('resetFiltersBtn');
    const visibleCountEl = document.getElementById('visibleAppsCount');
    const tbody = document.getElementById('applicationsTbody');
    const noMatchesMsg = document.getElementById('noMatchesMsg');

    if (!tbody) return;

    const allRows = Array.from(tbody.querySelectorAll('.app-row'));

    // Apply filtering and sorting dynamically
    function updateList() {
      const q = (searchInput?.value || '').toLowerCase().trim();
      const selectedRole = roleSelect?.value || 'all';
      const selectedSort = sortSelect?.value || 'date-desc';

      let visibleRows = [];

      allRows.forEach(row => {
        const name = row.getAttribute('data-name') || '';
        const email = row.getAttribute('data-email') || '';
        const role = row.getAttribute('data-job-title') || '';
        const jobId = row.getAttribute('data-job-id') || '';

        // 1. Text Search Filter
        const matchesSearch = !q || name.includes(q) || email.includes(q) || role.includes(q);

        // 2. Role Filter
        const matchesRole = selectedRole === 'all' || jobId === selectedRole;

        if (matchesSearch && matchesRole) {
          row.style.display = '';
          visibleRows.push(row);
        } else {
          row.style.display = 'none';
        }
      });

      // Sort visible rows
      visibleRows.sort((a, b) => {
        const dateA = parseInt(a.getAttribute('data-date-ts') || '0', 10);
        const dateB = parseInt(b.getAttribute('data-date-ts') || '0', 10);
        const nameA = a.getAttribute('data-name') || '';
        const nameB = b.getAttribute('data-name') || '';

        switch (selectedSort) {
          case 'date-desc':
            return dateB - dateA;
          case 'date-asc':
            return dateA - dateB;
          case 'name-asc':
            return nameA.localeCompare(nameB);
          case 'name-desc':
            return nameB.localeCompare(nameA);
          default:
            return dateB - dateA;
        }
      });

      // Re-append sorted rows into tbody
      visibleRows.forEach(r => tbody.appendChild(r));

      // Update counter & empty state
      if (visibleCountEl) visibleCountEl.textContent = visibleRows.length;
      if (noMatchesMsg) {
        noMatchesMsg.style.display = visibleRows.length === 0 && allRows.length > 0 ? 'block' : 'none';
      }
    }

    // Attach listeners
    searchInput?.addEventListener('input', updateList);
    roleSelect?.addEventListener('change', updateList);
    sortSelect?.addEventListener('change', updateList);

    // Header click sorting
    const tableHeaderCols = document.querySelectorAll('th[data-sort-col]');
    tableHeaderCols.forEach(th => {
      th.addEventListener('click', () => {
        const col = th.getAttribute('data-sort-col');
        if (col === 'date') {
          sortSelect.value = sortSelect.value === 'date-desc' ? 'date-asc' : 'date-desc';
        } else if (col === 'name') {
          sortSelect.value = sortSelect.value === 'name-asc' ? 'name-desc' : 'name-asc';
        }
        updateList();
      });
    });

    // Reset filters
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      if (roleSelect) roleSelect.value = 'all';
      if (sortSelect) sortSelect.value = 'date-desc';
      updateList();
    });

    // -------------------------------------------------------------
    // BULK SELECTION & INTERVIEW SCHEDULING LOGIC
    // -------------------------------------------------------------
    const selectAllCheckbox = document.getElementById('selectAllCheckbox');
    const bulkSelectVisibleBtn = document.getElementById('bulkSelectVisibleBtn');
    const bulkActionBar = document.getElementById('bulkActionBar');
    const selectedAppsCountEl = document.getElementById('selectedAppsCount');
    const clearSelectionBtn = document.getElementById('clearSelectionBtn');
    const openBulkScheduleModalBtn = document.getElementById('openBulkScheduleModalBtn');
    const bulkScheduleModal = document.getElementById('bulkScheduleModal');
    const closeBulkModalBtn = document.getElementById('closeBulkModalBtn');
    const cancelBulkModalBtn = document.getElementById('cancelBulkModalBtn');
    const bulkScheduleForm = document.getElementById('bulkScheduleForm');
    const modalSelectedCountEl = document.getElementById('modalSelectedCount');
    const submitCountTxtEl = document.getElementById('submitCountTxt');
    const selectedCandidatesChipsEl = document.getElementById('selectedCandidatesChips');
    const schedulePreviewListEl = document.getElementById('schedulePreviewList');
    const previewTimeSpanEl = document.getElementById('previewTimeSpan');
    const previewModeBadgeEl = document.getElementById('previewModeBadge');
    const selectFilteredCountEl = document.getElementById('selectFilteredCount');

    // Inputs inside modal
    const bulkFormStartAt = document.getElementById('bulkFormStartAt');
    const bulkFormDuration = document.getElementById('bulkFormDuration');
    const bulkFormBuffer = document.getElementById('bulkFormBuffer');
    const bufferSelectGroup = document.getElementById('bufferSelectGroup');
    const strategyCardStaggered = document.getElementById('strategyCardStaggered');
    const strategyCardGroup = document.getElementById('strategyCardGroup');
    const slotModeRadios = document.querySelectorAll('input[name="bulkSlotMode"]');

    // Default start time to tomorrow at 10:00 AM
    const tomorrow = new Date();
    tomorrow.setDate(tomorrow.getDate() + 1);
    tomorrow.setHours(10, 0, 0, 0);
    const localIsoString = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
    if (bulkFormStartAt) bulkFormStartAt.value = localIsoString;

    // Track selected candidates: id -> { id, name, email, job }
    const selectedCandidates = new Map();

    function updateBulkBar() {
      const count = selectedCandidates.size;
      if (selectedAppsCountEl) selectedAppsCountEl.textContent = count;
      if (modalSelectedCountEl) modalSelectedCountEl.textContent = count;
      if (submitCountTxtEl) submitCountTxtEl.textContent = count;

      const isModalOpen = bulkScheduleModal && bulkScheduleModal.style.display !== 'none';
      if (count > 0 && !isModalOpen) {
        if (bulkActionBar) bulkActionBar.style.display = 'flex';
      } else {
        if (bulkActionBar) bulkActionBar.style.display = 'none';
      }

      // Sync select-all checkbox state based on visible rows
      const visibleCheckboxes = allRows.filter(r => r.style.display !== 'none').map(r => r.querySelector('.app-row-checkbox'));
      const allVisibleChecked = visibleCheckboxes.length > 0 && visibleCheckboxes.every(cb => cb && cb.checked);
      const someVisibleChecked = visibleCheckboxes.some(cb => cb && cb.checked);
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = allVisibleChecked;
        selectAllCheckbox.indeterminate = someVisibleChecked && !allVisibleChecked;
      }
    }

    // Row Checkbox Listeners
    tbody.querySelectorAll('.app-row-checkbox').forEach(cb => {
      cb.addEventListener('change', (e) => {
        const id = cb.getAttribute('data-id');
        const name = cb.getAttribute('data-name');
        const email = cb.getAttribute('data-email');
        const job = cb.getAttribute('data-job');

        if (cb.checked) {
          selectedCandidates.set(id, { id, name, email, job });
        } else {
          selectedCandidates.delete(id);
        }
        updateBulkBar();
      });
    });

    // Master Select All visible checkbox
    selectAllCheckbox?.addEventListener('change', () => {
      const isChecked = selectAllCheckbox.checked;
      allRows.forEach(row => {
        if (row.style.display !== 'none') {
          const cb = row.querySelector('.app-row-checkbox');
          if (cb) {
            cb.checked = isChecked;
            const id = cb.getAttribute('data-id');
            const name = cb.getAttribute('data-name');
            const email = cb.getAttribute('data-email');
            const job = cb.getAttribute('data-job');
            if (isChecked) {
              selectedCandidates.set(id, { id, name, email, job });
            } else {
              selectedCandidates.delete(id);
            }
          }
        }
      });
      updateBulkBar();
    });

    // Toolbar "Select Filtered" button
    bulkSelectVisibleBtn?.addEventListener('click', () => {
      const visibleRows = allRows.filter(r => r.style.display !== 'none');
      const allChecked = visibleRows.every(r => {
        const cb = r.querySelector('.app-row-checkbox');
        return cb && cb.checked;
      });

      const targetChecked = !allChecked;
      visibleRows.forEach(row => {
        const cb = row.querySelector('.app-row-checkbox');
        if (cb) {
          cb.checked = targetChecked;
          const id = cb.getAttribute('data-id');
          const name = cb.getAttribute('data-name');
          const email = cb.getAttribute('data-email');
          const job = cb.getAttribute('data-job');
          if (targetChecked) {
            selectedCandidates.set(id, { id, name, email, job });
          } else {
            selectedCandidates.delete(id);
          }
        }
      });
      updateBulkBar();
    });

    // Clear Selection Button
    clearSelectionBtn?.addEventListener('click', () => {
      selectedCandidates.clear();
      tbody.querySelectorAll('.app-row-checkbox').forEach(cb => { cb.checked = false; });
      if (selectAllCheckbox) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      }
      updateBulkBar();
    });

    // Open & Close Modal
    function openBulkModal() {
      if (selectedCandidates.size === 0) return;

      // Populate student preview chips
      if (selectedCandidatesChipsEl) {
        selectedCandidatesChipsEl.innerHTML = '';
        selectedCandidates.forEach(cand => {
          const chip = document.createElement('div');
          chip.className = 'candidate-chip';
          chip.innerHTML = `
            <span class="chip-avatar">${(cand.name?.[0] || 'C').toUpperCase()}</span>
            <span class="chip-name">${cand.name}</span>
            <span class="chip-job">${cand.job}</span>
            <button type="button" class="chip-remove-btn" title="Remove from this batch" data-id="${cand.id}">✕</button>
          `;
          chip.querySelector('.chip-remove-btn')?.addEventListener('click', (e) => {
            e.stopPropagation();
            const id = cand.id;
            selectedCandidates.delete(id);
            const cb = tbody.querySelector(`.app-row-checkbox[data-id="${id}"]`);
            if (cb) cb.checked = false;
            updateBulkBar();
            openBulkModal();
          });
          selectedCandidatesChipsEl.appendChild(chip);
        });
      }

      updateSchedulePreview();
      if (bulkScheduleModal) bulkScheduleModal.style.display = 'flex';
      if (bulkActionBar) bulkActionBar.style.display = 'none';
      document.body.style.overflow = 'hidden';
    }

    function closeBulkModal() {
      if (bulkScheduleModal) bulkScheduleModal.style.display = 'none';
      if (selectedCandidates.size > 0 && bulkActionBar) {
        bulkActionBar.style.display = 'flex';
      }
      document.body.style.overflow = '';
    }

    openBulkScheduleModalBtn?.addEventListener('click', openBulkModal);
    closeBulkModalBtn?.addEventListener('click', closeBulkModal);
    cancelBulkModalBtn?.addEventListener('click', closeBulkModal);
    bulkScheduleModal?.addEventListener('click', (e) => {
      if (e.target === bulkScheduleModal) closeBulkModal();
    });

    // Mode Toggle (Staggered vs Group)
    slotModeRadios.forEach(radio => {
      radio.addEventListener('change', () => {
        const mode = radio.value;
        if (mode === 'group') {
          if (bufferSelectGroup) bufferSelectGroup.style.display = 'none';
          strategyCardGroup?.classList.add('active');
          strategyCardStaggered?.classList.remove('active');
        } else {
          if (bufferSelectGroup) bufferSelectGroup.style.display = 'block';
          strategyCardStaggered?.classList.add('active');
          strategyCardGroup?.classList.remove('active');
        }
        updateSchedulePreview();
      });
    });

    bulkFormStartAt?.addEventListener('input', updateSchedulePreview);
    bulkFormDuration?.addEventListener('change', updateSchedulePreview);
    bulkFormBuffer?.addEventListener('change', updateSchedulePreview);

    // Live Schedule Timeline Preview Generator
    function updateSchedulePreview() {
      if (!schedulePreviewListEl) return;
      schedulePreviewListEl.innerHTML = '';

      const candidatesArr = Array.from(selectedCandidates.values());
      if (candidatesArr.length === 0) {
        closeBulkModal();
        return;
      }

      const startVal = bulkFormStartAt?.value;
      const startDate = startVal ? new Date(startVal) : new Date();
      const durationMin = parseInt(bulkFormDuration?.value || '30', 10);
      const bufferMin = parseInt(bulkFormBuffer?.value || '5', 10);
      const activeMode = document.querySelector('input[name="bulkSlotMode"]:checked')?.value || 'staggered';

      if (previewModeBadgeEl) {
        previewModeBadgeEl.textContent = activeMode === 'staggered' ? '⏱️ Staggered Consecutive' : '👥 Group Session';
      }

      const stepMs = (durationMin + bufferMin) * 60 * 1000;
      let lastEndTime = new Date(startDate.getTime() + durationMin * 60 * 1000);

      candidatesArr.forEach((cand, idx) => {
        const slotStart = activeMode === 'group'
          ? new Date(startDate.getTime())
          : new Date(startDate.getTime() + idx * stepMs);
        const slotEnd = new Date(slotStart.getTime() + durationMin * 60 * 1000);
        if (slotEnd > lastEndTime) lastEndTime = slotEnd;

        const timeFormat = { hour: '2-digit', minute: '2-digit' };
        const slotStr = `${slotStart.toLocaleTimeString([], timeFormat)} – ${slotEnd.toLocaleTimeString([], timeFormat)}`;
        const dateStr = slotStart.toLocaleDateString([], { month: 'short', day: 'numeric', weekday: 'short' });

        const item = document.createElement('div');
        item.className = 'schedule-preview-item';
        item.innerHTML = `
          <div class="preview-item-left">
            <span class="preview-slot-idx">#${idx + 1}</span>
            <div class="preview-cand-info">
              <strong class="preview-cand-name">${cand.name}</strong>
              <span class="preview-cand-job">💼 ${cand.job}</span>
            </div>
          </div>
          <div class="preview-item-right">
            <span class="preview-slot-time">📅 ${dateStr}, ${slotStr}</span>
            <span class="preview-slot-dur">${durationMin} min slot</span>
          </div>
        `;
        schedulePreviewListEl.appendChild(item);
      });

      if (previewTimeSpanEl) {
        if (activeMode === 'group') {
          previewTimeSpanEl.textContent = `${candidatesArr.length} candidates together at ${startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
        } else {
          const totalMinutes = (lastEndTime.getTime() - startDate.getTime()) / (60 * 1000);
          previewTimeSpanEl.textContent = `${candidatesArr.length} slots from ${startDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} to ${lastEndTime.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })} (~${Math.round(totalMinutes)} mins)`;
        }
      }
    }

    // Submit Bulk Scheduling Form
    bulkScheduleForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const candidateIds = Array.from(selectedCandidates.keys());
      if (candidateIds.length === 0) {
        alert('Please select at least one candidate.');
        return;
      }

      const submitBtn = document.getElementById('submitBulkScheduleBtn');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span>Scheduling & Notifying Candidates... ⏳</span>';
      }

      try {
        const payload = {
          applicationIds: candidateIds,
          title: document.getElementById('bulkFormTitle')?.value || 'Technical Screening',
          interviewType: document.getElementById('bulkFormType')?.value || 'video',
          meetingLink: document.getElementById('bulkFormMeetingLink')?.value || '',
          startAt: bulkFormStartAt?.value,
          durationMinutes: parseInt(bulkFormDuration?.value || '30', 10),
          slotMode: document.querySelector('input[name="bulkSlotMode"]:checked')?.value || 'staggered',
          bufferMinutes: parseInt(bulkFormBuffer?.value || '5', 10),
          interviewerNames: document.getElementById('bulkFormInterviewer')?.value || '',
          notes: document.getElementById('bulkFormNotes')?.value || '',
          timezone: Intl.DateTimeFormat().resolvedOptions().timeZone || 'UTC'
        };

        const res = await fetch('/api/interviews/bulk-schedule', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const data = await res.json();
        if (res.ok && data.success) {
          alert(`🎉 Success! Scheduled ${data.count} candidate interviews.\n\nEach student has received an interview notification with their specific time slot in their portal notifications section.`);
          window.location.href = '/employer/interviews';
        } else {
          alert(data.error || 'Failed to schedule bulk interviews. Please check your selections and try again.');
          if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = `<span>Confirm & Schedule (${candidateIds.length}) Interviews 🚀</span>`;
          }
        }
      } catch (err) {
        console.error(err);
        alert('Network error while scheduling interviews. Please try again.');
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.innerHTML = `<span>Confirm & Schedule (${candidateIds.length}) Interviews 🚀</span>`;
        }
      }
    });

    // Initial run to respect initial values
    updateList();
  });
</script>


---
import DashboardLayout from "../layouts/DashboardLayout.astro";

// @ts-ignore
const payload = Astro.locals.user;
if (!payload || payload.userType !== "employee") {
  return Astro.redirect("/login");
}
---

<DashboardLayout title="Saved Jobs" userType="employee" activePath="/saved">
  <div class="saved-header mb-4">
    <div class="header-titles">
      <span class="badge-tag">Bookmarks</span>
      <h1>Saved Job Positions</h1>
      <p class="subtitle">
        Quickly review and apply to opportunities you've shortlisted for later.
      </p>
    </div>
    <a href="/jobs" class="btn btn-primary btn-glow">
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        ><circle cx="11" cy="11" r="8"></circle><line
          x1="21"
          y1="21"
          x2="16.65"
          y2="16.65"></line></svg
      >
      Discover More Jobs
    </a>
  </div>

  <div id="savedJobsList" class="jobs-grid"></div>

  <div id="emptyState" class="empty-state" style="display:none;">
    <div class="empty-icon">🔖</div>
    <h3>No Saved Jobs Yet</h3>
    <p>
      When searching for roles, click the bookmark icon on any job card to save
      it here for fast review.
    </p>
    <a href="/jobs" class="btn btn-primary mt-3">+ Browse Open Positions</a>
  </div>

  <div id="loadingState" class="empty-state">
    <div class="spinner"></div>
    <p>Loading your bookmarked positions…</p>
  </div>
</DashboardLayout>

<style is:global>
  .mb-4 {
    margin-bottom: 1.75rem;
  }
  .mt-3 {
    margin-top: 1rem;
  }

  .saved-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .badge-tag {
    display: inline-block;
    padding: 0.25rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .header-titles h1 {
    margin: 0 0 0.3rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .subtitle {
    margin: 0;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }

  .btn-glow {
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.35);
  }

  .jobs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
    gap: 1.5rem;
  }

  .saved-job-card {
    background: var(--color-surface);
    backdrop-filter: blur(16px);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-lg);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }
  .saved-job-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }

  .saved-card-top {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .company-avatar-box {
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: white;
    font-weight: 800;
    font-size: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
  }

  .job-card-meta {
    flex: 1;
    min-width: 0;
  }

  .saved-job-title {
    font-size: 1.05rem;
    font-weight: 700;
    margin: 0 0 0.2rem 0;
    color: var(--color-text-main);
  }

  .company-name {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0;
  }

  .remove-btn {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    cursor: pointer;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    transition: all 0.2s ease;
  }
  .remove-btn:hover {
    background: #fee2e2;
    border-color: #fca5a5;
    color: #dc2626;
  }

  .saved-job-desc {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .saved-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.85rem;
    border-top: 1px solid var(--color-border);
    gap: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    flex: 1;
    min-width: 0;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    color: var(--color-text-main);
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
  }
  .tag-green {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border-color: rgba(16, 185, 129, 0.2);
  }
  .tag-salary {
    background: rgba(99, 102, 241, 0.1);
    color: var(--color-primary);
    border-color: rgba(99, 102, 241, 0.2);
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .apply-btn {
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #ffffff !important;
    border: none;
    padding: 0.5rem 1.15rem;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
    letter-spacing: 0.01em;
  }
  .apply-btn:hover,
  .apply-btn:focus,
  .saved-job-card:hover .apply-btn {
    background: linear-gradient(135deg, #4f46e5, #7c3aed) !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(99, 102, 241, 0.45);
  }
  .apply-btn:active {
    transform: translateY(0);
    box-shadow: 0 2px 8px rgba(99, 102, 241, 0.3);
  }
  .apply-btn.applied {
    background: #dcfce7 !important;
    color: #15803d !important;
    cursor: not-allowed !important;
    box-shadow: none !important;
    pointer-events: none;
  }

  .empty-state {
    padding: 5rem 2rem;
    text-align: center;
    background: var(--color-surface);
    backdrop-filter: blur(16px);
    border-radius: var(--border-radius-lg);
    border: 1px solid var(--color-border);
  }
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 0.75rem;
  }

  .spinner {
    width: 38px;
    height: 38px;
    border: 3px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 1rem;
  }
  @media (max-width: 640px) {
    .jobs-grid {
      grid-template-columns: 1fr !important;
      gap: 1rem !important;
    }
    .saved-job-card {
      padding: 1.15rem 0.85rem !important;
      min-width: 0 !important;
      max-width: 100% !important;
      width: 100% !important;
      box-sizing: border-box !important;
      overflow: hidden !important;
    }
    .saved-card-footer {
      flex-direction: column !important;
      align-items: stretch !important;
      gap: 0.75rem !important;
    }
    .tags {
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box !important;
    }
    .tag {
      max-width: 100% !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      white-space: nowrap !important;
    }
    .apply-btn {
      width: 100% !important;
      text-align: center !important;
      justify-content: center !important;
      display: flex !important;
    }
  }
</style>

<script>
  const STORAGE_KEY = "jobned_saved_jobs";

  function getSavedJobs() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || localStorage.getItem("recruitnest_saved_jobs") || "[]");
    } catch {
      return [];
    }
  }

  function getAppliedJobs() {
    try {
      return new Set(
        JSON.parse(localStorage.getItem(STORAGE_KEY + "_applied") || "[]"),
      );
    } catch {
      return new Set();
    }
  }

  async function syncAndFetchSavedJobs() {
    try {
      const res = await fetch("/api/saved");
      if (res.ok) {
        const data = await res.json();
        if (data.success && Array.isArray(data.savedJobs)) {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(data.savedJobs));
          if (data.appliedJobIds) {
            localStorage.setItem(
              STORAGE_KEY + "_applied",
              JSON.stringify(data.appliedJobIds),
            );
          }
          return data.savedJobs;
        }
      }
    } catch (e) {
      console.error("Failed to sync saved jobs:", e);
    }
    return getSavedJobs();
  }

  async function removeSavedJob(jobId: string) {
    const jobs = getSavedJobs().filter((j: any) => j.id !== jobId);
    localStorage.setItem(STORAGE_KEY, JSON.stringify(jobs));
    renderJobs(jobs);

    try {
      await fetch("/api/saved", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ action: "remove", jobId }),
      });
    } catch (e) {
      console.error("Failed to remove saved job from server:", e);
    }
  }

  function formatSalary(min: any, max: any, currency: any) {
    if (
      (min === null || min === undefined || min === "") &&
      (max === null || max === undefined || max === "")
    )
      return null;
    const c = (currency || "USD").trim();
    const numMin = Number(min);
    const numMax = Number(max);

    const validMin = !isNaN(numMin) && isFinite(numMin) && numMin > 0;
    const validMax = !isNaN(numMax) && isFinite(numMax) && numMax > 0;
    if (!validMin && !validMax) return null;

    const fmtNum = (n: number) => {
      if (n >= 1_000_000_000_000) {
        const val = n / 1_000_000_000_000;
        return val > 999 ? "999T+" : `${val.toFixed(1).replace(/\.0$/, "")}T`;
      }
      if (n >= 1_000_000_000)
        return `${(n / 1_000_000_000).toFixed(1).replace(/\.0$/, "")}B`;
      if (n >= 1_000_000)
        return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, "")}M`;
      if (n >= 1_000) return `${(n / 1_000).toFixed(0)}k`;
      return `${Math.round(n)}`;
    };

    const fMin = validMin ? fmtNum(numMin) : null;
    const fMax = validMax ? fmtNum(numMax) : null;

    if (fMin && fMax) {
      if (fMin === fMax) return `${c} ${fMin}`;
      return `${c} ${fMin}–${fMax}`;
    }
    if (fMin) return `${c} ${fMin}+`;
    if (fMax) return `Up to ${c} ${fMax}`;
    return null;
  }

  function renderJobs(jobs: any[]) {
    const grid = document.getElementById("savedJobsList");
    const empty = document.getElementById("emptyState");
    const loading = document.getElementById("loadingState");

    if (loading) loading.style.display = "none";
    if (!grid || !empty) return;

    if (!jobs || jobs.length === 0) {
      grid.innerHTML = "";
      empty.style.display = "block";
      return;
    }

    const applied = getAppliedJobs();

    empty.style.display = "none";
    grid.innerHTML = jobs
      .map((job: any) => {
        const salary = formatSalary(
          job.salaryMin,
          job.salaryMax,
          job.salaryCurrency,
        );
        const isApplied = applied.has(job.id);

        return `
        <div class="saved-job-card">
          <div class="saved-card-top">
            <div class="company-avatar-box">
              ${(job.companyName || "C").charAt(0).toUpperCase()}
            </div>
            <div class="job-card-meta">
              <h3 class="saved-job-title">${escHtml(job.jobTitle || "Job Position")}</h3>
              <p class="company-name">${escHtml(job.companyName || "Featured Company")}</p>
            </div>
            <button class="remove-btn" onclick="removeSavedJob('${job.id}')" title="Remove bookmark">🗑</button>
          </div>
          <p class="saved-job-desc">${(() => { const clean = (job.description || "").replace(/<[^>]*>/g, '').replace(/&nbsp;/gi, ' ').trim(); const snippet = clean.length > 120 ? clean.slice(0, 120) + "…" : clean; return escHtml(snippet); })()}</p>
          <div class="saved-card-footer">
            <div class="tags">
              ${job.locationRemote ? '<span class="tag tag-green">🌐 Remote</span>' : ""}
              ${job.locationCity && !job.locationRemote ? `<span class="tag">📍 ${escHtml(job.locationCity)}</span>` : ""}
              ${salary ? `<span class="tag tag-salary">💰 ${escHtml(salary)}</span>` : ""}
            </div>
            <a href="${isApplied ? "javascript:void(0)" : `/jobs/${job.id}`}" class="apply-btn ${isApplied ? "applied" : ""}" ${isApplied ? 'onclick="return false;"' : ""}>${isApplied ? "✓ Applied" : "Apply Now"}</a>
          </div>
        </div>
      `;
      })
      .join("");
  }

  function escHtml(s: any) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }

  // @ts-ignore
  window.removeSavedJob = removeSavedJob;

  renderJobs(getSavedJobs());
  syncAndFetchSavedJobs().then((jobs) => renderJobs(jobs));
</script>

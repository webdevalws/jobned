---
import Layout from "../layouts/Layout.astro";

// Redirect logged-in users to their respective role dashboard
const payload = Astro.locals.user as any;
if (payload) {
  if (payload.userType === "employer") {
    return Astro.redirect("/employer");
  } else if (payload.userType === "employee") {
    return Astro.redirect("/dashboard");
  } else if (payload.userType === "admin") {
    return Astro.redirect("/admin");
  } else if (payload.userType === "superadmin") {
    return Astro.redirect("/superadmin");
  } else if (payload.userType === "masteradmin") {
    return Astro.redirect("/masteradmin");
  }
}
---

<Layout
  title="JobNed - AI-Powered Job & Talent Matching Platform"
  description="Discover top tech jobs or hire world-class candidates with AI candidate screening, real-time application tracking, and automated interview scheduling."
  keywords="tech jobs, AI hiring, candidate screening, developer jobs, recruitment software, remote jobs, SaaS careers"
  schemaType="SoftwareApplication"
>
  <!-- Navigation Header -->
  <header class="landing-nav">
    <div class="nav-container">
      <div class="logo">
        <a
          href="/"
          style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;"

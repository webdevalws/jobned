---
const payload = Astro.locals.user as any;
const logoHomePath = 
  payload?.userType === "employer" ? "/employer" :
  payload?.userType === "admin" ? "/admin" :
  payload?.userType === "superadmin" ? "/superadmin" :
  payload?.userType === "masteradmin" ? "/masteradmin" :
  payload?.userType === "employee" ? "/dashboard" : "/";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="logo">
        <a href={logoHomePath} style="display: flex; align-items: center; gap: 0.5rem; text-decoration: none; color: inherit;">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="var(--color-primary)" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
          <span class="logo-text">Job<span class="highlight">Ned</span></span>
        </a>
      </div>
      <p class="brand-desc">
        Connecting top-tier talent with world-class opportunities. Build your future with the most intelligent job matching platform.
      </p>
    </div>
    
    <div class="footer-links">
      <h4>Candidate Features</h4>
      <ul>
        <li><a href="/jobs">Browse All Jobs</a></li>
        <li><a href="/recommended">Recommended Jobs</a></li>
        <li><a href="/applications">Application Tracker</a></li>
        <li><a href="/saved">Saved Jobs</a></li>
        <li><a href="/settings">Profile &amp; Settings</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h4>Employer Features</h4>
      <ul>
        <li><a href="/employer">Employer Dashboard</a></li>
        <li><a href="/employer/post-job">Post Job Opening</a></li>
        <li><a href="/employer/jobs">Manage Job Listings</a></li>
        <li><a href="/employer/applications">Candidate Applications</a></li>
        <li><a href="/employer/interviews">Interview Schedule</a></li>
        <li><a href="/employer/screening">AI Candidate Screening</a></li>
      </ul>
    </div>

    <div class="footer-links">
      <h4>Company &amp; Legal</h4>
      <ul>
        <li><a href="/about">About Us</a></li>
        <li><a href="/contact">Contact Us</a></li>
        <li><a href="/pricing">Subscription Pricing</a></li>
        <li><a href="/terms">Terms &amp; Conditions</a></li>
        <li><a href="/refund-policy">Cancellation &amp; Refund</a></li>
        <li><a href="/privacy">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
  
  <div class="footer-bottom container">
    <p>&copy; {new Date().getFullYear()} JobNed. All rights reserved.</p>
    <div class="legal-links">
      <a href="/about">About Us</a>
      <a href="/contact">Contact Us</a>
      <a href="/pricing">Pricing</a>
      <a href="/terms">Terms</a>
      <a href="/refund-policy">Refund Policy</a>
      <a href="/privacy">Privacy Policy</a>
      <button type="button" onclick="if(typeof window.openCookiePreferences === 'function') window.openCookiePreferences()" class="footer-cookie-btn">Cookie Preferences ⚙️</button>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-surface);
    border-top: 1px solid var(--color-border);
    padding-top: 4rem;
    margin-top: 4rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.8fr 1fr 1.2fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
  }

  .footer-brand .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .logo-text {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-main);
    letter-spacing: -0.02em;
  }

  .brand-desc {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    max-width: 320px;
  }

  .footer-links h4 {
    font-size: 1.125rem;
    color: var(--color-text-main);
    margin-bottom: 1.25rem;
  }

  .footer-links ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .footer-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s;
    white-space: nowrap;
  }

  .footer-links a:hover {
    color: var(--color-primary);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  .legal-links {
    display: flex;
    gap: 1.5rem;
  }

  .legal-links a,
  .footer-cookie-btn {
    color: inherit;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    transition: color 0.2s;
  }

  .legal-links a:hover,
  .footer-cookie-btn:hover {
    color: var(--color-primary);
  }

  @media (max-width: 968px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 640px) {
    .site-footer {
      padding-top: 2.5rem;
      margin-top: 2.5rem;
    }
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2rem 1.25rem;
      margin-bottom: 2rem;
    }
    .footer-brand {
      grid-column: span 2;
    }
    .brand-desc {
      max-width: 100%;
      font-size: 0.875rem;
      margin-bottom: 1rem;
    }
    .footer-links h4 {
      font-size: 0.95rem;
      margin-bottom: 0.75rem;
    }
    .footer-links a {
      font-size: 0.875rem;
    }
    .footer-bottom {
      flex-direction: column;
      gap: 0.75rem;
      text-align: center;
      padding: 1.5rem 1rem;
    }
    .legal-links {
      flex-wrap: wrap;
      justify-content: center;
      gap: 1rem;
      font-size: 0.8rem;
    }
  }
</style>

---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { users, applications } from '../../db/schema';
import { eq, desc, count } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || (payload.userType !== 'masteradmin' && payload.userType !== 'superadmin')) {
  return Astro.redirect('/login');
}

const db = getDb();

// Fetch ONLY candidates / employees
const candidates = await db.select().from(users).where(
  eq(users.userType, 'employee')
).orderBy(desc(users.createdAt)).all();

// Fetch application counts per candidate
const appCounts = await db.select({
  applicantId: applications.applicantId,
  appCount: count()
}).from(applications).groupBy(applications.applicantId).all();

const appCountMap = new Map(appCounts.map(a => [a.applicantId, a.appCount]));
---

<DashboardLayout title="Candidate Directory - MasterAdmin" userType="masteradmin" activePath="/masteradmin/users">
  <div class="dashboard-header mb-4">
    <div class="header-titles">
      <span class="badge-tag">MasterAdmin Management</span>
      <h1>Candidate Directory & Accounts</h1>
      <p class="subtitle">Review candidate profiles, track job applications, edit details, or manage accounts.</p>
    </div>
    <div class="stats-counter-pill">
      <strong>{candidates.length}</strong> Registered Candidates
    </div>
  </div>

  <!-- Search Section -->
  <div class="search-bar-container mb-4">
    <div class="search-input-wrapper">
      <span class="search-icon">🔍</span>
      <input type="text" id="candidateSearchInput" class="search-input" placeholder="Search candidates by name, headline, email or location..." />
    </div>
  </div>

  <!-- Bulk Actions Toolbar (Hidden until items selected) -->
  <div id="bulkActionsToolbar" class="bulk-actions-toolbar mb-4" style="display: none;">
    <div class="bulk-actions-info">
      <span class="bulk-count-badge"><span id="selectedCandidatesCount">0</span> Selected</span>
      <span class="bulk-info-text">Choose an action to apply to selected candidate accounts</span>
    </div>
    <div class="bulk-actions-buttons">
      <button type="button" class="btn-bulk-deselect" id="btnDeselectAllCandidates">
        ✕ Clear Selection
      </button>
      <button type="button" id="btnDeleteSelectedCandidates" class="btn-bulk-delete">
        🗑️ Delete Selected (<span id="deleteSelectedBtnCount">0</span>)
      </button>
    </div>
  </div>

  <div class="table-card">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th style="width: 44px; text-align: center;">
              <input type="checkbox" id="selectAllCheckbox" class="row-checkbox-input" title="Select All Candidates" />
            </th>
            <th>Candidate & Headline</th>
            <th>Contact Email</th>
            <th>Location & Exp</th>
            <th>Applications</th>
            <th>Account Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {candidates.length === 0 ? (
            <tr>
              <td colspan="7" class="empty-cell">
                <div class="empty-state">
                  <div class="empty-icon">👥</div>
                  <h3>No Candidates Found</h3>
                  <p>No registered candidate accounts exist in the database.</p>
                </div>
              </td>
            </tr>
          ) : (
            candidates.map((cand) => {
              const totalApps = appCountMap.get(cand.id) || 0;
              const isBlocked = cand.isActive === false;
              const searchText = `${cand.firstName || ''} ${cand.lastName || ''} ${cand.headline || ''} ${cand.email || ''} ${cand.location || ''}`.toLowerCase();

              let skillsArr: string[] = [];
              if (cand.skills) {
                try {
                  const p = typeof cand.skills === 'string' ? JSON.parse(cand.skills) : cand.skills;
                  if (Array.isArray(p)) skillsArr = p;
                } catch (e) {}
              }

              return (
                <tr class={`candidate-row ${isBlocked ? 'blocked-row' : ''}`} data-user-id={cand.id} data-search-text={searchText}>
                  <td style="text-align: center;">
                    <input type="checkbox" class="candidate-row-checkbox row-checkbox-input" value={cand.id} title={`Select ${cand.firstName} ${cand.lastName}`} />
                  </td>
                  <td>
                    <div class="user-meta-cell">
                      <div class="user-avatar-circle">
                        {cand.firstName.charAt(0).toUpperCase()}
                      </div>
                      <div>
                        <strong class="user-name-txt">{cand.firstName} {cand.lastName}</strong>
                        <div class="user-headline-sub">{cand.headline || 'Job Seeker'}</div>
                      </div>
                    </div>
                  </td>
                  <td>
                    <span class="email-txt">{cand.email}</span>
                  </td>
                  <td>
                    <div class="location-exp-cell">
                      <span>📍 {cand.location || 'Not Specified'}</span>
                      <small>⏱ {cand.experienceYears ? `${cand.experienceYears} Yrs Exp` : 'Fresh / Entry'}</small>
                    </div>
                  </td>
                  <td>
                    <span class="apps-badge">
                      <strong>{totalApps}</strong> Applied
                    </span>
                  </td>
                  <td>
                    <span class={`account-pill ${isBlocked ? 'pill-blocked' : 'pill-active'}`}>
                      {isBlocked ? '🔴 Suspended' : '🟢 Active'}
                    </span>
                  </td>
                  <td>
                    <div class="actions-group">
                      <!-- View Dashboard As User (Impersonate) -->
                      <button 
                        type="button" 
                        class="btn-action-icon impersonate-action" 
                        title="View Candidate Dashboard (Impersonate)"
                        onclick={`impersonateUser('${cand.id}')`}
                      >
                        🚀
                      </button>

                      <!-- Quick View Modal Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon view-cand-btn" 
                        title="View Candidate Profile Details"
                        data-id={cand.id}
                        data-name={`${cand.firstName} ${cand.lastName}`}
                        data-headline={cand.headline || 'Job Seeker'}
                        data-email={cand.email}
                        data-phone={cand.phone || 'N/A'}
                        data-location={cand.location || 'N/A'}
                        data-exp={cand.experienceYears ? `${cand.experienceYears} Years` : 'Fresh / Entry'}
                        data-skills={JSON.stringify(skillsArr)}
                        data-bio={cand.bio || 'No biography provided.'}
                        data-linkedin={cand.linkedinUrl || ''}
                        data-portfolio={cand.portfolioUrl || ''}
                        data-verified={cand.verifiedStatus}
                        data-active={cand.isActive !== false ? 'Active' : 'Suspended'}
                      >
                        👁️
                      </button>

                      <!-- Edit Button -->
                      <a href={`/masteradmin/users/${cand.id}/edit`} class="btn-action-icon edit-action" title="Edit Candidate Profile & Credentials">
                        ✏️
                      </a>

                      <!-- Change Password Quick Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon change-pwd-btn" 
                        title="Change Candidate Password"
                        data-id={cand.id}
                        data-name={`${cand.firstName} ${cand.lastName}`}
                      >
                        🔑
                      </button>

                      <!-- Block / Unblock Button -->
                      <button 
                        type="button" 
                        class={`btn-action-icon block-btn ${isBlocked ? 'unblock-action' : 'block-action'}`} 
                        title={isBlocked ? 'Reactivate Candidate Account' : 'Block / Suspend Candidate'}
                        data-id={cand.id}
                        data-action={isBlocked ? 'unblock' : 'block'}
                      >
                        {isBlocked ? '🟢' : '🚫'}
                      </button>

                      <!-- Delete Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon delete-action delete-cand-btn" 
                        title="Delete Candidate Account"
                        data-id={cand.id}
                        data-name={`${cand.firstName} ${cand.lastName}`}
                      >
                        🗑️
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Candidate View Modal -->
  <div id="candModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-avatar" id="cAvatar">U</div>
          <div>
            <h2 id="cName">Candidate Name</h2>
            <p id="cHeadline">Professional Headline</p>
          </div>
        </div>
        <button type="button" class="modal-close" id="closeModal">✕</button>
      </div>

      <div class="modal-body">
        <div class="modal-info-grid">
          <div class="info-item">
            <span class="lbl">Email</span>
            <span class="val" id="cEmail">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Phone</span>
            <span class="val" id="cPhone">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Location</span>
            <span class="val" id="cLocation">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Experience</span>
            <span class="val" id="cExp">—</span>
          </div>
        </div>

        <div class="modal-section-title">Key Skills</div>
        <div class="skills-tags-wrap" id="cSkills">
          <span class="no-skills">No skills listed</span>
        </div>

        <div class="modal-section-title">Biography & Summary</div>
        <p class="bio-text" id="cBio">Biography details...</p>

        <div class="modal-section-title">Professional Links</div>
        <div class="links-row">
          <a id="cLinkedin" href="#" target="_blank" class="link-pill" style="display: none;">
            <span>🔗</span> LinkedIn Profile ↗
          </a>
          <a id="cPortfolio" href="#" target="_blank" class="link-pill" style="display: none;">
            <span>🌐</span> Portfolio Website ↗
          </a>
          <span id="cNoLinks" class="no-links-txt">No professional links added.</span>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="closeModalBtn">Close</button>
      </div>
    </div>
  </div>

  <!-- Change Password Modal -->
  <div id="pwdModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card modal-card-sm">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-avatar font-icon">🔑</div>
          <div>
            <h2>Change User Password</h2>
            <p id="pwdTargetUser">Target Account</p>
          </div>
        </div>
        <button type="button" class="modal-close" id="closePwdModal">✕</button>
      </div>

      <form id="quick-pwd-form">
        <input type="hidden" id="pwdUserId" value="" />
        <div class="modal-body">
          <div class="form-group">
            <label for="quickNewPassword">New Password <span class="req">*</span></label>
            <input type="password" id="quickNewPassword" required minlength="6" placeholder="Enter at least 6 characters..." />
          </div>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-outline" id="closePwdModalBtn">Cancel</button>
          <button type="submit" class="btn btn-primary" id="savePwdBtn">Save New Password</button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<script>
  // --- MULTI-SELECT & BULK ACTIONS LOGIC ---
  const selectAllCheckbox = document.getElementById('selectAllCheckbox') as HTMLInputElement | null;
  const bulkToolbar = document.getElementById('bulkActionsToolbar');
  const selectedCountEl = document.getElementById('selectedCandidatesCount');
  const deleteBtnCountEl = document.getElementById('deleteSelectedBtnCount');
  const btnDeselectAll = document.getElementById('btnDeselectAllCandidates');
  const btnDeleteSelected = document.getElementById('btnDeleteSelectedCandidates');

  function getVisibleCheckboxes() {
    const visibleRows = Array.from(document.querySelectorAll('.candidate-row')).filter(r => (r as HTMLElement).style.display !== 'none');
    return visibleRows.map(r => r.querySelector('.candidate-row-checkbox') as HTMLInputElement).filter(Boolean);
  }

  function updateSelectionUI() {
    const visibleCheckboxes = getVisibleCheckboxes();
    const checkedBoxes = Array.from(document.querySelectorAll('.candidate-row-checkbox:checked')) as HTMLInputElement[];
    const count = checkedBoxes.length;

    if (selectedCountEl) selectedCountEl.textContent = String(count);
    if (deleteBtnCountEl) deleteBtnCountEl.textContent = String(count);

    if (bulkToolbar) {
      bulkToolbar.style.display = count > 0 ? 'flex' : 'none';
    }

    if (selectAllCheckbox) {
      if (visibleCheckboxes.length > 0 && visibleCheckboxes.every(cb => cb.checked)) {
        selectAllCheckbox.checked = true;
        selectAllCheckbox.indeterminate = false;
      } else if (count > 0) {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = true;
      } else {
        selectAllCheckbox.checked = false;
        selectAllCheckbox.indeterminate = false;
      }
    }

    document.querySelectorAll('.candidate-row').forEach(row => {
      const cb = row.querySelector('.candidate-row-checkbox') as HTMLInputElement | null;
      if (cb && cb.checked) {
        row.classList.add('selected-row');
      } else {
        row.classList.remove('selected-row');
      }
    });
  }

  selectAllCheckbox?.addEventListener('change', (e) => {
    const isChecked = (e.target as HTMLInputElement).checked;
    getVisibleCheckboxes().forEach(cb => {
      cb.checked = isChecked;
    });
    updateSelectionUI();
  });

  document.querySelector('.data-table')?.addEventListener('change', (e) => {
    const target = e.target as HTMLElement;
    if (target && target.classList.contains('candidate-row-checkbox')) {
      updateSelectionUI();
    }
  });

  btnDeselectAll?.addEventListener('click', () => {
    document.querySelectorAll('.candidate-row-checkbox').forEach(cb => (cb as HTMLInputElement).checked = false);
    if (selectAllCheckbox) {
      selectAllCheckbox.checked = false;
      selectAllCheckbox.indeterminate = false;
    }
    updateSelectionUI();
  });

  // Search Filter Logic
  const searchInput = document.getElementById('candidateSearchInput') as HTMLInputElement | null;
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase().trim();
      const rows = document.querySelectorAll('.candidate-row');
      rows.forEach(row => {
        const textContent = (row as HTMLElement).getAttribute('data-search-text') || row.textContent?.toLowerCase() || '';
        if (!term || textContent.includes(term)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
      updateSelectionUI();
    });
  }

  async function impersonateUser(targetUserId: string) {
    if (confirm("View dashboard as this candidate? You will be logged into their account view and can return to MasterAdmin at any time.")) {
      try {
        const res = await fetch('/api/masteradmin/impersonate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ targetUserId })
        });
        const data = await res.json();
        if (res.ok && data.redirectUrl) {
          window.location.href = data.redirectUrl;
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(data.error || 'Failed to switch context', 'error');
        }
      } catch (e) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred while switching context.', 'error');
      }
    }
  }
  // @ts-ignore
  window.impersonateUser = impersonateUser;

  // View Modal logic
  const modal = document.getElementById('candModal');
  const closeModal = document.getElementById('closeModal');
  const closeModalBtn = document.getElementById('closeModalBtn');

  if (modal) {
    document.body.appendChild(modal);
  }

  document.querySelectorAll('.view-cand-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLButtonElement;
      const name = b.dataset.name || '';
      document.getElementById('cName')!.innerText = name;
      document.getElementById('cAvatar')!.innerText = name.charAt(0).toUpperCase();
      document.getElementById('cHeadline')!.innerText = b.dataset.headline || 'Job Seeker';
      document.getElementById('cEmail')!.innerText = b.dataset.email || '—';
      document.getElementById('cPhone')!.innerText = b.dataset.phone || '—';
      document.getElementById('cLocation')!.innerText = b.dataset.location || '—';
      document.getElementById('cExp')!.innerText = b.dataset.exp || '—';
      document.getElementById('cBio')!.innerText = b.dataset.bio || 'No biography provided.';

      // Skills Rendering
      const skillsContainer = document.getElementById('cSkills')!;
      skillsContainer.innerHTML = '';
      try {
        const skills: string[] = JSON.parse(b.dataset.skills || '[]');
        if (skills.length > 0) {
          skills.forEach(s => {
            const span = document.createElement('span');
            span.className = 'skill-tag';
            span.innerText = s;
            skillsContainer.appendChild(span);
          });
        } else {
          skillsContainer.innerHTML = '<span class="no-skills">No skills listed</span>';
        }
      } catch (e) {
        skillsContainer.innerHTML = '<span class="no-skills">No skills listed</span>';
      }

      // Links Rendering
      const linkedinBtn = document.getElementById('cLinkedin') as HTMLAnchorElement;
      const portfolioBtn = document.getElementById('cPortfolio') as HTMLAnchorElement;
      const noLinksTxt = document.getElementById('cNoLinks')!;

      let hasLink = false;
      if (b.dataset.linkedin) {
        linkedinBtn.href = b.dataset.linkedin;
        linkedinBtn.style.display = 'inline-flex';
        hasLink = true;
      } else {
        linkedinBtn.style.display = 'none';
      }

      if (b.dataset.portfolio) {
        portfolioBtn.href = b.dataset.portfolio;
        portfolioBtn.style.display = 'inline-flex';
        hasLink = true;
      } else {
        portfolioBtn.style.display = 'none';
      }

      noLinksTxt.style.display = hasLink ? 'none' : 'inline-block';

      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const hideModal = () => { 
    if (modal) {
      modal.style.display = 'none'; 
      document.body.style.overflow = '';
    }
  };
  closeModal?.addEventListener('click', hideModal);
  closeModalBtn?.addEventListener('click', hideModal);
  modal?.addEventListener('click', (e) => { if (e.target === modal) hideModal(); });

  // Password Modal logic
  const pwdModal = document.getElementById('pwdModal');
  const closePwdModal = document.getElementById('closePwdModal');
  const closePwdModalBtn = document.getElementById('closePwdModalBtn');
  const quickPwdForm = document.getElementById('quick-pwd-form') as HTMLFormElement | null;
  const pwdUserIdInput = document.getElementById('pwdUserId') as HTMLInputElement | null;
  const pwdTargetUserTxt = document.getElementById('pwdTargetUser');
  const quickNewPasswordInput = document.getElementById('quickNewPassword') as HTMLInputElement | null;
  const savePwdBtn = document.getElementById('savePwdBtn') as HTMLButtonElement | null;

  if (pwdModal) {
    document.body.appendChild(pwdModal);
  }

  document.querySelectorAll('.change-pwd-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const b = btn as HTMLButtonElement;
      const userId = b.dataset.id || '';
      const userName = b.dataset.name || '';

      if (pwdUserIdInput) pwdUserIdInput.value = userId;
      if (pwdTargetUserTxt) pwdTargetUserTxt.innerText = `Account: ${userName}`;
      if (quickNewPasswordInput) quickNewPasswordInput.value = '';

      if (pwdModal) {
        pwdModal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });
  });

  const hidePwdModal = () => {
    if (pwdModal) {
      pwdModal.style.display = 'none';
      document.body.style.overflow = '';
    }
  };
  closePwdModal?.addEventListener('click', hidePwdModal);
  closePwdModalBtn?.addEventListener('click', hidePwdModal);
  pwdModal?.addEventListener('click', (e) => { if (e.target === pwdModal) hidePwdModal(); });

  if (quickPwdForm && savePwdBtn) {
    quickPwdForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const userId = pwdUserIdInput?.value;
      const newPassword = quickNewPasswordInput?.value.trim();

      if (!userId || !newPassword || newPassword.length < 6) {
        // @ts-ignore
        if (window.showToast) window.showToast('Please enter a password of at least 6 characters.', 'error');
        return;
      }

      savePwdBtn.innerText = 'Saving...';
      savePwdBtn.disabled = true;

      try {
        const res = await fetch('/api/admin/users/change-password', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId, newPassword })
        });

        const result = await res.json();
        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast(result.message || 'Password changed successfully!');
          hidePwdModal();
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to update password', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('Error updating password', 'error');
      } finally {
        savePwdBtn.innerText = 'Save New Password';
        savePwdBtn.disabled = false;
      }
    });
  }

  // Block / Unblock Logic
  document.querySelectorAll('.block-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const userId = b.dataset.id;
      const action = b.dataset.action;
      if (!userId || !action) return;

      const confirmMsg = action === 'block' 
        ? 'Are you sure you want to SUSPEND/BLOCK this candidate? They will be unable to apply to jobs or access candidate features.' 
        : 'Reactivate this candidate account?';

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/users/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId, action })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast(`Candidate ${action === 'block' ? 'suspended' : 'reactivated'} successfully!`);
          window.location.reload();
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Operation failed', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('Error updating account status', 'error');
      }
    });
  });

  // Bulk Delete Candidates Action
  btnDeleteSelected?.addEventListener('click', async () => {
    const checkedBoxes = Array.from(document.querySelectorAll('.candidate-row-checkbox:checked')) as HTMLInputElement[];
    if (checkedBoxes.length === 0) return;

    const selectedIds = checkedBoxes.map(cb => cb.value);
    const count = selectedIds.length;

    const confirmMsg = count === 1
      ? `Are you sure you want to PERMANENTLY DELETE 1 selected candidate account?\n\nAll submitted job applications will be deleted.`
      : `Are you sure you want to PERMANENTLY DELETE all ${count} selected candidate accounts?\n\nAll submitted applications for these candidate accounts will be permanently deleted.`;

    if (!confirm(confirmMsg)) return;

    if (btnDeleteSelected) {
      btnDeleteSelected.disabled = true;
      btnDeleteSelected.textContent = `Deleting ${count} candidates...`;
    }

    try {
      const res = await fetch('/api/admin/users/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ userIds: selectedIds })
      });

      const data = await res.json();

      if (res.ok && data.success) {
        selectedIds.forEach(id => {
          const row = document.querySelector(`.candidate-row[data-user-id="${id}"]`);
          if (row) {
            (row as HTMLElement).style.transition = 'all 0.3s ease';
            (row as HTMLElement).style.opacity = '0';
            (row as HTMLElement).style.transform = 'translateX(20px)';
            setTimeout(() => row.remove(), 300);
          }
        });

        setTimeout(() => {
          updateSelectionUI();
          const remaining = document.querySelectorAll('.candidate-row:not([style*="display: none"])').length;
          const countPill = document.querySelector('.stats-counter-pill strong');
          if (countPill) countPill.textContent = String(remaining);

          if (remaining === 0) {
            const tbody = document.querySelector('.data-table tbody');
            if (tbody) {
              tbody.innerHTML = `
                <tr>
                  <td colspan="7" class="empty-cell">
                    <div class="empty-state">
                      <div class="empty-icon">👥</div>
                      <h3>No Candidates Found</h3>
                      <p>No registered candidate accounts exist in the database.</p>
                    </div>
                  </td>
                </tr>
              `;
            }
          }
        }, 350);

        // @ts-ignore
        if (window.showToast) window.showToast(`${count} candidate account(s) deleted successfully!`);
      } else {
        // @ts-ignore
        if (window.showToast) window.showToast(data.error || 'Failed to delete candidates', 'error');
      }
    } catch (err) {
      // @ts-ignore
      if (window.showToast) window.showToast('An error occurred during bulk deletion.', 'error');
    } finally {
      if (btnDeleteSelected) {
        btnDeleteSelected.disabled = false;
        btnDeleteSelected.innerHTML = `🗑️ Delete Selected (<span id="deleteSelectedBtnCount">0</span>)`;
      }
    }
  });

  // Delete Candidate Logic
  document.querySelectorAll('.delete-cand-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const userId = b.dataset.id;
      const name = b.dataset.name;
      if (!userId) return;

      if (!confirm(`Are you sure you want to PERMANENTLY DELETE candidate "${name}"? All submitted applications will be deleted.`)) {
        return;
      }

      try {
        const res = await fetch('/api/admin/users/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Candidate deleted successfully.');
          const row = document.querySelector(`.candidate-row[data-user-id="${userId}"]`);
          if (row) {
            (row as HTMLElement).style.transition = 'all 0.3s ease';
            (row as HTMLElement).style.opacity = '0';
            (row as HTMLElement).style.transform = 'translateX(20px)';
            setTimeout(() => {
              row.remove();
              updateSelectionUI();
              const remaining = document.querySelectorAll('.candidate-row:not([style*="display: none"])').length;
              const countPill = document.querySelector('.stats-counter-pill strong');
              if (countPill) countPill.textContent = String(remaining);
            }, 300);
          } else {
            window.location.reload();
          }
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to delete candidate', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred during deletion.', 'error');
      }
    });
  });
</script>


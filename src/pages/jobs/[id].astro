---
import { getResumeViewerUrl } from '../../lib/resume-helper';
import { sanitizeRichHtml } from '../../lib/sanitize';
import DashboardLayout from "../../layouts/DashboardLayout.astro";
import { getDb } from "../../lib/db";
import { jobPostings, applications, users } from "../../db/schema";
import { eq, and, desc, sql } from "drizzle-orm";

// @ts-ignore
const payload = Astro.locals.user;
const userType = payload?.userType || "employee";

const { id } = Astro.params;

let defaultBackUrl = "/jobs";
if (payload) {
  if (payload.userType === "masteradmin") {
    defaultBackUrl = "/masteradmin/employers";
  } else if (payload.userType === "superadmin") {
    defaultBackUrl = "/superadmin/employers";
  } else if (payload.userType === "admin") {
    defaultBackUrl = "/admin/jobs";
  } else if (payload.userType === "employer") {
    defaultBackUrl = "/employer/jobs";
  }
}

if (!id) {
  return Astro.redirect(defaultBackUrl);
}

const db = getDb();
let job = null;
let alreadyApplied = false;
let appId = null;

try {
  // 1. Fetch job with employer details
  job = await db
    .select({
      id: jobPostings.id,
      jobTitle: jobPostings.jobTitle,
      description: jobPostings.description,
      requirements: jobPostings.requirements,
      salaryMin: jobPostings.salaryMin,
      salaryMax: jobPostings.salaryMax,
      salaryCurrency: jobPostings.salaryCurrency,
      locationCity: jobPostings.locationCity,
      locationRemote: jobPostings.locationRemote,
      employmentType: jobPostings.employmentType,
      experienceLevel: jobPostings.experienceLevel,
      companyName: users.companyName,
      companyIndustry: users.companyIndustry,
      companyWebsite: users.companyWebsite,
      companyLogo: users.avatarUrl,
      employerId: jobPostings.employerId,
      status: jobPostings.status,
      isDeleted: jobPostings.isDeleted,
      applicationFormConfig: jobPostings.applicationFormConfig,
      externalApplyUrl: jobPostings.externalApplyUrl,
      applyMode: jobPostings.applyMode,
      sourceType: jobPostings.sourceType,
    })
    .from(jobPostings)
    .leftJoin(users, eq(jobPostings.employerId, users.id))
    .where(eq(jobPostings.id, id))
    .get();

  const isPrivilegedUser = payload ? (['masteradmin', 'superadmin', 'admin'].includes(payload.userType) || (payload.userType === 'employer' && job?.employerId === payload.userId)) : false;
  if (!job || (!isPrivilegedUser && (job.status !== "published" || job.isDeleted))) {
    return Astro.redirect(defaultBackUrl);
  }

  // Increment real view count when candidates/visitors view the job
  if (!payload || payload.userType === 'employee' || !isPrivilegedUser) {
    try {
      await db
        .update(jobPostings)
        .set({
          viewCount: sql`COALESCE(${jobPostings.viewCount}, 0) + 1`
        })
        .where(eq(jobPostings.id, id));
    } catch (viewErr) {
      console.warn("Could not increment job view count:", viewErr);
    }
  }

  // 2. Check if already applied
  if (payload && payload.userType === 'employee') {
    const existingApp = await db
      .select()
      .from(applications)
      .where(
        and(
          eq(applications.jobPostingId, id),
          eq(applications.applicantId, payload.userId)
        )
      )
      .get();
    
    if (existingApp) {
      alreadyApplied = true;
      appId = existingApp.id;
    }
  }
} catch (e) {
  console.error("Error loading job detail page:", e);
  return Astro.redirect(defaultBackUrl);
}

let candidateUser: any = null;
if (payload && payload.userType === 'employee') {
  try {
    candidateUser = await db.select().from(users).where(eq(users.id, payload.userId)).get();
  } catch (err) {
    console.error('Failed to load candidate user profile:', err);
  }
}

let jobApplicants: any[] = [];
if (payload && payload.userType === 'employer') {
  try {
    jobApplicants = await db
      .select({
        id: applications.id,
        status: applications.status,
        appliedAt: applications.appliedAt,
        applicantFirstName: users.firstName,
        applicantLastName: users.lastName,
        applicantEmail: users.email,
        resumeUrl: applications.resumeUrl,
        aiScore: applications.aiScore,
        headline: users.headline,
        avatarUrl: users.avatarUrl,
      })
      .from(applications)
      .innerJoin(users, eq(applications.applicantId, users.id))
      .where(eq(applications.jobPostingId, id))
      .orderBy(desc(applications.appliedAt))
      .all();
  } catch (err) {
    console.error('Failed to load job applicants on detail page:', err);
  }
}

let screeningQuestions: any[] = [];
if (job.applicationFormConfig) {
  try {
    const parsed = typeof job.applicationFormConfig === 'string' ? JSON.parse(job.applicationFormConfig) : job.applicationFormConfig;
    if (Array.isArray(parsed)) {
      screeningQuestions = parsed;
    } else if (parsed && Array.isArray(parsed.questions)) {
      screeningQuestions = parsed.questions;
    }
  } catch (e) {}
}

const formatSalary = (min: any, max: any, currency: string | null) => {
  if (!min && !max) return null;
  const c = (currency || 'USD').trim();
  const numMin = Number(min);
  const numMax = Number(max);
  const validMin = !isNaN(numMin) && isFinite(numMin) && numMin > 0;
  const validMax = !isNaN(numMax) && isFinite(numMax) && numMax > 0;
  if (!validMin && !validMax) return null;

  const fmtNum = (n: number) => {
    if (n >= 1_000_000_000_000) {
      const val = n / 1_000_000_000_000;
      return val > 999 ? '999T+' : `${val.toFixed(1).replace(/\.0$/, '')}T`;
    }
    if (n >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(1).replace(/\.0$/, '')}B`;
    if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
    if (n >= 1_000) return `${(n / 1_000).toFixed(0)}k`;
    return String(Math.round(n));
  };

  const fMin = validMin ? fmtNum(numMin) : null;
  const fMax = validMax ? fmtNum(numMax) : null;

  if (fMin && fMax) {
    if (fMin === fMax) return `${c} ${fMin}`;
    return `${c} ${fMin}–${fMax}`;
  }
  if (fMin) return `${c} ${fMin}+`;
  if (fMax) return `Up to ${c} ${fMax}`;
  return null;
};

const salary = formatSalary(job.salaryMin, job.salaryMax, job.salaryCurrency);
const logoColor = `hsl(${Math.abs((job.companyName || "X").charCodeAt(0) * 7) % 360}, 60%, 52%)`;

const rawSnippet = (job.description || "").replace(/<[^>]*>?/gm, " ").replace(/\s+/g, " ").trim();
const seoDescription = `${job.jobTitle} opening at ${job.companyName || 'Verified Employer'} in ${job.locationCity || 'Remote'}. ${rawSnippet.slice(0, 150)}... Apply now on JobNed!`;

const seoJobData = {
  title: `${job.jobTitle} at ${job.companyName || 'Verified Employer'}`,
  description: rawSnippet || job.jobTitle,
  datePosted: new Date().toISOString(),
  employmentType: job.employmentType || "Full-time",
  companyName: job.companyName || "Verified Employer",
  companyLogo: job.companyLogo || undefined,
  locationCity: job.locationCity || "Remote",
  isRemote: !!job.locationRemote || (job.locationCity || "").toLowerCase().includes("remote"),
  salaryMin: job.salaryMin || null,
  salaryMax: job.salaryMax || null,
  salaryCurrency: job.salaryCurrency || "USD",
};
---

<DashboardLayout 
  title={`${job.jobTitle} at ${job.companyName || 'Company'} - Job Opening`} 
  description={seoDescription}
  image={job.companyLogo || undefined}
  noindex={false}
  jobData={seoJobData}
  schemaType="JobPosting"
  userType={userType} 
  activePath={
    payload?.userType === 'employer' ? '/employer/jobs' : 
    payload?.userType === 'masteradmin' ? '/masteradmin/employers' : 
    payload?.userType === 'superadmin' ? '/superadmin/employers' : 
    payload?.userType === 'admin' ? '/admin/jobs' : '/jobs'
  }
>
  <div class="job-detail-page-wrapper">
    <div class="back-nav mb-5">
      <a 
        href={defaultBackUrl} 
        class="back-link"
        onclick="if (window.history && window.history.length > 1 && document.referrer && document.referrer.includes(window.location.host)) { window.history.back(); return false; }"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        Back
      </a>
    </div>

    <div class="card main-info-card">
      <div class="header-section">
        <div class="company-logo-large" style={`background: ${logoColor}`}>
          {(job.companyName || "?").charAt(0).toUpperCase()}
        </div>
        <div class="header-meta">
          <h1>{job.jobTitle}</h1>
          <p class="company-name-text">
            {job.companyName || "Company"} 
            {job.companyWebsite && (
              <a href={job.companyWebsite} target="_blank" rel="noopener noreferrer" class="website-link">
                Visit Website ↗
              </a>
            )}
          </p>
          <div class="tags mt-3">
            {job.locationRemote && <span class="tag tag-green">🌐 Remote</span>}
            {job.locationCity && !job.locationRemote && <span class="tag">📍 {job.locationCity}</span>}
            {job.employmentType && <span class="tag">⏱ {job.employmentType}</span>}
            {job.experienceLevel && <span class="tag">🎯 {job.experienceLevel}</span>}
            {salary && <span class="tag tag-salary">💰 {salary}</span>}
          </div>
        </div>
      </div>

      <hr class="divider mt-6 mb-6" />

      <div class="content-section">
        <h2>Job Description</h2>
        <div class="description-text" set:html={sanitizeRichHtml(job.description)} />
      </div>

      {(() => {
        let reqs = job.requirements;
        if (typeof reqs === 'string') {
          try { reqs = JSON.parse(reqs); } catch (e) {}
        }
        if (!reqs || (Array.isArray(reqs) && reqs.length === 0) || reqs === '[]' || reqs === '') return null;
        return (
          <div class="content-section mt-6">
            <h2>Requirements</h2>
            {Array.isArray(reqs) ? (
              <ul class="requirements-list">
                {reqs.map((r: string) => <li>{r}</li>)}
      </ul>
            ) : (
              <div class="requirements-text">{reqs}</div>
            )}
          </div>
        );
      })()}

      <!-- 1. GUEST VISITOR STATE: Require login before accessing application or company external redirect -->
      {!payload ? (
        <div class="application-section mt-8">
          <div class="guest-apply-cta-card">
            <div class="cta-badge-pill">
              <span class="verified-dot"></span>
              {job.applyMode === 'redirect' ? 'Verified Career Opportunity' : 'Open Position'}
            </div>
            <div class="cta-icon-wrapper">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </div>
            <div class="cta-content">
              <h3 class="cta-heading">Log in to Apply</h3>
              <p class="cta-text">
                Please log in or create a free candidate profile on JobNed to access the official application link for <strong>{job.companyName || 'this employer'}</strong> and track your application status.
              </p>
              <div class="cta-actions mt-4">
                <a href={`/login?redirect=/jobs/${job.id}`} class="btn btn-primary btn-cta">
                  <span>Log In to Apply</span>
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                  </svg>
                </a>
                <a href={`/register?type=employee&redirect=/jobs/${job.id}`} class="btn btn-outline btn-cta">
                  Create Free Account
                </a>
              </div>
              <span class="cta-footnote">✨ Free for all job seekers • Access direct employer application links</span>
            </div>
          </div>
        </div>
      ) : job.applyMode === 'redirect' && job.externalApplyUrl ? (
        /* 2. LOGGED-IN USERS: External Career Portal (Redirect) */
        <div class="application-section mt-8">
          <div class="external-apply-cta-card">
            <div class="cta-badge-pill">
              <span class="verified-dot"></span>
              Verified Career Opportunity
            </div>
            <div class="cta-icon-wrapper">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </div>
            <div class="cta-content">
              <h3 class="cta-heading">Apply on Official Company Portal</h3>
              <p class="cta-text">
                This position is actively hiring directly through <strong>{job.companyName || 'the employer'}</strong>'s official career website.
              </p>
              <div class="cta-actions mt-4">
                <a 
                  href={job.externalApplyUrl} 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn-external-apply"
                >
                  <span>Apply on Company Website ↗</span>
                </a>
              </div>
              <span class="cta-footnote mt-2">🔒 Secure link to official application page</span>
            </div>
          </div>
        </div>
      ) : payload?.userType === 'employee' ? (
        /* 3. LOGGED-IN CANDIDATE: Native 1-Click Apply */
        <div class="application-section mt-8">
          {alreadyApplied ? (
            <div class="applied-state-inline">
              <div class="applied-info">
                <span class="applied-badge">✓ Applied</span>
                <p>You have already submitted an application for this job posting.</p>
              </div>
              <a href={`/applications/${appId}`} class="btn btn-outline">View My Application</a>
            </div>
          ) : (
            <div class="apply-container-inline">
              <h2>Apply for this Job</h2>
              <p class="subtitle">Please fill out the form below to submit your resume and profile.</p>
              
              <form id="applyForm" class="apply-form mt-4">
                <input type="hidden" name="jobId" id="applyJobId" value={job.id} />
                <input type="hidden" id="hasDefaultResume" value={candidateUser?.defaultResumeUrl ? 'true' : 'false'} />
                
                <div class="form-grid">
                  {candidateUser?.defaultResumeUrl ? (
                    <div class="form-group full-width-group">
                      <label class="form-label">Resume Submission <span class="required">*</span></label>
                      <div class="resume-choice-toggle-container">
                        <label class="resume-choice-card active" id="choiceDefaultResumeLabel">
                          <input type="radio" name="resumeMode" id="modeDefaultResume" value="default" checked />
                          <div class="resume-choice-content">
                            <div class="choice-header">
                              <span class="choice-title">📄 Apply with Saved Default Resume</span>
                              <span class="choice-badge">Recommended</span>
                            </div>
                            <p class="choice-sub">Uses your pre-uploaded profile resume for fast 1-click application.</p>
                            <div class="default-resume-preview-row">
                              <span class="resume-ready-indicator">✓ Active Resume Attached</span>
                              <a href={getResumeViewerUrl(candidateUser.defaultResumeUrl, Astro.url.origin)} target="_blank" class="preview-mini-link">Preview Resume ↗</a>
                            </div>
                          </div>
                        </label>

                        <label class="resume-choice-card" id="choiceCustomResumeLabel">
                          <input type="radio" name="resumeMode" id="modeCustomResume" value="custom" />
                          <div class="resume-choice-content">
                            <div class="choice-header">
                              <span class="choice-title">📤 Upload a Different Resume</span>
                            </div>
                            <p class="choice-sub">Upload a tailored resume PDF specifically for this job role.</p>
                          </div>
                        </label>
                      </div>

                      <div id="customResumeUploadBox" class="custom-upload-container mt-3" style="display: none;">
                        <label class="form-label" for="resumeFile">Select Custom PDF Resume <span class="required">*</span></label>
                        <input type="file" id="resumeFile" class="form-input" accept="application/pdf" />
                        <span class="input-helper">Please upload your custom resume in PDF format (max 5MB).</span>
                        <label class="checkbox-option mt-2">
                          <input type="checkbox" id="saveAsDefault" name="saveAsDefault" />
                          <span class="checkbox-text">Update my saved default resume with this file</span>
                        </label>
                      </div>
                    </div>
                  ) : (
                    <div class="form-group full-width-group">
                      <div class="no-default-resume-tip mb-3">
                        <div class="tip-icon">💡</div>
                        <div class="tip-body">
                          <strong>No default resume uploaded yet</strong>
                          <p>You can upload a resume for this application below, and optionally save it to your profile for 1-click apply next time.</p>
                        </div>
                      </div>
                      <label class="form-label" for="resumeFile">Upload Resume (PDF) <span class="required">*</span></label>
                      <input type="file" id="resumeFile" class="form-input" accept="application/pdf" required />
                      <span class="input-helper">Please upload your resume in PDF format (max 5MB).</span>
                      <label class="checkbox-option mt-2">
                        <input type="checkbox" id="saveAsDefault" name="saveAsDefault" checked />
                        <span class="checkbox-text">Save this as my default resume for future 1-click applications</span>
                      </label>
                    </div>
                  )}

                  <div class="form-group">
                    <label class="form-label" for="candidateName">Full Name</label>
                    <input type="text" id="candidateName" class="form-input" value={candidateUser?.fullName || payload.name || ''} placeholder="Your full name" required />
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="candidateEmail">Email Address</label>
                    <input type="email" id="candidateEmail" class="form-input" value={candidateUser?.email || payload.email || ''} placeholder="you@example.com" required />
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="candidatePhone">Phone Number</label>
                    <input type="tel" id="candidatePhone" class="form-input" value={candidateUser?.phone || ''} placeholder="+1 (555) 000-0000" />
                  </div>

                  <div class="form-group">
                    <label class="form-label" for="candidateLocation">Current Location</label>
                    <input type="text" id="candidateLocation" class="form-input" value={candidateUser?.location || ''} placeholder="City, Country" />
                  </div>

                  <div class="form-group full-width-group">
                    <label class="form-label" for="candidateHeadline">Professional Headline</label>
                    <input type="text" id="candidateHeadline" class="form-input" value={candidateUser?.headline || ''} placeholder="e.g. Senior Frontend Developer with 5+ years experience" />
                  </div>
                </div>

                {/* Screening Questions Section */}
                {screeningQuestions.length > 0 && (
                  <div class="screening-questions-section mt-4">
                    <div class="screening-header">
                      <h3 class="screening-title">Employer Screening Questions</h3>
                      <p class="screening-subtitle">The employer has requested answers to the following questions:</p>
                    </div>
                    
                    <div class="screening-questions-list mt-3">
                      {screeningQuestions.map((q: any, idx: number) => (
                        <div class="screening-item mb-4" data-q-id={q.id} data-q-type={q.type} data-q-text={q.text} data-q-required={q.required ? 'true' : 'false'}>
                          <label class="form-label screening-question-label">
                            <span class="question-num">{idx + 1}.</span> {q.text}
                            {q.required && <span class="required">*</span>}
                          </label>

                          {q.type === 'text' && (
                            <input 
                              type="text" 
                              class="form-input screening-answer-input" 
                              name={`sq_${q.id}`} 
                              placeholder="Your answer..."
                              required={q.required}
                            />
                          )}

                          {q.type === 'paragraph' && (
                            <textarea 
                              class="form-textarea screening-answer-input" 
                              name={`sq_${q.id}`} 
                              rows="3" 
                              placeholder="Your answer..."
                              required={q.required}
                            ></textarea>
                          )}

                          {q.type === 'yes_no' && (
                            <div class="screening-radio-group">
                              <label class="radio-label">
                                <input type="radio" name={`sq_${q.id}`} value="Yes" required={q.required} />
                                <span class="radio-custom"></span>
                                <span class="radio-text">Yes</span>
                              </label>
                              <label class="radio-label">
                                <input type="radio" name={`sq_${q.id}`} value="No" required={q.required} />
                                <span class="radio-custom"></span>
                                <span class="radio-text">No</span>
                              </label>
                            </div>
                          )}

                          {q.type === 'select' && (
                            <select class="form-input screening-answer-input" name={`sq_${q.id}`} required={q.required}>
                              <option value="">Select an option...</option>
                              {(q.options || []).map((opt: string) => (
                                <option value={opt}>{opt}</option>
                              ))}
                            </select>
                          )}
                        </div>
                      ))}
                    </div>
                  </div>
                )}

                <div class="form-group mt-3">
                  <label class="form-label" for="coverLetter">Cover Letter / Note to Recruiter</label>
                  <textarea id="coverLetter" class="form-textarea" rows="4" placeholder="Tell the employer why you are a great fit for this position..."></textarea>
                </div>

                <div class="submit-row mt-4">
                  <button type="submit" class="btn btn-primary" id="submitApplyBtn">
                    <span id="submitApplyText">Submit Application</span>
                    <span id="submitApplySpinner" style="display: none;">Submitting...</span>
                  </button>
                </div>
              </form>
            </div>
          )}
        </div>
      ) : null}

      <!-- Employer Applicants Management Section -->
      {payload?.userType === 'employer' && (
        <div class="employer-applicants-section mt-8">
          <div class="applicants-section-header">
            <div>
              <div class="section-title-badge">
                <span class="badge-tag">Recruiter View</span>
                <h2>Applicants for this Role ({jobApplicants.length})</h2>
              </div>
              <p class="subtitle">Review candidates who applied for "{job.jobTitle}"</p>
            </div>
            <div class="header-action-buttons">
              <a href={`/employer/jobs/${job.id}/edit`} class="btn btn-outline">
                ✏️ Edit Job
              </a>
              <a href={`/employer/applications?jobId=${job.id}`} class="btn btn-primary">
                Open Full Table ↗
              </a>
            </div>
          </div>

          {jobApplicants.length === 0 ? (
            <div class="empty-applicants-box mt-4">
              <div class="empty-icon">📭</div>
              <h3>No applications received yet</h3>
              <p>When candidates apply, their resumes, profiles, and compatibility scores will be listed here.</p>
              <a href="/employer/candidates" class="btn btn-outline mt-3">Find Matching Candidates</a>
            </div>
          ) : (
            <div class="applicants-cards-grid mt-5">
              {jobApplicants.map((app) => (
                <div class="candidate-applicant-card">
                  <div class="candidate-card-header">
                    <div class="candidate-avatar">
                      {app.avatarUrl ? (
                        <img src={app.avatarUrl} alt={`${app.applicantFirstName} ${app.applicantLastName}`} />
                      ) : (
                        <span>{app.applicantFirstName?.charAt(0) || 'C'}{app.applicantLastName?.charAt(0) || ''}</span>
                      )}
                    </div>
                    <div class="candidate-primary-info">
                      <h4 class="candidate-name">{app.applicantFirstName} {app.applicantLastName}</h4>
                      <span class="candidate-email">{app.applicantEmail}</span>
                      {app.headline && <p class="candidate-headline">{app.headline}</p>}

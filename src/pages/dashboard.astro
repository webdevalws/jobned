</style>

<script define:vars={{ appliedArray: Array.from(appliedJobIds) }}>
  const appliedSet = new Set(appliedArray || []);
  let currentJobsPage = 1;
  const jobsPerPage = 4;
  let isLoadingJobs = false;
  let hasMoreJobs = true;

  function escHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function formatSalary(min, max, currency) {
    if ((min === null || min === undefined || min === '') && (max === null || max === undefined || max === '')) return null;
    const c = (currency || 'USD').trim();
    const numMin = Number(min);
    const numMax = Number(max);

    const validMin = !isNaN(numMin) && isFinite(numMin) && numMin > 0;
    const validMax = !isNaN(numMax) && isFinite(numMax) && numMax > 0;
    if (!validMin && !validMax) return null;

    const fmtNum = (n) => {
      if (n >= 1_000_000_000_000) {
        const val = n / 1_000_000_000_000;
        return val > 999 ? '999T+' : `${val.toFixed(1).replace(/\.0$/, '')}T`;
      }
      if (n >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(1).replace(/\.0$/, '')}B`;
      if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
      if (n >= 1_000) return `${(n / 1_000).toFixed(0)}k`;
      return `${Math.round(n)}`;
    };

    const fMin = validMin ? fmtNum(numMin) : null;
    const fMax = validMax ? fmtNum(numMax) : null;

    if (fMin && fMax) {
      if (fMin === fMax) return `${c} ${fMin}`;
      return `${c} ${fMin}–${fMax}`;
    }
    if (fMin) return `${c} ${fMin}+`;
    if (fMax) return `Up to ${c} ${fMax}`;
    return null;
  }

  function renderDashboardJobs(jobs) {
    const container = document.getElementById('dashboardJobsList');
    if (!container) return;

    if (!jobs || jobs.length === 0) {
      container.innerHTML = `
        <div class="empty-state-card">
          <div class="empty-icon">💼</div>
          <p>No more jobs found on this page.</p>
          <a href="/jobs" class="btn btn-primary mt-3">Browse All Jobs</a>
        </div>
      `;
      return;
    }

    const html = jobs.map((job) => {
      const isApplied = appliedSet.has(job.id);
      const compName = job.companyName || 'Featured Company';
      const firstLetter = compName.charAt(0).toUpperCase();
      const logoColor = `hsl(${Math.abs(compName.charCodeAt(0) * 7) % 360}, 60%, 52%)`;
      const salary = formatSalary(job.salaryMin, job.salaryMax, job.salaryCurrency);

      return `
        <a href="${isApplied ? '/applications' : `/jobs/${job.id}`}" class="job-card-modern">
          <div class="job-card-top">
            <div class="job-title-group">
              <div class="job-avatar-pill" style="background: ${logoColor};">
                ${firstLetter}
              </div>
              <div class="job-title-group-text">
                <h4 class="job-card-title">${escHtml(job.jobTitle || 'Job Position')}</h4>
                <p class="job-card-company">${escHtml(compName)}</p>
              </div>
            </div>
            ${isApplied ? `
              <span class="applied-pill">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                Applied
              </span>
            ` : `
              <span class="apply-cta-pill">Apply Now &rarr;</span>
            `}
          </div>

          <div class="job-card-bottom">
            <div class="job-tags-row">
              ${job.locationRemote ? '<span class="tag tag-remote">🌐 Remote</span>' : `<span class="tag">📍 ${escHtml(job.locationCity || 'Onsite')}</span>`}
              <span class="tag">⏱ ${escHtml(job.employmentType || 'Full-time')}</span>
              ${salary ? `<span class="tag tag-salary">💰 ${escHtml(salary)}</span>` : ''}
            </div>
          </div>
        </a>
      `;
    }).join('');

    container.innerHTML = html;
  }

  async function loadDashboardJobs(page) {
    if (isLoadingJobs || page < 1) return;
    isLoadingJobs = true;

    const container = document.getElementById('dashboardJobsList');
    const prevBtn = document.getElementById('prevJobsBtn');
    const nextBtn = document.getElementById('nextJobsBtn');
    const indicator = document.getElementById('jobsPageIndicator');

    if (container) {
      container.style.opacity = '0.35';
      container.style.pointerEvents = 'none';
    }

    try {
      const res = await fetch(`/api/jobs/search?page=${page}&limit=${jobsPerPage}`);
      if (res.ok) {
        const data = await res.json();
        const jobs = data.jobs || [];
        hasMoreJobs = data.hasMore ?? (jobs.length === jobsPerPage);
        currentJobsPage = page;

        if (jobs.length > 0) {
          renderDashboardJobs(jobs);
        } else if (page > 1) {
          hasMoreJobs = false;
        }

        if (indicator) indicator.textContent = `${currentJobsPage}`;
        if (prevBtn) prevBtn.disabled = currentJobsPage <= 1;
        if (nextBtn) nextBtn.disabled = !hasMoreJobs;
      }
    } catch (err) {
      console.error('Error fetching dashboard jobs:', err);
    } finally {
      isLoadingJobs = false;
      if (container) {
        container.style.opacity = '1';
        container.style.pointerEvents = 'auto';
      }
    }
  }

  // Setup buttons
  function initDashboardJobsPagination() {
    const prevBtn = document.getElementById('prevJobsBtn');
    const nextBtn = document.getElementById('nextJobsBtn');

    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (currentJobsPage > 1) {
          loadDashboardJobs(currentJobsPage - 1);
        }
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.preventDefault();
        if (hasMoreJobs) {
          loadDashboardJobs(currentJobsPage + 1);
        }
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDashboardJobsPagination);
  } else {
    initDashboardJobsPagination();
  }
</script>

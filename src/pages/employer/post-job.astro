    transition: all 0.2s ease !important;
  }
  :global(.ck.ck-toolbar .ck-button:hover),
  :global(.ck.ck-toolbar .ck-button.ck-on),
  :global(.ck.ck-button.ck-dropdown__button:hover),
  :global(.ck.ck-button.ck-dropdown__button.ck-on),
  :global(.ck.ck-button.ck-dropdown__button.ck-focused) {
    background-color: rgba(128, 128, 128, 0.15) !important;
    color: var(--color-text-main) !important;
  }
  :global(.ck.ck-editor__main > .ck-editor__editable:not(.ck-focused)) {
    border-color: var(--color-border) !important;

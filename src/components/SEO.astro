---
import { getBaseUrl } from "../lib/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article" | "job" | "profile";
  noindex?: boolean;
  canonicalUrl?: string;
  keywords?: string;
  author?: string;
  publishedTime?: string;
  modifiedTime?: string;
  schemaType?:
    | "WebSite"
    | "Organization"
    | "JobPosting"
    | "SoftwareApplication"
    | "BreadcrumbList";
  jobData?: {
    title: string;
    description: string;
    datePosted?: string;
    validThrough?: string;
    employmentType?: string;
    companyName?: string;
    companyLogo?: string;
    locationCity?: string;
    locationState?: string;
    locationCountry?: string;
    isRemote?: boolean;
    salaryMin?: number | null;
    salaryMax?: number | null;
    salaryCurrency?: string;
  };
  customSchema?: Record<string, any>;
}

const {
  title,
  description = "JobNed is an AI-powered job board and recruitment platform connecting top-tier talent with world-class tech hiring opportunities.",
  image = "/images/og-default.png",
  type = "website",
  noindex = false,
  canonicalUrl,
  keywords = "JobNed, jobs, hiring, recruitment, tech jobs, software engineer jobs, candidate matching, AI recruitment, job portal, SaaS careers",
  author = "JobNed",
  publishedTime,
  modifiedTime,
  schemaType,
  jobData,
  customSchema,
} = Astro.props;

// Base URL calculation
const baseUrl = getBaseUrl();
const siteName = "JobNed";
const defaultTitle = "JobNed - AI-Powered Job & Talent Matching Platform";
const formattedTitle = title
  ? title.includes(siteName)
    ? title
    : `${title} | ${siteName}`
  : defaultTitle;

// Absolute Canonical & Image URLs (Uses request origin dynamically so live site domain matches canonical URL)
const currentOrigin = Astro.url?.origin
  ? Astro.url.origin.replace(/\/+$/, "")
  : baseUrl;
const pathname = Astro.url?.pathname || "";
const absoluteCanonical = canonicalUrl || `${currentOrigin}${pathname}`;
const absoluteImage = image.startsWith("http")
  ? image
  : `${currentOrigin}${image.startsWith("/") ? image : `/${image}`}`;

// Robots directive
const robotsContent = noindex
  ? "noindex, nofollow"
  : "index, follow, max-image-preview:large";

// Base Schema.org Objects
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "JobNed",
  url: baseUrl,
  logo: `${baseUrl}/images/logo-icon.png`,
  sameAs: [
    "https://twitter.com/jobned",
    "https://linkedin.com/company/jobned",
  ],
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "JobNed",
  url: baseUrl,
  potentialAction: {
    "@type": "SearchAction",
    target: `${baseUrl}/jobs?q={search_term_string}`,
    "query-input": "required name=search_term_string",
  },
};

const appSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "JobNed",
  operatingSystem: "All",
  applicationCategory: "BusinessApplication",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
};

// JobPosting Schema.org for Google for Jobs
let jobPostingSchema: any = null;
if (jobData || schemaType === "JobPosting") {
  const d = jobData || {
    title: title || "Job Opening",
    description: description,
  };
  jobPostingSchema = {
    "@context": "https://schema.org",
    "@type": "JobPosting",
    title: d.title || title || "Job Opening",
    description: d.description
      ? d.description.replace(/<[^>]*>?/gm, "")
      : description,
    datePosted: d.datePosted || new Date().toISOString(),
    validThrough:
      d.validThrough ||
      new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString(),
    employmentType: d.employmentType
      ? d.employmentType.toUpperCase().replace("-", "_")
      : "FULL_TIME",
    hiringOrganization: {
      "@type": "Organization",
      name: d.companyName || "JobNed Verified Partner",
      logo: d.companyLogo
        ? d.companyLogo.startsWith("http")
          ? d.companyLogo
          : `${baseUrl}${d.companyLogo}`
        : `${baseUrl}/images/logo-icon.png`,
      sameAs: baseUrl,
    },
    jobLocation: d.isRemote
      ? {
          "@type": "Place",
          address: {
            "@type": "PostalAddress",
            addressCountry: d.locationCountry || "US",
          },
        }
      : {
          "@type": "Place",
          address: {
            "@type": "PostalAddress",
            addressLocality: d.locationCity || "Remote",
            addressRegion: d.locationState || "",
            addressCountry: d.locationCountry || "US",
          },
        },
    jobLocationType: d.isRemote ? "TELECOMMUTE" : undefined,
    applicantLocationRequirements: d.isRemote
      ? {
          "@type": "Country",
          name: d.locationCountry || "USA",
        }
      : undefined,
  };

  if (d.salaryMin || d.salaryMax) {
    jobPostingSchema.baseSalary = {
      "@type": "MonetaryAmount",
      currency: d.salaryCurrency || "USD",
      value: {
        "@type": "QuantitativeValue",
        minValue: d.salaryMin || d.salaryMax,
        maxValue: d.salaryMax || d.salaryMin,
        unitText: "YEAR",
      },
    };
  }
}
---

<!-- Primary Meta Tags -->
<title>{formattedTitle}</title>
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="title" content={formattedTitle} />
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content={author} />
<meta name="robots" content={robotsContent} />
<meta name="theme-color" content="#10B981" />

<!-- Canonical URL -->
<link rel="canonical" href={absoluteCanonical} />

<!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
<meta property="og:site_name" content={siteName} />
<meta property="og:type" content={type === "job" ? "website" : type} />
<meta property="og:url" content={absoluteCanonical} />
<meta property="og:title" content={formattedTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
{
  publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )
}
{
  modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )
}

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={absoluteCanonical} />
<meta name="twitter:title" content={formattedTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:site" content="@jobned" />
<meta name="twitter:creator" content="@jobned" />

<!-- Schema.org JSON-LD Structured Data -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationSchema)}
/>
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{
  schemaType === "SoftwareApplication" && (
    <script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
  )
}
{
  jobPostingSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jobPostingSchema)}
    />
  )
}
{
  customSchema && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(customSchema)}
    />
  )
}

---
// JobNed AI Guide - Intelligent Platform Assistant
---

<div id="jobned-assistant-root">
  <!-- Proactive Teaser Speech Bubble -->
  <div id="jobned-teaser-bubble" class="teaser-bubble" style="display: none;">
    <div class="teaser-content">
      <span class="teaser-wave">👋</span>
      <span class="teaser-text">Need help finding a job or hiring? <strong>Ask AI!</strong></span>
    </div>
    <button id="jobned-teaser-close" class="teaser-close" aria-label="Dismiss teaser">✕</button>
  </div>

  <!-- Floating Launcher Button & Tooltip Wrapper -->
  <div class="launcher-wrapper">
    <span class="launcher-tooltip">Ask JobNed AI</span>
    <button id="jobned-assistant-toggle" class="assistant-launcher" aria-label="Open JobNed AI Assistant">
      <div class="launcher-pulse"></div>
      <div class="launcher-icon">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 8V4H8"></path>
          <rect width="16" height="12" x="4" y="8" rx="2"></rect>
          <path d="M2 14h2"></path>
          <path d="M20 14h2"></path>
          <path d="M15 13v2"></path>
          <path d="M9 13v2"></path>
        </svg>
      </div>
      <span class="launcher-online-dot"></span>
    </button>
  </div>

  <!-- Chat Dialog Modal -->
  <div id="jobned-assistant-dialog" class="assistant-modal" style="display: none;" role="dialog" aria-modal="true" aria-labelledby="assistant-heading">
    <!-- Header -->
    <div class="assistant-header">
      <div class="header-info">
        <div class="assistant-avatar">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 8V4H8"></path>
            <rect width="16" height="12" x="4" y="8" rx="2"></rect>
            <path d="M2 14h2"></path>
            <path d="M20 14h2"></path>
            <path d="M15 13v2"></path>
            <path d="M9 13v2"></path>
          </svg>
          <span class="avatar-status"></span>
        </div>
        <div>
          <div id="assistant-heading" class="assistant-title">JobNed AI Guide</div>
          <div class="assistant-subtitle">Live Platform & Job Assistant</div>
        </div>
      </div>

      <div class="header-actions">
        <!-- Clear Chat -->
        <button id="jobned-assistant-clear" class="header-btn" title="Clear Conversation" aria-label="Clear Chat">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="3 6 5 6 21 6"></polyline>
            <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
          </svg>
        </button>

        <!-- Close -->
        <button id="jobned-assistant-close" class="header-btn" title="Close Assistant" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
    </div>

    <!-- Quick Chips Bar -->
    <div class="quick-chips-wrapper" id="quick-chips">
      <div class="chips-scroll">
        <button class="chip-btn" data-query="Are there any developer or tech jobs available?">🔍 Developer Jobs</button>
        <button class="chip-btn" data-query="Show me remote work openings">🏠 Remote Jobs</button>
        <button class="chip-btn" data-query="How do I create an account?">🚀 Create Account</button>
        <button class="chip-btn" data-query="How do I apply for a job with my resume?">📄 How to Apply</button>
        <button class="chip-btn" data-query="How do I post a job as an employer?">💼 Post a Job</button>
        <button class="chip-btn" data-query="What are the recruitment plans and pricing?">💎 Pricing Plans</button>
        <button class="chip-btn" data-query="How does candidate screening & match scoring work?">🎯 Candidate Screening</button>
      </div>
    </div>

    <!-- Messages Container -->
    <div id="jobned-messages-container" class="assistant-body">
      <div id="messages-list" class="messages-list">
        <!-- Injected dynamically -->
      </div>

      <!-- Typing Indicator -->
      <div id="assistant-typing" class="assistant-message bot-message" style="display: none;">
        <div class="msg-bubble bot-bubble typing-bubble">
          <span class="dot"></span>
          <span class="dot"></span>
          <span class="dot"></span>
        </div>
      </div>
    </div>

    <!-- Scroll to bottom button -->
    <button id="scroll-bottom-btn" class="scroll-bottom-btn" style="display: none;" aria-label="Scroll to bottom">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>

    <!-- Input Footer -->
    <div class="assistant-footer">
      <form id="jobned-assistant-form" class="input-form">
        <input
          type="text"
          id="jobned-assistant-input"
          class="chat-input"
          placeholder="Ask a question or search jobs..."
          autocomplete="off"
          maxlength="500"
        />
        <button type="submit" id="jobned-assistant-send" class="send-btn" aria-label="Send message">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="22" y1="2" x2="11" y2="13"></line>
            <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
          </svg>
        </button>
      </form>
      <div class="footer-note">
        <span class="online-indicator-tiny"></span>
        <span>Official JobNed AI Assistant</span>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function() {
    const root = document.getElementById('jobned-assistant-root');
    const toggleBtn = document.getElementById('jobned-assistant-toggle');
    const dialog = document.getElementById('jobned-assistant-dialog');
    const closeBtn = document.getElementById('jobned-assistant-close');
    const clearBtn = document.getElementById('jobned-assistant-clear');
    const form = document.getElementById('jobned-assistant-form');
    const input = document.getElementById('jobned-assistant-input');
    const messagesList = document.getElementById('messages-list');
    const typingIndicator = document.getElementById('assistant-typing');
    const messagesContainer = document.getElementById('jobned-messages-container');
    const quickChips = document.getElementById('quick-chips');
    const scrollBottomBtn = document.getElementById('scroll-bottom-btn');
    const teaserBubble = document.getElementById('jobned-teaser-bubble');
    const teaserClose = document.getElementById('jobned-teaser-close');

    if (!toggleBtn || !dialog) return;

    let isWaiting = false;
    const STORAGE_KEY = 'jobned_ai_chat_v9';

    // Teaser speech bubble management
    const teaserDismissed = sessionStorage.getItem('jobned_teaser_dismissed');
    if (!teaserDismissed && teaserBubble) {
      setTimeout(() => {
        if (dialog.style.display === 'none') {
          teaserBubble.style.display = 'flex';
        }
      }, 2500);
    }

    if (teaserClose) {
      teaserClose.addEventListener('click', (e) => {
        e.stopPropagation();
        if (teaserBubble) teaserBubble.style.display = 'none';
        sessionStorage.setItem('jobned_teaser_dismissed', 'true');
      });
    }

    if (teaserBubble) {
      teaserBubble.addEventListener('click', () => {
        teaserBubble.style.display = 'none';
        sessionStorage.setItem('jobned_teaser_dismissed', 'true');
        toggleChat(true);
      });
    }

    function formatTime(date) {
      try {
        return new Intl.DateTimeFormat([], { hour: 'numeric', minute: '2-digit', hour12: true }).format(date);
      } catch (e) {
        return '';
      }
    }

    const CONV_ID_KEY = 'jobned_chat_conv_id';
    const VISITOR_NAME_KEY = 'jobned_chat_visitor_name';

    function getConversationId() {
      let id = sessionStorage.getItem(CONV_ID_KEY);
      if (!id) {
        id = typeof crypto !== 'undefined' && crypto.randomUUID ? crypto.randomUUID() : 'bc_' + Math.random().toString(36).slice(2) + Date.now().toString(36);
        sessionStorage.setItem(CONV_ID_KEY, id);
      }
      return id;
    }

    function getVisitorName() {
      return sessionStorage.getItem(VISITOR_NAME_KEY) || 'Anonymous';
    }

    function setVisitorName(name) {
      if (name && name !== 'Anonymous') {
        sessionStorage.setItem(VISITOR_NAME_KEY, name);
      }
    }

    // Default welcome prompt
    const defaultWelcome = {
      role: 'assistant',
      content: "👋 Hello! I am your **JobNed AI Guide**.\n\nI can help you with:\n• **Live Job Openings:** Search roles, salaries, or remote positions.\n• **Job Seekers:** Step-by-step guidance on creating a profile and applying.\n• **Employers:** Instructions on posting jobs, pricing plans, and candidate screening.\n\nHow can I help you today?",
      timestamp: formatTime(new Date()),
      jobs: []
    };

    function loadMessages() {
      try {
        const stored = sessionStorage.getItem(STORAGE_KEY);
        if (stored) {
          const parsed = JSON.parse(stored);
          if (Array.isArray(parsed) && parsed.length > 0) {
            // Filter out any stored error messages
            const clean = parsed.filter(m => !m.content || !m.content.startsWith('⚠️'));
            if (clean.length > 0) return clean;
          }
        }
      } catch (e) {}
      return [defaultWelcome];
    }

    function saveMessages(msgs) {
      try {
        const clean = msgs.filter(m => !m.content || !m.content.startsWith('⚠️'));
        sessionStorage.setItem(STORAGE_KEY, JSON.stringify(clean.slice(-15)));
      } catch (e) {}
    }

    let chatMessages = loadMessages();
    getConversationId(); // initialize ID early

    function formatInline(str) {
      if (!str) return '';
      // Inline code `code`
      let res = str.replace(/`([^`]+)`/g, '<code class="ai-inline-code">$1</code>');
      // Markdown links: [Title](url)
      res = res.replace(/\[([^\]]+)\]\(([^)]+)\)/g, function(_, label, url) {
        const cleanUrl = url.trim();
        const isExternal = cleanUrl.startsWith('http');
        return `<a href="${cleanUrl}" class="ai-msg-link" target="${isExternal ? '_blank' : '_self'}" rel="noopener noreferrer">${label}</a>`;
      });
      // Bold: **text** or __text__
      res = res.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
      res = res.replace(/__([^_]+)__/g, '<strong>$1</strong>');
      // Italic: *text* or _text_
      res = res.replace(/(^|[^\w*])\*([^\s*][^*]*[^\s*]|[^\s*])\*(?=[^\w*]|$)/g, '$1<em>$2</em>');
      res = res.replace(/(^|[^\w_])_([^\s_][^_]*[^\s_]|[^\s_])_(?=[^\w_]|$)/g, '$1<em>$2</em>');
      return res;
    }

    // Robust Safe Markdown Parser
    function parseMarkdown(text) {
      if (!text) return '';
      let safe = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      const lines = safe.split(/\r?\n/);
      let inUl = false;
      let inOl = false;
      const processed = [];

      for (let i = 0; i < lines.length; i++) {
        let line = lines[i].trim();
        if (!line) {
          if (inUl) { processed.push('</ul>'); inUl = false; }
          if (inOl) { processed.push('</ol>'); inOl = false; }
          continue;
        }

        const headingMatch = line.match(/^(#{1,6})\s+(.+)$/);
        const bulletMatch = line.match(/^([•\-\*\+])\s+(.+)$/);
        const numberMatch = line.match(/^(\d+[\.\)])\s+(.+)$/);

        if (headingMatch) {
          if (inUl) { processed.push('</ul>'); inUl = false; }
          if (inOl) { processed.push('</ol>'); inOl = false; }
          processed.push(`<div class="ai-heading">${formatInline(headingMatch[2])}</div>`);
        } else if (bulletMatch) {
          if (inOl) { processed.push('</ol>'); inOl = false; }
          if (!inUl) { processed.push('<ul>'); inUl = true; }
          processed.push(`<li>${formatInline(bulletMatch[2])}</li>`);
        } else if (numberMatch) {
          if (inUl) { processed.push('</ul>'); inUl = false; }
          if (!inOl) { processed.push('<ol>'); inOl = true; }
          processed.push(`<li>${formatInline(numberMatch[2])}</li>`);
        } else {
          if (inUl) { processed.push('</ul>'); inUl = false; }
          if (inOl) { processed.push('</ol>'); inOl = false; }
          processed.push(`<p class="ai-p">${formatInline(line)}</p>`);
        }
      }

      if (inUl) processed.push('</ul>');
      if (inOl) processed.push('</ol>');

      return processed.join('');
    }

    // Render Job Cards
    function renderJobCards(jobs) {
      if (!Array.isArray(jobs) || jobs.length === 0) return '';
      return `
        <div class="ai-job-cards-container">
          <div class="ai-job-cards-header">📌 Matching Positions</div>
          ${jobs.map(job => `
            <div class="ai-job-card">
              <div class="job-card-top">
                <a href="/jobs/${job.id}" class="job-card-title">${escapeHtml(job.jobTitle)}</a>
                <span class="job-card-type">${escapeHtml(job.employmentType || 'Full-time')}</span>
              </div>
              <div class="job-card-company">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                <span>${escapeHtml(job.companyName || 'Verified Employer')}</span>
              </div>
              <div class="job-card-meta">
                <span class="meta-tag ${job.locationRemote ? 'tag-remote' : ''}">
                  ${job.locationRemote ? '🏠 Remote' : `📍 ${escapeHtml(job.locationCity || 'Onsite')}`}
                </span>
                ${job.salaryMin ? `
                  <span class="meta-tag tag-salary">
                    💵 ${job.salaryMin.toLocaleString()} - ${job.salaryMax ? job.salaryMax.toLocaleString() : ''} ${escapeHtml(job.salaryCurrency || 'USD')}
                  </span>
                ` : ''}
              </div>
              <a href="/jobs/${job.id}" class="job-card-action">View Opening →</a>
            </div>
          `).join('')}
        </div>
      `;
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderMessages() {
      if (!messagesList) return;
      messagesList.innerHTML = '';

      chatMessages.forEach((msg, idx) => {
        const isUser = msg.role === 'user';
        const msgEl = document.createElement('div');
        msgEl.className = `assistant-message ${isUser ? 'user-message' : 'bot-message'}`;

        if (isUser) {
          msgEl.innerHTML = `
            <div class="msg-bubble user-bubble">
              <div class="msg-content">${parseMarkdown(msg.content)}</div>
              ${msg.timestamp ? `<div class="msg-time user-time">${escapeHtml(msg.timestamp)}</div>` : ''}
            </div>
          `;
        } else {
          msgEl.innerHTML = `
            <div class="msg-bubble bot-bubble">
              <button class="msg-copy-btn" title="Copy text" data-idx="${idx}" aria-label="Copy reply">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
              <div class="msg-content">${parseMarkdown(msg.content)}</div>
              ${msg.jobs && msg.jobs.length > 0 ? renderJobCards(msg.jobs) : ''}
              ${msg.timestamp ? `<div class="msg-time bot-time">${escapeHtml(msg.timestamp)}</div>` : ''}
            </div>
          `;
        }

        messagesList.appendChild(msgEl);
      });

      // Bind copy buttons
      const copyBtns = messagesList.querySelectorAll('.msg-copy-btn');
      copyBtns.forEach(btn => {
        btn.addEventListener('click', (e) => {
          const idx = parseInt(btn.getAttribute('data-idx') || '-1', 10);
          if (idx >= 0 && chatMessages[idx]) {
            const rawContent = chatMessages[idx].content || '';
            navigator.clipboard.writeText(rawContent).then(() => {
              btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
              setTimeout(() => {
                btn.innerHTML = `<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>`;
              }, 1800);
            });
          }
        });
      });

      scrollToBottom();
    }

    function scrollToBottom() {
      if (messagesContainer) {
        messagesContainer.scrollTop = messagesContainer.scrollHeight;
      }
    }

    // Scroll listener for floating scroll-to-bottom button
    if (messagesContainer && scrollBottomBtn) {
      messagesContainer.addEventListener('scroll', () => {
        const threshold = 120;
        const diff = messagesContainer.scrollHeight - messagesContainer.scrollTop - messagesContainer.clientHeight;
        scrollBottomBtn.style.display = diff > threshold ? 'flex' : 'none';
      });

      scrollBottomBtn.addEventListener('click', () => {
        scrollToBottom();
      });
    }

    function toggleChat(open) {
      const isOpen = open !== undefined ? open : dialog.style.display === 'none';
      dialog.style.display = isOpen ? 'flex' : 'none';
      toggleBtn.classList.toggle('active', isOpen);
      if (teaserBubble) teaserBubble.style.display = 'none';

      if (isOpen) {
        renderMessages();
        setTimeout(() => input && input.focus(), 150);
      }
    }

    toggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleChat();
    });

    closeBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      toggleChat(false);
    });

    // Close when clicking or tapping outside the chat dialog
    document.addEventListener('pointerdown', (e) => {
      if (dialog.style.display !== 'none') {
        const isInsideDialog = dialog.contains(e.target);
        const isToggleBtn = toggleBtn.contains(e.target);
        if (!isInsideDialog && !isToggleBtn) {
          toggleChat(false);
        }
      }
    });

    // Close on Escape key
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && dialog.style.display !== 'none') {
        toggleChat(false);
      }
    });

    clearBtn.addEventListener('click', () => {
      sessionStorage.removeItem(CONV_ID_KEY);
      sessionStorage.removeItem(VISITOR_NAME_KEY);
      sessionStorage.removeItem(STORAGE_KEY);
      getConversationId();
      chatMessages = [{
        ...defaultWelcome,
        timestamp: formatTime(new Date())
      }];
      saveMessages(chatMessages);
      renderMessages();
    });

    // Quick chips click
    if (quickChips) {
      quickChips.addEventListener('click', (e) => {
        const target = e.target.closest('.chip-btn');
        if (target && !isWaiting) {
          const query = target.getAttribute('data-query');
          if (query) {
            handleSend(query);
          }
        }
      });
    }

    async function handleSend(customText) {
      const text = (customText || (input ? input.value : '')).trim();
      if (!text || isWaiting) return;

      if (input) input.value = '';
      isWaiting = true;

      // Append user message
      const now = new Date();
      chatMessages.push({
        role: 'user',
        content: text,
        timestamp: formatTime(now)
      });
      saveMessages(chatMessages);
      renderMessages();

      if (typingIndicator) {
        typingIndicator.classList.add('active');
        typingIndicator.style.display = 'flex';
      }
      scrollToBottom();

      try {
        const cleanHistory = chatMessages
          .filter(m => !m.content || !m.content.startsWith('⚠️'))
          .slice(-8)
          .map(m => ({ role: m.role, content: m.content }));

        const res = await fetch('/api/ai/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: cleanHistory,
            currentPath: window.location.pathname || '/',
            conversationId: getConversationId(),
            visitorName: getVisitorName()
          })
        });

        const data = await res.json();
        if (data.visitorName && data.visitorName !== 'Anonymous') {
          setVisitorName(data.visitorName);
        }
        if (data.conversationId) {
          sessionStorage.setItem(CONV_ID_KEY, data.conversationId);
        }

        const reply = data.reply || (data.error ? `⚠️ ${data.error}` : 'Unable to generate response.');
        const jobs = Array.isArray(data.jobs) ? data.jobs : [];

        chatMessages.push({
          role: 'assistant',
          content: reply,
          timestamp: formatTime(new Date()),
          jobs: jobs
        });
        saveMessages(chatMessages);
      } catch (err) {
        chatMessages.push({
          role: 'assistant',
          content: '⚠️ Network connection issue. Could not reach JobNed AI. Please check your network and try again.',
          timestamp: formatTime(new Date()),
          jobs: []
        });
      } finally {
        isWaiting = false;
        if (typingIndicator) {
          typingIndicator.classList.remove('active');
          typingIndicator.style.display = 'none';
        }
        renderMessages();
      }
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      handleSend();
    });

    // Render initial state
    renderMessages();
  })();
</script>

<style is:global>
  #jobned-assistant-root {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 99999;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
  }

  @media (max-width: 768px) {
    #jobned-assistant-root {
      bottom: calc(76px + env(safe-area-inset-bottom, 0px)) !important;
      right: 16px !important;
    }
    #jobned-assistant-root .teaser-bubble {
      bottom: 68px !important;
      right: 0 !important;
      max-width: calc(100vw - 32px) !important;
    }
  }

  /* Teaser Speech Bubble (Dark Mode Default) */
  #jobned-assistant-root .teaser-bubble {
    position: absolute;
    bottom: 74px;
    right: 0;
    max-width: calc(100vw - 36px) !important;
    width: max-content !important;
    min-width: 250px;
    box-sizing: border-box !important;
    background: #1e1b4b;
    border: 1px solid rgba(167, 139, 250, 0.45);
    border-radius: 14px;
    padding: 9px 12px 9px 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.5), 0 0 15px rgba(99, 102, 241, 0.25);
    cursor: pointer;
    white-space: nowrap !important;
    animation: teaserFloat 3s ease-in-out infinite;
    z-index: 10;
  }

  #jobned-assistant-root .teaser-bubble::after {
    content: '';
    position: absolute;
    bottom: -6px;
    right: 24px;
    width: 12px;
    height: 12px;
    background: #1e1b4b;
    border-right: 1px solid rgba(167, 139, 250, 0.45);
    border-bottom: 1px solid rgba(167, 139, 250, 0.45);
    transform: rotate(45deg);
  }

  @keyframes teaserFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-4px); }
  }


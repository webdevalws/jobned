    padding: 0.25rem 0.75rem;
    background: rgba(99, 102, 241, 0.15);
    color: var(--color-primary);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.4rem;
  }

  .header-titles h1 {
    margin: 0 0 0.3rem 0;
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .subtitle {

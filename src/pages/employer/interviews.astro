---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { interviews, applications, jobPostings, users } from '../../db/schema';
import { eq, desc, and } from 'drizzle-orm';
import { generateGoogleCalendarUrl, generateOutlookCalendarUrl } from '../../lib/calendar';

const payload = Astro.locals.user;
if (!payload || payload.userType !== 'employer') {
  return Astro.redirect('/login');
}

const statusFilter = Astro.url.searchParams.get('status') || '';
const preselectedAppId = Astro.url.searchParams.get('appId') || '';

const db = getDb();

// 1. Fetch all interviews for this employer
const allInterviews = await db.select({
  id: interviews.id,
  applicationId: interviews.applicationId,
  jobPostingId: interviews.jobPostingId,
  title: interviews.title,
  interviewType: interviews.interviewType,
  meetingLink: interviews.meetingLink,
  scheduledAt: interviews.scheduledAt,
  durationMinutes: interviews.durationMinutes,
  status: interviews.status,
  notes: interviews.notes,
  interviewerNames: interviews.interviewerNames,
  timezone: interviews.timezone,
  jobTitle: jobPostings.jobTitle,
  candidateFirstName: users.firstName,
  candidateLastName: users.lastName,
  candidateEmail: users.email,
  candidateAvatar: users.avatarUrl,
  candidateHeadline: users.headline,
})
.from(interviews)
.innerJoin(jobPostings, eq(interviews.jobPostingId, jobPostings.id))
.innerJoin(users, eq(interviews.candidateId, users.id))
.where(eq(interviews.employerId, payload.userId))
.orderBy(desc(interviews.scheduledAt))
.all();

// 2. Fetch active candidates/applications to populate the searchable combobox with rich disambiguation metadata
const employerApps = await db.select({
  id: applications.id,
  jobPostingId: applications.jobPostingId,
  jobTitle: jobPostings.jobTitle,
  candidateId: users.id,
  candidateName: users.firstName,
  candidateLastName: users.lastName,
  candidateEmail: users.email,
  candidateAvatar: users.avatarUrl,
  candidateHeadline: users.headline,
  status: applications.status,
  aiScore: applications.aiScore,
  appliedAt: applications.appliedAt,
})
.from(applications)
.innerJoin(jobPostings, eq(applications.jobPostingId, jobPostings.id))
.innerJoin(users, eq(applications.applicantId, users.id))
.where(and(
  eq(applications.employerId, payload.userId),
  eq(jobPostings.status, 'published')
))
.orderBy(desc(applications.appliedAt))
.all();

// Filter interviews based on tab
const now = new Date();
let filteredInterviews = allInterviews;
if (statusFilter === 'upcoming') {
  filteredInterviews = allInterviews.filter(i => (i.status === 'scheduled' || i.status === 'rescheduled') && new Date(i.scheduledAt) >= now);
} else if (statusFilter === 'completed') {
  filteredInterviews = allInterviews.filter(i => i.status === 'completed' || (new Date(i.scheduledAt) < now && i.status !== 'cancelled'));
} else if (statusFilter === 'cancelled') {
  filteredInterviews = allInterviews.filter(i => i.status === 'cancelled');
}

const stats = {
  total: allInterviews.length,
  upcoming: allInterviews.filter(i => (i.status === 'scheduled' || i.status === 'rescheduled') && new Date(i.scheduledAt) >= now).length,
  completed: allInterviews.filter(i => i.status === 'completed').length,
  cancelled: allInterviews.filter(i => i.status === 'cancelled').length,
};

function formatInterviewTime(d: any) {
  if (!d) return '—';
  const date = d instanceof Date ? d : new Date(d);
  return date.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}
---

<DashboardLayout title="Interview Management" userType="employer" activePath="/employer/interviews">
  <div class="interviews-page-container">
    <!-- Header Section -->
    <div class="page-header mb-4">
      <div class="header-titles">
        <span class="badge-tag">Recruiter Workspace</span>
        <h1>Interview Scheduling & Calendar</h1>
        <p class="subtitle">Schedule, manage candidate interview rounds, and sync with Google Calendar & Outlook.</p>
      </div>

      <div class="header-actions-group" style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
        <a href="/employer/applications" class="btn btn-outline" title="Select candidates by role & status to schedule bulk interviews">
          ⚡ Bulk Schedule Interviews &rarr;
        </a>
        <button type="button" class="btn btn-primary btn-glow" onclick="openScheduleModal()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          Schedule Single Interview
        </button>
      </div>
    </div>

    <!-- Stats Summary Row -->
    <div class="stats-pills-grid mb-4">
      <a href="/employer/interviews" class={`stat-badge-card ${!statusFilter ? 'active-card' : ''}`}>
        <span class="stat-pill-num">{stats.total}</span>
        <span class="stat-pill-label">Total Rounds</span>
      </a>
      <a href="/employer/interviews?status=upcoming" class={`stat-badge-card pill-purple ${statusFilter === 'upcoming' ? 'active-card' : ''}`}>
        <span class="stat-pill-num">{stats.upcoming}</span>
        <span class="stat-pill-label">Upcoming</span>
      </a>
      <a href="/employer/interviews?status=completed" class={`stat-badge-card pill-green ${statusFilter === 'completed' ? 'active-card' : ''}`}>
        <span class="stat-pill-num">{stats.completed}</span>
        <span class="stat-pill-label">Completed</span>
      </a>
      <a href="/employer/interviews?status=cancelled" class={`stat-badge-card pill-red ${statusFilter === 'cancelled' ? 'active-card' : ''}`}>
        <span class="stat-pill-num">{stats.cancelled}</span>
        <span class="stat-pill-label">Cancelled</span>
      </a>
    </div>

    <!-- Interviews List -->
    <div class="interviews-list-container">
      {filteredInterviews.length === 0 ? (
        <div class="card empty-state-box">
          <div class="empty-icon">📅</div>
          <h3>No interviews found</h3>
          <p>You have no interviews matching this filter. Schedule an interview with any candidate to get started.</p>
          <button type="button" class="btn btn-primary mt-3" onclick="openScheduleModal()">
            Schedule Interview
          </button>
        </div>
      ) : (
        <div class="interviews-grid">
          {filteredInterviews.map((item) => {
            const isUpcoming = (item.status === 'scheduled' || item.status === 'rescheduled') && new Date(item.scheduledAt) >= now;
            const googleCalUrl = generateGoogleCalendarUrl({
              title: `${item.title} - ${item.candidateFirstName} ${item.candidateLastName}`,
              description: `Interview for ${item.jobTitle}.\nCandidate: ${item.candidateFirstName} ${item.candidateLastName} (${item.candidateEmail})\n\nNotes:\n${item.notes || 'None'}`,
              location: item.meetingLink || 'Online Video Meeting',
              startTime: item.scheduledAt,
              durationMinutes: item.durationMinutes || 45
            });
            const outlookCalUrl = generateOutlookCalendarUrl({
              title: `${item.title} - ${item.candidateFirstName} ${item.candidateLastName}`,
              description: `Interview for ${item.jobTitle}.\nCandidate: ${item.candidateFirstName} ${item.candidateLastName}`,
              location: item.meetingLink || 'Online Video Meeting',
              startTime: item.scheduledAt,
              durationMinutes: item.durationMinutes || 45
            });

            return (
              <div class={`interview-card card ${item.status}`}>
                <div class="interview-card-header">
                  <div class="candidate-meta-col">
                    <div class="candidate-avatar">
                      {item.candidateAvatar ? (
                        <img src={item.candidateAvatar} alt={item.candidateFirstName} />
                      ) : (
                        <span>{(item.candidateFirstName?.[0] || 'C').toUpperCase()}</span>
                      )}
                    </div>
                    <div>
                      <h3 class="candidate-name">{item.candidateFirstName} {item.candidateLastName}</h3>
                      <span class="job-applied-pill">💼 {item.jobTitle}</span>
                    </div>
                  </div>

                  <div class="status-tags-group">
                    <span class={`status-badge status-${item.status}`}>
                      {item.status === 'scheduled' ? 'Scheduled' : item.status === 'rescheduled' ? 'Rescheduled' : item.status === 'completed' ? 'Completed' : 'Cancelled'}
                    </span>
                    <span class="type-pill">
                      {item.interviewType === 'video' ? '🎥 Video Call' : item.interviewType === 'phone' ? '📞 Phone' : '📍 In-Person'}
                    </span>
                  </div>
                </div>

                <div class="interview-details-body">
                  <h4 class="interview-title">{item.title}</h4>
                  
                  <div class="info-row">
                    <div class="info-item">
                      <span class="info-label">Date & Time:</span>
                      <strong class="info-val highlight-time">🕒 {formatInterviewTime(item.scheduledAt)}</strong>
                    </div>
                    <div class="info-item">
                      <span class="info-label">Duration:</span>
                      <span class="info-val">⏱ {item.durationMinutes || 45} mins</span>
                    </div>
                  </div>

                  {item.interviewerNames && (
                    <div class="info-item mt-2">
                      <span class="info-label">Interviewers:</span>
                      <span class="info-val">👥 {item.interviewerNames}</span>
                    </div>
                  )}

                  {item.notes && (
                    <div class="interview-notes-box">
                      <strong>Agenda / Candidate Instructions:</strong>
                      <p>{item.notes}</p>
                    </div>
                  )}
                </div>

                <div class="interview-card-footer">
                  <div class="left-actions">
                    {item.meetingLink && (
                      <a href={item.meetingLink} target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">
                        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                        Join Meeting
                      </a>
                    )}

                    <!-- 1-Click Calendar Sync Dropdown -->
                    <div class="calendar-sync-dropdown">
                      <button type="button" class="btn btn-sm btn-outline cal-btn">
                        <span>📅 Add to Calendar</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="cal-dropdown-menu">
                        <a href={googleCalUrl} target="_blank" rel="noopener noreferrer" class="cal-menu-item">
                          <span>Google Calendar</span>
                        </a>
                        <a href={outlookCalUrl} target="_blank" rel="noopener noreferrer" class="cal-menu-item">
                          <span>Outlook Web</span>
                        </a>
                        <a href={`/api/interviews/ics?id=${item.id}`} class="cal-menu-item">
                          <span>Apple / Outlook (.ics)</span>
                        </a>
                      </div>
                    </div>
                  </div>

                  <div class="right-actions">
                    {isUpcoming && (
                      <>
                        <button
                          type="button"
                          class="btn-action-link text-success"
                          onclick={`updateInterviewStatus('${item.id}', 'completed')`}
                          title="Mark this interview as completed"
                        >
                          ✓ Mark Done
                        </button>
                        <button
                          type="button"
                          class="btn-action-link"
                          onclick={`editInterview('${item.id}', '${escape(JSON.stringify(item))}')`}
                        >
                          Reschedule
                        </button>
                        <button
                          type="button"
                          class="btn-action-link text-danger"
                          onclick={`updateInterviewStatus('${item.id}', 'cancelled')`}
                        >
                          Cancel
                        </button>
                      </>
                    )}
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    <!-- Schedule Interview Modal with Modern Inputs & Searchable Disambiguation Combobox -->
    <div id="scheduleModal" class="modal-backdrop" style="display: none;" onclick="closeModalOnBackdrop(event)">
      <div class="modal card modern-modal">
        <div class="modal-header">
          <div>
            <div class="modal-badge">
              <span class="dot-pulse"></span>
              <span>Interview Setup</span>
            </div>
            <h2 class="modal-title" id="modalHeading">Schedule Candidate Interview</h2>
            <p class="modal-subtitle">Set up video call, phone screen, or onsite rounds with live calendar sync.</p>
          </div>
          <button type="button" class="modal-close" onclick="closeScheduleModal()" aria-label="Close modal">✕</button>
        </div>

        <form id="scheduleForm" onsubmit="submitInterviewSchedule(event)" class="modal-body">
          <input type="hidden" id="formInterviewId" name="interviewId" value="" />
          <input type="hidden" id="formAppSelect" name="applicationId" value="" required />

          <!-- Candidate & Role with Searchable Disambiguation Selector -->
          <div class="form-group mb-4">
            <label class="form-label">
              <span>Candidate & Role <span class="required">*</span></span>
              <span class="label-hint">Search by Name, Email, or Job Title</span>
            </label>

            <!-- 1. Selected Candidate Preview Card (Shown when an applicant is selected) -->
            <div id="selectedCandidateCard" class="selected-candidate-card" style="display: none;">
              <div class="candidate-summary-left">
                <div class="candidate-avatar-badge" id="selectedAvatar">JD</div>
                <div class="candidate-details">
                  <div class="name-email-line">
                    <strong class="selected-name" id="selectedName">John Doe</strong>
                    <span class="selected-email-badge" id="selectedEmail">john@example.com</span>
                  </div>
                  <div class="selected-job-line">
                    <span class="selected-job" id="selectedJob">💼 Senior React Developer</span>
                    <span class="selected-score-badge" id="selectedScore">✨ 95% Match</span>
                  </div>
                </div>
              </div>
              <button type="button" class="btn btn-sm btn-outline-change" onclick="clearCandidateSelection()">
                Change Applicant ↻
              </button>
            </div>

            <!-- 2. Searchable Candidate Combobox (Shown when picking an applicant) -->
            <div id="candidateSearchCombobox" class="candidate-combobox-wrap">
              <div class="search-input-box">
                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                <input
                  type="text"
                  id="candidateSearchInput"
                  class="form-input search-combobox-input"
                  placeholder="Type candidate name, email (e.g. alex@gmail.com), or role..."
                  autocomplete="off"
                  onfocus="showCandidateDropdown()"
                  oninput="filterCandidateOptions(this.value)"
                />
                <button type="button" class="clear-search-btn" id="clearSearchBtn" style="display: none;" onclick="resetCandidateSearch()">✕</button>
              </div>

              <!-- Filterable Applicant Options List -->
              <div id="candidateOptionsList" class="candidate-options-dropdown" style="display: none;">
                {employerApps.length === 0 ? (
                  <div class="no-options-message">
                    <span>No active job applicants found to schedule.</span>
                  </div>
                ) : (
                  employerApps.map(app => {
                    const initials = `${(app.candidateName?.[0] || 'C').toUpperCase()}${(app.candidateLastName?.[0] || '').toUpperCase()}`;
                    const appliedFormatted = app.appliedAt ? new Date(app.appliedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : '';
                    return (
                      <div
                        class="candidate-option-item"
                        data-app-id={app.id}
                        data-name={`${app.candidateName} ${app.candidateLastName}`}
                        data-email={app.candidateEmail}
                        data-job={app.jobTitle}
                        data-initials={initials}
                        data-score={app.aiScore !== null ? `${app.aiScore}% Match` : ''}
                        data-status={app.status.replace('_', ' ')}
                        data-search-text={`${app.candidateName} ${app.candidateLastName} ${app.candidateEmail} ${app.jobTitle} ${app.status}`.toLowerCase()}
                        onclick={`selectCandidate('${app.id}', '${escape(app.candidateName)} ${escape(app.candidateLastName)}', '${escape(app.candidateEmail)}', '${escape(app.jobTitle)}', '${initials}', '${app.aiScore !== null ? `${app.aiScore}% Match` : ''}')`}
                      >
                        <div class="opt-avatar-box">
                          {app.candidateAvatar ? (
                            <img src={app.candidateAvatar} alt={app.candidateName} />
                          ) : (
                            <span>{initials}</span>
                          )}
                        </div>

                        <div class="opt-info-col">
                          <div class="opt-header-line">
                            <span class="opt-candidate-name">{app.candidateName} {app.candidateLastName}</span>
                            <!-- Unique Identifier Email Tag to Disambiguate Identical Names -->
                            <span class="opt-email-tag" title="Applicant Email Address">
                              <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                              {app.candidateEmail}
                            </span>
                          </div>

                          <div class="opt-meta-line">
                            <span class="opt-job-tag">💼 {app.jobTitle}</span>
                            {appliedFormatted && <span class="opt-date-tag">• Applied {appliedFormatted}</span>}
                            <span class="opt-status-tag">{app.status.replace('_', ' ')}</span>
                          </div>
                        </div>

                        <div class="opt-action-arrow">
                          <span>Select →</span>
                        </div>
                      </div>
                    );
                  })
                )}
                <div id="noResultsFound" class="no-options-message" style="display: none;">
                  <span>No applicant matches your search query. Try another name or email.</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Interview Title with Icon -->
          <div class="form-group mb-3">
            <label for="formTitle" class="form-label">
              <span>Interview Title <span class="required">*</span></span>
              <span class="label-hint">e.g. Technical Screening, Culture Fit, Final Round</span>
            </label>
            <div class="input-with-icon">
              <span class="input-icon">🏷️</span>
              <input
                type="text"
                id="formTitle"
                name="title"
                class="form-input"
                placeholder="e.g. Round 1 Technical Screening with Lead Architect"
                required
              />
            </div>
          </div>

          <!-- Format & Duration Row -->
          <div class="form-grid-2 mb-3">
            <div class="form-group">
              <label for="formInterviewType" class="form-label">Interview Format <span class="required">*</span></label>
              <div class="input-with-icon">
                <span class="input-icon">🎙️</span>
                <select id="formInterviewType" name="interviewType" class="form-select" required>
                  <option value="video">Online Video Call (Google Meet / Zoom)</option>
                  <option value="phone">Phone Screening</option>
                  <option value="in_person">In-Person Onsite Round</option>
                </select>
              </div>
            </div>

            <div class="form-group">
              <label for="formDuration" class="form-label">Duration <span class="required">*</span></label>
              <div class="input-with-icon">
                <span class="input-icon">⏱️</span>
                <select id="formDuration" name="durationMinutes" class="form-select" required>
                  <option value="15">15 minutes (Quick Sync)</option>
                  <option value="30">30 minutes</option>
                  <option value="45" selected>45 minutes (Standard)</option>
                  <option value="60">60 minutes (1 Hour)</option>
                  <option value="90">90 minutes (In-Depth Technical)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Date/Time & Meeting URL Row -->
          <div class="form-grid-2 mb-3">
            <div class="form-group">
              <label for="formScheduledAt" class="form-label">Date & Time <span class="required">*</span></label>
              <div class="input-with-icon">
                <span class="input-icon">📅</span>
                <input
                  type="datetime-local"
                  id="formScheduledAt"
                  name="scheduledAt"
                  class="form-input"
                  required
                />
              </div>
            </div>

            <div class="form-group">
              <label for="formMeetingLink" class="form-label">Meeting URL or Location</label>
              <div class="input-with-icon">
                <span class="input-icon">🔗</span>
                <input
                  type="text"
                  id="formMeetingLink"
                  name="meetingLink"
                  class="form-input"
                  placeholder="https://meet.google.com/xyz-abc or Office Room 402"
                />
              </div>
            </div>
          </div>

          <!-- Interviewers Panel -->
          <div class="form-group mb-3">
            <label for="formInterviewers" class="form-label">Interviewer(s) Panel / Hosts</label>
            <div class="input-with-icon">
              <span class="input-icon">👥</span>
              <input
                type="text"
                id="formInterviewers"
                name="interviewerNames"
                class="form-input"
                placeholder="e.g. Alex Rivera (Staff Engineer), Priya Patel (Product Lead)"
              />
            </div>
          </div>

          <!-- Notes / Agenda -->
          <div class="form-group mb-4">
            <label for="formNotes" class="form-label">
              <span>Candidate Preparation & Agenda</span>
              <span class="label-hint">Visible to Candidate</span>
            </label>
            <textarea
              id="formNotes"
              name="notes"
              class="form-textarea"
              rows="3"
              placeholder="Provide agenda, topics to prepare, coding environments required, or documents to bring..."
            ></textarea>
          </div>

          <div class="modal-actions">
            <button type="button" class="btn btn-outline" onclick="closeScheduleModal()">Cancel</button>
            <button type="submit" id="submitScheduleBtn" class="btn btn-primary btn-glow">
              <span id="btnSubmitText">Confirm & Schedule Interview</span>
              <span id="btnSpinner" class="spinner" style="display:none;"></span>
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</DashboardLayout>

<style>
  .interviews-page-container {
    max-width: 1100px;
    margin: 0 auto;
    width: 100%;
    box-sizing: border-box;
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 1.75rem;
  }

  .badge-tag {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-primary);
    background: rgba(167, 139, 250, 0.1);
    padding: 0.2rem 0.6rem;
    border-radius: 9999px;
    display: inline-block;
    margin-bottom: 0.35rem;
  }

  .page-header h1 {
    font-size: 1.85rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: var(--color-text-main);
  }

  .subtitle {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin: 0;
  }

  .btn-glow {
    box-shadow: 0 4px 14px rgba(124, 58, 237, 0.35);
  }

  /* Stats row */
  .stats-pills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1.25rem;
    margin-bottom: 2rem !important;
  }

  .stat-badge-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    padding: 1.15rem 1.25rem;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    z-index: 1;
  }
  .stat-badge-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
    z-index: 5;
  }
  .stat-badge-card.active-card {
    border-color: var(--color-primary);
    background: rgba(167, 139, 250, 0.08);
  }

  .stat-pill-num {
    font-size: 1.65rem;

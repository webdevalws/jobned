---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { users, applications } from '../../db/schema';
import { eq, desc, count } from 'drizzle-orm';

const payload = Astro.locals.user;
if (!payload || (payload.userType !== 'admin' && payload.userType !== 'superadmin')) {
  return Astro.redirect('/login');
}

const db = getDb();

// Fetch ONLY candidates / employees
const candidates = await db.select().from(users).where(
  eq(users.userType, 'employee')
).orderBy(desc(users.createdAt)).all();

// Fetch application counts per candidate
const appCounts = await db.select({
  applicantId: applications.applicantId,
  appCount: count()
}).from(applications).groupBy(applications.applicantId).all();

const appCountMap = new Map(appCounts.map(a => [a.applicantId, a.appCount]));
---

<DashboardLayout title="Candidate Directory - Admin" userType="admin" activePath="/admin/users">
  <div class="dashboard-header mb-4">
    <div class="header-titles">
      <span class="badge-tag">Platform Moderation</span>
      <h1>Candidate Directory & Accounts</h1>
      <p class="subtitle">Review candidate profiles, track job applications, edit details, or manage accounts.</p>
    </div>
    <div class="stats-counter-pill">
      <strong>{candidates.length}</strong> Registered Candidates
    </div>
  </div>

  <script>
  // Search Filter Logic
  const searchInput = document.getElementById('candidateSearchInput') as HTMLInputElement | null;
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      const term = (e.target as HTMLInputElement).value.toLowerCase();
      const rows = document.querySelectorAll('.candidate-row');
      rows.forEach(row => {
        const textContent = row.textContent?.toLowerCase() || '';
        if (textContent.includes(term)) {
          (row as HTMLElement).style.display = '';
        } else {
          (row as HTMLElement).style.display = 'none';
        }
      });
    });
  }

  async function impersonateUser(targetUserId: string) {
    // Impersonation logic placeholder
  }
  </script>

  <!-- Search Section -->
  <div class="search-bar-container mb-4">
    <div class="search-input-wrapper">
      <span class="search-icon">🔍</span>
      <input type="text" id="candidateSearchInput" class="search-input" placeholder="Search candidates by name, headline, email or location..." />
    </div>
  </div>

  <div class="table-card">
    <div class="table-responsive">
      <table class="data-table">
        <thead>
          <tr>
            <th>Candidate & Headline</th>
            <th>Contact Email</th>
            <th>Location & Exp</th>
            <th>Applications</th>
            <th>Account Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {candidates.length === 0 ? (
            <tr>
              <td colspan="6" class="empty-cell">
                <div class="empty-state">
                  <div class="empty-icon">👥</div>
                  <h3>No Candidates Found</h3>
                  <p>No registered candidate accounts exist in the database.</p>
                </div>
              </td>
            </tr>
          ) : (
            candidates.map((cand) => {
              const totalApps = appCountMap.get(cand.id) || 0;
              const isBlocked = cand.isActive === false;

              let skillsArr: string[] = [];
              if (cand.skills) {
                try {
                  const p = typeof cand.skills === 'string' ? JSON.parse(cand.skills) : cand.skills;
                  if (Array.isArray(p)) skillsArr = p;
                } catch (e) {}
              }

              return (
                <tr class={`candidate-row ${isBlocked ? 'blocked-row' : ''}`} data-user-id={cand.id}>
                  <td class="col-user">
                    <div class="user-meta-cell">
                      <div class="user-avatar-circle">
                        {cand.firstName.charAt(0).toUpperCase()}
                      </div>
                      <div>
                        <strong class="user-name-txt">{cand.firstName} {cand.lastName}</strong>
                        <div class="user-headline-sub">{cand.headline || 'Job Seeker'}</div>
                      </div>
                    </div>
                  </td>
                  <td class="col-email">
                    <a href={`mailto:${cand.email}`} class="email-txt">✉️ {cand.email}</a>
                  </td>
                  <td class="col-location">
                    <div class="location-exp-cell">
                      <span>📍 {cand.location || 'Not Specified'}</span>
                      <small>⏱ {cand.experienceYears ? `${cand.experienceYears} Yrs Exp` : 'Fresh / Entry'}</small>
                    </div>
                  </td>
                  <td class="col-apps">
                    <span class="apps-badge">
                      <strong>{totalApps}</strong> Applied
                    </span>
                  </td>
                  <td class="col-status">
                    <span class={`account-pill ${isBlocked ? 'pill-blocked' : 'pill-active'}`}>
                      {isBlocked ? '🔴 Suspended' : '🟢 Active'}
                    </span>
                  </td>
                  <td class="col-actions">
                    <div class="actions-group">
                      <!-- Quick View Modal Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon view-cand-btn" 
                        title="View Candidate Profile Details"
                        data-id={cand.id}
                        data-name={`${cand.firstName} ${cand.lastName}`}
                        data-headline={cand.headline || 'Job Seeker'}
                        data-email={cand.email}
                        data-phone={cand.phone || 'N/A'}
                        data-location={cand.location || 'N/A'}
                        data-exp={cand.experienceYears ? `${cand.experienceYears} Years` : 'Fresh / Entry'}
                        data-skills={JSON.stringify(skillsArr)}
                        data-bio={cand.bio || 'No biography provided.'}
                        data-linkedin={cand.linkedinUrl || ''}
                        data-portfolio={cand.portfolioUrl || ''}
                        data-verified={cand.verifiedStatus}
                        data-active={cand.isActive !== false ? 'Active' : 'Suspended'}
                      >
                        👁️
                      </button>

                      <!-- Edit Button -->
                      <a href={`/admin/users/${cand.id}/edit`} class="btn-action-icon edit-action" title="Edit Candidate Profile">
                        ✏️
                      </a>

                      <!-- Block / Unblock Button -->
                      <button 
                        type="button" 
                        class={`btn-action-icon block-btn ${isBlocked ? 'unblock-action' : 'block-action'}`} 
                        title={isBlocked ? 'Reactivate Candidate Account' : 'Block / Suspend Candidate'}
                        data-id={cand.id}
                        data-action={isBlocked ? 'unblock' : 'block'}
                      >
                        {isBlocked ? '🟢' : '🚫'}
                      </button>

                      <!-- Delete Button -->
                      <button 
                        type="button" 
                        class="btn-action-icon delete-action delete-cand-btn" 
                        title="Delete Candidate Account"
                        data-id={cand.id}
                        data-name={`${cand.firstName} ${cand.lastName}`}
                      >
                        🗑️
                      </button>
                    </div>
                  </td>
                </tr>
              );
            })
          )}
        </tbody>
      </table>
    </div>
  </div>

  <!-- Candidate View Modal -->
  <div id="candModal" class="modal-backdrop" style="display: none;">
    <div class="modal-card">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-avatar" id="cAvatar">U</div>
          <div>
            <h2 id="cName">Candidate Name</h2>
            <p id="cHeadline">Professional Headline</p>
          </div>
        </div>
        <button type="button" class="modal-close" id="closeModal">✕</button>
      </div>

      <div class="modal-body">
        <div class="modal-info-grid">
          <div class="info-item">
            <span class="lbl">Email</span>
            <span class="val" id="cEmail">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Phone</span>
            <span class="val" id="cPhone">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Location</span>
            <span class="val" id="cLocation">—</span>
          </div>
          <div class="info-item">
            <span class="lbl">Experience</span>
            <span class="val" id="cExp">—</span>
          </div>
        </div>

        <div class="modal-section-title">Key Skills</div>
        <div class="skills-tags-wrap" id="cSkills">
          <span class="no-skills">No skills listed</span>
        </div>

        <div class="modal-section-title">Biography & Summary</div>
        <p class="bio-text" id="cBio">Biography details...</p>

        <div class="modal-section-title">Professional Links</div>
        <div class="links-row">
          <a id="cLinkedin" href="#" target="_blank" class="link-pill" style="display: none;">
            <span>🔗</span> LinkedIn Profile ↗
          </a>
          <a id="cPortfolio" href="#" target="_blank" class="link-pill" style="display: none;">
            <span>🌐</span> Portfolio Website ↗
          </a>
          <span id="cNoLinks" class="no-links-txt">No professional links added.</span>
        </div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline" id="closeModalBtn">Close</button>
      </div>
    </div>
  </div>
</DashboardLayout>

<script>
  // Block / Unblock Logic
  document.querySelectorAll('.block-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const userId = b.dataset.id;
      const action = b.dataset.action;
      if (!userId || !action) return;

      const confirmMsg = action === 'block' 
        ? 'Are you sure you want to SUSPEND/BLOCK this candidate? They will be unable to apply to jobs or access candidate features.' 
        : 'Reactivate this candidate account?';

      if (!confirm(confirmMsg)) return;

      try {
        const res = await fetch('/api/admin/users/status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId, action })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast(`Candidate ${action === 'block' ? 'suspended' : 'reactivated'} successfully!`);
          window.location.reload();
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Operation failed', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('Error updating account status', 'error');
      }
    });
  });

  // Delete Candidate Logic
  document.querySelectorAll('.delete-cand-btn').forEach(btn => {
    btn.addEventListener('click', async () => {
      const b = btn as HTMLButtonElement;
      const userId = b.dataset.id;
      const name = b.dataset.name;
      if (!userId) return;

      if (!confirm(`Are you sure you want to PERMANENTLY DELETE candidate "${name}"? All submitted applications will be deleted.`)) {
        return;
      }

      try {
        const res = await fetch('/api/admin/users/delete', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ userId })
        });

        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Candidate deleted successfully.');
          window.location.reload();
        } else {
          const result = await res.json();
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to delete candidate', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('An error occurred during deletion.', 'error');
      }
    });
  });
</script>


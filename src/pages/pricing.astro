            </li>
          </ul>

          <div class="card-action">
            <button 
              type="button" 
              class="btn btn-primary w-full checkout-btn" 
              data-plan="P003"
              data-price={p003.price}
              data-currency={p003.currency}
              data-planname={p003.planName}
            >
              {getButtonText(p003, !!user)}
            </button>

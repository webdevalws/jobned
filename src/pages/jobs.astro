---
import { getResumeViewerUrl } from '../lib/resume-helper';
import DashboardLayout from "../layouts/DashboardLayout.astro";
import { getDb } from "../lib/db";
import { jobPostings, applications, users } from "../db/schema";
import { eq, desc, and, or, isNull, notLike } from "drizzle-orm";

// @ts-ignore
const payload = Astro.locals.user;
const userType = payload?.userType || "employee";

Astro.response.headers.set(
  "Cache-Control",
  "no-store, no-cache, must-revalidate, max-age=0",
);

// Pre-apply job ID from query string (from dashboard "Apply" button)
const preApplyJobId = Astro.url.searchParams.get("apply") || "";
const preViewJobId = Astro.url.searchParams.get("view") || "";
const initialQuery = Astro.url.searchParams.get("q") || "";
const initialLocation = Astro.url.searchParams.get("location") || "";

// Check which jobs the user already applied to
let appliedJobIds: Set<string> = new Set();
let candidateUser: any = null;

if (payload && payload.userType === "employee") {
  try {
    const db = getDb();
    const userApps = await db
      .select({ jobPostingId: applications.jobPostingId })
      .from(applications)
      .where(eq(applications.applicantId, payload.userId))
      .all();

    appliedJobIds = new Set(userApps.map((a) => a.jobPostingId));
    candidateUser = await db.select().from(users).where(eq(users.id, payload.userId)).get();
  } catch (e) {
    console.error("Error loading user application data:", e);
  }
}

const appliedArray = Array.from(appliedJobIds);
---

<DashboardLayout title="Find Jobs" userType={userType} activePath="/jobs">
  <div class="page-header">
    <div>
      <h1 class="page-title">Find Jobs</h1>
      <p class="page-subtitle">
        Discover opportunities posted by top employers
      </p>
    </div>
    <div class="jobs-count-badge" id="jobsCountBadge">
      0 jobs available
    </div>
  </div>

  <!-- Search & Filter Bar -->
  <div class="card search-bar-card">
    <div class="search-row">
      <div class="search-input-wrap">
        <svg
          class="search-icon-svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><circle cx="11" cy="11" r="8"></circle><line
            x1="21"
            y1="21"
            x2="16.65"
            y2="16.65"></line></svg
        >
        <input
          type="text"
          id="searchInput"
          placeholder="Search jobs, skills, companies…"
          class="search-input"
          value={initialQuery}
        />
      </div>
      <div class="search-input-wrap search-location-wrap">
        <svg
          class="search-icon-svg"
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"
          ></path><circle cx="12" cy="10" r="3"></circle></svg
        >
        <input
          type="text"
          id="locationInput"
          placeholder="City or location…"
          class="search-input"
          value={initialLocation}
        />
      </div>
      <div class="filters">
        <select id="typeFilter" class="filter-select">
          <option value="">All Types</option>
          <option value="Full-time">Full-time</option>
          <option value="Part-time">Part-time</option>
          <option value="Contract">Contract</option>
          <option value="Internship">Internship</option>
        </select>
        <select id="expFilter" class="filter-select">
          <option value="">All Levels</option>
          <option value="Entry">Entry Level</option>
          <option value="Mid">Mid Level</option>
          <option value="Senior">Senior</option>
          <option value="Lead">Lead</option>
        </select>
        <label class="remote-toggle">
          <input type="checkbox" id="remoteFilter" />
          <span>Remote Only</span>
        </label>
        <button
          id="clearFilters"
          class="btn btn-outline clear-btn"
          style="display:none;">Clear</button
        >
      </div>
    </div>
  </div>

  <!-- Search Fallback Notice Banner -->
  <div id="fallbackBanner" class="search-fallback-banner" style="display: none;">
    <div class="fallback-banner-content">
      <div class="fallback-icon-wrap">💡</div>
      <div class="fallback-text-group">
        <h4 class="fallback-title" id="fallbackTitle">No exact matches found</h4>
        <p class="fallback-subtitle" id="fallbackSubtitle">Showing all available open job opportunities below so you can explore other great positions:</p>
      </div>
    </div>
    <button type="button" class="btn btn-outline btn-sm fallback-clear-btn" onclick="window.clearAllFilters()">
      <span>Clear Search</span>
    </button>
  </div>

  <!-- Jobs Grid -->
  <div id="jobsGrid" class="jobs-grid">
  </div>

  <div id="loadingIndicator" style="display: none; text-align: center; padding: 2rem;">
    <div style="display: inline-block; width: 24px; height: 24px; border: 3px solid rgba(99, 102, 241, 0.2); border-radius: 50%; border-top-color: var(--color-primary); animation: spin 1s ease-in-out infinite;"></div>
    <p style="color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.5rem;">Loading more jobs...</p>
    <style>@keyframes spin { to { transform: rotate(360deg); } }</style>
  </div>

  <!-- Empty state -->
  <div id="emptyState" class="empty-state" style="display:none;">
    <div class="empty-icon">🔍</div>
    <h3>No jobs found</h3>
    <p>Try adjusting your search or filters</p>
    <button onclick="clearAllFilters()" class="btn btn-primary mt-2"
      >Clear Filters</button
    >
  </div>

  <!-- Apply Modal -->
  <div
    id="applyModal"
    class="modal-backdrop"
    style="display:none;"
    onclick="closeModalBackdrop(event)"
  >
    <div class="modal">
      <div class="modal-header">
        <div>
          <h2 class="modal-title" id="modalJobTitle">Apply for Job</h2>
          <p class="modal-company" id="modalCompany"></p>
        </div>
        <button class="modal-close" onclick="closeApplyModal()">✕</button>
      </div>

      <form id="applyForm" class="modal-body">
        <input type="hidden" id="applyJobId" />

        <input type="hidden" id="modalHasDefaultResume" value={candidateUser?.defaultResumeUrl ? 'true' : 'false'} />

        <!-- Resume Choice Section -->
        {candidateUser?.defaultResumeUrl ? (
          <div class="form-group">
            <label class="form-label">Resume <span class="required">*</span></label>
            <div class="modal-resume-choice-container">
              <label class="modal-resume-choice-card active" id="modalChoiceDefaultLabel">
                <input type="radio" name="modalResumeMode" id="modalModeDefault" value="default" checked />
                <div>
                  <strong>📄 Use Default Resume</strong>
                  <span class="badge-pill-green ml-2">Active</span>
                  <p class="modal-choice-sub">Pre-uploaded resume from your profile</p>
                  <a href={getResumeViewerUrl(candidateUser.defaultResumeUrl, Astro.url.origin)} target="_blank" class="preview-mini-link">Preview ↗</a>
                </div>
              </label>
              <label class="modal-resume-choice-card" id="modalChoiceCustomLabel">
                <input type="radio" name="modalResumeMode" id="modalModeCustom" value="custom" />
                <div>
                  <strong>📤 Upload Custom Resume</strong>
                  <p class="modal-choice-sub">Upload a different PDF file</p>
                </div>
              </label>
            </div>

            <div id="modalCustomResumeBox" class="mt-3" style="display: none;">
              <input
                type="file"
                id="resumeFile"
                class="form-input"
                accept="application/pdf"
                style="padding: 0.625rem;"
              />
              <p class="form-hint">Max file size: 5MB.</p>
              <label class="checkbox-option mt-1">
                <input type="checkbox" id="modalSaveAsDefault" />
                <span>Save as new default resume</span>
              </label>
            </div>
          </div>
        ) : (
          <div class="form-group">
            <label class="form-label" for="resumeFile"
              >Resume (PDF) <span class="required">*</span></label
            >
            <input
              type="file"
              id="resumeFile"
              class="form-input"
              accept="application/pdf"
              required
              style="padding: 0.625rem;"
            />
            <p class="form-hint">Max file size: 5MB.</p>
            <label class="checkbox-option mt-1">
              <input type="checkbox" id="modalSaveAsDefault" checked />
              <span>Save this resume as default for future applications</span>
            </label>
          </div>
        )}

        <div class="form-group">
          <label class="form-label" for="photoFile">
            Applicant Photo / Headshot 
            {candidateUser?.avatarUrl ? <span class="optional">(optional to replace)</span> : <span class="required">*</span>}
          </label>
          {candidateUser?.avatarUrl && (
            <div class="existing-avatar-preview mb-2">
              <img src={candidateUser.avatarUrl} alt="Avatar" class="avatar-thumbnail" />
              <span class="avatar-status-text">✓ Using your profile headshot</span>
            </div>
          )}
          <input
            type="file"
            id="photoFile"
            class="form-input"
            accept="image/png, image/jpeg, image/jpg, image/webp"
            required={!candidateUser?.avatarUrl}
            style="padding: 0.625rem;"
          />
          <p class="form-hint">Clean profile photo (PNG, JPG, WEBP, max 5MB).</p>
        </div>

        <div class="form-group">
          <label class="form-label" for="linkedinUrl"
            >LinkedIn Profile URL <span class="required">*</span></label
          >
          <input
            type="url"
            id="linkedinUrl"
            class="form-input"
            required
            placeholder="https://linkedin.com/in/yourprofile"
            value={candidateUser?.linkedinUrl || ''}
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="portfolioUrl"
            >Portfolio / Website URL <span class="optional">(optional)</span></label
          >
          <input
            type="url"
            id="portfolioUrl"
            class="form-input"
            placeholder="https://yourportfolio.com"
            value={candidateUser?.portfolioUrl || ''}
          />
        </div>

        <div class="form-group">
          <label class="form-label" for="coverLetter"
            >About You / Cover Letter <span class="optional">(optional)</span></label
          >
          <textarea
            id="coverLetter"
            class="form-textarea"
            placeholder="Tell the employer about your background, skills, and why you are a great fit..."
            rows="4"></textarea>
        </div>

        <div class="modal-actions">
          <button
            type="button"
            class="btn btn-outline"
            onclick="closeApplyModal()">Cancel</button
          >
          <button type="submit" class="btn btn-primary" id="submitApplyBtn">
            <span id="submitApplyText">Submit Application</span>
            <span id="submitApplySpinner" style="display:none;"
              >Submitting…</span
            >
          </button>
        </div>
      </form>
    </div>
  </div>
</DashboardLayout>

<style is:global>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .page-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
  }
  .page-subtitle {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    margin: 0;
  }
  .jobs-count-badge {
    background: var(--color-primary-light);
    color: var(--color-primary-dark);
    padding: 0.375rem 0.875rem;
    border-radius: 2rem;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .search-bar-card {
    padding: 1rem 1.25rem;
    margin-bottom: 1.5rem;
  }
  .search-row {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: center;
  }
  .search-input-wrap {
    flex: 1;
    min-width: 200px;
    position: relative;
    display: flex;
    align-items: center;
  }
  .search-icon-svg {
    position: absolute;
    left: 0.75rem;
    color: var(--color-text-muted);
    pointer-events: none;
  }
  .search-input {
    width: 100%;
    padding: 0.625rem 0.75rem 0.625rem 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-family: inherit;
    font-size: 0.9rem;
    background: var(--color-bg);
    color: var(--color-text-main);
    transition: border-color 0.2s;
  }
  .search-input:focus {
    outline: none;
    border-color: var(--color-primary);
    background: var(--color-surface);
  }
  .filters {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    flex-wrap: wrap;
  }
  .filter-select {
    padding: 0.5rem 2.25rem 0.5rem 0.85rem;
    font-size: 0.875rem;
  }
  .remote-toggle {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    cursor: pointer;
    user-select: none;
    white-space: nowrap;
  }
  .remote-toggle input {
    cursor: pointer;
    accent-color: var(--color-primary);
  }
  .clear-btn {
    font-size: 0.8rem;
    padding: 0.4rem 0.75rem;
  }

  .jobs-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 1rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
  }
  .job-card {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    box-sizing: border-box;
    overflow: hidden;
    transition:
      box-shadow 0.2s,
      transform 0.2s;
  }
  .job-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-2px);
  }
  .job-card-top {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    width: 100%;
    min-width: 0;
  }
  .company-logo {
    width: 44px;
    height: 44px;
    border-radius: var(--border-radius-md);
    display: flex;
    align-items: center;
    justify-content: center;
    color: white;
    font-weight: 700;
    font-size: 1.1rem;
    flex-shrink: 0;
  }
  .job-card-meta {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .job-title {
    font-size: 0.95rem;
    font-weight: 700;
    margin: 0 0 0.125rem 0;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
    line-height: 1.3;
  }
  .company-name {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .job-desc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: break-word;
  }
  .job-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    width: 100%;
    min-width: 0;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    flex: 1 1 auto;
    min-width: 0;
    max-width: 100%;
  }
  .tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 1rem;
    color: var(--color-text-muted);
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    box-sizing: border-box;
  }
  .tag-green {
    background: #dcfce7;
    border-color: #86efac;
    color: #15803d;
  }
  .ai-fit-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.2rem 0.6rem;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(59, 130, 246, 0.12));
    border: 1px solid rgba(124, 58, 237, 0.3);
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--color-primary);
    white-space: nowrap;
    margin-top: 0.35rem;
    width: fit-content;
    max-width: 100%;
    box-shadow: 0 2px 8px rgba(124, 58, 237, 0.1);
  }
  .ai-fit-pill strong {
    font-weight: 700;
    color: #7c3aed;
  }
  .tag-salary {
    background: #ede9fe;
    border-color: #c4b5fd;
    color: #6d28d9;
    max-width: 220px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .posted-date {
    font-size: 0.7rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .apply-btn {
    padding: 0.45rem 1.1rem;
    background: linear-gradient(135deg, #6366f1, #8b5cf6);
    color: #ffffff !important;
    border: none;
    border-radius: var(--border-radius-md);
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    white-space: nowrap;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(99, 102, 241, 0.25);
  }
  .apply-btn:hover:not(:disabled),
  .job-card:hover .apply-btn:not(.applied):not(:disabled) {
    background: linear-gradient(135deg, #4f46e5, #7c3aed) !important;
    color: #ffffff !important;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(99, 102, 241, 0.4);
  }
  .apply-btn.applied {
    background: #dcfce7 !important;
    color: #15803d !important;
    cursor: not-allowed;
    box-shadow: none !important;
  }
  .apply-btn:disabled {
    opacity: 0.75;
    cursor: not-allowed;
  }

  .empty-state {
    text-align: center;
    padding: 5rem 2rem;
  }
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }
  .empty-state h3 {
    margin: 0 0 0.5rem 0;
  }
  .empty-state p {
    color: var(--color-text-muted);
    margin: 0;
  }
  .mt-2 {
    margin-top: 1rem;
  }

  /* Modal */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    backdrop-filter: blur(4px);
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .modal {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-xl);
    width: min(540px, 94vw);
    max-height: 88vh;
    overflow-y: auto;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7);
    animation: slideUpModal 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    box-sizing: border-box;
  }
  @keyframes slideUpModal {
    from {
      transform: translateY(30px) scale(0.95);
      opacity: 0;
    }
    to {
      transform: none;
      opacity: 1;
    }
  }

  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 1.5rem 1.5rem 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .modal-title {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0 0 0.25rem 0;
    color: var(--color-text-main);
  }
  .modal-company {
    font-size: 0.9rem;
    color: var(--color-primary);
    margin: 0;
    font-weight: 500;
  }
  .modal-close {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    font-size: 1.25rem;
    cursor: pointer;
    color: var(--color-text-muted);
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    line-height: 1;
    transition: all 0.2s;
  }
  .modal-close:hover {
    background: var(--color-border);
    color: var(--color-text-main);
    transform: rotate(90deg);
  }

  .modal-body {
    padding: 1.5rem;
  }
  .form-group {
    margin-bottom: 1.25rem;
  }
  .form-label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
    color: var(--color-text-main);
  }
  .required {
    color: var(--color-danger);
  }
  .optional {
    color: var(--color-text-muted);
    font-weight: 400;
    font-size: 0.8rem;
  }
  .form-input,
  .form-textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-md);
    font-family: inherit;
    font-size: 0.9rem;
    color: var(--color-text-main);
    transition: all 0.2s;
    background: var(--color-bg);
  }
  .form-input:focus,
  .form-textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.2);
    background: var(--color-surface);
  }
  .form-textarea {
    resize: vertical;
    min-height: 100px;
  }
  .form-hint {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0.35rem 0 0 0;
  }

  .modal-actions {
    display: flex;
    justify-content: flex-end;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
      margin-bottom: 1rem;
    }
    .search-bar-card {
      padding: 0.875rem 0.75rem !important;
      margin-bottom: 1rem !important;
    }
    .search-row {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
    }
    .search-input-wrap {
      width: 100%;
      min-width: 0;
    }
    .filters {
      width: 100%;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem;
    }
    .filter-select {
      width: 100% !important;
      max-width: 100% !important;

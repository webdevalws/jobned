<script is:inline>
  function switchJob(jobId) {
    const urlParams = new URLSearchParams(window.location.search);
    urlParams.set('jobId', jobId);
    window.location.href = `/employer/screening?${urlParams.toString()}`;
  }

  function filterCandidateList() {
    const query = (document.getElementById('candidateSearchInput')?.value || '').toLowerCase().trim();
    const tier = document.getElementById('tierFilter')?.value || 'all';
    const cards = document.querySelectorAll('.candidate-ranking-card');

    cards.forEach(card => {
      const name = card.getAttribute('data-name') || '';
      const skills = card.getAttribute('data-skills') || '';
      const cardTier = card.getAttribute('data-tier') || '';

      const matchQuery = !query || name.includes(query) || skills.includes(query);
      const matchTier = tier === 'all' || cardTier === tier;

      if (matchQuery && matchTier) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  async function updateAppStage(applicationId, newStatus) {
    try {
      const res = await fetch('/api/employer/screening', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'update_status',
          applicationId,
          newStatus
        })
      });
      const data = await res.json();
      if (res.ok) {
        if (window.showToast) window.showToast(`Candidate stage updated to ${newStatus.toUpperCase()}`);
      } else {
        if (window.showToast) window.showToast(data.error || 'Failed to update stage', 'error');
      }
    } catch (e) {
      if (window.showToast) window.showToast('Network error while updating stage', 'error');
    }
  }

  async function batchShortlistTop() {
    const stageDropdowns = document.querySelectorAll('.stage-dropdown');
    const appIds = [];
    stageDropdowns.forEach(d => {
      const id = d.getAttribute('data-app-id');
      if (id) appIds.push(id);
    });

    if (appIds.length === 0) return;

    try {
      const res = await fetch('/api/employer/screening', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'batch_shortlist',
          applicationIds: appIds
        })
      });
      const data = await res.json();
      if (res.ok) {
        if (window.showToast) window.showToast(`✨ Successfully shortlisted top candidates!`);
        setTimeout(() => window.location.reload(), 600);
      } else {
        if (window.showToast) window.showToast(data.error || 'Batch action failed', 'error');
      }
    } catch (e) {
      if (window.showToast) window.showToast('Error executing batch action', 'error');
    }
  }

  async function inviteTalent(candidateId, jobId) {
    try {
      const res = await fetch('/api/employer/screening', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          action: 'invite_talent',
          candidateId,
          jobId
        })
      });
      const data = await res.json();
      if (res.ok) {
        if (window.showToast) window.showToast('🌟 Candidate invited to apply via Direct Message!');
      } else {
        if (window.showToast) window.showToast(data.error || 'Failed to send invite', 'error');
      }
    } catch (e) {
      if (window.showToast) window.showToast('Error sending invitation', 'error');
    }
  }

  async function generateLlamaVerdict(btn, payloadStr) {
    let payload;
    try {
      payload = JSON.parse(payloadStr);
    } catch (e) {
      payload = payloadStr;
    }

    // Find the candidate card and panel
    const card = btn.closest('.candidate-ranking-card');
    if (!card) return;

    // Find the verdict panel — get candidateId from data attribute or from panel id
    const panels = card.querySelectorAll('.llama-verdict-panel');
    const panel = panels[0];
    if (!panel) return;

    const bodyEl = panel.querySelector('.llama-verdict-body');
    if (!bodyEl) return;

    // Show panel with loading state
    panel.style.display = 'block';
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    bodyEl.innerHTML = '<div class="llama-loading">🦙 Llama AI is analyzing this candidate... Please wait a moment.</div>';

    btn.disabled = true;
    btn.textContent = '⏳ Generating...';

    try {
      const res = await fetch('/api/ai/llama-verdict', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();

      if (res.ok && data.verdict) {
        // Safe escape before formatting markdown-like bold text
        const safeVerdict = String(data.verdict)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');

        const formatted = safeVerdict
          .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
          .replace(/\n/g, '<br>');
        bodyEl.innerHTML = `<div>${formatted}</div>
          <div style="margin-top:12px; font-size:0.78rem; color: var(--color-text-muted); border-top: 1px solid rgba(255,255,255,0.07); padding-top:8px;">
            Powered by <strong style="color:#a78bfa">Llama 3.3 70B</strong> via Cloudflare Workers AI
          </div>`;
        if (window.showToast) window.showToast('🦙 AI verdict generated successfully!');
      } else {
        bodyEl.innerHTML = `<div class="llama-error">⚠️ ${data.error || 'Failed to generate verdict. Please try again.'}</div>`;
      }
    } catch (err) {
      bodyEl.innerHTML = '<div class="llama-error">⚠️ Network error. Could not reach AI service.</div>';
    } finally {
      btn.disabled = false;
      btn.textContent = '🦙 AI Verdict';
    }
  }
</script>

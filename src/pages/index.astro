                    <span class="score-text">Match</span>
                  </div>
                </div>

                <div class="dashboard-stats">
                  <div class="stat-bar-group">
                    <div class="stat-label">Skills Alignment</div>
                    <div class="stat-bar">
                      <div
                        class="stat-fill"
                        style="width: 95%; background: var(--color-primary);"
                      >
                      </div>
                    </div>
                  </div>
                  <div class="stat-bar-group">
                    <div class="stat-label">Experience Level</div>
                    <div class="stat-bar">
                      <div
                        class="stat-fill"
                        style="width: 100%; background: #60A5FA;"
                      >
                      </div>
                    </div>
                  </div>
                  <div class="stat-bar-group">
                    <div class="stat-label">Culture Fit</div>
                    <div class="stat-bar">
                      <div
                        class="stat-fill"
                        style="width: 85%; background: #FDBA74;"
                      >
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <div class="dashboard-footer">
                <div class="candidate-pulse">
                  <div class="pulse-dot"></div>
                  <span>Analyzing opportunities...</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section -->
    <section class="stats">

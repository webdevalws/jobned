</style>

<script define:vars={{ appliedArray, preApplyJobId, preViewJobId, initialQuery, initialLocation }}>
  // Parse applied set
  let appliedJobIds = new Set(appliedArray || []);

  // --- FILTER LOGIC ---
  let allJobs = [];

  function renderJobs(jobs, append = false, isFallback = false, filteredQuery = "") {
    const grid = document.getElementById("jobsGrid");
    const empty = document.getElementById("emptyState");
    const badge = document.getElementById("jobsCountBadge");
    const fallbackBanner = document.getElementById("fallbackBanner");
    const fallbackTitle = document.getElementById("fallbackTitle");
    const fallbackSubtitle = document.getElementById("fallbackSubtitle");

    if (isFallback && fallbackBanner) {
      fallbackBanner.style.display = "flex";
      const qText = filteredQuery ? `"${escHtml(filteredQuery)}"` : "your search";
      if (fallbackTitle) fallbackTitle.innerHTML = `No exact matches found for <strong>${escHtml(filteredQuery || 'your query')}</strong>`;
      if (fallbackSubtitle) fallbackSubtitle.textContent = `Showing all available open job opportunities below so you can explore other great positions:`;
      if (badge) badge.textContent = `All ${allJobs.length} available jobs`;
    } else {
      if (fallbackBanner) fallbackBanner.style.display = "none";
      if (badge) badge.textContent = `${allJobs.length} job${allJobs.length !== 1 ? "s" : ""} available`;
    }

    if (jobs.length === 0 && !append) {
      grid.style.display = "none";
      empty.style.display = "block";
      if (fallbackBanner) fallbackBanner.style.display = "none";
      return;
    }
    grid.style.display = "grid";
    empty.style.display = "none";

    const html = (jobs || [])
      .map((job) => {
        try {
          if (!job || !job.id) return "";
          const isApplied = appliedJobIds ? appliedJobIds.has(job.id) : false;
          const salary = formatSalary(
            job.salaryMin,
            job.salaryMax,
            job.salaryCurrency,
          );
          const companyNameStr = job.companyName || "Verified Employer";
          const logoColor = `hsl(${Math.abs(companyNameStr.charCodeAt(0) * 7) % 360}, 60%, 52%)`;

          let pubDate = "Recently";
          if (job.publishedAt) {
            try {
              const d = new Date(job.publishedAt);
              if (!isNaN(d.getTime())) {
                pubDate = d.toLocaleDateString("en-US", { month: "short", day: "numeric" });
              }
            } catch (e) {}
          }

          const scoreBadge = (job.hasProfile && job.matchScore !== undefined && job.matchScore > 0)
            ? `<div class="ai-fit-pill"><span class="ai-spark">✨</span><span class="ai-txt">AI Match: <strong>${job.matchScore}%</strong></span></div>`
            : "";

          const rawCleanDesc = (job.description || "").replace(/<[^>]*>/g, '').replace(/&nbsp;/gi, ' ').replace(/\s+/g, ' ').trim();
          const descSnippet = rawCleanDesc.length > 120 ? rawCleanDesc.slice(0, 120) + "…" : rawCleanDesc;

          return `
          <div class="card job-card" onclick="window.location.href='/jobs/${job.id}'" style="cursor: pointer;" data-job-id="${job.id}">
            <div class="job-card-top">
              <div class="company-logo" style="background:${logoColor}">
                ${companyNameStr.charAt(0).toUpperCase()}
              </div>
              <div class="job-card-meta">
                <h3 class="job-title">${escHtml(job.jobTitle || "Job Position")}</h3>
                <p class="company-name">${escHtml(companyNameStr)}</p>
                ${scoreBadge}
              </div>
              <button
                class="apply-btn ${isApplied ? "applied" : ""}"
                data-job-id="${job.id}"
                data-job-title="${escAttr(job.jobTitle || "")}"
                data-company="${escAttr(companyNameStr)}"
                onclick="event.stopPropagation(); window.location.href='/jobs/${job.id}'"
                ${isApplied ? "disabled" : ""}
              >${isApplied ? "✓ Applied" : "Apply Now"}</button>
            </div>
            <p class="job-desc">${escHtml(descSnippet)}</p>
            <div class="job-footer">
              <div class="tags">
                ${job.locationRemote ? '<span class="tag tag-green">🌐 Remote</span>' : ""}
                ${job.locationCity && !job.locationRemote ? `<span class="tag">📍 ${escHtml(job.locationCity)}</span>` : ""}
                ${job.employmentType ? `<span class="tag">⏱ ${escHtml(job.employmentType)}</span>` : ""}
                ${job.experienceLevel ? `<span class="tag">🎯 ${escHtml(job.experienceLevel)}</span>` : ""}
                ${salary ? `<span class="tag tag-salary">💰 ${escHtml(salary)}</span>` : ""}
              </div>
              <span class="posted-date">${pubDate}</span>
            </div>
          </div>
        `;
        } catch (err) {
          console.error("Error rendering card:", err);
          return "";
        }
      })
      .join("");
      
    if (append) {
      grid.insertAdjacentHTML('beforeend', html);
    } else {
      grid.innerHTML = html;
    }
  }

  function formatSalary(min, max, currency) {
    if ((min === null || min === undefined || min === '') && (max === null || max === undefined || max === '')) return null;
    const c = (currency || 'USD').trim();
    const numMin = Number(min);
    const numMax = Number(max);

    const validMin = !isNaN(numMin) && isFinite(numMin) && numMin > 0;
    const validMax = !isNaN(numMax) && isFinite(numMax) && numMax > 0;
    if (!validMin && !validMax) return null;

    const fmtNum = (n) => {
      if (n >= 1_000_000_000_000) {
        const val = n / 1_000_000_000_000;
        return val > 999 ? '999T+' : `${val.toFixed(1).replace(/\.0$/, '')}T`;
      }
      if (n >= 1_000_000_000) return `${(n / 1_000_000_000).toFixed(1).replace(/\.0$/, '')}B`;
      if (n >= 1_000_000) return `${(n / 1_000_000).toFixed(1).replace(/\.0$/, '')}M`;
      if (n >= 1_000) return `${(n / 1_000).toFixed(0)}k`;
      return `${Math.round(n)}`;
    };

    const fMin = validMin ? fmtNum(numMin) : null;
    const fMax = validMax ? fmtNum(numMax) : null;

    if (fMin && fMax) {
      if (fMin === fMax) return `${c} ${fMin}`;
      return `${c} ${fMin}–${fMax}`;
    }
    if (fMin) return `${c} ${fMin}+`;
    if (fMax) return `Up to ${c} ${fMax}`;
    return null;
  }

  function escHtml(s) {
    return String(s || "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;");
  }
  function escAttr(s) {
    return String(s || "")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  let currentPage = 1;
  let hasMoreJobs = true;
  let isFetching = false;

  async function fetchJobs(page = 1, append = false) {
    const search = (document.getElementById("searchInput")?.value || "").toLowerCase().trim();
    const location = (document.getElementById("locationInput")?.value || "").toLowerCase().trim();
    const type = document.getElementById("typeFilter")?.value || "";
    const exp = document.getElementById("expFilter")?.value || "";
    const remote = document.getElementById("remoteFilter")?.checked;

    const url = new URL("/api/jobs/search", window.location.origin);
    if (search) url.searchParams.set("q", search);
    if (location) url.searchParams.set("location", location);
    if (type) url.searchParams.set("type", type);
    if (exp) url.searchParams.set("exp", exp);
    if (remote) url.searchParams.set("remote", "true");
    url.searchParams.set("page", page);
    
    isFetching = true;
    const loadingEl = document.getElementById('loadingIndicator');
    if (loadingEl) loadingEl.style.display = 'block';
    
    try {
      const res = await fetch(url);
      const data = await res.json();
      
      const newlyFetched = data.jobs || [];
      if (append) {
        allJobs = [...allJobs, ...newlyFetched];
      } else {
        allJobs = newlyFetched;
      }
      
      hasMoreJobs = data.hasMore;
      currentPage = page;
      
      updateClearButton();
      renderJobs(newlyFetched, append, data.isFallback, data.filteredQuery || search || location);
      
    } catch (e) {
      console.error(e);
    } finally {
      isFetching = false;
      const loadingEl = document.getElementById('loadingIndicator');
      if (loadingEl) loadingEl.style.display = 'none';
    }
  }

  function updateClearButton() {
    const search = (document.getElementById("searchInput")?.value || "").trim();
    const location = (document.getElementById("locationInput")?.value || "").trim();
    const type = document.getElementById("typeFilter")?.value || "";
    const exp = document.getElementById("expFilter")?.value || "";
    const remote = document.getElementById("remoteFilter")?.checked;
    
    const hasFilter = search || location || type || exp || remote;
    const clearBtn = document.getElementById("clearFilters");
    if (clearBtn) clearBtn.style.display = hasFilter ? "inline-flex" : "none";
  }

  async function applyFilters() {
    await fetchJobs(1, false);
  }

  // Infinite Scroll Observer
  const observer = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting && hasMoreJobs && !isFetching) {
      fetchJobs(currentPage + 1, true);
    }
  }, { rootMargin: '100px' });

  // Add a sentinel element at the end of the grid for the observer
  const sentinel = document.createElement('div');
  sentinel.style.height = '1px';
  sentinel.style.width = '100%';
  sentinel.style.clear = 'both';
  document.getElementById('jobsGrid')?.after(sentinel);
  observer.observe(sentinel);

  // Live search + filter events
  let debounceTimer;
  let searchRecordTimer;
  const searchInputEl = document.getElementById("searchInput");
  if (searchInputEl) {
    searchInputEl.addEventListener("input", (e) => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 250);

      clearTimeout(searchRecordTimer);
      searchRecordTimer = setTimeout(() => {
        const q = e.target.value.trim();
        if (q.length >= 2) {
          fetch("/api/employee/record-search", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ query: q }),
          }).catch((err) => console.error("Error tracking search", err));
        }
      }, 1500);
    });
  }

  const locationInputEl = document.getElementById("locationInput");
  if (locationInputEl) {
    locationInputEl.addEventListener("input", () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(applyFilters, 250);
    });
  }

  document.getElementById("typeFilter")?.addEventListener("change", applyFilters);
  document.getElementById("expFilter")?.addEventListener("change", applyFilters);
  document.getElementById("remoteFilter")?.addEventListener("change", applyFilters);
  document.getElementById("clearFilters")?.addEventListener("click", () => window.clearAllFilters());

  window.clearAllFilters = function () {
    const sEl = document.getElementById("searchInput");
    const lEl = document.getElementById("locationInput");
    const tEl = document.getElementById("typeFilter");
    const eEl = document.getElementById("expFilter");
    const rEl = document.getElementById("remoteFilter");
    if (sEl) sEl.value = "";
    if (lEl) lEl.value = "";
    if (tEl) tEl.value = "";
    if (eEl) eEl.value = "";
    if (rEl) rEl.checked = false;
    applyFilters();
  };

  // --- MODAL LOGIC ---
  const modalModeDefault = document.getElementById("modalModeDefault");
  const modalModeCustom = document.getElementById("modalModeCustom");
  const modalCustomResumeBox = document.getElementById("modalCustomResumeBox");
  const modalChoiceDefaultLabel = document.getElementById("modalChoiceDefaultLabel");
  const modalChoiceCustomLabel = document.getElementById("modalChoiceCustomLabel");
  const modalResumeFileInput = document.getElementById("resumeFile");

  function updateModalResumeModeUI() {
    if (modalModeCustom && modalModeCustom.checked) {
      if (modalCustomResumeBox) modalCustomResumeBox.style.display = 'block';
      if (modalChoiceCustomLabel) modalChoiceCustomLabel.classList.add('active');
      if (modalChoiceDefaultLabel) modalChoiceDefaultLabel.classList.remove('active');
      if (modalResumeFileInput) modalResumeFileInput.required = true;
    } else if (modalModeDefault && modalModeDefault.checked) {
      if (modalCustomResumeBox) modalCustomResumeBox.style.display = 'none';
      if (modalChoiceDefaultLabel) modalChoiceDefaultLabel.classList.add('active');
      if (modalChoiceCustomLabel) modalChoiceCustomLabel.classList.remove('active');
      if (modalResumeFileInput) {
        modalResumeFileInput.required = false;
        modalResumeFileInput.value = '';
      }
    }
  }

  modalModeDefault?.addEventListener('change', updateModalResumeModeUI);
  modalModeCustom?.addEventListener('change', updateModalResumeModeUI);

  window.openApplyModal = function (btn) {
    const jobId = btn.getAttribute("data-job-id");
    const jobTitle = btn.getAttribute("data-job-title");
    const company = btn.getAttribute("data-company");

    document.getElementById("applyJobId").value = jobId;
    document.getElementById("modalJobTitle").textContent =
      `Apply for: ${jobTitle}`;
    document.getElementById("modalCompany").textContent = company;
    if (modalResumeFileInput) modalResumeFileInput.value = "";
    document.getElementById("photoFile").value = "";
    document.getElementById("coverLetter").value = "";

    if (modalModeDefault) {
      modalModeDefault.checked = true;
      updateModalResumeModeUI();
    }

    const modal = document.getElementById("applyModal");
    modal.style.display = "flex";
    document.body.style.overflow = "hidden";
  };

  window.closeApplyModal = function () {
    document.getElementById("applyModal").style.display = "none";
    document.body.style.overflow = "";
  };

  window.closeModalBackdrop = function (e) {
    if (e.target === document.getElementById("applyModal")) {
      closeApplyModal();
    }
  };

  // Keyboard escape to close
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeApplyModal();
    }
  });

  // --- APPLY FORM SUBMIT ---
  document.getElementById("applyForm").addEventListener("submit", async (e) => {
    e.preventDefault();

    const jobId = document.getElementById("applyJobId").value;
    const resumeFileInput = document.getElementById("resumeFile");
    const photoFileInput = document.getElementById("photoFile");
    const linkedinUrlInput = document.getElementById("linkedinUrl");
    const portfolioUrlInput = document.getElementById("portfolioUrl");
    const coverLetter = document.getElementById("coverLetter").value.trim();
    const hasDefaultResume = document.getElementById("modalHasDefaultResume")?.value === 'true';
    const modalModeDefault = document.getElementById("modalModeDefault");
    const modalModeCustom = document.getElementById("modalModeCustom");
    const isCustomMode = modalModeCustom ? modalModeCustom.checked : !hasDefaultResume;
    const useDefault = hasDefaultResume && !isCustomMode;

    const file = resumeFileInput.files ? resumeFileInput.files[0] : null;

    if (!useDefault && !file) {
      showToast("Please upload your resume", "error");
      return;
    }
    if (!useDefault && file && file.type !== "application/pdf") {
      showToast("Only PDF files are allowed for resume", "error");
      return;
    }

    const photoFile = photoFileInput.files ? photoFileInput.files[0] : null;
    if (!photoFile && photoFileInput.required) {
      showToast("Please upload your profile photo", "error");
      return;
    }

    if (photoFile && photoFile.size > 5 * 1024 * 1024) {
      showToast("Photo must be less than 5MB", "error");
      return;
    }
    if (photoFile && !photoFile.type.startsWith("image/")) {
      showToast("Only image files (PNG, JPG, WEBP) are allowed for photo", "error");
      return;
    }

    let linkedinUrl = linkedinUrlInput.value.trim();
    if (linkedinUrl && !/^https?:\/\//i.test(linkedinUrl)) {
      linkedinUrl = "https://" + linkedinUrl;
    }

    const linkedinRegex = /^https?:\/\/(www\.)?linkedin\.com\/(in|pub|profile)\/[a-zA-Z0-9%\-_]+(\/.*)?$/i;
    if (!linkedinUrl || !linkedinRegex.test(linkedinUrl)) {
      showToast("Please enter a valid LinkedIn profile URL (e.g., https://linkedin.com/in/yourname)", "error");
      linkedinUrlInput.focus();
      return;
    }

    let portfolioUrl = portfolioUrlInput.value.trim();
    if (portfolioUrl && !/^https?:\/\//i.test(portfolioUrl)) {
      portfolioUrl = "https://" + portfolioUrl;
    }

    const submitBtn = document.getElementById("submitApplyBtn");
    const submitText = document.getElementById("submitApplyText");
    const submitSpinner = document.getElementById("submitApplySpinner");

    submitBtn.disabled = true;
    submitText.style.display = "none";
    submitSpinner.style.display = "inline";

    try {
      const formData = new FormData();
      formData.append("jobPostingId", jobId);

      if (useDefault) {
        formData.append("useDefaultResume", "true");
      } else if (file) {
        formData.append("resume", file);
        const saveAsDefaultCb = document.getElementById("modalSaveAsDefault");
        if (saveAsDefaultCb && saveAsDefaultCb.checked) {
          formData.append("saveAsDefault", "true");
        }
      }

      if (photoFile) {
        formData.append("photo", photoFile);
      }
      formData.append("linkedinUrl", linkedinUrl);
      if (portfolioUrl) {
        formData.append("portfolioUrl", portfolioUrl);
      }
      if (coverLetter) {
        formData.append("coverLetter", coverLetter);
      }

      const res = await fetch("/api/employee/apply", {
        method: "POST",
        body: formData,
      });

      const data = await res.json();

      if (res.ok) {
        showToast("Application submitted successfully! 🎉");
        appliedJobIds.add(jobId);

        // Update the button in the grid
        const btns = document.querySelectorAll(`[data-job-id="${jobId}"]`);
        btns.forEach((b) => {
          b.textContent = "✓ Applied";
          b.classList.add("applied");
          b.disabled = true;
        });

        closeApplyModal();
      } else {
        showToast(data.error || "Failed to submit application", "error");
      }
    } catch (err) {
      showToast("Network error. Please try again.", "error");
    } finally {
      submitBtn.disabled = false;
      submitText.style.display = "inline";
      submitSpinner.style.display = "none";
    }
  });

  // --- INITIALIZE ---
  fetchJobs(1, false);
  
  // Quick apply/view from query param
  if (preApplyJobId) {
    window.location.href = `/jobs/${preApplyJobId}`;
  }
  if (preViewJobId) {
    window.location.href = `/jobs/${preViewJobId}`;
  }
</script>

<style>
  .modal-resume-choice-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }
  @media (max-width: 600px) {
    .modal-resume-choice-container {
      grid-template-columns: 1fr;
    }
  }
  .modal-resume-choice-card {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    padding: 0.75rem 0.875rem;
    background: var(--color-surface-hover);
    border: 2px solid var(--color-border);
    border-radius: var(--border-radius-md);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.2s ease;
  }
  .modal-resume-choice-card:hover {
    border-color: var(--color-primary);
  }
  .modal-resume-choice-card.active {
    border-color: var(--color-primary);
    background: rgba(59, 130, 246, 0.04);
  }
  .modal-resume-choice-card input[type="radio"] {
    margin-top: 0.15rem;
    accent-color: var(--color-primary);
  }
  .modal-choice-sub {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    margin: 0.15rem 0 0.35rem 0;
  }
  .badge-pill-green {
    display: inline-flex;
    align-items: center;
    background: rgba(16, 185, 129, 0.15);
    color: #059669;
    font-size: 0.7rem;
    font-weight: 600;
    padding: 0.1rem 0.4rem;
    border-radius: 9999px;

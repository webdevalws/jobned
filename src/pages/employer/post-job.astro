</style>

<!-- CKEditor 5 CDN Script -->
<script is:inline src="https://cdn.ckeditor.com/ckeditor5/39.0.1/classic/ckeditor.js"></script>

<script>
  interface ScreeningQuestion {
    id: string;
    text: string;
    type: 'text' | 'paragraph' | 'yes_no' | 'number' | 'select';
    options?: string[];
    required: boolean;
  }

  let questions: ScreeningQuestion[] = [];

  const questionsContainer = document.getElementById('questions-container');
  const addQuestionBtn = document.getElementById('add-question-btn');

  function renderQuestions() {
    if (!questionsContainer) return;
    questionsContainer.innerHTML = '';

    if (questions.length === 0) {
      questionsContainer.innerHTML = `
        <div style="text-align: center; padding: 1.5rem; border: 1px dashed var(--color-border); border-radius: 10px; color: var(--color-text-muted); font-size: 0.88rem;">
          No screening questions added yet. Click one of the presets above or "+ Add Another Screening Question" below.
        </div>
      `;
      return;
    }

    questions.forEach((q, idx) => {
      const card = document.createElement('div');
      card.className = 'question-item-card';
      card.innerHTML = `
        <div class="q-card-header">
          <span class="q-badge">Question #${idx + 1}</span>
          <div class="q-actions">
            ${idx > 0 ? `<button type="button" class="btn-q-icon btn-move-up" data-idx="${idx}" title="Move Up">↑</button>` : ''}
            ${idx < questions.length - 1 ? `<button type="button" class="btn-q-icon btn-move-down" data-idx="${idx}" title="Move Down">↓</button>` : ''}
            <button type="button" class="btn-q-icon btn-q-delete" data-idx="${idx}" title="Delete Question">🗑️</button>
          </div>
        </div>

        <div class="q-card-grid">
          <div class="form-group" style="margin: 0;">
            <label class="q-field-label">Question Prompt <span class="req">*</span></label>
            <input type="text" class="q-text-input" data-idx="${idx}" value="${q.text}" placeholder="e.g. How many years of experience do you have with TypeScript?" required />
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="q-field-label">Response Type</label>
            <select class="q-type-select" data-idx="${idx}">
              <option value="text" ${q.type === 'text' ? 'selected' : ''}>Short Text</option>
              <option value="paragraph" ${q.type === 'paragraph' ? 'selected' : ''}>Detailed Paragraph</option>
              <option value="yes_no" ${q.type === 'yes_no' ? 'selected' : ''}>Yes / No</option>
              <option value="number" ${q.type === 'number' ? 'selected' : ''}>Numeric (Number/Years)</option>
              <option value="select" ${q.type === 'select' ? 'selected' : ''}>Dropdown (Multiple Choice)</option>
            </select>
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="q-checkbox-pill">
              <input type="checkbox" class="q-req-checkbox" data-idx="${idx}" ${q.required ? 'checked' : ''} />
              <span class="q-req-label">Mandatory Question</span>
            </label>
          </div>

          ${q.type === 'select' ? `
            <div class="form-group q-options-row">
              <label class="q-field-label">Choice Options (Comma separated) <span class="req">*</span></label>
              <input type="text" class="q-options-input" data-idx="${idx}" value="${(q.options || []).join(', ')}" placeholder="e.g. Immediate, 2 Weeks, 1 Month, 2+ Months" required />
            </div>
          ` : ''}
        </div>
      `;
      questionsContainer.appendChild(card);
    });

    attachQuestionEvents();
  }

  function attachQuestionEvents() {
    // Text changes
    document.querySelectorAll('.q-text-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        if (questions[idx]) questions[idx].text = (e.target as HTMLInputElement).value;
      });
    });

    // Type changes
    document.querySelectorAll('.q-type-select').forEach(select => {
      select.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        const val = (e.target as HTMLSelectElement).value as any;
        if (questions[idx]) {
          questions[idx].type = val;
          if (val === 'select' && (!questions[idx].options || questions[idx].options?.length === 0)) {
            questions[idx].options = ['Option 1', 'Option 2'];
          }
          renderQuestions();
        }
      });
    });

    // Options changes
    document.querySelectorAll('.q-options-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        const raw = (e.target as HTMLInputElement).value;
        if (questions[idx]) {
          questions[idx].options = raw.split(',').map(s => s.trim()).filter(Boolean);
        }
      });
    });

    // Required checkbox changes
    document.querySelectorAll('.q-req-checkbox').forEach(box => {
      box.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        if (questions[idx]) questions[idx].required = (e.target as HTMLInputElement).checked;
      });
    });

    // Delete question
    document.querySelectorAll('.btn-q-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        questions.splice(idx, 1);
        renderQuestions();
      });
    });

    // Move up
    document.querySelectorAll('.btn-move-up').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        if (idx > 0) {
          const temp = questions[idx];
          questions[idx] = questions[idx - 1];
          questions[idx - 1] = temp;
          renderQuestions();
        }
      });
    });

    // Move down
    document.querySelectorAll('.btn-move-down').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        if (idx < questions.length - 1) {
          const temp = questions[idx];
          questions[idx] = questions[idx + 1];
          questions[idx + 1] = temp;
          renderQuestions();
        }
      });
    });
  }

  function addQuestion(preset?: string) {
    const id = 'q_' + Math.random().toString(36).substr(2, 9);
    let newQ: ScreeningQuestion = {
      id,
      text: '',
      type: 'text',
      required: true
    };

    if (preset === 'exp') {
      newQ.text = 'How many years of professional experience do you have in this role?';
      newQ.type = 'number';
    } else if (preset === 'notice') {
      newQ.text = 'What is your notice period or earliest start date?';
      newQ.type = 'select';
      newQ.options = ['Immediately available', '1 - 2 weeks', '1 month', '2+ months'];
    } else if (preset === 'auth') {
      newQ.text = 'Are you legally authorized to work in this location without sponsorship?';
      newQ.type = 'yes_no';
    } else if (preset === 'salary') {
      newQ.text = 'What is your expected annual / monthly compensation range?';
      newQ.type = 'text';
    }

    questions.push(newQ);
    renderQuestions();
  }

  addQuestionBtn?.addEventListener('click', () => addQuestion());

  document.querySelectorAll('.chip-btn').forEach(chip => {
    chip.addEventListener('click', (e) => {
      const preset = (e.currentTarget as HTMLElement).dataset.preset;
      addQuestion(preset);
    });
  });

  // Initial render
  renderQuestions();

  // --- HIRING STAGE PIPELINE BUILDER ---
  interface HiringStageItem {
    id: string;
    step: number;
    title: string;
    icon: string;
    desc: string;
  }

  let pipelineStagesList: HiringStageItem[] = [
    { id: 's_1', step: 1, title: 'Application Received', icon: '📥', desc: 'Application & resume submitted' },
    { id: 's_2', step: 2, title: 'AI Screening & Assessment', icon: '✨', desc: 'Semantic AI skills alignment' },
    { id: 's_3', step: 3, title: 'Recruiter Profile Review', icon: '🔍', desc: 'Hiring manager evaluation' },
    { id: 's_4', step: 4, title: 'Technical Interview Round', icon: '🎯', desc: 'Coding & system design evaluation' },
    { id: 's_5', step: 5, title: 'Final Decision & Offer', icon: '🏆', desc: 'Official offer letter' },
  ];

  const stagesContainer = document.getElementById('stages-container');
  const addStageBtn = document.getElementById('add-stage-btn');

  function renderStages() {
    if (!stagesContainer) return;
    stagesContainer.innerHTML = '';

    if (pipelineStagesList.length === 0) {
      stagesContainer.innerHTML = `
        <div style="text-align: center; padding: 1.5rem; border: 1px dashed var(--color-border); border-radius: 10px; color: var(--color-text-muted); font-size: 0.88rem;">
          No hiring stages added yet. Click one of the presets above or "+ Add Custom Stage Step" below.
        </div>
      `;
      return;
    }

    pipelineStagesList.forEach((st, idx) => {
      st.step = idx + 1;
      const card = document.createElement('div');
      card.className = 'stage-item-card';
      card.innerHTML = `
        <div class="stage-card-header">
          <span class="stage-badge">Stage #${st.step}</span>
          <div class="q-actions">
            ${idx > 0 ? `<button type="button" class="btn-q-icon btn-stage-up" data-idx="${idx}" title="Move Up">↑</button>` : ''}
            ${idx < pipelineStagesList.length - 1 ? `<button type="button" class="btn-q-icon btn-stage-down" data-idx="${idx}" title="Move Down">↓</button>` : ''}
            <button type="button" class="btn-q-icon btn-q-delete btn-stage-delete" data-idx="${idx}" title="Delete Stage">🗑️</button>
          </div>
        </div>

        <div class="stage-card-grid">
          <div class="form-group" style="margin: 0;">
            <label class="q-field-label">Icon</label>
            <select class="q-type-select stage-icon-input" data-idx="${idx}">
              <option value="📥" ${st.icon === '📥' ? 'selected' : ''}>📥 Inbox</option>
              <option value="✨" ${st.icon === '✨' ? 'selected' : ''}>✨ AI Spark</option>
              <option value="🔍" ${st.icon === '🔍' ? 'selected' : ''}>🔍 Review</option>
              <option value="🎯" ${st.icon === '🎯' ? 'selected' : ''}>🎯 Target</option>
              <option value="💻" ${st.icon === '💻' ? 'selected' : ''}>💻 Code</option>
              <option value="📞" ${st.icon === '📞' ? 'selected' : ''}>📞 Call</option>
              <option value="🎨" ${st.icon === '🎨' ? 'selected' : ''}>🎨 Design</option>
              <option value="✏️" ${st.icon === '✏️' ? 'selected' : ''}>✏️ Task</option>
              <option value="👥" ${st.icon === '👥' ? 'selected' : ''}>👥 Team</option>
              <option value="👔" ${st.icon === '👔' ? 'selected' : ''}>👔 Manager</option>
              <option value="🏛️" ${st.icon === '🏛️' ? 'selected' : ''}>🏛️ Executive</option>
              <option value="🏆" ${st.icon === '🏆' ? 'selected' : ''}>🏆 Offer</option>
            </select>
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="q-field-label">Stage Title <span class="req">*</span></label>
            <input type="text" class="q-text-input stage-title-input" data-idx="${idx}" value="${st.title}" placeholder="e.g. Technical Interview" required />
          </div>

          <div class="form-group" style="margin: 0;">
            <label class="q-field-label">Stage Description</label>
            <input type="text" class="q-text-input stage-desc-input" data-idx="${idx}" value="${st.desc}" placeholder="e.g. Live coding session with tech lead" />
          </div>
        </div>
      `;
      stagesContainer.appendChild(card);
    });

    attachStageEvents();
  }

  function attachStageEvents() {
    document.querySelectorAll('.stage-title-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        if (pipelineStagesList[idx]) pipelineStagesList[idx].title = (e.target as HTMLInputElement).value;
      });
    });

    document.querySelectorAll('.stage-icon-input').forEach(select => {
      select.addEventListener('change', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        if (pipelineStagesList[idx]) pipelineStagesList[idx].icon = (e.target as HTMLSelectElement).value;
      });
    });

    document.querySelectorAll('.stage-desc-input').forEach(input => {
      input.addEventListener('input', (e) => {
        const idx = parseInt((e.target as HTMLElement).dataset.idx || '0');
        if (pipelineStagesList[idx]) pipelineStagesList[idx].desc = (e.target as HTMLInputElement).value;
      });
    });

    document.querySelectorAll('.btn-stage-delete').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        pipelineStagesList.splice(idx, 1);
        renderStages();
      });
    });

    document.querySelectorAll('.btn-stage-up').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        if (idx > 0) {
          const temp = pipelineStagesList[idx];
          pipelineStagesList[idx] = pipelineStagesList[idx - 1];
          pipelineStagesList[idx - 1] = temp;
          renderStages();
        }
      });
    });

    document.querySelectorAll('.btn-stage-down').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const idx = parseInt((e.currentTarget as HTMLElement).dataset.idx || '0');
        if (idx < pipelineStagesList.length - 1) {
          const temp = pipelineStagesList[idx];
          pipelineStagesList[idx] = pipelineStagesList[idx + 1];
          pipelineStagesList[idx + 1] = temp;
          renderStages();
        }
      });
    });
  }

  function addStage() {
    const id = 's_' + Math.random().toString(36).substr(2, 9);
    pipelineStagesList.push({
      id,
      step: pipelineStagesList.length + 1,
      title: 'Custom Evaluation Stage',
      icon: '🎯',
      desc: 'Candidate evaluation round'
    });
    renderStages();
  }

  function loadPipelinePreset(presetKey: string) {
    if (presetKey === 'tech') {
      pipelineStagesList = [
        { id: 's_1', step: 1, title: 'Application Received', icon: '📥', desc: 'Application & resume submitted' },
        { id: 's_2', step: 2, title: 'AI Screening & Assessment', icon: '✨', desc: 'Semantic AI skills alignment' },
        { id: 's_3', step: 3, title: 'Recruiter Profile Review', icon: '🔍', desc: 'Hiring manager evaluation' },
        { id: 's_4', step: 4, title: 'Technical Interview Round', icon: '🎯', desc: 'Coding & system design evaluation' },
        { id: 's_5', step: 5, title: 'Final Decision & Offer', icon: '🏆', desc: 'Official offer letter' },
      ];
    } else if (presetKey === 'startup') {
      pipelineStagesList = [
        { id: 's_1', step: 1, title: 'Application Submitted', icon: '📥', desc: 'Resume logged in queue' },
        { id: 's_2', step: 2, title: 'Screening Call', icon: '📞', desc: '15-min recruiter chat' },
        { id: 's_3', step: 3, title: 'Founder & Tech Interview', icon: '💻', desc: 'Technical & culture interview' },
        { id: 's_4', step: 4, title: 'Hiring Offer Extended', icon: '🏆', desc: 'Final employment agreement' },
      ];
    } else if (presetKey === 'design') {
      pipelineStagesList = [
        { id: 's_1', step: 1, title: 'Portfolio Submitted', icon: '🎨', desc: 'Portfolio & resume submission' },
        { id: 's_2', step: 2, title: 'Design Challenge', icon: '✏️', desc: 'Take-home design assignment' },
        { id: 's_3', step: 3, title: 'Team Presentation', icon: '👥', desc: 'Design walkthrough & critique' },
        { id: 's_4', step: 4, title: 'Hiring Offer', icon: '🏆', desc: 'Final job offer' },
      ];
    } else if (presetKey === 'corporate') {
      pipelineStagesList = [
        { id: 's_1', step: 1, title: 'Application Received', icon: '📥', desc: 'Form & CV logged' },
        { id: 's_2', step: 2, title: 'HR Screening', icon: '📋', desc: 'HR eligibility check' },
        { id: 's_3', step: 3, title: 'Technical Assessment', icon: '💻', desc: 'Proctored skill assessment' },
        { id: 's_4', step: 4, title: 'Hiring Manager Round', icon: '👔', desc: 'In-depth domain interview' },
        { id: 's_5', step: 5, title: 'Executive Panel', icon: '🏛️', desc: 'Leadership interview' },
        { id: 's_6', step: 6, title: 'Official Job Offer', icon: '🏆', desc: 'Offer & background verification' },
      ];
    }
    renderStages();
  }

  addStageBtn?.addEventListener('click', () => addStage());

  document.querySelectorAll('.pipeline-preset-btn').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const preset = (e.currentTarget as HTMLElement).dataset.pipeline;
      if (preset) loadPipelinePreset(preset);
    });
  });

  renderStages();

  // CKEditor 5 Initialization for Job Description & Responsibilities
  let jobDescriptionEditor: any = null;
  const descEl = document.querySelector('#description');

  if (descEl && typeof (window as any).ClassicEditor !== 'undefined') {
    (window as any).ClassicEditor
      .create(descEl, {
        placeholder: 'Outline key expectations, role responsibilities, tech stack, and ideal qualification criteria...',
        toolbar: [
          'heading', '|',
          'bold', 'italic', 'underline', 'strikethrough', '|',
          'bulletedList', 'numberedList', 'blockQuote', '|',
          'insertTable', 'undo', 'redo'
        ]
      })
      .then((editor: any) => {
        jobDescriptionEditor = editor;
        editor.model.document.on('change:data', () => {
          const descInput = document.querySelector('#description') as HTMLTextAreaElement | null;
          if (descInput) descInput.value = editor.getData();
        });
      })
      .catch((err: any) => {
        console.error('CKEditor init error:', err);
      });
  }

  // Form Submission
  const form = document.getElementById('post-job-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('submit-job-btn') as HTMLButtonElement | null;

  if (form && submitBtn) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (jobDescriptionEditor) {
        const descInput = document.querySelector('#description') as HTMLTextAreaElement | null;
        if (descInput) descInput.value = jobDescriptionEditor.getData();
      }
      
      const formData = new FormData(e.target as HTMLFormElement);
      const data: Record<string, any> = Object.fromEntries(formData.entries());
      
      data.locationRemote = formData.has('locationRemote');

      // Attach custom screening questions & custom hiring pipeline stages
      const validQuestions = questions.filter(q => q.text.trim().length > 0);
      const validStages = pipelineStagesList.filter(s => s.title.trim().length > 0);

      if (validQuestions.length > 0 || validStages.length > 0) {
        data.applicationFormConfig = JSON.stringify({
          questions: validQuestions,
          hiringStages: validStages
        });
      } else {
        data.applicationFormConfig = null;
      }

      const originalText = submitBtn.innerHTML;
      submitBtn.innerText = 'Publishing...';
      submitBtn.disabled = true;
      
      try {
        const res = await fetch('/api/employer/jobs', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify(data)
        });
        
        const result = await res.json();
        
        if (res.ok) {
          // @ts-ignore
          if (window.showToast) window.showToast('Job posted successfully!');
          window.location.href = '/employer/jobs';
        } else {
          // @ts-ignore
          if (window.showToast) window.showToast(result.error || 'Failed to post job. Please try again.', 'error');
        }
      } catch (err) {
        // @ts-ignore
        if (window.showToast) window.showToast('A network error occurred. Please check your connection.', 'error');
      } finally {
        submitBtn.innerHTML = originalText;
        submitBtn.disabled = false;
      }
    });
  }
</script>

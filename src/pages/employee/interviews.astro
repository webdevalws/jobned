---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { getDb } from '../../lib/db';
import { interviews, jobPostings, users } from '../../db/schema';
import { eq, desc, and, or, isNull } from 'drizzle-orm';
import { generateGoogleCalendarUrl, generateOutlookCalendarUrl } from '../../lib/calendar';

const payload = Astro.locals.user;
if (!payload || payload.userType !== 'employee') {
  return Astro.redirect('/login');
}

const db = getDb();

// Fetch all interviews scheduled for this candidate (excluding candidate-deleted ones)
let userInterviews: any[] = [];

try {
  userInterviews = await db.select({
    id: interviews.id,
    applicationId: interviews.applicationId,
    jobPostingId: interviews.jobPostingId,
    title: interviews.title,
    interviewType: interviews.interviewType,
    meetingLink: interviews.meetingLink,
    scheduledAt: interviews.scheduledAt,
    durationMinutes: interviews.durationMinutes,
    status: interviews.status,
    notes: interviews.notes,
    interviewerNames: interviews.interviewerNames,
    timezone: interviews.timezone,
    candidateDeleted: interviews.candidateDeleted,
    jobTitle: jobPostings.jobTitle,
    locationCity: jobPostings.locationCity,
    locationRemote: jobPostings.locationRemote,
    companyName: users.companyName,
    companyAvatar: users.avatarUrl,
    companyIndustry: users.companyIndustry,
    employerFirstName: users.firstName,
    employerLastName: users.lastName
  })
  .from(interviews)
  .innerJoin(jobPostings, eq(interviews.jobPostingId, jobPostings.id))
  .innerJoin(users, eq(interviews.employerId, users.id))
  .where(and(
    eq(interviews.candidateId, payload.userId),
    or(
      eq(interviews.candidateDeleted, false),
      isNull(interviews.candidateDeleted)
    )
  ))
  .orderBy(desc(interviews.scheduledAt))
  .all();
} catch (e) {
  console.error('Error fetching candidate interviews with candidateDeleted filter:', e);
  try {
    userInterviews = await db.select({
      id: interviews.id,
      applicationId: interviews.applicationId,
      jobPostingId: interviews.jobPostingId,
      title: interviews.title,
      interviewType: interviews.interviewType,
      meetingLink: interviews.meetingLink,
      scheduledAt: interviews.scheduledAt,
      durationMinutes: interviews.durationMinutes,
      status: interviews.status,
      notes: interviews.notes,
      interviewerNames: interviews.interviewerNames,
      timezone: interviews.timezone,
      jobTitle: jobPostings.jobTitle,
      locationCity: jobPostings.locationCity,
      locationRemote: jobPostings.locationRemote,
      companyName: users.companyName,
      companyAvatar: users.avatarUrl,
      companyIndustry: users.companyIndustry,
      employerFirstName: users.firstName,
      employerLastName: users.lastName
    })
    .from(interviews)
    .innerJoin(jobPostings, eq(interviews.jobPostingId, jobPostings.id))
    .innerJoin(users, eq(interviews.employerId, users.id))
    .where(eq(interviews.candidateId, payload.userId))
    .orderBy(desc(interviews.scheduledAt))
    .all();
  } catch (err2) {
    console.error('Fallback query error loading interviews:', err2);
    userInterviews = [];
  }
}

const now = new Date();
const upcomingInterviews = userInterviews.filter(i => (i.status === 'scheduled' || i.status === 'rescheduled') && new Date(i.scheduledAt) >= now);
const pastInterviews = userInterviews.filter(i => i.status === 'completed' || i.status === 'cancelled' || new Date(i.scheduledAt) < now);

function formatInterviewTime(d: any) {
  if (!d) return '—';
  const date = d instanceof Date ? d : new Date(d);
  return date.toLocaleDateString('en-US', {
    weekday: 'short',
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    hour: '2-digit',
    minute: '2-digit'
  });
}

function getCountdownBadge(scheduledAt: any) {
  const target = new Date(scheduledAt).getTime();
  const diffMs = target - now.getTime();
  if (diffMs < 0) return 'Past';

  const diffHours = Math.floor(diffMs / (1000 * 60 * 60));
  const diffDays = Math.floor(diffHours / 24);

  if (diffDays === 0) {
    if (diffHours === 0) {
      const diffMins = Math.floor(diffMs / (1000 * 60));
      return `Starts in ${diffMins} mins`;
    }
    return `Today in ${diffHours} hrs`;
  }
  if (diffDays === 1) return 'Tomorrow';
  return `In ${diffDays} days`;
}
---

<DashboardLayout title="My Interviews" userType="employee" activePath="/employee/interviews">
  <div class="candidate-interviews-wrapper">
    <!-- Header -->
    <div class="page-header mb-4">
      <div>
        <div class="badge-row">
          <span class="badge-tag">Candidate Schedule</span>
          {upcomingInterviews.length > 0 && (
            <span class="pulse-pill">
              <span class="dot"></span>
              {upcomingInterviews.length} Upcoming
            </span>
          )}
        </div>
        <h1 class="page-title">My Interviews</h1>
        <p class="page-subtitle">View upcoming interview rounds, join video calls, and sync schedules to your personal calendar.</p>
      </div>

      <a href="/applications" class="btn btn-outline">
        View All Applications &rarr;
      </a>
    </div>

    <!-- Upcoming Section -->
    <div class="section-container mb-5">
      <h2 class="section-heading">
        <span>Upcoming Interviews</span>
        <span class="count-pill">{upcomingInterviews.length}</span>
      </h2>

      {upcomingInterviews.length === 0 ? (
        <div class="card empty-state-box">
          <div class="empty-icon">📅</div>
          <h3>No upcoming interviews scheduled</h3>
          <p>When an employer shortlists you and schedules an interview, it will appear here with calendar sync and video meeting links.</p>
          <a href="/jobs" class="btn btn-primary btn-glow mt-3">Explore Open Positions</a>
        </div>
      ) : (
        <div class="interviews-grid">
          {upcomingInterviews.map((item) => {
            const googleCalUrl = generateGoogleCalendarUrl({
              title: `${item.title} - ${item.companyName || 'JobNed Employer'}`,
              description: `Interview for position: ${item.jobTitle}\nCompany: ${item.companyName || 'JobNed Employer'}\n\nInstructions:\n${item.notes || 'None'}`,
              location: item.meetingLink || 'Online Video Meeting',
              startTime: item.scheduledAt,
              durationMinutes: item.durationMinutes || 45
            });
            const outlookCalUrl = generateOutlookCalendarUrl({
              title: `${item.title} - ${item.companyName || 'JobNed Employer'}`,
              description: `Interview for position: ${item.jobTitle}\nCompany: ${item.companyName || 'JobNed Employer'}`,
              location: item.meetingLink || 'Online Video Meeting',
              startTime: item.scheduledAt,
              durationMinutes: item.durationMinutes || 45
            });

            const countdown = getCountdownBadge(item.scheduledAt);

            return (
              <div class="interview-card card highlight-upcoming">
                <div class="card-top-row">
                  <div class="company-brand-col">
                    <div class="company-logo-avatar">
                      {item.companyAvatar ? (
                        <img src={item.companyAvatar} alt={item.companyName || 'Company'} />
                      ) : (
                        <span>{(item.companyName?.[0] || 'C').toUpperCase()}</span>
                      )}
                    </div>
                    <div>
                      <h3 class="job-role-title">{item.jobTitle}</h3>
                      <p class="company-name-text">
                        <span>{item.companyName || `${item.employerFirstName} ${item.employerLastName}`}</span>
                        {item.locationRemote && <span class="tag-remote">🌐 Remote</span>}
                      </p>
                    </div>
                  </div>

                  <div class="timing-badge-group">
                    <span class="countdown-pill">{countdown}</span>
                    <span class="format-pill">
                      {item.interviewType === 'video' ? '🎥 Video Call' : item.interviewType === 'phone' ? '📞 Phone Screen' : '📍 In-Person'}
                    </span>
                  </div>
                </div>

                <div class="card-details-content">
                  <h4 class="round-title">{item.title}</h4>

                  <div class="datetime-banner">
                    <div class="datetime-item">
                      <span class="icon">🕒</span>
                      <div>
                        <strong class="time-primary">{formatInterviewTime(item.scheduledAt)}</strong>
                        <span class="duration-sub">{item.durationMinutes || 45} minutes duration</span>
                      </div>
                    </div>
                  </div>

                  {item.interviewerNames && (
                    <div class="interviewer-info-row">
                      <span class="label">Interviewers:</span>
                      <span class="val">👥 {item.interviewerNames}</span>
                    </div>
                  )}

                  {item.notes && (
                    <div class="candidate-notes-box">
                      <strong>Preparation & Agenda:</strong>
                      <p>{item.notes}</p>
                    </div>
                  )}
                </div>

                <div class="card-footer-actions">
                  <div class="primary-actions">
                    {item.meetingLink && (
                      <a href={item.meetingLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-join">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>
                        Join Meeting
                      </a>
                    )}

                    <!-- 1-Click Calendar Sync -->
                    <div class="calendar-dropdown-wrap">
                      <button type="button" class="btn btn-outline cal-trigger-btn">
                        <span>📅 Sync to Calendar</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"></polyline></svg>
                      </button>
                      <div class="cal-menu">
                        <a href={googleCalUrl} target="_blank" rel="noopener noreferrer" class="cal-item">
                          <span>Google Calendar</span>
                        </a>
                        <a href={outlookCalUrl} target="_blank" rel="noopener noreferrer" class="cal-item">
                          <span>Outlook Web</span>
                        </a>
                        <a href={`/api/interviews/ics?id=${item.id}`} class="cal-item">
                          <span>Download .ics (Apple / Outlook)</span>
                        </a>
                      </div>
                    </div>
                  </div>

                  <a href={`/applications`} class="btn-app-link">
                    View Application &rarr;
                  </a>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </div>

    <!-- Past / Completed Section -->
    {pastInterviews.length > 0 && (
      <div class="section-container" id="pastInterviewsContainer">
        <h2 class="section-heading past-heading">
          <span>Past & Completed Interviews</span>
          <span class="count-pill muted" id="pastCountPill">{pastInterviews.length}</span>
        </h2>

        <div class="interviews-grid past-grid">
          {pastInterviews.map((item) => (
            <div class="interview-card card past-card" id={`past-interview-${item.id}`}>
              <div class="card-top-row">
                <div class="company-brand-col">
                  <div>
                    <h3 class="job-role-title">{item.jobTitle}</h3>
                    <p class="company-name-text">{item.companyName || 'Employer'}</p>
                  </div>
                </div>

                <div class="past-card-actions">
                  <span class={`status-pill-small status-${item.status}`}>
                    {item.status === 'completed' ? '✓ Completed' : item.status === 'cancelled' ? '✕ Cancelled' : 'Finished'}
                  </span>
                  <button
                    type="button"
                    class="delete-past-btn"
                    onclick={`deletePastInterview('${item.id}')`}
                    title="Delete from history"
                  >
                    🗑️ Delete
                  </button>
                </div>
              </div>

              <div class="card-details-content">
                <h4 class="round-title-muted">{item.title}</h4>
                <p class="past-time-label">Date: {formatInterviewTime(item.scheduledAt)} ({item.durationMinutes || 45} mins)</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</DashboardLayout>

<script>
  async function deletePastInterview(id: string) {
    if (!confirm('Remove this past interview from your history? (This will not affect the employer\'s record).')) {
      return;
    }

    const card = document.getElementById(`past-interview-${id}`);
    if (card) {
      card.style.opacity = '0.3';
      card.style.pointerEvents = 'none';
    }

    try {
      const res = await fetch('/api/interviews/delete-past', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ interviewId: id })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        if (card) card.remove();

        const pastGrid = document.querySelector('.past-grid');
        const countPill = document.getElementById('pastCountPill');
        if (pastGrid) {
          const remaining = pastGrid.children.length;
          if (countPill) countPill.textContent = String(remaining);
          if (remaining === 0) {
            const pastContainer = document.getElementById('pastInterviewsContainer');
            if (pastContainer) pastContainer.remove();
          }
        }
      } else {
        alert(data.error || 'Failed to remove interview.');
        if (card) {
          card.style.opacity = '1';
          card.style.pointerEvents = 'auto';
        }
      }
    } catch (err) {
      console.error('Error deleting interview:', err);
      alert('Network error while removing interview.');
      if (card) {
        card.style.opacity = '1';
        card.style.pointerEvents = 'auto';
      }
    }
  }

  // @ts-ignore
  window.deletePastInterview = deletePastInterview;
</script>


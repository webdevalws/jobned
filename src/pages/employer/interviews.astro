<script is:inline>
  // Rich client-side applicant catalogue
  let selectedAppId = '';

  function showCandidateDropdown() {
    const dropdown = document.getElementById('candidateOptionsList');
    if (dropdown) dropdown.style.display = 'block';
  }

  function hideCandidateDropdown() {
    setTimeout(() => {
      const dropdown = document.getElementById('candidateOptionsList');
      if (dropdown) dropdown.style.display = 'none';
    }, 200);
  }

  function filterCandidateOptions(query) {
    const q = (query || '').toLowerCase().trim();
    const clearBtn = document.getElementById('clearSearchBtn');
    const dropdown = document.getElementById('candidateOptionsList');
    const noResults = document.getElementById('noResultsFound');
    const items = document.querySelectorAll('.candidate-option-item');

    if (clearBtn) clearBtn.style.display = q ? 'inline-block' : 'none';
    if (dropdown) dropdown.style.display = 'block';

    let matchCount = 0;
    items.forEach(el => {
      const searchText = el.getAttribute('data-search-text') || '';
      if (!q || searchText.includes(q)) {
        el.style.display = 'flex';
        matchCount++;
      } else {
        el.style.display = 'none';
      }
    });

    if (noResults) {
      noResults.style.display = matchCount === 0 ? 'block' : 'none';
    }
  }

  function resetCandidateSearch() {
    const input = document.getElementById('candidateSearchInput');
    if (input) {
      input.value = '';
      filterCandidateOptions('');
      input.focus();
    }
  }

  function selectCandidate(appId, name, email, jobTitle, initials, score) {
    selectedAppId = appId;
    document.getElementById('formAppSelect').value = appId;

    // Populate selected preview card
    document.getElementById('selectedName').textContent = unescape(name);
    document.getElementById('selectedEmail').textContent = unescape(email);
    document.getElementById('selectedJob').textContent = `💼 ${unescape(jobTitle)}`;
    document.getElementById('selectedAvatar').textContent = unescape(initials);
    
    const scoreEl = document.getElementById('selectedScore');
    if (score && score !== 'null') {
      scoreEl.textContent = unescape(score);
      scoreEl.style.display = 'inline';
    } else {
      scoreEl.style.display = 'none';
    }

    // Toggle view: show card, hide search box
    document.getElementById('selectedCandidateCard').style.display = 'flex';
    document.getElementById('candidateSearchCombobox').style.display = 'none';
    document.getElementById('candidateOptionsList').style.display = 'none';

    // Auto-suggest interview title if empty
    const titleInput = document.getElementById('formTitle');
    if (titleInput && !titleInput.value) {
      titleInput.value = `Technical Interview - ${unescape(jobTitle)}`;
    }
  }

  function clearCandidateSelection() {
    selectedAppId = '';
    document.getElementById('formAppSelect').value = '';
    document.getElementById('selectedCandidateCard').style.display = 'none';
    document.getElementById('candidateSearchCombobox').style.display = 'block';
    
    const searchInput = document.getElementById('candidateSearchInput');
    if (searchInput) {
      searchInput.value = '';
      filterCandidateOptions('');
      searchInput.focus();
    }
  }

  function openScheduleModal(targetAppId) {
    const modal = document.getElementById('scheduleModal');
    if (modal) {
      document.getElementById('formInterviewId').value = '';
      document.getElementById('modalHeading').textContent = 'Schedule Candidate Interview';
      document.getElementById('btnSubmitText').textContent = 'Confirm & Schedule Interview';
      
      // Default scheduledAt to tomorrow at 10:00 AM local
      const tomorrow = new Date();
      tomorrow.setDate(tomorrow.getDate() + 1);
      tomorrow.setHours(10, 0, 0, 0);
      const isoLocal = new Date(tomorrow.getTime() - tomorrow.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      document.getElementById('formScheduledAt').value = isoLocal;

      // Check if target candidate passed or preselected
      const appIdToUse = targetAppId || new URLSearchParams(window.location.search).get('appId');
      if (appIdToUse) {
        const item = document.querySelector(`.candidate-option-item[data-app-id="${appIdToUse}"]`);
        if (item) {
          selectCandidate(
            appIdToUse,
            escape(item.getAttribute('data-name')),
            escape(item.getAttribute('data-email')),
            escape(item.getAttribute('data-job')),
            item.getAttribute('data-initials'),
            item.getAttribute('data-score')
          );
        }
      } else {
        clearCandidateSelection();
      }

      modal.style.display = 'flex';
    }
  }

  function closeScheduleModal() {
    const modal = document.getElementById('scheduleModal');
    if (modal) modal.style.display = 'none';
  }

  function closeModalOnBackdrop(e) {
    if (e.target.id === 'scheduleModal') {
      closeScheduleModal();
    }
  }

  function editInterview(id, itemJsonEscaped) {
    try {
      const item = JSON.parse(unescape(itemJsonEscaped));
      const modal = document.getElementById('scheduleModal');
      if (!modal) return;

      document.getElementById('formInterviewId').value = item.id;
      
      // Select candidate
      const targetItem = document.querySelector(`.candidate-option-item[data-app-id="${item.applicationId}"]`);
      if (targetItem) {
        selectCandidate(
          item.applicationId,
          escape(targetItem.getAttribute('data-name')),
          escape(targetItem.getAttribute('data-email')),
          escape(targetItem.getAttribute('data-job')),
          targetItem.getAttribute('data-initials'),
          targetItem.getAttribute('data-score')
        );
      } else {
        selectCandidate(
          item.applicationId,
          escape(`${item.candidateFirstName} ${item.candidateLastName}`),
          escape(item.candidateEmail || ''),
          escape(item.jobTitle),
          (item.candidateFirstName?.[0] || 'C').toUpperCase(),
          ''
        );
      }

      document.getElementById('formTitle').value = item.title;
      document.getElementById('formInterviewType').value = item.interviewType || 'video';
      document.getElementById('formDuration').value = item.durationMinutes || 45;
      document.getElementById('formMeetingLink').value = item.meetingLink || '';
      document.getElementById('formInterviewers').value = item.interviewerNames || '';
      document.getElementById('formNotes').value = item.notes || '';

      const d = new Date(item.scheduledAt);
      const isoLocal = new Date(d.getTime() - d.getTimezoneOffset() * 60000).toISOString().slice(0, 16);
      document.getElementById('formScheduledAt').value = isoLocal;

      document.getElementById('modalHeading').textContent = 'Reschedule Interview';
      document.getElementById('btnSubmitText').textContent = 'Save Changes & Reschedule';

      modal.style.display = 'flex';
    } catch (err) {
      console.error('Failed to parse interview details:', err);
    }
  }

  async function submitInterviewSchedule(e) {
    e.preventDefault();
    const submitBtn = document.getElementById('submitScheduleBtn');
    const btnText = document.getElementById('btnSubmitText');
    const spinner = document.getElementById('btnSpinner');

    const appId = document.getElementById('formAppSelect').value;
    if (!appId) {
      alert('Please search and select a candidate for this interview round.');
      return;
    }

    if (submitBtn) submitBtn.disabled = true;
    if (spinner) spinner.style.display = 'inline-block';

    const formData = new FormData(e.target);
    const payload = {
      interviewId: formData.get('interviewId') || undefined,
      applicationId: appId,
      title: formData.get('title'),
      interviewType: formData.get('interviewType'),
      durationMinutes: parseInt(formData.get('durationMinutes'), 10),
      scheduledAt: formData.get('scheduledAt'),
      meetingLink: formData.get('meetingLink'),
      interviewerNames: formData.get('interviewerNames'),
      notes: formData.get('notes'),
    };

    try {
      const res = await fetch('/api/interviews/schedule', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });

      const data = await res.json();
      if (res.ok && data.success) {
        if (typeof window.showToast === 'function') {
          window.showToast(data.message || 'Interview scheduled successfully! ✓');
        }
        setTimeout(() => {
          window.location.reload();
        }, 600);
      } else {
        alert(data.error || 'Failed to schedule interview.');
      }
    } catch (err) {
      console.error('Error submitting interview:', err);
      alert('A network error occurred.');
    } finally {
      if (submitBtn) submitBtn.disabled = false;
      if (spinner) spinner.style.display = 'none';
    }
  }

  async function updateInterviewStatus(interviewId, newStatus) {
    const confirmMsg = newStatus === 'completed'
      ? 'Are you sure you want to mark this interview as completed?'
      : 'Are you sure you want to cancel this interview?';

    if (!confirm(confirmMsg)) return;

    try {
      const res = await fetch('/api/interviews/update-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ interviewId, status: newStatus })
      });

      const data = await res.json();
      if (res.ok && data.success) {
        if (typeof window.showToast === 'function') {
          window.showToast(`Interview marked as ${newStatus} ✓`);
        }
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } else {
        alert(data.error || 'Failed to update interview status.');
      }
    } catch (err) {
      console.error('Error updating status:', err);
      alert('A network error occurred.');
    }
  }

  // Close combobox dropdown when clicking outside
  document.addEventListener('click', (e) => {
    const combobox = document.getElementById('candidateSearchCombobox');
    const dropdown = document.getElementById('candidateOptionsList');
    if (combobox && dropdown && !combobox.contains(e.target)) {
      dropdown.style.display = 'none';
    }
  });

  // Check URL param to open schedule modal automatically
  document.addEventListener('DOMContentLoaded', () => {
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('action') === 'schedule' || urlParams.get('appId')) {
      openScheduleModal(urlParams.get('appId'));
    }
  });
</script>
